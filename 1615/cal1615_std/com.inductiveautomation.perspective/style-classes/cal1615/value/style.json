{
  "base": {
    "style": {
      "height": "22px",
      "lineHeight": "20px",
      "boxSizing": "border-box",
      "padding": "0 3px",
      "overflow": "hidden",
      "whiteSpace": "nowrap",
      "backgroundColor": "var(--neutral-10)",
      "borderColor": "var(--neutral-60)",
      "borderStyle": "solid",
      "borderWidth": "1px",
      "borderRadius": "4px",
      "fontFamily": "Arial",
      "fontSize": "13px",
      "fontWeight": "bold",
      "textAlign": "right",
      "color": "var(--neutral-100)",
      "boxShadow": "inset 0 1px 2px rgba(0,0,0,0.14)",
      "fontVariantNumeric": "tabular-nums"
    }
  }
}