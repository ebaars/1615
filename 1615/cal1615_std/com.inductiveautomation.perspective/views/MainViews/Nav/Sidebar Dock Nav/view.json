        "scripts": {
          "customMethods": [],
          "extensionFunctions": null,
          "messageHandlers": [
            {
              "messageType": "expand-collapse",
              "pageScope": true,
              "script": "\t# implement your handler heredef onMessageReceived(self, payload):\n\t\tstate=payload \n\t\t\n\t\tself.props.items[0].expanded = state\n\t\tself.props.items[1].expanded = state\n\t\tself.props.items[2].expanded = state\n\t\tself.props.items[3].expanded = state\n\t\tself.props.items[4].expanded = state\n\t\tself.props.items[5].expanded = state",
              "sessionScope": false,
              "viewScope": false
            }
          ]
        },
        "type": "ia.display.accordion"
      },
      {
        "children": [
          {
            "events": {
              "component": {
                "onActionPerformed": {
                  "config": {
                    "script": "\tpayload=True\n\t\n\tsystem.perspective.sendMessage('expand-collapse', payload, scope = 'page')"
                  },
                  "scope": "G",
                  "type": "script"
                }
              }
            },
            "meta": {
              "name": "btn-expand"
            },
            "position": {
              "basis": "80px",
              "grow": 1
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "config": {
                    "expression": "if(\n\t{.../Accordion.props.items[0].expanded} = true && \n\t{.../Accordion.props.items[1].expanded} = true && \n\t{.../Accordion.props.items[2].expanded} = true && \n\t{.../Accordion.props.items[3].expanded} = true && \n\t{.../Accordion.props.items[4].expanded} = true && \n\t{.../Accordion.props.items[5].expanded} = true,\n\tfalse, true)"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "image": {
                "height": 16,
                "icon": {
                  "path": "material/unfold_more"
                },
