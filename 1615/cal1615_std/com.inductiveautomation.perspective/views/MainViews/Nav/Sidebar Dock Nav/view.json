        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "padding": "0.25rem 0.5rem",
            "borderBottomStyle": "solid",
            "borderBottomWidth": "1px",
            "borderBottomColor": "var(--neutral-50)"
          }
