{
  "custom": {
    "selected": -1,
    "task": "",
    "interval": 0,
    "rev": 0
  },
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 1680,
      "height": 1024
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "wrap": "wrap",
      "alignContent": "flex-start",
      "alignItems": "flex-start",
      "style": {
        "padding": "6px"
      }
    },
    "children": [
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "schedule"
        },
        "position": {
          "grow": 3,
          "shrink": 0,
          "basis": "600px"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "cal1615/card",
            "padding": "8px",
            "margin": "4px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "basis": "40px",
              "shrink": 0
            },
            "props": {
              "text": "Preventive Maintenance Schedule",
              "style": {
                "fontSize": "22px",
                "fontWeight": "bold",
                "textAlign": "center"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "runTime"
            },
            "position": {
              "basis": "24px",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "textAlign": "center"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p01r02_batch_run_time_hrs",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "expression",
                      "expression": "\"Run Time: \" + numberFormat({value}, \"#,##0\") + \" hours\""
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.table",
            "meta": {
              "name": "table"
            },
            "position": {
              "grow": 1,
              "basis": "300px"
            },
            "props": {
              "selection": {
                "mode": "single"
              },
              "columns": [
                {
                  "field": "Task",
                  "header": {
                    "title": "Task"
                  },
                  "width": 360
                },
                {
                  "field": "Remaining",
                  "header": {
                    "title": "Remaining"
                  },
                  "width": 120,
                  "justify": "right"
                },
                {
                  "field": "Interval",
                  "header": {
                    "title": "Interval"
                  },
                  "width": 120,
                  "justify": "right"
                },
                {
                  "field": "Units",
                  "header": {
                    "title": "Units"
                  },
                  "width": 100
                }
              ]
            },
            "propConfig": {
              "props.data": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "toMillis(now(10000)) + {view.custom.rev}"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\treturn cal1615.pm.rows()"
                    }
                  ]
                }
              }
            },
            "events": {
              "component": {
                "onRowClick": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tself.view.custom.selected = event.rowIndex\n\tself.view.custom.task = event.value['Task']\n\tself.view.custom.interval = event.value['Interval']"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "task"
        },
        "position": {
          "grow": 1,
          "shrink": 0,
          "basis": "260px"
        },
        "props": {
          "direction": "column",
          "style": {
            "classes": "cal1615/card",
            "padding": "10px",
            "margin": "4px",
            "gap": "8px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "basis": "36px",
              "shrink": 0
            },
            "props": {
              "text": "Maintenance Task",
              "style": {
                "fontSize": "18px",
                "fontWeight": "bold",
                "textAlign": "center"
              }
            }
          },
          {
            "type": "ia.input.text-field",
            "meta": {
              "name": "taskName"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "placeholder": "task"
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.task",
                    "bidirectional": true
                  }
                }
              }
            }
          },
          {
            "type": "ia.container.flex",
            "meta": {
              "name": "intervalRow"
            },
            "position": {
              "basis": "30px",
              "shrink": 0
            },
            "props": {
              "direction": "row",
              "alignItems": "stretch"
            },
            "children": [
              {
                "type": "ia.display.label",
                "meta": {
                  "name": "l"
                },
                "position": {
                  "grow": 1,
                  "basis": "0"
                },
                "props": {
                  "text": "Interval (hours)"
                }
              },
              {
                "type": "ia.input.numeric-entry-field",
                "meta": {
                  "name": "interval"
                },
                "position": {
                  "basis": "110px",
                  "shrink": 0
                },
                "props": {
                  "format": "#,##0",
                  "style": {
                    "classes": "cal1615/entry"
                  }
                },
                "propConfig": {
                  "props.value": {
                    "binding": {
                      "type": "property",
                      "config": {
                        "path": "view.custom.interval",
                        "bidirectional": true
                      }
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "create"
            },
            "position": {
              "basis": "44px",
              "shrink": 0
            },
            "props": {
              "text": "Create",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated} && len(trim({view.custom.task})) > 0 && {view.custom.interval} > 0"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tcal1615.pm.add(self.view.custom.task.strip(), self.view.custom.interval)\n\tself.view.custom.rev += 1"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "modify"
            },
            "position": {
              "basis": "44px",
              "shrink": 0
            },
            "props": {
              "text": "Modify",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated} && {view.custom.selected} >= 0"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tcal1615.pm.update(self.view.custom.selected, self.view.custom.task.strip(), self.view.custom.interval)\n\tself.view.custom.rev += 1"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "delete"
            },
            "position": {
              "basis": "44px",
              "shrink": 0
            },
            "props": {
              "text": "Delete",
              "style": {
                "classes": "cal1615/btn-stop"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated} && {view.custom.selected} >= 0"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tcal1615.pm.delete(self.view.custom.selected)\n\tself.view.custom.selected = -1\n\tself.view.custom.rev += 1"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "reset"
            },
            "position": {
              "basis": "44px",
              "shrink": 0
            },
            "props": {
              "text": "Reset",
              "style": {
                "classes": "cal1615/btn-start"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated} && {view.custom.selected} >= 0"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tcal1615.pm.reset(self.view.custom.selected)\n\tself.view.custom.rev += 1"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}