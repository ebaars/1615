            "meta": {
              "name": "publishNow"
            },
            "position": {
              "basis": "150px",
              "shrink": 0
            },
            "props": {
              "text": "Publish now",
              "primary": true,
              "style": {
                "fontSize": "14px"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated} && {[cal1615]HMI/MQTT/connected}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.tag.writeBlocking(['[cal1615]HMI/MQTT/publish_now'], [True])"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "status"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "14px",
                "padding": "2px 8px",
                "textAlign": "left",
                "whiteSpace": "pre-wrap",
                "fontWeight": "bold"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{[cal1615]HMI/MQTT/state} + '   sent ' + toStr({[cal1615]HMI/MQTT/count_out}) + '   received ' + toStr({[cal1615]HMI/MQTT/count_in}) + '   refused ' + toStr({[cal1615]HMI/MQTT/rejected}) + '   ' + coalesce({[cal1615]HMI/MQTT/msg}, '')"
