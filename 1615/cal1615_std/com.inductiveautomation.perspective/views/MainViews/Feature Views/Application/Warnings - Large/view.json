{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "width": 879
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "basis": "800px",
          "grow": 1
        },
        "props": {
          "columns": {
            "active": {
              "displayPath": {
                "enabled": false
              },
              "label": {
                "enabled": true
              },
              "priority": {
                "enabled": false
              },
              "source": {
                "enabled": false
              },
              "state": {
                "enabled": false
              }
            }
          },
          "filters": {
            "active": {
              "priorities": {
                "critical": false,
                "high": false,
                "medium": false
              },
              "states": {
                "clearUnacked": false
              }
            }
          },
          "rowStyles": {
            "activeAcked": {
              "priorities": {
                "low": {
                  "backgroundColor": "#FFCA8A"
                }
              }
            },
            "activeUnacked": {
              "priorities": {
                "low": {
                  "backgroundColor": "#FFAC47"
                }
              }
            }
          },
          "toolbar": {
            "enableFilter": false,
            "enableFilterResults": false,
            "enabled": false
          }
        },
        "type": "ia.display.alarmstatustable"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column"
    },
    "type": "ia.container.flex"
  }
}