{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {},
  "root": {
    "type": "ia.container.breakpt",
    "meta": {
      "name": "root"
    },
    "props": {
      "breakpoint": 1200
    },
    "children": [
      {
        "type": "ia.display.view",
        "meta": {
          "name": "small"
        },
        "position": {},
        "props": {
          "path": "MainViews/Feature Views/Home/Overview - Small",
          "params": {}
        }
      },
      {
        "type": "ia.display.view",
        "meta": {
          "name": "large"
        },
        "position": {
          "size": "large"
        },
        "props": {
          "path": "MainViews/Feature Views/Home/Overview - Large",
          "params": {},
          "useDefaultViewWidth": true,
          "useDefaultViewHeight": true
        },
        "propConfig": {
          "props.style.zoom": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "min(1, ({page.props.dimensions.viewport.width} - if({session.custom.navPinned}, 240, 0) - 20) / 1680)"
              }
            }
          }
        }
      }
    ]
  }
}