{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 56,
      "width": 1272
    }
  },
  "root": {
    "children": [
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "page": "/"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "name": "Home Icon"
        },
        "position": {
          "basis": "40px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "../Alarms.custom.numAlarms"
              },
              "transforms": [
                {
                  "expression": "if({value} \u003e 0, \"Header/Alarm_Active\", \"Header/Icon\")",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/home",
          "style": {
            "marginLeft": 10
          }
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "component": {
            "onActionPerformed": {
              "config": {
                "id": "Menu",
                "type": "toggle"
              },
              "scope": "C",
              "type": "dock"
            }
          }
        },
        "meta": {
          "name": "menuButton"
        },
        "position": {
          "basis": "88px",
          "shrink": 0
        },
        "props": {
          "image": {
            "icon": {
              "path": "material/menu"
            },
            "position": "right"
          },
          "justify": "space-around",
          "primary": false,
          "style": {
            "margin": "8px"
          },
          "text": "Menu"
        },
        "type": "ia.input.button"
      },
      {
        "children": [
          {
            "meta": {
              "name": "logoImage"
            },
            "position": {
              "height": 45,
              "width": 45,
              "x": 8,
              "y": 8
            },
            "props": {
              "fit": {
                "height": 45,
                "mode": "contain",
                "width": 45
              },
              "source": "/system/images/Custom/LitzlerLogo.jpg"
            },
            "type": "ia.display.image"
          },
          {
            "children": [
              {
                "meta": {
                  "name": "logoImage"
                },
                "position": {
                  "height": 53,
                  "width": 65,
                  "y": 0.5
                },
                "props": {
                  "fit": {
                    "height": 60,
                    "mode": "contain",
                    "width": 60
                  },
                  "source": "/system/images/Custom/LitzlerLogo.jpg"
                },
                "type": "ia.display.image"
              }
            ],
            "meta": {
              "name": "logo"
            },
            "position": {
              "height": "auto",
              "width": "auto"
            },
            "type": "ia.container.coord"
          }
        ],
        "meta": {
          "name": "logo_0"
        },
        "position": {
          "basis": "230px",
          "shrink": 0
        },
        "type": "ia.container.coord"
      },
      {
        "meta": {
          "name": "mainNav"
        },
        "position": {
          "basis": "900px",
          "grow": 1
        },
        "props": {
          "path": "Framework/Header Alarm Nav",
          "style": {
            "marginLeft": "8px",
            "marginRight": "8px"
          }
        },
        "type": "ia.display.view"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "User"
        },
        "position": {
          "basis": "30px",
          "shrink": 0
        },
        "props": {
          "path": "material/person",
          "style": {
            "classes": "Header/Icon"
          }
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "hasDelegate": true,
          "name": "Sign In"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.size} !\u003d \"small\""
              },
              "type": "expr"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "session.props.auth.user.userName"
              },
              "transforms": [
                {
                  "expression": "if({value} \u003d null || len({value}) \u003d 0, \"Sign In\", {value})",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "cursor": "pointer",
            "marginLeft": "4px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "hasDelegate": true,
          "name": "Spacer 1"
        },
        "position": {
          "basis": "10px",
          "shrink": 0
        },
        "props": {
          "text": " "
        },
        "type": "ia.display.label"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "page": "/alarms"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "name": "Alarm Icon"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "../Alarms.custom.numAlarms"
              },
              "transforms": [
                {
                  "expression": "if({value} \u003e 0, \"Header/Alarm_Active\", \"Header/Icon\")",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "path": "material/alarm"
        },
        "type": "ia.display.icon"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "page": "/alarms"
              },
              "scope": "C",
              "type": "nav"
            }
          }
        },
        "meta": {
          "hasDelegate": true,
          "name": "Alarms"
        },
        "position": {
          "shrink": 0
        },
        "propConfig": {
          "custom.numAlarms": {
            "binding": {
              "config": {
                "expression": "now(2000)"
              },
              "transforms": [
                {
                  "code": "\tprioAckn \u003d len(system.alarm.queryStatus(priority \u003d [\"high\", \"critical\"],state \u003d [\"ActiveAcked\",\"ActiveUnacked\"]))\n\treturn  prioAckn\n\t\n\t",
                  "type": "script"
                }
              ],
              "type": "expr"
            }
          },
          "position.display": {
            "binding": {
              "config": {
                "expression": "{view.params.size} !\u003d \"small\""
              },
              "type": "expr"
            }
          },
          "props.style.classes": {
            "binding": {
              "config": {
                "path": "../Alarms.custom.numAlarms"
              },
              "transforms": [
                {
                  "expression": "if({value} \u003e 0, \"Header/Alarm_Active\", \"\")",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          },
          "props.text": {
            "binding": {
              "config": {
                "path": "this.custom.numAlarms"
              },
              "transforms": [
                {
                  "expression": "numberFormat({value}, \"#,##0\") + \" alarm\" + if({value} \u003e 1 || {value} \u003d 0, \"s\", \"\")",
                  "type": "expression"
                }
              ],
              "type": "property"
            }
          }
        },
        "props": {
          "style": {
            "cursor": "pointer",
            "marginLeft": "6px"
          }
        },
        "type": "ia.display.label"
      },
      {
        "children": [
          {
            "meta": {
              "name": "Label"
            },
            "position": {
              "basis": "48px",
              "grow": 1,
              "shrink": 0
            },
            "props": {
              "style": {
                "fontSize": "16px",
                "paddingRight": "8px",
                "textAlign": "right"
              },
              "text": "Theme"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Dropdown"
            },
            "position": {
              "basis": "138px",
              "shrink": 0
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "config": {
                    "bidirectional": true,
                    "path": "session.props.theme"
                  },
                  "type": "property"
                }
              }
            },
            "props": {
              "options": [
                {
                  "label": "Light",
                  "value": "light"
                },
                {
                  "label": "Light Cool",
                  "value": "light-cool"
                },
                {
                  "label": "Light Warm",
                  "value": "light-warm"
                },
                {
                  "label": "Dark",
                  "value": "dark"
                },
                {
                  "label": "Dark Cool",
                  "value": "dark-cool"
                },
                {
                  "label": "Dark Warm",
                  "value": "dark-warm"
                }
              ],
              "search": {
                "enabled": false,
                "marginLeft": "8px"
              }
            },
            "type": "ia.input.dropdown"
          }
        ],
        "meta": {
          "name": "themePicker"
        },
        "position": {
          "basis": "216px",
          "grow": 1,
          "shrink": 0
        },
        "props": {
          "justify": "space-between",
          "style": {
            "backgroundColor": " var(--neutral-20)",
            "marginBottom": "8px",
            "marginRight": "16px",
            "marginTop": "8px"
          }
        },
        "type": "ia.container.flex"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignContent": "flex-start",
      "style": {
        "classes": "framework/header"
      }
    },
    "type": "ia.container.flex"
  }
}