              "type": "expr",
              "config": {
                "expression": "if({page.props.path} = \"/zone/1\" || {page.props.path} = \"/zone/2\" || {page.props.path} = \"/zone/3\" || {page.props.path} = \"/advanced-cooling\" || {page.props.path} = \"/rto\", \"framework/header-selected\", \"\")"
              }
            }
          },
          "props.items[2].style.classes": {
            "binding": {
              "type": "expr",
              "config": {
