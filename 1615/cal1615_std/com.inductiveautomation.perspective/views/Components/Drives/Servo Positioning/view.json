        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Gap Position",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.input.numeric-entry-field",
            "meta": {
              "name": "entry"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "format": "#,##0.0000",
              "spinner": {
                "enabled": false
              },
              "style": {
                "classes": "cal1615/entry"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p01_recipe_active/impreg_gap_sp",
                    "bidirectional": false
                  }
                }
              },
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Setpoint is read from p01_recipe_active/impreg_gap_sp but written to the HMI input the PLC copies from.\n\tsystem.tag.writeBlocking(['[cal1615]p02_recipe_from_hmi/impreg_gap_sp'], [self.props.value])"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "IN",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {}
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "row3"
        },
        "position": {
          "basis": "42px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "6px",
            "padding": "4px 6px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "btn_MovetoPosition"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Move to Position",
              "style": {
                "classes": "cal1615/btn-start"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = '[cal1615]p02_dint_from_hmi/impreg_1_/bit_10'\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
                  }
                }
              }
            }
          }
        ]
      }
