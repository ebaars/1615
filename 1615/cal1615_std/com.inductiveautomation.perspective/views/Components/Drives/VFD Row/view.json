      {
        "type": "ia.display.label",
        "meta": {
          "name": "speed"
        },
        "position": {
          "basis": "95px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "textAlign": "right",
            "fontSize": "13px",
            "paddingRight": "12px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "0": "{view.params.speed}"
                },
                "tagPath": "{0}"
              },
              "transforms": [
                {
                  "type": "format",
                  "formatType": "numeric",
                  "formatValue": "#,##0.0"
                }
              ]
            }
          },
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.params.speed}) > 0"
              }
            }
          }
        }
