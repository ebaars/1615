{
  "custom": {
    "sel": 0
  },
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 490,
      "height": 52
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "cal1615/card",
        "gap": "10px",
        "paddingLeft": "12px",
        "paddingRight": "12px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "title"
        },
        "position": {
          "basis": "92px",
          "shrink": 0
        },
        "props": {
          "text": "Spring Conv.",
          "style": {
            "fontSize": "14px",
            "fontWeight": "bold",
            "textAlign": "left"
          }
        }
      },
      {
        "type": "ia.input.slider",
        "meta": {
          "name": "slider"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "min": -5,
          "max": 5,
          "step": 0.1,
          "value": 0
        },
        "propConfig": {
          "props.value": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "coalesce({[cal1615]p23r17_spd_adj}, 0)"
              }
            },
            "onChange": {
              "enabled": true,
              "script": "\tself.view.custom.sel = currentValue"
            }
          },
          "props.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.props.auth.authenticated}"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "chosen"
        },
        "position": {
          "basis": "78px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "14px",
            "fontWeight": "bold",
            "textAlign": "right",
            "whiteSpace": "nowrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "numberFormat({view.custom.sel}, '0.0') + ' %'"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "set"
        },
        "position": {
          "basis": "46px",
          "shrink": 0
        },
        "props": {
          "text": "Set",
          "primary": true,
          "style": {
            "fontSize": "13px"
          }
        },
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "abs({view.custom.sel} - coalesce({[cal1615]p23r17_spd_adj}, 0)) > 0.05"
              }
            }
          },
          "props.enabled": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{session.props.auth.authenticated}"
              }
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tsystem.tag.writeBlocking(['[cal1615]p23r17_spd_adj'], [float(self.view.custom.sel)])"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "actual"
        },
        "position": {
          "basis": "66px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "11px",
            "opacity": "0.75",
            "textAlign": "right",
            "whiteSpace": "nowrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "'PLC ' + numberFormat(coalesce({[cal1615]p23r17_spd_adj}, 0), '0.0')"
              }
            }
          }
        }
      }
    ]
  }
}