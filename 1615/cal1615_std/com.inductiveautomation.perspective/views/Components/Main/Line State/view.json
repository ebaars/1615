        "props": {
          "direction": "column",
          "style": {
            "margin": "4px 8px 2px 8px",
            "borderRadius": "8px",
            "justifyContent": "center",
            "alignItems": "stretch"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "state"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "24px",
                "fontWeight": "800",
                "color": "#ffffff",
                "textAlign": "center",
                "letterSpacing": "1px"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "coalesce({[cal1615]HMI/LineState/state}, '---')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "since"
            },
            "position": {
              "basis": "18px",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "fontSize": "13px",
                "color": "#ffffff",
                "textAlign": "center",
                "opacity": "0.92"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "runScript('cal1615.overview.age', 1000, {[cal1615]HMI/LineState/since}, 'for ')"
                  }
                }
              }
            }
          }
        ],
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({[cal1615]HMI/LineState/state} = 'RUNNING', '#2e9e5b', if({[cal1615]HMI/LineState/state} = 'SETUP', '#e0a21b', if({[cal1615]HMI/LineState/state} = 'DOWN', '#d64545', '#6b7684')))"
              }
            }
          }
        }
      },
