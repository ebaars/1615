{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 250,
      "height": 122
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "style": {
        "classes": "cal1615/card",
        "paddingBottom": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "header"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "text": "Production",
          "style": {
            "classes": "cal1615/card-header"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "buttons"
        },
        "position": {
          "basis": "42px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "6px",
            "padding": "4px 6px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Recipe"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Recipe",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "nav",
                  "scope": "C",
                  "config": {
                    "page": "/recipe"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Trend"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Trend",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "nav",
                  "scope": "C",
                  "config": {
                    "page": "/trend"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "shopOrder"
        },
        "position": {
          "basis": "48px",
          "shrink": 0
        },
        "props": {
          "direction": "column",
          "style": {
            "padding": "2px 6px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "basis": "20px",
              "shrink": 0
            },
            "props": {
              "text": "Shop Order Number",
              "style": {
                "classes": "cal1615/row-label",
                "textAlign": "center"
              }
            }
          },
          {
            "type": "ia.input.text-field",
            "meta": {
              "name": "value"
            },
            "position": {
              "basis": "22px",
              "shrink": 0
            },
            "props": {
              "style": {
                "classes": "cal1615/entry",
                "textAlign": "center"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]HMI/shop_order",
                    "bidirectional": true
                  }
                }
              },
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}