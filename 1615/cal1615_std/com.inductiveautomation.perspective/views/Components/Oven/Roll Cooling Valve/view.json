            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Auto",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = '[cal1615]p02_dint_from_hmi/adv_cooling_4_/bit_17'\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "btn_Manual"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Manual",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = '[cal1615]p02_dint_from_hmi/adv_cooling_4_/bit_18'\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
                  }
                }
              }
            }
          }
        ]
