            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p19_ao_cv",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "#,##0.0"
                    }
                  ]
                }
              }
