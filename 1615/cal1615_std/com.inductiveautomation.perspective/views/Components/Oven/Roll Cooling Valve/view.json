            "props": {
              "text": "%",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {}
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "row1"
        },
        "position": {
          "basis": "28px",
