            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Mode",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
