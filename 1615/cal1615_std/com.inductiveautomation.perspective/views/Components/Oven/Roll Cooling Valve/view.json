            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/status"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p19_dint_to_hmi_0_/bit_19",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "map",
                      "inputType": "scalar",
                      "outputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "Auto"
                        },
                        {
                          "input": false,
                          "output": "Manual"
                        }
                      ],
                      "fallback": "---"
                    }
                  ]
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p19_dint_to_hmi_0_/bit_19",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "map",
                      "inputType": "scalar",
                      "outputType": "color",
                      "mappings": [
                        {
                          "input": true,
                          "output": "#00E000"
                        },
                        {
                          "input": false,
                          "output": "#FFA040"
                        }
                      ],
                      "fallback": "#FFFFFF"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {}
      },
