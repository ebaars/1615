{
  "custom": {
    "t": {}
  },
  "params": {
    "zone": 1
  },
  "propConfig": {
    "params.zone": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.t": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"cal1615.zones.paths\", 0, {view.params.zone})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 300,
      "height": 158
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "style": {
        "classes": "cal1615/card",
        "paddingBottom": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "header"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "text": "Control Valve",
          "style": {
            "classes": "cal1615/card-header"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "output"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Output",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "value"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.cv_output}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "#,##0.0"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "%",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.cv_output}) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "manualSp"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Manual Setpoint",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.input.numeric-entry-field",
            "meta": {
              "name": "entry"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "format": "#,##0.0",
              "spinner": {
                "enabled": false
              },
              "style": {
                "classes": "cal1615/entry"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.cv_manual_sp}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  }
                }
              },
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Setpoint is read from @z:cv_manual_sp but written to the HMI input the PLC copies from.\n\tsystem.tag.writeBlocking([self.view.custom.t['cv_manual_sp_w']], [self.props.value])"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "%",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.cv_manual_sp}) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "mode"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Mode",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "status"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/status"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.cv_auto}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "map",
                      "inputType": "scalar",
                      "outputType": "scalar",
                      "mappings": [
                        {
                          "input": true,
                          "output": "Auto"
                        },
                        {
                          "input": false,
                          "output": "Manual"
                        }
                      ],
                      "fallback": "---"
                    }
                  ]
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.cv_auto}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "map",
                      "inputType": "scalar",
                      "outputType": "color",
                      "mappings": [
                        {
                          "input": true,
                          "output": "#00E000"
                        },
                        {
                          "input": false,
                          "output": "#FFA040"
                        }
                      ],
                      "fallback": "#FFFFFF"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.cv_auto}) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "buttons"
        },
        "position": {
          "basis": "42px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "style": {
            "gap": "6px",
            "padding": "4px 6px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "auto"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Auto",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = self.view.custom.t['pb_cv_auto']\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "manual"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Manual",
              "style": {
                "classes": "cal1615/btn"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = self.view.custom.t['pb_cv_manual']\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}