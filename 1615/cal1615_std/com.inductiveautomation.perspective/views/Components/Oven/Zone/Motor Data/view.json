          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Recirc Fan Setpoint",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.input.numeric-entry-field",
            "meta": {
              "name": "entry"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "format": "#,##0",
