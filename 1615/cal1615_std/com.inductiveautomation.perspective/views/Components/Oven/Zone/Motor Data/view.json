{
  "custom": {
    "t": {}
  },
  "params": {
    "zone": 1
  },
  "propConfig": {
    "params.zone": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.t": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"cal1615.zones.paths\", 0, {view.params.zone})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 340,
      "height": 144
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "style": {
        "classes": "cal1615/card",
        "paddingBottom": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "header"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "text": "Motor Data",
          "style": {
            "classes": "cal1615/card-header"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "exhRpm"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Exhaust Fan",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "value"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.exh_rpm}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "#,##0"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "RPM",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.exh_rpm}) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "exhSp"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Exhaust Fan Setpoint",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.input.numeric-entry-field",
            "meta": {
              "name": "entry"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "format": "#,##0",
              "spinner": {
                "enabled": false
              },
              "style": {
                "classes": "cal1615/entry"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.exh_sp}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  }
                }
              },
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Setpoint is read from @z:exh_sp but written to the HMI input the PLC copies from.\n\tsystem.tag.writeBlocking([self.view.custom.t['exh_sp_w']], [self.props.value])"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "RPM",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.exh_sp}) > 0"
              }
            }
          }
        }
      },
