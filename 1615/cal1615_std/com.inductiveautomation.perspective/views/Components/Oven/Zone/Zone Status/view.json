        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "startHeat"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Start Heat",
              "style": {
                "classes": "cal1615/btn-start"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = self.view.custom.t['pb_start_heat']\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "stopHeat"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Stop Heat",
              "style": {
                "classes": "cal1615/btn-stop"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\ttag = self.view.custom.t['pb_stop_heat']\n\tsystem.tag.writeBlocking([tag], [True])\n\tdef release(tag=tag):\n\t\timport time\n\t\ttime.sleep(0.5)\n\t\tsystem.tag.writeBlocking([tag], [False])\n\tsystem.util.invokeAsynchronous(release)"
