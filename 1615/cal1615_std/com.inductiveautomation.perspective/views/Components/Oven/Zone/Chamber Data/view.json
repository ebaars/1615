{
  "custom": {
    "t": {}
  },
  "params": {
    "zone": 1
  },
  "propConfig": {
    "params.zone": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.t": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "runScript(\"cal1615.zones.paths\", 0, {view.params.zone})"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 300,
      "height": 88
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "style": {
        "classes": "cal1615/card",
        "paddingBottom": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "header"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "text": "Chamber Data",
          "style": {
            "classes": "cal1615/card-header"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "pressure"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Zone Pressure",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "value"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.pressure}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "#,##0.000"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "\"wc",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.pressure}) > 0"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "lfl"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Lower Flash Limit",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "value"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.custom.t.lfl}"
                    },
                    "tagPath": "{0}",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "#,##0.0"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "%",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.custom.t.lfl}) > 0"
              }
            }
          }
        }
      }
    ]
  }
}