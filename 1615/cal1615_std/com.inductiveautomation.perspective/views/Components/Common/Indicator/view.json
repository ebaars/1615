{
  "custom": {},
  "params": {
    "text": "",
    "tagPath": "",
    "onColor": "#00E000",
    "offColor": "#FFFF00",
    "invert": false
  },
  "propConfig": {
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.onColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.offColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.invert": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 130,
      "height": 32
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "backgroundColor": "var(--neutral-10)",
        "borderStyle": "solid",
        "borderWidth": "1px",
        "borderColor": "var(--neutral-60)",
        "borderRadius": "3px",
        "padding": "4px 6px",
        "gap": "6px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "text"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "text": "",
          "style": {
            "fontFamily": "Arial",
            "fontSize": "12px",
            "whiteSpace": "nowrap",
            "overflow": "hidden",
            "lineHeight": "22px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.text"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "lamp"
        },
        "position": {
          "basis": "18px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "borderRadius": "4px",
            "borderStyle": "solid",
            "borderWidth": "1px",
            "borderColor": "#555555",
            "width": "18px",
            "height": "18px",
            "minWidth": "18px",
            "boxSizing": "border-box"
          }
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "tag",
              "config": {
                "fallbackDelay": 2.5,
                "mode": "indirect",
                "references": {
                  "0": "{view.params.tagPath}"
                },
                "tagPath": "{0}"
              },
              "transforms": [
                {
                  "type": "expression",
                  "expression": "if(isNull({value}), \"#FF00FF\", if(toBoolean({value}) != {view.params.invert}, {view.params.onColor}, {view.params.offColor}))"
                }
              ]
            }
          }
        }
      }
    ]
  }
}