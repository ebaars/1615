{
  "custom": {},
  "params": {
    "title": "",
    "message": "",
    "tagPath": "",
    "value": true
  },
  "propConfig": {
    "params.title": {
      "paramDirection": "input",
      "persistent": false
    },
    "params.message": {
      "paramDirection": "input",
      "persistent": false
    },
    "params.tagPath": {
      "paramDirection": "input",
      "persistent": false
    },
    "params.value": {
      "paramDirection": "input",
      "persistent": false
    }
  },
  "props": {
    "defaultSize": {
      "width": 400,
      "height": 170
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "style": {
        "classes": "cal1615/card",
        "padding": "12px",
        "gap": "12px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "message"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "text": "",
          "style": {
            "fontSize": "15px",
            "textAlign": "center",
            "whiteSpace": "pre-wrap"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "{view.params.message}"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "buttons"
        },
        "position": {
          "basis": "44px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "justify": "center",
          "style": {
            "gap": "16px"
          }
        },
        "children": [
          {
            "type": "ia.input.button",
            "meta": {
              "name": "yes"
            },
            "position": {
              "basis": "140px",
              "shrink": 0
            },
            "props": {
              "text": "Yes, reset",
              "primary": true,
              "style": {
                "fontSize": "15px"
              }
            },
            "propConfig": {
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.tag.writeBlocking([self.view.params.tagPath], [self.view.params.value])\n\tsystem.perspective.closePopup('confirm')"
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "no"
            },
            "position": {
              "basis": "140px",
              "shrink": 0
            },
            "props": {
              "text": "Cancel",
              "style": {
                "fontSize": "15px"
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tsystem.perspective.closePopup('confirm')"
                  }
                }
              }
            }
          }
        ]
      }
    ]
  }
}