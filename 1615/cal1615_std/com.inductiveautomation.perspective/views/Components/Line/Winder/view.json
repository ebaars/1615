                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Setpoint is read from p01_recipe_active/winder_tension_sp but written to the HMI input the PLC copies from.\n\tsystem.tag.writeBlocking(['[cal1615]p02_recipe_from_hmi/winder_tension_sp'], [self.props.value])"
                  }
                }
