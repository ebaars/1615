{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 243,
      "height": 88
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "column",
      "style": {
        "classes": "cal1615/card",
        "paddingBottom": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "header"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "text": "Roll Cooling",
          "style": {
            "classes": "cal1615/card-header"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "row0"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Temperature",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "value"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "text": "---",
              "style": {
                "classes": "cal1615/value"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p19_ai_tc01",
                    "bidirectional": false
                  },
                  "transforms": [
                    {
                      "type": "format",
                      "formatType": "numeric",
                      "formatValue": "#,##0.0"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "F",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {}
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "row1"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "stretch",
          "style": {
            "paddingLeft": "6px",
            "paddingRight": "6px",
            "paddingTop": "3px",
            "paddingBottom": "3px",
            "gap": "4px"
          }
        },
        "children": [
          {
            "type": "ia.display.label",
            "meta": {
              "name": "title"
            },
            "position": {
              "grow": 1,
              "basis": "0"
            },
            "props": {
              "text": "Temperature Setpoint",
              "style": {
                "classes": "cal1615/row-label"
              }
            }
          },
          {
            "type": "ia.input.numeric-entry-field",
            "meta": {
              "name": "entry"
            },
            "position": {
              "basis": "100px",
              "shrink": 0
            },
            "props": {
              "format": "#,##0.0",
              "spinner": {
                "enabled": false
              },
              "style": {
                "classes": "cal1615/entry"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "direct",
                    "tagPath": "[cal1615]p01_recipe_active/adv_cooling_temp_sp",
                    "bidirectional": false
                  }
                }
              },
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.props.auth.authenticated}"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\t# Setpoint is read from p01_recipe_active/adv_cooling_temp_sp but written to the HMI input the PLC copies from.\n\tsystem.tag.writeBlocking(['[cal1615]p02_recipe_from_hmi/adv_cooling_temp_sp'], [self.props.value])"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "F",
              "style": {
                "classes": "cal1615/units"
              }
            }
          }
        ],
        "propConfig": {}
      }
    ]
  }
}