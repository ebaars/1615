                  "config": {
                    "script": "\t# Setpoint is read from p01_recipe_active/ts2_tension_sp but written to the HMI input the PLC copies from.\n\tsystem.tag.writeBlocking(['[cal1615]p02_recipe_from_hmi/ts2_tension_sp'], [self.props.value])"
