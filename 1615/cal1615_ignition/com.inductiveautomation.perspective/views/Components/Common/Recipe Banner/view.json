{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 677,
      "height": 32
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "cal1615/banner"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "lbl"
        },
        "position": {
          "basis": "170px",
          "shrink": 0
        },
        "props": {
          "text": "Active Recipe:"
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "name"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "text": "---"
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "tag",
              "config": {
                "fallbackDelay": 2.5,
                "mode": "direct",
                "tagPath": "[cal1615]p01_recipe_active/name/name"
              }
            },
            "transforms": [
              {
                "type": "expression",
                "expression": "if(isNull({value}), \"---\", {value})"
              }
            ]
          }
        }
      }
    ]
  }
}