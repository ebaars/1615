{
  "custom": {},
  "params": {
    "compact": false,
    "label": "",
    "tag": "",
    "writeTag": "",
    "units": "",
    "kind": "value",
    "format": "#,##0.0",
    "stacked": false,
    "map": {},
    "leds": [],
    "buttons": [],
    "labelWidth": ""
  },
  "propConfig": {
    "params.compact": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.label": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.writeTag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.units": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.kind": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.format": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.stacked": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.map": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.leds": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.buttons": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.labelWidth": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "width": 240,
      "height": 26
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "paddingLeft": "4px",
        "paddingRight": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "lbl"
        },
        "position": {
          "grow": 1,
          "shrink": 1,
          "basis": "0"
        },
        "props": {
          "text": "",
          "style": {
            "classes": "cal1615/row-label"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.label"
              }
            }
          },
          "props.style.textAlign": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.stacked}, \"center\", \"left\")"
              }
            }
          },
          "position.display": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "len({view.params.label}) > 0"
              }
            }
          },
          "position.basis": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.stacked}, \"18px\", if(len({view.params.labelWidth}) > 0, {view.params.labelWidth}, \"0\"))"
              }
            }
          },
          "position.grow": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.stacked} || len({view.params.labelWidth}) > 0, 0, 1)"
              }
            }
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "val"
        },
        "position": {
          "grow": 0,
          "shrink": 0,
          "basis": "auto"
        },
        "props": {
          "direction": "row",
          "justify": "center",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "ia.input.numeric-entry-field",
            "meta": {
              "name": "entry"
            },
            "position": {
              "basis": "66px",
              "shrink": 0
            },
            "props": {
              "value": null,
              "format": "#,##0.0",
              "spinner": {
                "enabled": false
              },
              "style": {
                "classes": "cal1615/entry"
              }
            },
            "propConfig": {
              "props.value": {
                "binding": {
                  "type": "tag",
                  "config": {
                    "bidirectional": false,
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "0": "{view.params.tag}"
                    },
                    "tagPath": "{0}"
                  }
                },
                "onChange": {
                  "enabled": null,
                  "script": "\tif origin not in ('Browser', 'BindingWriteback'):\n\t\treturn\n\tif currentValue is None or (previousValue is not None and currentValue.value == previousValue.value):\n\t\treturn\n\tp = self.view.params\n\ttarget = p.writeTag or p.tag\n\tif target:\n\t\tsystem.tag.writeBlocking([target], [currentValue.value])\n"
                }
              },
              "props.format": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.format"
                  }
                }
              },
              "props.enabled": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "{session.custom.canOperate}"
                  }
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "units"
            },
            "position": {
              "basis": "34px",
              "shrink": 0
            },
            "props": {
              "text": "",
              "style": {
                "classes": "cal1615/units"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.params.units"
                  }
                }
              },
              "position.display": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "!{view.params.stacked} || len({view.params.units}) > 0"
                  }
                }
              }
            }
          }
        ],
        "propConfig": {
          "position.basis": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.params.stacked}, \"22px\", if({view.params.compact}, \"34px\", if({view.params.kind} = \"value\" || {view.params.kind} = \"entry\", \"auto\", \"55%\")))"
              }
            }
          },
          "position.grow": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(!{view.params.stacked} && len({view.params.label}) = 0, 1, 0)"
              }
            }
          }
        }
      }
    ],
    "propConfig": {
      "props.direction": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.stacked}, \"column\", \"row\")"
          }
        }
      },
      "props.alignItems": {
        "binding": {
          "type": "expr",
          "config": {
            "expression": "if({view.params.stacked}, \"stretch\", \"center\")"
          }
        }
      }
    }
  }
}