{
  "custom": {
    "v": null
  },
  "params": {
    "text": "",
    "tag": "",
    "onColor": "#00E000",
    "offColor": "#FFFF00",
    "invert": false
  },
  "propConfig": {
    "params.text": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.tag": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.onColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.offColor": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.invert": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.v": {
      "binding": {
        "type": "tag",
        "config": {
          "bidirectional": false,
          "fallbackDelay": 2.5,
          "mode": "indirect",
          "references": {
            "0": "{view.params.tag}"
          },
          "tagPath": "{0}"
        }
      }
    }
  },
  "props": {
    "defaultSize": {
      "width": 110,
      "height": 30
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "cal1615/indicator",
        "height": "100%",
        "gap": "4px"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "text"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "text": "",
          "style": {
            "fontFamily": "Arial",
            "fontSize": "12px",
            "whiteSpace": "nowrap",
            "overflow": "hidden"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.text"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "lamp"
        },
        "position": {
          "basis": "18px",
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "borderRadius": "4px",
            "borderStyle": "solid",
            "borderWidth": "1px",
            "borderColor": "#555555",
            "height": "18px",
            "minWidth": "18px"
          }
        },
        "propConfig": {
          "props.style.backgroundColor": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if(isNull({view.custom.v}), \"#FF00FF\", if(toBoolean({view.custom.v}) != {view.params.invert}, {view.params.onColor}, {view.params.offColor}))"
              }
            }
          }
        }
      }
    ]
  }
}