{
  "custom": {},
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 400,
      "height": 56
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "position": {},
    "props": {
      "direction": "row",
      "alignItems": "center",
      "style": {
        "classes": "cal1615/header",
        "gap": "8px",
        "paddingLeft": "6px",
        "paddingRight": "6px"
      }
    },
    "children": [
      {
        "type": "ia.display.image",
        "meta": {
          "name": "parkLogo"
        },
        "position": {
          "basis": "150px",
          "shrink": 1
        },
        "props": {
          "source": "data:image/png;base64,",
          "fit": {
            "mode": "contain"
          }
        },
        "events": {
          "dom": {
            "onClick": {
              "type": "nav",
              "scope": "C",
              "config": {
                "page": "/"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "spacer"
        },
        "position": {
          "grow": 1,
          "basis": "0"
        },
        "props": {
          "text": ""
        }
      },
      {
        "type": "ia.display.icon",
        "meta": {
          "name": "alarmIcon"
        },
        "position": {
          "basis": "26px",
          "shrink": 0
        },
        "props": {
          "path": "material/notifications",
          "style": {
            "classes": "cal1615/header-icon"
          }
        },
        "propConfig": {
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({../alarmCount.custom.numAlarms} > 0, \"cal1615/alarm-active\", \"cal1615/header-icon\")"
              }
            }
          }
        },
        "events": {
          "dom": {
            "onClick": {
              "type": "nav",
              "scope": "C",
              "config": {
                "page": "/alarms"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "alarmCount"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "",
          "style": {
            "cursor": "pointer"
          }
        },
        "custom": {
          "numAlarms": 0
        },
        "propConfig": {
          "custom.numAlarms": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "now(5000)"
              },
              "transforms": [
                {
                  "type": "script",
                  "code": "\treturn len(system.alarm.queryStatus(priority=['High', 'Critical'], state=['ActiveAcked', 'ActiveUnacked']))"
                }
              ]
            }
          },
          "props.text": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "toStr({this.custom.numAlarms})"
              }
            }
          },
          "props.style.classes": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({this.custom.numAlarms} > 0, \"cal1615/alarm-active\", \"\")"
              }
            }
          }
        },
        "events": {
          "dom": {
            "onClick": {
              "type": "nav",
              "scope": "C",
              "config": {
                "page": "/alarms"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.icon",
        "meta": {
          "name": "user"
        },
        "position": {
          "basis": "28px",
          "shrink": 0
        },
        "props": {
          "path": "material/person",
          "style": {
            "classes": "cal1615/header-icon"
          }
        },
        "events": {
          "dom": {
            "onClick": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tif self.session.props.auth.authenticated:\n\t\tsystem.perspective.logout()\n\telse:\n\t\tsystem.perspective.login()"
              }
            }
          }
        }
      },
      {
        "type": "ia.input.button",
        "meta": {
          "name": "menuButton"
        },
        "position": {
          "basis": "80px",
          "shrink": 0
        },
        "props": {
          "text": "Menu",
          "image": {
            "icon": {
              "path": "material/menu"
            }
          }
        },
        "events": {
          "component": {
            "onActionPerformed": {
              "type": "dock",
              "scope": "C",
              "config": {
                "id": "nav",
                "type": "toggle"
              }
            }
          }
        }
      }
    ]
  }
}