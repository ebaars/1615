					N: XIC(p23r15_request_line_run)XIO(p23r15_sample_timer.DN)TON(p23r15_sample_timer,?,?);
					N: XIC(p23r15_sample_timer.DN)FFL(p25_ai_ts2_lc,p23r15_fll_stack[0],p23r15_ffl,?,?);
					N: XIC(p23r15_ffl.DN)FFU(p23r15_fll_stack[0],p23r15_ffu_temp,p23r15_ffl,?,?);
					N: XIC(p23r15_sample_timer.DN)AVE(p23r15_fll_stack[0],0,p23r15_average_tension,p23_ave,?,?);
					N: ADD(p01_recipe_active.ts1_tension_sp,p23r15_dead_band_setpoint,p23r15_dead_band_plus)SUB(p01_recipe_active.ts1_tension_sp,p23r15_dead_band_setpoint,p23r15_dead_band_minus);
					N: XIC(p23r15_request_line_run)XIO(p23r15_minus_adjust_acitve)XIO(p23r15_plus_adjust_acitve)XIO(p23r15_mean_adjust_acitve)TON(p23r15_adjust_dwell1,?,?);
					N: XIC(p23r15_ts1_tension_ok)XIC(p23r15_adjust_dwell1.DN)GRT(p23r15_average_tension,p23r15_dead_band_plus)MOV(p23r15_plus_offset,p01_param_mtr_over_speed_pct)OTE(p23r15_minus_adjust_acitve)LES(p23r15_plus_adjust,7)ADD(p23r15_plus_adjust,0.2,p23r15_plus_adjust);
					N: XIC(p23r15_ts1_tension_ok)XIC(p23r15_adjust_dwell1.DN)LES(p23r15_average_tension,p23r15_dead_band_minus)MOV(p23r15_minus_offset,p01_param_mtr_over_speed_pct)OTE(p23r15_plus_adjust_acitve)LES(p23r15_minus_adjust,7)ADD(p23r15_minus_adjust,0.2,p23r15_minus_adjust);
					N: XIC(p23r15_ts1_tension_ok)XIC(p23r15_adjust_dwell1.DN)XIO(p23r15_minus_adjust_acitve)XIO(p23r15_plus_adjust_acitve)MOV(p23r15_neutral_offset,p01_param_mtr_over_speed_pct)MOV(1,p23r15_minus_adjust)MOV(1,p23r15_plus_adjust)OTE(p23r15_mean_adjust_acitve);
					N: XIO(p23r15_request_line_run)MOV(1,p23r15_minus_adjust)MOV(1,p23r15_plus_adjust);
					N: XIC(p23r15_request_line_run)MUL(p23r15_minus_adjust,p23_param_minus_adj_rate,p23r15_minus_offset);
					N: XIC(p23r15_request_line_run)MUL(p23r15_plus_adjust,p23_param_plus_adj_rate,p23r15_plus_offset);
					N: MOV(p12r15_mtr_roll_speed_offset,p12r15_mtr_roll_speed_offset);
					N: XIC(p23r15_request_line_run)XIO(p01r09_stretch_mode)CPT(p23_ao_selected_speed,p01r12_master_ramped_speed+p12r15_mtr_roll_speed_offset);
					N: XIC(p23r15_request_line_run)XIC(p01r09_stretch_mode)CPT(p23_ao_selected_speed,p01r12_master_ramped_speed);
					N: XIO(p23r15_request_line_run)XIO(p23r15_request_jog_fwd)XIO(p23r15_request_jog_rev)XIO(p23r15_request_thread_fwd)XIO(p23r15_request_thread_rev)MOV(0,p23_ao_selected_speed);
					RC: "Faults";
					N: OTE(p23r15.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p23r15.fault,p23r15.fault_ack);
					N: XIC(p23_di_metering_roll.faulted)[TON(p23r15_timer_fault[0],?,?) ,XIC(p23r15_timer_fault[0].DN) OTL(p23r15.fault.0) ];
					N: XIC(p23r15.fault_ack.0)XIO(p23_di_metering_roll.faulted)XIC(p01r09_pb_global_reset)[OTU(p23r15.fault.0) ,OTU(p23r15.fault_ack.0) ];
					N: XIC(FAULT)[TON(p23r15_timer_fault[1],?,?) ,XIC(p23r15_timer_fault[1].DN) OTL(p23r15.fault.1) ];
					N: XIC(p23r15.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p23r15.fault.1) ,OTU(p23r15.fault_ack.1) ];
					N: XIO(p23_di_metering_roll.ready)[TON(p23r15_timer_fault[2],?,?) ,XIC(p23r15_timer_fault[2].DN) OTL(p23r15.fault.2) ];
					N: XIC(p23r15.fault_ack.2)XIC(p23_di_metering_roll.ready)XIC(p01r09_pb_global_reset)[OTU(p23r15.fault.2) ,OTU(p23r15.fault_ack.2) ];
