					N: XIC(p28_do_slt_air_supply_sv)OTE(p00_io_winder:4:O.0);
					RC: "Analog Outputs";
					N: OTE(p28r04.comment.3);
					N: SYS_SPEED_TO_VFD(p28r04_slitter_speed,p28r04_slitter_gear_ratio,p28r04_slitter_roll_diameter_ft,p28_ao_sltr_selected_speed,p00_vfd_slitter:O.Data[1]);
					RC: "Faults";
					N: OTE(p28r04.comment.30);
