					N: MOV(0,p19_real_to_hmi[27])MOV(0,p19_real_to_hmi[28])MOV(0,p19_real_to_hmi[29]);
					N: MOV(0,p19_real_to_hmi[30])MOV(0,p19_real_to_hmi[31]);
