					    "2,3 = Warnings$N"
					    "4,5 = Process Indicators$N"
					    "6-15 Status";
					N: OTE(p19r05.comment.3);
					N: [XIC(HMI) OTE(p19_dint_to_hmi[0].0) ,XIC(HMI) OTE(p19_dint_to_hmi[0].1) ,XIC(HMI) OTE(p19_dint_to_hmi[0].2) ,XIC(HMI) OTE(p19_dint_to_hmi[0].3) ];
