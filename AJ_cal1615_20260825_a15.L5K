			END_ROUTINE

			ROUTINE R31_Exhaust_VFD 
					RC: "p12r31$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r31.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r31.comment (dint)$N"
					    "p12r31.oneshot (dint)$N"
					    "p12r31_timer_xxxx (timer)$N"
					    "p12r31_xxxx (any)$N"
					    "p12r31.fault (dint)$N"
					    "p12r31.warning (dint)$N"
					    "";
					N: OTE(p12r31.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r31.comment.2);
					N: [XIC(p02_dint_from_hmi.zone_2[4].4) ,XIC(p12r20_state.4) ONS(p12r31.oneshot.0) ]OTE(p12r31_pb_start);
					N: [XIC(p02_dint_from_hmi.zone_2[4].5) ,XIO(p23r02.warning.0) XIO(p11r30.warning.4) XIO(p12r30.warning.4) XIC(p11r02_shutdown_temp) XIC(p12r02_shutdown_temp) [ONS(p12r31.oneshot.1) ,XIC(p02_dint_from_hmi.global[6].7) ] ]OTE(p12r31_pb_stop);
					N: LEQ(p12_ai_exhaust_rpm,p01_param_fan_zero_speed)OTE(p12r31_vfd_stopped);
					RC: "Requests";
					N: OTE(p12r31.comment.3);
					N: XIO(p01r02.fault.4)XIO(p12r31.warning.3)EQU(p12r31.fault,0)OTE(p12r31_run_permissive);
					N: [XIC(p12r31_pb_start) ,XIC(p12r31_request_auto_run) ]XIO(p12r31_pb_stop)XIC(p12r31_run_permissive)OTE(p12r31_request_auto_run);
					RC: "Sequence";
					N: OTE(p12r31.comment.4);
					RC: "Output Control";
					N: OTE(p12r31.comment.5);
					N: XIC(p12r31_request_auto_run)OTE(p12_do_exh.forward);
					N: XIC(p01r09_pb_global_reset)OTE(p12_do_exh.fault_reset);
					RC: "Select Speed Setpoint";
					N: OTE(p12r31.comment.6);
					N: XIC(p12r31_request_auto_run)MOV(p01_recipe_active.zone_2.exhaust_sp,p12_ao_exhaust_selected_speed);
					N: XIC(p01r09_open_oven)MOV(p01_param_open_oven_exh_sp,p12_ao_exhaust_selected_speed);
					N: XIO(p12r31_request_auto_run)MOV(0,p12_ao_exhaust_selected_speed);
					RC: "Faults";
					N: OTE(p12r31.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r31.fault,p12r31.fault_ack);
					N: XIC(p12_di_exh.faulted)[TON(p12r31_timer_fault[0],?,?) ,XIC(p12r31_timer_fault[0].DN) OTL(p12r31.fault.0) ];
					N: XIC(p12r31.fault_ack.0)XIO(p12_di_exh.faulted)XIC(p01r09_pb_global_reset)[OTU(p12r31.fault.0) ,OTU(p12r31.fault_ack.0) ];
					N: XIO(p12_di_exh_fan_mtr_ts)[TON(p12r31_timer_fault[1],?,?) ,XIC(p12r31_timer_fault[1].DN) OTL(p12r31.fault.1) ];
					N: XIC(p12r31.fault_ack.1)XIC(p12_di_exh_fan_mtr_ts)XIC(p01r09_pb_global_reset)[OTU(p12r31.fault.1) ,OTU(p12r31.fault_ack.1) ];
					N: XIO(p12_di_exh.ready)[TON(p12r31_timer_fault[2],?,?) ,XIC(p12r31_timer_fault[2].DN) OTL(p12r31.fault.2) ];
					N: XIC(p12r31.fault_ack.2)XIC(p12_di_exh.ready)XIC(p01r09_pb_global_reset)[OTU(p12r31.fault.2) ,OTU(p12r31.fault_ack.2) ];
					N: XIC(p12_di_exh.ready)XIO(p12_di_exh.ctrl_from_net)[TON(p12r31_timer_fault[3],?,?) ,XIC(p12r31_timer_fault[3].DN) OTL(p12r31.fault.3) ];
					N: XIC(p12r31.fault_ack.3)[XIO(p12_di_exh.ready) ,XIC(p12_di_exh.ctrl_from_net) ]XIC(p01r09_pb_global_reset)[OTU(p12r31.fault.3) ,OTU(p12r31.fault_ack.3) ];
					N: NEQ(p12r31.fault,p12r31.fault_ack)OTE(p12r31.unack_fault);
					RC: "Warnings";
					N: OTE(p12r31.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p12r31.warning,p12r31.warning_ack);
					N: XIO(p12r31_request_auto_run)XIO(p12r02_shutdown_temp)[TON(p12r31_timer_warning[0],?,?) ,XIC(p12r31_timer_warning[0].DN) OTL(p12r31.warning.0) ];
					N: XIC(p12r31.warning_ack.0)[XIC(p12r02_shutdown_temp) ,XIC(p12r31_request_auto_run) ][OTU(p12r31.warning.0) ,OTU(p12r31.warning_ack.0) ];
					N: [XIC(p12_di_exh.running_fwd) XIO(p12_di_exh_flow_ok) ,XIO(p12_di_exh.running_fwd) XIO(p12_di_exh.running_rev) XIC(p12_di_exh_flow_ok) ][TON(p12r31_timer_warning[1],?,?) ,XIC(p12r31_timer_warning[1].DN) OTL(p12r31.warning.1) ];
					N: XIC(p12r31.warning_ack.1)[[XIC(p12_di_exh.running_fwd) ,XIC(p12_di_exh.running_rev) ] XIC(p12_di_exh_flow_ok) ,XIO(p12_di_exh.running_fwd) XIO(p12_di_exh_flow_ok) ][OTU(p12r31.warning.1) ,OTU(p12r31.warning_ack.1) ];
					N: XIC(p12_di_exh.warning)[TON(p12r31_timer_warning[2],?,?) ,XIC(p12r31_timer_warning[2].DN) OTL(p12r31.warning.2) ];
					N: XIC(p12r31.warning_ack.2)XIO(p12_di_exh.warning)[OTU(p12r31.warning.2) ,OTU(p12r31.warning_ack.2) ];
					N: XIC(p12_di_exh.ready)XIO(p12_di_exh.ctrl_from_net)[TON(p12r31_timer_warning[3],?,?) ,XIC(p12r31_timer_warning[3].DN) OTL(p12r31.warning.3) ];
