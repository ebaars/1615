					N: XIC(p01r09_pb_global_reset)MOV(p19r03.warning,p19r03.warning_ack);
					N: XIC(FAULT)[TON(p19r03_timer_warning[0],?,?) ,XIC(p19r03_timer_warning[0].DN) OTL(p19r03.warning.0) ];
					N: XIO(FAULT)[OTU(p19r03.warning.0) ,OTU(p19r03.warning_ack.0) ];
					N: NEQ(p19r03.warning,p19r03.warning_ack)OTE(p19r03.unack_warning);
					N: RET();
			END_ROUTINE

