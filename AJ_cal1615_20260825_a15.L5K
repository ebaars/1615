					N: XIC(p01r09_pb_global_reset)MOV(p23r13.fault,p23r13.fault_ack);
					N: XIC(p23_di_supply.faulted)[TON(p23r13_timer_fault[0],?,?) ,XIC(p23r13_timer_fault[0].DN) OTL(p23r13.fault.0) ];
					N: XIC(p23r13.fault_ack.0)XIO(p23_di_supply.faulted)XIC(p01r09_pb_global_reset)[OTU(p23r13.fault.0) ,OTU(p23r13.fault_ack.0) ];
					N: XIC(FAULT)[TON(p23r13_timer_fault[1],?,?) ,XIC(p23r13_timer_fault[1].DN) OTL(p23r13.fault.1) ];
					N: XIC(p23r13.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p23r13.fault.1) ,OTU(p23r13.fault_ack.1) ];
					N: XIO(p23_di_supply.ready)[TON(p23r13_timer_fault[2],?,?) ,XIC(p23r13_timer_fault[2].DN) OTL(p23r13.fault.2) ];
					N: XIC(p23r13.fault_ack.2)XIC(p23_di_supply.ready)XIC(p01r09_pb_global_reset)[OTU(p23r13.fault.2) ,OTU(p23r13.fault_ack.2) ];
					N: XIC(p23_di_supply.ready)XIO(p23_di_supply.ctrl_from_net)[TON(p23r13_timer_fault[3],?,?) ,XIC(p23r13_timer_fault[3].DN) OTL(p23r13.fault.3) ];
					N: XIC(p23r13.fault_ack.3)[XIC(p23_di_supply.ctrl_from_net) ,XIO(p23_di_supply.ready) ]XIC(p01r09_pb_global_reset)[OTU(p23r13.fault.3) ,OTU(p23r13.fault_ack.3) ];
					N: XIO(p23_di_supply_motor_therm)[TON(p23r13_timer_fault[4],?,?) ,XIC(p23r13_timer_fault[4].DN) OTL(p23r13.fault.4) ];
					N: XIC(p23r13.fault_ack.4)XIC(p23_di_supply_motor_therm)XIC(p01r09_pb_global_reset)[OTU(p23r13.fault.4) ,OTU(p23r13.fault_ack.4) ];
					N: NEQ(p23r13.fault,p23r13.fault_ack)OTE(p23r13.unack_fault);
					RC: "Warnings";
					N: OTE(p23r13.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p23r13.warning,p23r13.warning_ack);
					N: XIC(p23_di_supply.warning)[TON(p23r13_timer_warning[0],?,?) ,XIC(p23r13_timer_warning[0].DN) OTL(p23r13.warning.0) ];
					N: XIC(p23r13.warning_ack.0)XIO(p23_di_supply.warning)OTU(p23r13.warning.0);
					N: XIO(p23_di_filter_clean)[TON(p23r13_timer_warning[1],?,?) ,XIC(p23r13_timer_warning[1].DN) OTL(p23r13.warning.1) ];
					N: XIC(p23r13.warning_ack.1)XIC(p23_di_filter_clean)[OTU(p23r13.warning.1) ,OTU(p23r13.warning_ack.1) ];
					N: XIC(p23_do_supply.forward)XIO(p23_di_supply_speed_ok)[TON(p23r13_timer_warning[2],?,?) ,XIC(p23r13_timer_warning[2].DN) OTL(p23r13.warning.2) ];
					N: XIC(p23r13.warning_ack.2)[XIC(p23_di_supply_speed_ok) ,XIO(p23_do_supply.forward) ][OTU(p23r13.warning.2) ,OTU(p23r13.warning_ack.2) ];
					N: NEQ(p23r13.warning,p23r13.warning_ack)OTE(p23r13.unack_warning);
					N: RET();
