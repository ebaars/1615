					    "01:(bb)$N"
					    "10: (Ab)$N"
					    "11: (AF)";
					N: XIO(p23_di_servo_ds.operation_bit_14)XIO(p23_di_servo_ds.operation_bit_15)OTE(p23r12_servo_not_ready);
					N: XIC(p23_di_servo_ds.operation_bit_14)XIO(p23_di_servo_ds.operation_bit_15)OTE(p23r12_servo_status_bb);
