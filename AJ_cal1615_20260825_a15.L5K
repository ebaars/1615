					N: XIO(FAULT)[OTU(p21r04.warning.0) ,OTU(p21r04.warning_ack.0) ];
					N: NEQ(p21r04.warning,p21r04.warning_ack)OTE(p21r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p21r05$N"
					    "This routine is called, continuously, from p21R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p21r05.comment.0);
					RC: "Tag Usage$N"
