			ROUTINE R02_Misc_Control 
					RC: "p28R02$N"
					    "This routine is called, continuously, from p28R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p28r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p28r02.comment (dint)$N"
					    "p28r02.oneshot (dint)$N"
					    "p28r02_timer_xxxx (timer)$N"
					    "p28r02_xxxx (any)$N"
