					N: XIC(p23r17.fault_ack.3)[XIC(p23_di_spring.ctrl_from_net) ,XIO(p23_di_spring.ready) ]XIC(p01r09_pb_global_reset)[OTU(p23r17.fault.3) ,OTU(p23r17.fault_ack.3) ];
