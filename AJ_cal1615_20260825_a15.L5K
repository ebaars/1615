					N: XIC(FAULT)[TON(p28r09_timer_fault[0],?,?) ,XIC(p28r09_timer_fault[0].DN) OTL(p28r09.fault.0) ];
					N: XIC(p28r09.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p28r09.fault.0) ,OTU(p28r09.fault_ack.0) ];
					N: NEQ(p28r09.fault,p28r09.fault_ack)OTE(p28r09.unack_fault);
