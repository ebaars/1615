					N: XIC(p02_dint_from_hmi.zone_2[4].19)OTE(p12r30_pb_auto);
					N: MOV(p01_recipe_active.zone_2.temp_sp,p12r30_pid_temp_sp);
					N: XIC(p01r09_open_oven)MOV(p01_param_open_oven_temp,p12r30_pid_temp_sp);
					RC: "Multiply by 10,$N"
					    "Scaled back down in the PID$N"
