					N: [XIC(p12r20_state.9) ,XIC(p12r20_state.10) ]EQU(p12r30_pid_temp.OUT,100)LES(p12r30_pid_temp.ERR,3.0)OTE(p12r30_request_PID_shot);
					N: [XIC(p12r20_state.31) ,XIC(p12r20_state.13) ,XIO(p12r20_state.9) XIO(p12r20_state.10) ,XIC(p12r30_request_PID_shot) ,XIO(p12r30_request_heat_last) ]OTE(p12r30_pid_temp.SWM);
					N: [XIO(p12r30_request_heat) ,XIO(p12r20_state.9) XIO(p12r20_state.10) ]MOV(0.0,p12r30_pid_temp.SO);
					N: XIC(p12r20_state.12)MOV(100.0,p12r30_pid_temp.SO);
					N: XIC(p12r20_state.31)MOV(p12r30_cv_man_sp,p12r30_pid_temp.SO);
					N: XIC(p12r30_request_PID_shot)MOV(50,p12r30_pid_temp.SO);
					N: [MOV(0,p12r30_pid_temp.MINCV) MOV(100,p12r30_pid_temp.MAXCV) ,MOV(0,p12r30_pid_temp.MINI) MOV(10000,p12r30_pid_temp.MAXI) ,MOV(p12r30_pid_temp.MINI,p12r30_pid_temp.MINS) MOV(1000,p12r30_pid_temp.MAXS) ][OTE(p12r30_pid_temp.NOZC) ,XIC(AFI) OTE(p12r30_pid_temp.CA) ,XIC(AFI) OTE(p12r30_pid_temp.PE) ,OTE(p12r30_pid_temp.NOBC) ];
					N: LES(p12r30_pid_temp.UPD,0.01)MOV(0.01,p12r30_pid_temp.UPD);
					N: [MOV(p12_param_pid1_kp,p12r30_pid_temp.KP) MOV(p12_param_pid1_ki,p12r30_pid_temp.KI) ,MOV(p12_param_pid1_kd,p12r30_pid_temp.KD) MOV(p12_param_pid1_ff,p12r30_pid_temp.BIAS) ];
					N: XIC(p12r30_request_soak_control)[MOV(p12_param_pid2_kp,p12r30_pid_temp.KP) MOV(p12_param_pid2_ki,p12r30_pid_temp.KI) ,MOV(p12_param_pid2_kd,p12r30_pid_temp.KD) MOV(p12_param_pid2_ff,p12r30_pid_temp.BIAS) ];
					N: MOV(p12r30_pid_temp.BIAS,p12r30_pid_temp.BIAS)PID(p12r30_pid_temp,p12r30_pid_temp_pv,0,p12r16_pid_temp_cv,0,0,0);
					RC: "Output Control";
					N: OTE(p12r30.comment.6);
					N: XIC(p12r30_request_heat)OTE(p12_do_enable_burner);
					N: [XIC(p12_di_flame_failure) ,XIC(p12_do_rst_flame) ]XIC(p01r09_pb_global_reset)OTE(p12_do_rst_flame);
					N: MOV(p12r30_pid_temp.OUT,p12_ao_cv);
					RC: "Faults";
