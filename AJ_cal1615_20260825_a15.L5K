					N: [XIC(p21_do_close_inlet_clamp_sv) OTE(p00_io_letoff:3:O.4) ,XIC(p21_do_close_platen_sv) OTE(p00_io_letoff:3:O.5) ,XIC(p21_do_enable_platen_heater) OTE(p00_io_line:1:O.6) ,XIC(p21_do_close_exit_clamp_sv) OTE(p00_io_letoff:3:O.7) ];
					RC: "Analog";
