			ROUTINE R01_Main 
					RC: "p11R01 Main$N"
					    "$N"
					    "This routine is called, continuously, from p11 System while the plc is in Run mode.  All other p11 System routines are called from this routine.";
					N: OTE(p11r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r01.comment (dint)$N"
					    "p11r01.oneshot (dint)$N"
