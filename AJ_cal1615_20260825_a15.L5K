					N: XIC(p13r30.warning_ack.0)[CMP(p13r30_pid_temp_sp_error+2<p13_param_tc01_dev) ,XIO(p13r30_request_cool) ][OTU(p13r30.warning.0) ,OTU(p13r30.warning_ack.0) ];
					N: XIC(p13_di_tc01_bo)[TON(p13r30_timer_warning[1],?,?) ,XIC(p13r30_timer_warning[1].DN) OTL(p13r30.warning.1) ];
					N: XIC(p13r30.warning_ack.1)XIO(p13_di_tc01_bo)[OTU(p13r30.warning.1) ,OTU(p13r30.warning_ack.1) ];
					N: XIC(p13_di_tc02_bo)[TON(p13r30_timer_warning[2],?,?) ,XIC(p13r30_timer_warning[2].DN) OTL(p13r30.warning.2) ];
					N: XIC(p13r30.warning_ack.2)XIO(p13_di_tc02_bo)[OTU(p13r30.warning.2) ,OTU(p13r30.warning_ack.2) ];
