			                                      DefaultData := 0.00000000e+000);
			IN_param_master_decel_rate : REAL (Description := "Input Parameter$NDecel Ramp$Nx/second",
			                                      Usage := Input,
			                                      RADIX := Float,
			                                      Required := Yes,
			                                      Visible := Yes,
			                                      DefaultData := 0.00000000e+000);
			IN_last_scan_s : REAL (Description := "Input Parameter$NLast Scan $Nseconds",
			                          Usage := Input,
			                          RADIX := Float,
