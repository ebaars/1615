					N: XIO(FAULT)[OTU(p01r10.warning.0) ,OTU(p01r10.warning_ack.0) ];
					N: NEQ(p01r10.warning,p01r10.warning_ack)OTE(p01r10.unack_warning);
					RC: "Flash Timers";
