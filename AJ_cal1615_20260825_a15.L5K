					N: OTE(p23r13.comment.4);
					N: XIC(p23r13_request_auto_run)MOV(p01_recipe_active.impreg_supply_speed_sp,p23_ao_supply_selected_speed);
					N: XIO(p23r13_request_auto_run)MOV(0,p23_ao_supply_selected_speed);
