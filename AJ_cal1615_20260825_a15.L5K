	ADD_ON_INSTRUCTION_DEFINITION Ramp_Test (Revision := "1.0",
	                                         ExecutePrescan := No,
	                                         ExecutePostscan := No,
	                                         ExecuteEnableInFalse := No,
	                                         CreatedDate := "2007-08-09T12:52:44.890Z",
	                                         CreatedBy := "DDQ2FX91\GAP",
	                                         EditedDate := "2023-03-06T19:22:19.166Z",
	                                         EditedBy := "DESKTOP-UJLNSL3\cal1615",
	                                         SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			SP : REAL (Usage := Input,
			              RADIX := Float,
			              Required := Yes,
			              Visible := Yes,
			              DefaultData := 0.00000000e+000);
			Rate : REAL (Usage := Input,
			                RADIX := Float,
			                Required := Yes,
			                Visible := Yes,
			                DefaultData := 0.00000000e+000);
			ScanTime : REAL (Usage := Input,
			                    RADIX := Float,
			                    Required := Yes,
			                    Visible := Yes,
			                    DefaultData := 0.00000000e+000);
			PV : REAL (Usage := InOut,
			              RADIX := Float,
			              Required := Yes,
			              Visible := Yes);
		END_PARAMETERS

		LOCAL_TAGS
			request_decel : BOOL (RADIX := Decimal,
			                        ExternalAccess := Read/Write,
			                        DefaultData := 0);
			request_accel : BOOL (RADIX := Decimal,
			                        ExternalAccess := Read/Write,
			                        DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: LES(SP,PV)OTE(request_decel);
				N: XIC(request_decel)[CPT(PV,PV+(Rate * ScanTime)) ,AFI() LES(PV,SP) MOV(SP,PV) ];
				N: GRT(SP,PV)OTE(request_accel);
				N: XIC(request_accel)[CPT(PV,PV+(Rate * ScanTime)) ,AFI() GRT(PV,SP) MOV(SP,PV) ];
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

