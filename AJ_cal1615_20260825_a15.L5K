					N: [XIC(Local:6:I.Data.5) OTE(p21_di_platen_hi_temp_ok) ,XIC(Local:6:I.Data.4) OTE(p21_di_splice_2_hand_close) ,XIC(p00_io_letoff:5:I.2) OTE(p21_di_open_splice_platen) ,XIC(p00_io_letoff:5:I.3) OTE(p21_di_close_inlet_clamp) ,XIC(p00_io_letoff:5:I.4) OTE(p21_di_close_exit_clamp) ,XIC(p00_io_letoff:5:I.14) OTE(p21_di_platen_not_closed) ];
					N: XIC(p00_io_letoff:2:I.Ch0OverrangeAlarm)OTE(p21_di_tc_bo);
					RC: "Analog";
					N: OTE(p21r03.comment.4);
					N: CPT(p21_ai_splice_platen_temp,p00_io_letoff:2:I.Ch0Data*0.1);
					RC: "VFD";
					N: OTE(p21r03.comment.5);
					RC: "Faults";
					N: OTE(p21r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p21r03.fault,p21r03.fault_ack);
					N: XIC(FAULT)[TON(p21r03_timer_fault[0],?,?) ,XIC(p21r03_timer_fault[0].DN) OTL(p21r03.fault.0) ];
					N: XIC(p21r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p21r03.fault.0) ,OTU(p21r03.fault_ack.0) ];
					N: NEQ(p21r03.fault,p21r03.fault_ack)OTE(p21r03.unack_fault);
					RC: "Warnings";
					N: OTE(p21r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p21r03.warning,p21r03.warning_ack);
					N: XIC(FAULT)[TON(p21r03_timer_warning[0],?,?) ,XIC(p21r03_timer_warning[0].DN) OTL(p21r03.warning.0) ];
					N: XIO(FAULT)[OTU(p21r03.warning.0) ,OTU(p21r03.warning_ack.0) ];
					N: NEQ(p21r03.warning,p21r03.warning_ack)OTE(p21r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p21r04$N"
