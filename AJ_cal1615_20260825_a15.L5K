					N: XIC(p11_di_recirc.ready)XIO(p11_di_recirc.ctrl_from_net)[TON(p11r32_timer_fault[3],?,?) ,XIC(p11r32_timer_fault[3].DN) OTL(p11r32.fault.3) ];
					N: XIC(p11r32.fault_ack.3)[XIO(p11_di_recirc.ready) ,XIC(p11_di_recirc.ctrl_from_net) ]XIC(p01r09_pb_global_reset)[OTU(p11r32.fault.3) ,OTU(p11r32.fault_ack.3) ];
					N: NEQ(p11r32.fault,p11r32.fault_ack)OTE(p11r32.unack_fault);
					RC: "Warnings";
					N: OTE(p11r32.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p11r32.warning,p11r32.warning_ack);
					N: XIO(p11r32_request_auto_run)XIO(p11r02_shutdown_temp)[TON(p11r32_timer_warning[0],?,?) ,XIC(p11r32_timer_warning[0].DN) OTL(p11r32.warning.0) ];
					N: XIC(p11r32.warning_ack.0)[XIC(p11r02_shutdown_temp) ,XIC(p11r32_request_auto_run) ][OTU(p11r32.warning.0) ,OTU(p11r32.warning_ack.0) ];
					N: [XIC(p11_di_recirc.running_fwd) XIO(p11_di_recirc_flow_ok) ,XIO(p11_di_recirc.running_fwd) XIC(p11_di_recirc_flow_ok) ][TON(p11r32_timer_warning[1],?,?) ,XIC(p11r32_timer_warning[1].DN) OTL(p11r32.warning.1) ];
					N: XIC(p11r32.warning_ack.1)[XIC(p11_di_recirc.running_fwd) XIC(p11_di_recirc_flow_ok) ,XIO(p11_di_recirc.running_fwd) XIO(p11_di_recirc_flow_ok) ][OTU(p11r32.warning.1) ,OTU(p11r32.warning_ack.1) ];
					N: XIC(p11_di_recirc.warning)[TON(p11r32_timer_warning[2],?,?) ,XIC(p11r32_timer_warning[2].DN) OTL(p11r32.warning.2) ];
					N: XIC(p11r32.warning_ack.2)XIO(p11_di_recirc.warning)[OTU(p11r32.warning.2) ,OTU(p11r32.warning_ack.2) ];
					N: XIC(p11_di_recirc.ready)XIO(p11_di_recirc.ctrl_from_net)[TON(p11r32_timer_warning[3],?,?) ,XIC(p11r32_timer_warning[3].DN) OTL(p11r32.warning.3) ];
					N: XIC(p11r32.warning_ack.3)[XIC(p11_di_recirc.ctrl_from_net) ,XIO(p11_di_recirc.ready) ][OTU(p11r32.warning.3) ,OTU(p11r32.warning_ack.3) ];
					RC: "Warnings";
					N: OTE(p11r32.comment.31);
					N: NEQ(p11r32.warning,p11r32.warning_ack)OTE(p11r32.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P12_Zone_2 (MAIN := "R01_Main",
	                    MODE := 0,
	                    DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					RC: "p12R01 Main$N"
					    "$N"
					    "This routine is called, continuously, from p12 System while the plc is in Run mode.  All other p12 System routines are called from this routine.";
					N: OTE(p12r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r01.comment (dint)$N"
					    "p12r01.oneshot (dint)$N"
					    "p12r01_timer_xxxx (timer)$N"
					    "p12r01_xxxx (any)$N"
					    "p12r01.fault (dint)$N"
					    "p12r01.warning (dint)$N"
					    "";
					N: OTE(p12r01.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r01.comment.2);
					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Parameters,0);
					N: JSR(R20_Temp_Sequence,0);
					N: JSR(R30_Temperature_Control,0);
					N: JSR(R31_Exhaust_VFD,0);
					N: JSR(R32_Recirc_VFD,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p12R02$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r02.comment (dint)$N"
					    "p12r02.oneshot (dint)$N"
					    "p12r02_timer_xxxx (timer)$N"
					    "p12r02_xxxx (any)$N"
					    "p12r02.fault (dint)$N"
					    "p12r02.warning (dint)$N"
					    "";
					N: OTE(p12r02.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r02.comment.2);
					N: NEQ(p12_dint_to_hmi[0],0)OTE(p12r02_fault_exists);
					N: NEQ(p12_dint_to_hmi[2],0)OTE(p12r02_warning_exists);
					RC: "Requests";
					N: OTE(p12r02.comment.3);
					N: [XIC(p12r02.unack_fault) ,XIC(p12r03.unack_fault) ,XIC(p12r04.unack_fault) ,XIC(p12r05.unack_fault) ,XIC(p12r06.unack_fault) ,XIC(p12r07.unack_fault) ,XIC(p12r08.unack_fault) ,XIC(p12r09.unack_fault) ,XIC(p12r10.unack_fault) ,XIC(p12r20.unack_fault) ,XIC(p12r30.unack_fault) ,XIC(p12r31.unack_fault) ,XIC(p12r32.unack_fault) ]OTE(p12r02_unack_fault);
					N: [XIC(p12r02.unack_warning) ,XIC(p12r03.unack_warning) ,XIC(p12r04.unack_warning) ,XIC(p12r05.unack_warning) ,XIC(p12r06.unack_warning) ,XIC(p12r07.unack_warning) ,XIC(p12r08.unack_warning) ,XIC(p12r09.unack_warning) ,XIC(p12r10.unack_warning) ,XIC(p12r20.unack_warning) ,XIC(p12r30.unack_warning) ,XIC(p12r31.unack_warning) ,XIC(p12r32.unack_warning) ]OTE(p12r02_unack_warning);
					RC: "Sequence";
					N: OTE(p12r02.comment.4);
					N: LES(p12_ai_tc01,p12_param_shutdown_temp)LES(p12_ai_tc02,p12_param_shutdown_temp)XIO(p12r30.warning.1)XIO(p12r30.warning.2)OTE(p12r02_safe_temp);
					N: XIC(p12r02_safe_temp)[TON(p12r02_timer_safe_temp[0],?,?) ,XIC(p12r02_timer_safe_temp[0].DN) OTL(p12r02_shutdown_temp) ];
					N: [XIO(p12r30.warning.1) GRT(p12_ai_tc01,p01_param_temp_limit) ,XIO(p12r30.warning.2) GRT(p12_ai_tc02,p12_param_shutdown_temp) ]OTE(p12r02_not_safe_temp);
					N: XIC(p12r02_not_safe_temp)[TON(p12r02_timer_safe_temp[1],?,?) ,XIC(p12r02_timer_safe_temp[1].DN) OTU(p12r02_shutdown_temp) ];
					N: XIC(p12r30_pb_zone_off)OTU(p12r02_shutdown_temp);
					RC: "Output Control";
					N: OTE(p12r02.comment.5);
					RC: "Faults";
					N: OTE(p12r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r02.fault,p12r02.fault_ack);
					N: XIC(FAULT)[TON(p12r02_timer_fault[0],?,?) ,XIC(p12r02_timer_fault[0].DN) OTL(p12r02.fault.0) ];
					N: XIC(p12r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r02.fault.0) ,OTU(p12r02.fault_ack.0) ];
					N: NEQ(p12r02.fault,p12r02.fault_ack)OTE(p12r02.unack_fault);
					RC: "Warnings";
					N: OTE(p12r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p12r02.warning,p12r02.warning_ack);
					RC: "Probably need to add a FIFO for the pressure.";
					N: LES(p12_ai_prs,p12_param_zone_pressure)[TON(p12r02_timer_warning[0],?,?) ,XIC(p12r02_timer_warning[0].DN) OTL(p12r02.warning.0) ];
					N: XIC(p12r02.warning_ack.0)CMP(p12_ai_prs>(p12_param_zone_pressure+0.002))[OTU(p12r02.warning.0) ,OTU(p12r02.warning_ack.0) ];
					N: NEQ(p12r02.warning,p12r02.warning_ack)OTE(p12r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p12r03$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r03.comment (dint)$N"
					    "p12r03.oneshot (dint)$N"
					    "p12r03_timer_xxxx (timer)$N"
					    "p12r03_xxxx (any)$N"
					    "p12r03.fault (dint)$N"
					    "p12r03.warning (dint)$N"
					    "";
					N: OTE(p12r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r03.comment.2);
					RC: "Digital";
					N: OTE(p12r03.comment.3);
					N: [XIC(Local:4:I.Data.8) OTE(p12_di_burner_auto) ,XIC(Local:4:I.Data.9) OTE(p12_di_high_limit_temp_ok) ,XIC(Local:4:I.Data.10) OTE(p12_di_burner_safeties_ok) ,XIC(Local:4:I.Data.11) OTE(p12_di_recirc_flow_ok) ];
					N: [XIC(Local:4:I.Data.12) OTE(p12_di_exh_flow_ok) ,XIC(Local:4:I.Data.13) OTE(p12_di_flame_failure) ,XIC(Local:4:I.Data.14) OTE(p12_di_flame_on) ,XIC(p00_io_oven:2:I.Ch2OverrangeAlarm) OTE(p12_di_tc01_bo) ,XIC(p00_io_oven:2:I.Ch3OverrangeAlarm) OTE(p12_di_tc02_bo) ];
					N: [XIC(p00_io_prc:1:I.3) OTE(p12_di_recirc_fan_mtr_ts) ,XIC(p00_io_prc:1:I.4) OTE(p12_di_exh_fan_mtr_ts) ];
					N: [XIC(p00_io_oven:3:I.8) OTE(p12_di_sp00) ,XIC(p00_io_oven:3:I.9) OTE(p12_di_zone_air_clean) ,XIC(p00_io_oven:3:I.10) OTE(p12_di_fresh_air_clean) ,XIC(p00_io_oven:3:I.11) OTE(p12_di_door_open) ];
					N: [XIC(p00_io_oven:3:I.12) OTE(p12_di_sp0) ,XIC(p00_io_oven:3:I.13) OTE(p12_di_sp1) ,XIC(p00_io_oven:3:I.14) OTE(p12_di_sp2) ,XIC(p00_io_oven:3:I.15) OTE(p12_di_sp3) ];
					N: [XIC(p00_vfd_z2_exhaust:I.Data[0].0) OTE(p12_di_exh.faulted) ,XIC(p00_vfd_z2_exhaust:I.Data[0].1) OTE(p12_di_exh.warning) ,XIC(p00_vfd_z2_exhaust:I.Data[0].2) OTE(p12_di_exh.running_fwd) ,XIC(p00_vfd_z2_exhaust:I.Data[0].3) OTE(p12_di_exh.running_rev) ];
					N: [XIC(p00_vfd_z2_exhaust:I.Data[0].4) OTE(p12_di_exh.ready) ,XIC(p00_vfd_z2_exhaust:I.Data[0].5) OTE(p12_di_exh.ctrl_from_net) ,XIC(p00_vfd_z2_exhaust:I.Data[0].6) OTE(p12_di_exh.ref_from_net) ,XIC(p00_vfd_z2_exhaust:I.Data[0].7) OTE(p12_di_exh.at_reference) ];
					N: XIC(p01r02.fault.4)MOV(0,p00_vfd_z2_exhaust:I.Data[0]);
					N: [XIC(p00_vfd_z2_recirc:I.Data[0].0) OTE(p12_di_recirc.faulted) ,XIC(p00_vfd_z2_recirc:I.Data[0].1) OTE(p12_di_recirc.warning) ,XIC(p00_vfd_z2_recirc:I.Data[0].2) OTE(p12_di_recirc.running_fwd) ,XIC(p00_vfd_z2_recirc:I.Data[0].3) OTE(p12_di_recirc.running_rev) ];
					N: [XIC(p00_vfd_z2_recirc:I.Data[0].4) OTE(p12_di_recirc.ready) ,XIC(p00_vfd_z2_recirc:I.Data[0].5) OTE(p12_di_recirc.ctrl_from_net) ,XIC(p00_vfd_z3_recirc:I.Data[0].6) OTE(p12_di_recirc.ref_from_net) ,XIC(p00_vfd_z2_recirc:I.Data[0].7) OTE(p12_di_recirc.at_reference) ];
					N: XIC(p01r02.fault.3)MOV(0,p00_vfd_z2_recirc:I.Data[0]);
					RC: "Analog";
					N: OTE(p12r03.comment.4);
					N: SYS_SCP(p01_sys_scp,p00_io_oven:1:I.Ch2Data,p12_prs_input_min,p12_prs_input_max,p12_prs_output_min,p12_prs_output_max,p12_ai_prs);
					N: SYS_SCP(p01_sys_scp,p00_io_oven:1:I.Ch1Data,p12_lfl_input_min,p12_lfl_input_max,p12_lfl_output_min,p12_lfl_output_max,p12_ai_lfl);
					N: CPT(p12_ai_tc01,p00_io_oven:2:I.Ch2Data*0.1)ADD(p12_ai_tc01,p12_param_tc01z,p12_ai_tc01);
					N: CPT(p12_ai_tc02,p00_io_oven:2:I.Ch3Data*0.1)ADD(p12_ai_tc02,p12_param_tc02z,p12_ai_tc02);
					RC: "VFD";
					N: OTE(p12r03.comment.5);
					N: CPT(p12_ai_recirc_rpm,ABS(p00_vfd_z2_recirc:I.Data[1])*1);
					N: CPT(p12_ai_recirc_amps,p00_vfd_z2_recirc:I.Data[2]*0.1);
					N: CPT(p12_ai_recirc_hz_max,p00_vfd_z2_recirc:I.Data[4]*0.1)SYS_SCP(p12r03_hz,p00_vfd_z2_recirc:I.Data[1],0,1750,0,p12_ai_recirc_hz_max,p12_ai_recirc_hz);
					N: CPT(p12_ai_exhaust_rpm,ABS(p00_vfd_z2_exhaust:I.Data[1])*1);
					N: CPT(p12_ai_exhaust_amps,p00_vfd_z2_exhaust:I.Data[2]*0.1);
					N: CPT(p12_ai_exhaust_hz,p00_vfd_z2_exhaust:I.Data[4]*0.1);
					N: CPT(p12_ai_exhaust_hz_max,p00_vfd_z2_exhaust:I.Data[4]*0.1)SYS_SCP(p12r03_hz,p00_vfd_z2_exhaust:I.Data[1],0,1750,0,p12_ai_exhaust_hz_max,p12_ai_exhaust_hz);
					RC: "Faults";
					N: OTE(p12r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r03.fault,p12r03.fault_ack);
					N: XIC(FAULT)[TON(p12r03_timer_fault[0],?,?) ,XIC(p12r03_timer_fault[0].DN) OTL(p12r03.fault.0) ];
					N: XIC(p12r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r03.fault.0) ,OTU(p12r03.fault_ack.0) ];
					N: NEQ(p12r03.fault,p12r03.fault_ack)OTE(p12r03.unack_fault);
					RC: "Warnings";
					N: OTE(p12r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p12r03.warning,p12r03.warning_ack);
					N: XIC(FAULT)[TON(p12r03_timer_warning[0],?,?) ,XIC(p12r03_timer_warning[0].DN) OTL(p12r03.warning.0) ];
					N: XIO(FAULT)[OTU(p12r03.warning.0) ,OTU(p12r03.warning_ack.0) ];
					N: NEQ(p12r03.warning,p12r03.warning_ack)OTE(p12r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p12r04$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r04.comment (dint)$N"
					    "p12r04.oneshot (dint)$N"
					    "p12r04_timer_xxxx (timer)$N"
					    "p12r04_xxxx (any)$N"
					    "p12r04.fault (dint)$N"
					    "p12r04.warning (dint)$N"
					    "";
					N: OTE(p12r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r04.comment.2);
					RC: "Digital";
					N: OTE(p12r04.comment.3);
					N: [XIC(p12_do_enable_burner) OTE(Local:7:O.Data.2) ,XIC(p12_do_rst_flame) OTE(Local:7:O.Data.3) ];
					N: [XIC(p12_do_exh.forward) OTE(p00_vfd_z2_exhaust:O.Data[0].0) ,XIC(p12_do_exh.reverse) OTE(p00_vfd_z2_exhaust:O.Data[0].1) ,XIC(p12_do_exh.fault_reset) OTE(p00_vfd_z2_exhaust:O.Data[0].2) ,OTE(p00_vfd_z2_exhaust:O.Data[0].6) ,OTE(p00_vfd_z2_exhaust:O.Data[0].5) ];
					N: [XIC(p12_do_recirc.forward) OTE(p00_vfd_z2_recirc:O.Data[0].0) ,XIC(p12_do_recirc.reverse) OTE(p00_vfd_z2_recirc:O.Data[0].1) ,XIC(p12_do_recirc.fault_reset) OTE(p00_vfd_z2_recirc:O.Data[0].2) ,OTE(p00_vfd_z2_recirc:O.Data[0].5) ,OTE(p00_vfd_z2_recirc:O.Data[0].6) ];
					RC: "Analog";
					N: OTE(p12r04.comment.4);
					N: SYS_SCP(p01_sys_scp,p12_ao_cv,p12_hc_input_min,p12_hc_input_max,p12_hc_output_min,p12_hc_output_max,p00_io_oven:0:O.Ch1Data);
					RC: "VFD";
					N: OTE(p12r04.comment.5);
					N: SYS_SCP(p01_sys_scp,p12_ao_exhaust_selected_speed,p12_exhaust_input_min,p12_exhaust_input_max,p12_exhaust_output_min,p12_exhaust_output_max,p00_vfd_z2_exhaust:O.Data[1]);
					N: SYS_SCP(p01_sys_scp,p12_ao_recirc_selected_speed,p12_recirc_input_min,p12_recirc_input_max,p12_recirc_output_min,p12_recirc_output_max,p00_vfd_z2_recirc:O.Data[1]);
					RC: "Faults";
					N: OTE(p12r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r04.fault,p12r04.fault_ack);
					N: XIC(FAULT)[TON(p12r04_timer_fault[0],?,?) ,XIC(p12r04_timer_fault[0].DN) OTL(p12r04.fault.0) ];
					N: XIC(p12r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r04.fault.0) ,OTU(p12r04.fault_ack.0) ];
					N: NEQ(p12r04.fault,p12r04.fault_ack)OTE(p12r04.unack_fault);
					RC: "Warnings";
					N: OTE(p12r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p12r04.warning,p12r04.warning_ack);
					N: XIC(FAULT)[TON(p12r04_timer_warning[0],?,?) ,XIC(p12r04_timer_warning[0].DN) OTL(p12r04.warning.0) ];
					N: XIO(FAULT)[OTU(p12r04.warning.0) ,OTU(p12r04.warning_ack.0) ];
					N: NEQ(p12r04.warning,p12r04.warning_ack)OTE(p12r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p12r05$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r05.comment (dint)$N"
					    "p12r05.oneshot (dint)$N"
					    "p12r05_timer_xxxx (timer)$N"
					    "p12r05_xxxx (any)$N"
					    "p12r05.fault (dint)$N"
					    "p12r05.warning (dint)$N"
					    "";
					N: OTE(p12r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r05.comment.2);
					RC: "0,1 = Alarms$N"
					    "2,3 = Warnings$N"
					    "4,5 = Process Indicators$N"
					    "6-15 Status";
					N: OTE(p12r05.comment.3);
					N: [EQU(p12r30.fault,0) OTE(p12_dint_to_hmi[4].0) ,XIC(p12r30_vfds_ready) OTE(p12_dint_to_hmi[4].1) ,XIC(HMI) OTE(p12_dint_to_hmi[4].2) ,XIC(HMI) OTE(p12_dint_to_hmi[4].3) ];
