					N: XIC(p01r13_permissive_drives)XIC(p20_do_engage_lfr_clutch)[XIC(p21r10_state.1) ,XIC(p21r10_state.2) ]OTE(p20r11_permissive_jog);
					N: XIC(p20r11_permissive_jog)XIO(p20r11_request_jog_rev)XIC(p20_di_lfr_jog_fwd)OTE(p20r11_request_jog_fwd);
					N: XIC(p20r11_permissive_jog)XIO(p20r11_request_jog_fwd)XIC(p20_di_lfr_jog_rev)OTE(p20r11_request_jog_rev);
					N: [XIC(p20_di_lfr_nip_close) ,XIC(p20r11_request_close_nip) ]XIO(p20_di_acc_empty)XIO(p20r11_manual_open_nip)OTE(p20r11_request_close_nip);
					N: XIC(p21_di_open_splice_platen)XIC(p30r10_state.1)XIC(p20r13_state.1)OTE(p20r11_manual_open_nip);
					RC: "Output Control";
					N: OTE(p20r11.comment.4);
					N: XIC(p20r11_request_jog_fwd)OTE(p20_do_enable_lfr_fwd);
					N: XIC(p20r11_request_jog_rev)OTE(p20_do_enable_lfr_rev);
					N: XIC(p20r11_request_close_nip)TON(p20r11_nip_close_dwell,?,?)XIC(p20r11_nip_close_dwell.DN)OTE(p20_do_close_nip);
					N: XIC(p20_do_close_nip)[TON(p20r11_timer_clutch_on,?,?) ,TOF(p20r11_timer_clutch_off,?,?) ];
					N: [XIC(p20r11_timer_clutch_on.DN) ,XIC(p20r11_timer_clutch_off.DN) ]XIO(p20r11_timer_clutch_on.TT)OTE(p20_do_engage_lfr_clutch);
					RC: "Faults";
					N: OTE(p20r11.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r11.fault,p20r11.fault_ack);
					N: XIC(FAULT)[TON(p20r11_timer_fault[0],?,?) ,XIC(p20r11_timer_fault[0].DN) OTL(p20r11.fault.0) ];
					N: XIC(p20r11.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r11.fault.0) ,OTU(p20r11.fault_ack.0) ];
					N: NEQ(p20r11.fault,p20r11.fault_ack)OTE(p20r11.unack_fault);
					RC: "Warnings";
					N: OTE(p20r11.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r11.warning,p20r11.warning_ack);
					N: XIC(FAULT)[TON(p20r11_timer_warning[0],?,?) ,XIC(p20r11_timer_warning[0].DN) OTL(p20r11.warning.0) ];
					N: XIO(FAULT)[OTU(p20r11.warning.0) ,OTU(p20r11.warning_ack.0) ];
					N: NEQ(p20r11.warning,p20r11.warning_ack)OTE(p20r11.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R13_Accumulator 
					RC: "p20r13$N"
					    "This routine is called, continuously, from p20R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p20r13.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r13.comment (dint)$N"
					    "p20r13.oneshot (dint)$N"
					    "p20r13_timer_xxxx (timer)$N"
					    "p20r13_xxxx (any)$N"
					    "p20r13.fault (dint)$N"
					    "p20r13.warning (dint)$N"
					    "";
					N: OTE(p20r13.comment.1);
					RC: "Notes$N"
					    "Letoff accumulator postion control.$N"
					    "The carriage position in mm is compared to the control setpoint in mm.$N"
					    "A fixed range around the control setpoint moves with this setpoint.$N"
					    "If the carriage position is above the high range point, it will be driven down at high speed$N"
					    "If the carriage position is below the low range point, it will be driven up at high speed.$N"
					    "If the carriage position is inside the range, position is controlled by PID.$N"
					    "The control setpoint may be switched from a high position to a low position using the fill accumulator function.";
					N: OTE(p20r13.comment.2);
					N: CPT(p20_acc_tens_prs,38+(p01_recipe_active.acc_tension_sp*0.318));
					N: CPT(p20_param_acc_ctr_prs,p01_recipe_active.acc_counter_pressure_sp*1);
					N: CPT(p20_param_acc_high_prs,p01_recipe_active.acc_fill_pressure_sp*1);
					N: MOV(p20_param_high_ctrl_pct,p20_param_high_ctrl_pct)MOV(p20_param_high_low_ctrl_pct,p20_param_high_low_ctrl_pct);
					RC: "Requests";
					N: OTE(p20r13.comment.3);
					N: [XIC(p20_di_lof_acc_fill) ,XIC(p20r09_accumulator_auto) LES(p20r17_letoff_avg_diam_inch,p20_param_acc_auto_fill) ]OTE(p20r13_request_fill);
					RC: "Fill Sequence";
					N: OTE(p20r13.comment.4);
					N: [XIC(p20r13_state.10) XIC(p20r13_state.0) ,XIO(p20r09_accumulator_auto) ONS(p20r13.oneshot.0) ,XIC(S:FS) ,XIC(p02_dint_from_hmi.letoff[0].9) ][MOV(0,p20r13_state) ,OTL(p20r13_state.1) ];
					N: XIC(p20r13_state.1)XIC(p20r13_state.0)XIC(p20r13_request_fill)[MOV(0,p20r13_state) ,OTL(p20r13_state.2) ];
					N: XIC(p20r13_state.2)XIC(p20r13_state.0)[MOV(0,p20r13_state) ,OTL(p20r13_state.3) ];
					N: XIC(p20r13_state.3)XIC(p20r13_state.0)[LEQ(p20r13_selected_pressure,p20_ao_acc_ten_prs) ,GEQ(p20r13_ai_acc_pct,p20_param_low_low_ctrl_pct) ][MOV(0,p20r13_state) ,OTL(p20r13_state.4) ];
					N: XIC(p20r13_state.4)XIC(p20r13_state.0)[XIC(p20_di_acc_full) ,CMP(p20r13_ai_acc_pct>(p20r10_pid_psn.SP-3.5)) ][MOV(0,p20r13_state) ,OTL(p20r13_state.5) ];
					N: XIC(p20r13_state.5)[GEQ(p20r13_ai_acc_pct,p20r13_acc_top_pos) ,XIC(p20_di_acc_full) ][MOV(0,p20r13_state) ,OTL(p20r13_state.6) ];
					N: [XIC(p20r13_state.6) ,XIC(p20r13_state.5) ,XIC(p20r13_state.4) ,XIC(p20r13_state.3) ,XIC(p20r13_state.2) ]XIC(p20r13_state.0)XIC(p20r11_request_close_nip)[MOV(0,p20r13_state) ,OTL(p20r13_state.7) ];
					N: XIC(p20r13_state.7)XIC(p20r13_state.0)XIC(p20_di_acc_empty)[MOV(0,p20r13_state) ,OTL(p20r13_state.8) ];
					N: XIC(p20r13_state.8)XIC(p20r13_state.0)XIC(p20_di_acc_empty)LEQ(p20r13_ai_acc_pct,p20_param_low_ctrl_pct)[MOV(0,p20r13_state) ,OTL(p20r13_state.9) ];
					N: XIC(p20r13_state.9)XIC(p20r13_state.0)LEQ(p20r13_ai_acc_pct,p20_param_empty_pct)[MOV(0,p20r13_state) ,OTL(p20r13_state.10) ];
					N: OTL(p20r13_state.0);
					N: SYS_ENC(p20r13_enc,p20r13_state,p20r13_status);
					RC: "Output Control";
					N: OTE(p20r13.comment.5);
					N: OTE(p20_do_acc_enable_tension);
					RC: "Accumulator Pressure Setpoints$N"
					    "$N"
					    "";
					N: NOP();
					N: XIO(p20_do_acc_enable_tension)MOV(0,p20_ao_acc_ten_prs);
					N: XIC(p20r13_state.7)MOV(p20_acc_tens_prs,p20r13_selected_pressure);
					N: XIC(p20r13_state.1)GRT(p20r13_ai_acc_pct,p20_param_low_low_ctrl_pct)MOV(p20_zero_tension_prs,p20r13_selected_pressure);
					N: [[XIC(p20r13_state.2) ,XIC(p20r13_state.3) ,XIC(p20r13_state.4) ] CPT(p20r13_selected_pressure,p20_acc_tens_prs+p20_param_acc_init_prs+p20_param_acc_fill_ctr_prs) ,XIC(p20r13_state.5) CPT(p20r13_selected_pressure,p20_acc_tens_prs+p20_param_acc_pos_prs+p20_param_acc_fill_ctr_prs) ]MOV(p20_param_acc_fill_ctr_prs,p20_param_acc_ctr_prs)[LEQ(p20r13_ai_acc_pct,50) MOV(p20_param_acc_init_high_prs,p20_param_acc_init_prs) ,GRT(p20r13_ai_acc_pct,50) MOV(p20_param_acc_init_low_prs,p20_param_acc_init_prs) ];
					N: [XIC(p20r13_state.8) ,XIC(p20r13_state.9) ,XIC(p20r13_state.10) ,XIC(p20r13_state.1) LES(p20r13_ai_acc_pct,2) ,XIC(S:FS) ]MOV(p20_param_acc_empty_prs,p20r13_selected_pressure);
					N: XIC(p20r13_state.3)ONS(p20r13.oneshot.1)CPT(p20_ao_acc_ten_prs,41+p20_param_acc_ctr_prs);
					N: XIC(p20r13_state.6)MOV(p20_acc_fill_prs,p20_ao_acc_ten_prs);
					RC: "Pressure Accel Decel Ramp Settings$N"
					    "$N"
					    "";
					N: NOP();
					N: [XIC(p20r13_state.1) ,XIC(p20r13_state.2) ,XIC(p20r13_state.3) ]MOV(p20_param_acc_med_accel,p20_param_prs_accel_rate)MOV(p20_param_acc_med_decel,p20_param_prs_decel_rate);
					N: [XIC(p20r13_state.4) ,XIC(p20r13_state.5) ,XIC(p20r13_state.8) ,XIC(p20r13_state.9) ,XIC(p20r13_state.10) ][MOV(p20_param_acc_slow_accel,p20_param_prs_accel_rate) ,MOV(p20_param_acc_slow_decel,p20_param_prs_decel_rate) ];
					N: XIC(p20r13_state.7)MOV(p20_param_acc_fast_accel,p20_param_prs_accel_rate)MOV(p20_param_acc_fast_decel,p20_param_prs_decel_rate);
					N: XIC(p20r14_acc_request_tension_ctrl)MOV(p20_param_acc_pid_accel,p20_param_prs_accel_rate)MOV(p20_param_acc_pid_decel,p20_param_prs_decel_rate);
					RC: "Accumulator Pressure Accel Decel Ramp$N"
					    "$N"
					    "";
					N: NOP();
					N: XIC(p20_do_acc_enable_tension)SYS_ACC_DEC_RAMP(p20r13_ramp_tension_pressure,p20r13_selected_pressure,p20_param_prs_accel_rate,p20_param_prs_decel_rate,p01r02_plc_scan_time_in_sec,p20_ao_acc_ten_prs)MOV(p20_ao_acc_ten_prs,p20_ao_acc_ten_prs);
					N: MUL(p20_param_acc_ctr_prs,1,p20_ao_acc_ctr_prs);
					RC: "Faults";
					N: OTE(p20r13.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r13.fault,p20r13.fault_ack);
					N: XIC(FAULT)[TON(p20r13_timer_fault[0],?,?) ,XIC(p20r13_timer_fault[0].DN) OTL(p20r13.fault.0) ];
					N: XIC(p20r13.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r13.fault.0) ,OTU(p20r13.fault_ack.0) ];
					N: NEQ(p20r13.fault,p20r13.fault_ack)OTE(p20r13.unack_fault);
					RC: "Warnings";
					N: OTE(p20r13.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r13.warning,p20r13.warning_ack);
					N: XIC(FAULT)[TON(p20r13_timer_warning[0],?,?) ,XIC(p20r13_timer_warning[0].DN) OTL(p20r13.warning.0) ];
					N: XIO(FAULT)[OTU(p20r13.warning.0) ,OTU(p20r13.warning_ack.0) ];
					N: NEQ(p20r13.warning,p20r13.warning_ack)OTE(p20r13.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R15_Letoff_A_VFD 
					RC: "p27r15$N"
					    "This routine is called, continuously, from p27r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r15.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p27r15.comment (dint)$N"
					    "p27r15.oneshot (dint)$N"
					    "p27r15_timer_xxxx (timer)$N"
					    "p27r15_xxxx (any)$N"
					    "p27r15.fault (dint)$N"
					    "p27r15.warning (dint)$N"
					    "";
					N: OTE(p20r15.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r15.comment.2);
					N: XIC(p01r13_permissive_drives)XIO(p01r09.fault.0)EQU(p20r15.fault,0)OTE(p20r15_permissive_run);
					N: XIC(p20_di_loa_active)[XIC(p20_di_loa_start) ,XIC(p20r15_loa_on) ]XIC(p20_di_loa_stop)OTE(p20r15_loa_on);
					RC: "Requests";
					N: OTE(p20r15.comment.4);
					N: [XIO(p01r13_line_running) XIO(p01r13_line_slow_ramp) [XIC(p20r13_state.1) ,XIC(p20r13_state.2) ,XIC(p20r13_state.9) ,XIC(p20r13_state.10) ] ,XIC(p20_do_close_nip) ,XIC(p20r13_state.7) ,XIO(p20r15_permissive_run) ]OTE(p20r15_request_stop);
					N: XIC(p20r15_loa_on)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ,XIC(p20r15_request_thread_fwd) ,XIC(p20r15_request_thread_rev) ][XIC(p20r13_state.1) ,XIC(p20r13_state.2) ,XIC(p20r13_state.3) ,XIC(p20r13_state.6) ,XIC(p20r13_state.8) ,XIC(p20r13_state.9) ,XIC(p20r13_state.10) ][[GEQ(p20_ai_lc01,5) ,XIC(p20r15_request_tension) ] XIO(p20r15_request_stop) ,XIC(p20r15_request_thread_fwd) ,XIC(p20r15_request_thread_rev) ]OTE(p20r15_request_tension);
					N: XIC(p20r15_loa_on)[XIO(p01r13_line_running) ,XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p20r13_state.4)XIO(p20r15_request_stop)OTE(p20r15_request_over_speed);
					N: XIC(p20r15_loa_on)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p20r13_state.5)XIO(p20r15_request_stop)OTE(p20r15_request_position);
					N: XIC(p20r15_permissive_run)XIC(p20_di_loa_fwd_dir)[XIC(p20_di_loa_jog) XIC(p20r15_zero_speed) ,XIC(p20r15_request_jog_fwd) XIO(p20r15_zero_speed) ]OTE(p20r15_request_jog_fwd);
					N: XIC(p20r15_permissive_run)XIO(p20_di_loa_fwd_dir)[XIC(p20_di_loa_jog) XIC(p20r15_zero_speed) ,XIC(p20r15_request_jog_rev) XIO(p20r15_zero_speed) ]OTE(p20r15_request_jog_rev);
					N: XIC(p20r15_loa_on)[XIC(p20_di_loa_fwd_dir) [XIC(p22r11_request_thread_fwd) ,XIC(p25r11_request_thread_fwd) ] ,XIO(p20_di_loa_fwd_dir) [XIC(p22r11_request_thread_rev) ,XIC(p25r11_request_thread_rev) ] ]OTE(p20r15_request_thread_fwd);
					N: XIC(p20r15_loa_on)[XIC(p20_di_loa_fwd_dir) [XIC(p22r11_request_thread_rev) ,XIC(p25r11_request_thread_rev) ] ,XIO(p20_di_loa_fwd_dir) [XIC(p22r11_request_thread_fwd) ,XIC(p25r11_request_thread_fwd) ] ]OTE(p20r15_request_thread_rev);
					N: LEQ(p20_ai_loa_speed,0.1)OTE(p20r15_zero_speed);
					RC: "Outputs";
					N: OTE(p20r15.comment.5);
					N: XIC(p20r15_permissive_run)[XIC(p20_di_loa_fwd_dir) [XIC(p20r15_request_tension) ,XIC(p20r15_request_position) ,XIC(p20r15_request_over_speed) ] ,XIC(p20r15_request_thread_fwd) ,XIC(p20r15_request_jog_fwd) ]OTE(p20_vfd_do_loa.forward);
					N: XIC(p20r15_permissive_run)[XIO(p20_di_loa_fwd_dir) [XIC(p20r15_request_tension) ,XIC(p20r15_request_position) ,XIC(p20r15_request_over_speed) ] ,XIC(p20r15_request_thread_rev) ,XIC(p20r15_request_jog_rev) ]OTE(p20_vfd_do_loa.reverse);
