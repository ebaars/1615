			IN_accel_rate : REAL (Description := "Input Parameter$NAccel Ramp$Nx/second",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			IN_decel_rate : REAL (Description := "Input Parameter$NDecel Ramp$Nx/second",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			IN_last_scan_s : REAL (Description := "Input Parameter$NLast Scan $Nseconds",
			                          Usage := Input,
			                          RADIX := Float,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0.00000000e+000);
			IN_OUT_ramped_setpoint : REAL (Description := "Input Output Parameter$NRamped Setpoint",
			                                  Usage := InOut,
			                                  RADIX := Float,
			                                  Required := Yes,
			                                  Visible := Yes);
			IN_target_setpoint : REAL (Description := "Input Parameter$NTargetet Setpoint",
			                              Usage := Input,
			                              RADIX := Float,
			                              Required := Yes,
			                              Visible := Yes,
			                              DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			local_last_scan_ms : DINT (RADIX := Decimal,
			                             ExternalAccess := Read/Write,
			                             DefaultData := 0);
			p01r03_last_scan_ms : DINT (RADIX := Decimal,
			                              ExternalAccess := Read/Write,
			                              DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: LEQ(IN_OUT_ramped_setpoint,IN_target_setpoint)[CPT(IN_OUT_ramped_setpoint,IN_OUT_ramped_setpoint+(IN_accel_rate*(IN_last_scan_s))) ,GRT(IN_OUT_ramped_setpoint,IN_target_setpoint) MOV(IN_target_setpoint,IN_OUT_ramped_setpoint) ];
				N: GRT(IN_OUT_ramped_setpoint,IN_target_setpoint)[CPT(IN_OUT_ramped_setpoint,IN_OUT_ramped_setpoint-(IN_decel_rate*(IN_last_scan_s))) ,LES(IN_OUT_ramped_setpoint,IN_target_setpoint) MOV(IN_target_setpoint,IN_OUT_ramped_setpoint) ];
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION SYS_RPM_TO_SPEED (Revision := "1.0",
	                                                ExecutePrescan := No,
	                                                ExecutePostscan := No,
	                                                ExecuteEnableInFalse := No,
	                                                CreatedDate := "2007-09-12T13:52:15.343Z",
	                                                CreatedBy := "EB_2\EB",
	                                                EditedDate := "2023-03-06T19:22:20.228Z",
	                                                EditedBy := "DESKTOP-UJLNSL3\cal1615",
	                                                SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			IN_gear_ratio : REAL (Description := "Gear Ratio",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			IN_roll_diameter : REAL (Description := "Roll Diameter",
			                            Usage := Input,
			                            RADIX := Float,
			                            Required := Yes,
			                            Visible := Yes,
			                            DefaultData := 0.00000000e+000);
			IN_vfd_fb_rpm : REAL (Description := "VFD Feedback in RPM",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			OUT_surface_speed_fb : REAL (Description := "Roll Surface Speed Feedback",
			                                Usage := Output,
			                                RADIX := Float,
			                                Required := Yes,
			                                Visible := Yes,
			                                ExternalAccess := Read Only,
			                                DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			no_diameter : BOOL (RADIX := Decimal,
			                      ExternalAccess := Read/Write,
			                      DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: LEQ(IN_gear_ratio,0)MOV(1,IN_gear_ratio);
				N: LEQ(IN_roll_diameter,0)OTE(no_diameter);
				N: XIO(no_diameter)CPT(OUT_surface_speed_fb,(IN_vfd_fb_rpm/(IN_gear_ratio))*(IN_roll_diameter * 3.14159));
				N: XIC(no_diameter)CPT(OUT_surface_speed_fb,(IN_vfd_fb_rpm/(IN_gear_ratio))*1);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION SYS_SCP (Revision := "1.0",
	                                       ExecutePrescan := No,
	                                       ExecutePostscan := No,
	                                       ExecuteEnableInFalse := No,
	                                       CreatedDate := "2007-04-04T15:43:14.328Z",
	                                       CreatedBy := "DDQ2FX91\GAP",
	                                       EditedDate := "2025-12-23T15:00:35.942Z",
	                                       EditedBy := "LITZLER\TSG",
	                                       SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			Input : REAL (Usage := Input,
			                 RADIX := Float,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0.00000000e+000);
			Input_Min : REAL (Usage := Input,
			                     RADIX := Float,
			                     Required := Yes,
			                     Visible := Yes,
			                     DefaultData := 0.00000000e+000);
			Input_Max : REAL (Usage := Input,
			                     RADIX := Float,
			                     Required := Yes,
			                     Visible := Yes,
			                     DefaultData := 0.00000000e+000);
			Output_Min : REAL (Usage := Input,
			                      RADIX := Float,
			                      Required := Yes,
			                      Visible := Yes,
			                      DefaultData := 0.00000000e+000);
			Output_Max : REAL (Usage := Input,
			                      RADIX := Float,
			                      Required := Yes,
			                      Visible := Yes,
			                      DefaultData := 0.00000000e+000);
			Output : REAL (Usage := Output,
			                  RADIX := Float,
			                  Required := Yes,
			                  Visible := Yes,
			                  ExternalAccess := Read Only,
			                  DefaultData := 0.00000000e+000);
			Fault : BOOL (Usage := Output,
			                 RADIX := Decimal,
			                 Required := No,
			                 Visible := No,
			                 ExternalAccess := Read Only,
			                 DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			m : REAL (RADIX := Float,
			            ExternalAccess := Read/Write,
			            DefaultData := 0.00000000e+000);
			b : REAL (RADIX := Float,
			            ExternalAccess := Read/Write,
			            DefaultData := 0.00000000e+000);
			X1 : REAL (RADIX := Float,
			             ExternalAccess := Read/Write,
			             DefaultData := 0.00000000e+000);
			X2 : REAL (RADIX := Float,
			             ExternalAccess := Read/Write,
			             DefaultData := 0.00000000e+000);
			Y1 : REAL (RADIX := Float,
			             ExternalAccess := Read/Write,
			             DefaultData := 0.00000000e+000);
			Y2 : REAL (RADIX := Float,
			             ExternalAccess := Read/Write,
			             DefaultData := 0.00000000e+000);
			X3 : REAL (RADIX := Float,
			             ExternalAccess := Read/Write,
			             DefaultData := 0.00000000e+000);
			Y3 : REAL (RADIX := Float,
			             ExternalAccess := Read/Write,
			             DefaultData := 0.00000000e+000);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: MOV(Input_Min,X1)MOV(Input_Max,X2)MOV(Input,X3);
				N: MOV(Output_Min,Y1)MOV(Output_Max,Y2);
				N: CMP((X1-X2) = 0)OTE(Fault);
				N: GEQ(Input_Max,Input_Min)[GRT(X3,Input_Max) MOV(Input_Max,X3) ,LES(X3,Input_Min) MOV(Input_Min,X3) ];
				N: GEQ(Input_Min,Input_Max)[GRT(X3,Input_Min) MOV(Input_Min,X3) ,LES(X3,Input_Max) MOV(Input_Max,X3) ];
				N: XIO(Fault)CPT(m,(Y1-Y2)/(X1-X2));
				N: XIO(Fault)CPT(b,Y2-m * X2);
				N: XIO(Fault)CPT(Y3,X3 * m + b);
				N: XIC(Fault)CPT(Output,Y1);
				N: XIO(Fault)CPT(Output,Y3);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION SYS_SPEED_TO_VFD (Revision := "1.0",
	                                                ExecutePrescan := No,
	                                                ExecutePostscan := No,
	                                                ExecuteEnableInFalse := No,
	                                                CreatedDate := "2007-09-12T17:24:00.015Z",
	                                                CreatedBy := "EB_2\EB",
	                                                EditedDate := "2023-03-06T19:22:21.921Z",
	                                                EditedBy := "DESKTOP-UJLNSL3\cal1615",
	                                                SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			IN_gear_ratio : REAL (Description := "Gear Ratio",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			IN_roll_diameter : REAL (Description := "Roll Diameter",
			                            Usage := Input,
			                            RADIX := Float,
			                            Required := Yes,
			                            Visible := Yes,
			                            DefaultData := 0.00000000e+000);
			IN_selected_speed : REAL (Description := "Selected Speed",
			                             Usage := Input,
			                             RADIX := Float,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0.00000000e+000);
			OUT_surface_speed_rpm : REAL (Description := "RPM to VFD",
			                                 Usage := Output,
			                                 RADIX := Float,
			                                 Required := Yes,
			                                 Visible := Yes,
			                                 ExternalAccess := Read Only,
			                                 DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: LEQ(IN_gear_ratio,0)MOV(1,IN_gear_ratio);
				N: LEQ(IN_roll_diameter,0)MOV(1,IN_roll_diameter);
				N: CPT(OUT_surface_speed_rpm,(IN_selected_speed/(IN_roll_diameter * 3.14159))*(IN_gear_ratio));
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION SYS_Toggle (Revision := "1.0",
	                                          ExecutePrescan := No,
	                                          ExecutePostscan := No,
	                                          ExecuteEnableInFalse := No,
	                                          CreatedDate := "2007-09-17T12:49:46.734Z",
	                                          CreatedBy := "EB_2\EB",
	                                          EditedDate := "2023-03-06T19:22:22.156Z",
	                                          EditedBy := "DESKTOP-UJLNSL3\cal1615",
	                                          SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			in_pb : BOOL (Description := "IN: Momentary On PB",
			                 Usage := Input,
			                 RADIX := Decimal,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0);
			out_state : BOOL (Description := "OUT: State",
			                     Usage := InOut,
			                     RADIX := Decimal,
			                     Required := Yes,
			                     Visible := Yes);
			toggle_state : BOOL (Usage := Input,
			                        RADIX := Decimal,
			                        Required := No,
			                        Visible := Yes,
			                        DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			ons : DINT (COMMENT.1 := "One Shots",
			              RADIX := Decimal,
			              ExternalAccess := Read/Write,
			              DefaultData := 0);
			toggle_select_deselct : BOOL (Description := "Toggle $NSelect/Deselect",
			                                RADIX := Decimal,
			                                ExternalAccess := Read/Write,
			                                DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIC(in_pb)ONS(ons.1)OTL(toggle_select_deselct);
				N: XIC(toggle_select_deselct)XIO(out_state)[OTL(out_state) ,OTU(toggle_select_deselct) ];
				N: XIC(toggle_select_deselct)XIC(out_state)[OTU(out_state) ,OTU(toggle_select_deselct) ];
				N: XIC(out_state)OTE(toggle_state);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

