					N: XIC(FAULT)[TON(p21r04_timer_fault[0],?,?) ,XIC(p21r04_timer_fault[0].DN) OTL(p21r04.fault.0) ];
					N: XIC(p21r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p21r04.fault.0) ,OTU(p21r04.fault_ack.0) ];
					N: NEQ(p21r04.fault,p21r04.fault_ack)OTE(p21r04.unack_fault);
					RC: "Warnings";
