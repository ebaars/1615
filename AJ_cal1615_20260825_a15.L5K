					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Parameters,0);
					N: JSR(R20_Temp_Sequence,0);
					N: JSR(R30_Temperature_Control,0);
					N: JSR(R31_Exhaust_VFD,0);
