					N: XIO(p23r17_di_brake)[TON(p23r17_timer_fault[5],?,?) ,XIC(p23r17_timer_fault[5].DN) OTL(p23r17.fault.5) ];
					N: XIC(p23r17.fault_ack.5)XIC(p23r17_di_brake)XIC(p01r09_pb_global_reset)[OTU(p23r17.fault.5) ,OTU(p23r17.fault_ack.5) ];
