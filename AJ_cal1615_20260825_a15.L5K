					N: [XIC(p11_do_enable_burner) OTE(Local:7:O.Data.0) ,XIC(p11_do_rst_flame) OTE(Local:7:O.Data.1) ];
					N: [XIC(p11_do_exh.forward) OTE(p00_vfd_z1_exhaust:O.Data[0].0) ,XIC(p11_do_exh.reverse) OTE(p00_vfd_z1_exhaust:O.Data[0].1) ,XIC(p11_do_exh.fault_reset) OTE(p00_vfd_z1_exhaust:O.Data[0].2) ,OTE(p00_vfd_z1_exhaust:O.Data[0].5) ,OTE(p00_vfd_z1_exhaust:O.Data[0].6) ];
					N: [XIC(p11_do_recirc.forward) OTE(p00_vfd_z1_recirc:O.Data[0].0) ,XIC(p11_do_recirc.reverse) OTE(p00_vfd_z1_recirc:O.Data[0].1) ,XIC(p11_do_recirc.fault_reset) OTE(p00_vfd_z1_recirc:O.Data[0].2) ,OTE(p00_vfd_z1_recirc:O.Data[0].5) ,OTE(p00_vfd_z1_recirc:O.Data[0].6) ];
					RC: "Analog";
					N: OTE(p11r04.comment.4);
					N: SYS_SCP(p01_sys_scp,p11_ao_cv,p11_hc_input_min,p11_hc_input_max,p11_hc_output_min,p11_hc_output_max,p00_io_oven:0:O.Ch0Data);
					RC: "VFD";
					N: OTE(p11r04.comment.5);
					N: SYS_SCP(p01_sys_scp,p11_ao_exhaust_selected_speed,p11_exhaust_input_min,p11_exhaust_input_max,p11_exhaust_output_min,p11_exhaust_output_max,p00_vfd_z1_exhaust:O.Data[1]);
					N: SYS_SCP(p01_sys_scp,p11_ao_recirc_selected_speed,p11_recirc_input_min,p11_recirc_input_max,p11_recirc_output_min,p11_recirc_output_max,p00_vfd_z1_recirc:O.Data[1]);
					RC: "Faults";
					N: OTE(p11r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p11r04.fault,p11r04.fault_ack);
					N: XIC(FAULT)[TON(p11r04_timer_fault[0],?,?) ,XIC(p11r04_timer_fault[0].DN) OTL(p11r04.fault.0) ];
					N: XIC(p11r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p11r04.fault.0) ,OTU(p11r04.fault_ack.0) ];
					N: NEQ(p11r04.fault,p11r04.fault_ack)OTE(p11r04.unack_fault);
					RC: "Warnings";
					N: OTE(p11r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p11r04.warning,p11r04.warning_ack);
					N: XIC(FAULT)[TON(p11r04_timer_warning[0],?,?) ,XIC(p11r04_timer_warning[0].DN) OTL(p11r04.warning.0) ];
					N: XIO(FAULT)[OTU(p11r04.warning.0) ,OTU(p11r04.warning_ack.0) ];
					N: NEQ(p11r04.warning,p11r04.warning_ack)OTE(p11r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p11r05$N"
					    "This routine is called, continuously, from p11R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p11r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r05.comment (dint)$N"
					    "p11r05.oneshot (dint)$N"
					    "p11r05_timer_xxxx (timer)$N"
					    "p11r05_xxxx (any)$N"
					    "p11r05.fault (dint)$N"
					    "p11r05.warning (dint)$N"
					    "";
					N: OTE(p11r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p11r05.comment.2);
					RC: "0,1 = Alarms$N"
					    "2,3 = Warnings$N"
					    "4,5 = Process Indicators$N"
					    "6-15 Status";
					N: OTE(p11r05.comment.3);
					N: [EQU(p11r30.fault,0) OTE(p11_dint_to_hmi[4].0) ,XIC(p11r30_vfds_ready) OTE(p11_dint_to_hmi[4].1) ,XIC(HMI) OTE(p11_dint_to_hmi[4].2) ,XIC(HMI) OTE(p11_dint_to_hmi[4].3) ];
					N: [XIC(p11r31_request_auto_run) OTE(p11_dint_to_hmi[4].4) ,XIC(p11r31_vfd_stopped) OTE(p11_dint_to_hmi[4].5) ,XIC(p11r31_request_auto_stop) OTE(p11_dint_to_hmi[4].6) ,XIC(HMI) OTE(p11_dint_to_hmi[4].7) ];
					N: [XIC(p11r32_request_auto_run) OTE(p11_dint_to_hmi[4].8) ,XIO(p11r32_request_auto_run) OTE(p11_dint_to_hmi[4].9) ,XIC(p11r32_request_auto_stop) OTE(p11_dint_to_hmi[4].10) ,XIC(HMI) OTE(p11_dint_to_hmi[4].11) ];
					N: [XIC(HMI) OTE(p11_dint_to_hmi[4].12) ,XIC(HMI) OTE(p11_dint_to_hmi[4].13) ,XIC(HMI) OTE(p11_dint_to_hmi[4].14) ,XIC(HMI) OTE(p11_dint_to_hmi[4].15) ];
					N: [XIC(p11r30_request_heat) OTE(p11_dint_to_hmi[4].16) ,XIO(p11r30_request_heat) OTE(p11_dint_to_hmi[4].17) ,XIC(p11r30_request_manual) OTE(p11_dint_to_hmi[4].18) ,XIO(p11r30_request_manual) OTE(p11_dint_to_hmi[4].19) ];
					N: [XIC(HMI) OTE(p11_dint_to_hmi[4].20) ,XIC(HMI) OTE(p11_dint_to_hmi[4].21) ,XIC(HMI) OTE(p11_dint_to_hmi[4].22) ,XIC(HMI) OTE(p11_dint_to_hmi[4].23) ];
					N: [XIC(HMI) OTE(p11_dint_to_hmi[4].24) ,XIC(HMI) OTE(p11_dint_to_hmi[4].25) ,XIC(HMI) OTE(p11_dint_to_hmi[4].26) ,XIC(HMI) OTE(p11_dint_to_hmi[4].27) ];
					N: [XIC(HMI) OTE(p11_dint_to_hmi[4].28) ,XIC(HMI) OTE(p11_dint_to_hmi[4].29) ,XIC(HMI) OTE(p11_dint_to_hmi[4].30) ,XIC(HMI) OTE(p11_dint_to_hmi[4].31) ];
					N: [XIC(p11_di_burner_auto) OTE(p11_dint_to_hmi[5].0) ,XIC(p11_di_burner_safeties_ok) OTE(p11_dint_to_hmi[5].1) ,XIC(p11_di_zone_air_clean) OTE(p11_dint_to_hmi[5].2) ,XIC(p11_di_sp0) OTE(p11_dint_to_hmi[5].3) ];
					N: [XIC(p11_di_door_open) OTE(p11_dint_to_hmi[5].4) ,XIC(p11_di_exh_fan_mtr_ts) OTE(p11_dint_to_hmi[5].5) ,XIC(p11_di_exh_flow_ok) OTE(p11_dint_to_hmi[5].6) ,XIO(p11_di_flame_failure) OTE(p11_dint_to_hmi[5].7) ];
					N: [XIC(p11_di_flame_on) OTE(p11_dint_to_hmi[5].8) ,XIC(p11_di_high_limit_temp_ok) OTE(p11_dint_to_hmi[5].9) ,XIC(p11_di_recirc_fan_mtr_ts) OTE(p11_dint_to_hmi[5].10) ,XIC(p11_di_recirc_flow_ok) OTE(p11_dint_to_hmi[5].11) ];
					N: [XIO(p11_di_sp00) OTE(p11_dint_to_hmi[5].12) ,XIC(p11_di_fresh_air_clean) OTE(p11_dint_to_hmi[5].13) ,XIC(p11_di_tc01_bo) OTE(p11_dint_to_hmi[5].14) ,XIC(p11_di_tc02_bo) OTE(p11_dint_to_hmi[5].15) ];
					N: [XIC(p11_di_exh.running_fwd) OTE(p11_dint_to_hmi[5].16) ,XIC(p11_di_exh.running_fwd) OTE(p11_dint_to_hmi[5].17) ,XIC(p11_di_tc01_bo) OTE(p11_dint_to_hmi[5].18) ,XIC(p11_di_tc02_bo) OTE(p11_dint_to_hmi[5].19) ];
					N: [XIC(p11_di_recirc.running_fwd) OTE(p11_dint_to_hmi[5].24) ,XIC(p11_di_exh.running_fwd) OTE(p11_dint_to_hmi[5].25) ,XIC(p11_di_tc01_bo) OTE(p11_dint_to_hmi[5].26) ,XIC(p11_di_tc02_bo) OTE(p11_dint_to_hmi[5].27) ];
					N: [XIC(p11_di_exh.faulted) OTE(p11_dint_to_hmi[6].0) ,XIC(p11_di_exh.warning) OTE(p11_dint_to_hmi[6].1) ,XIC(p11_di_exh.running_fwd) OTE(p11_dint_to_hmi[6].2) ,XIC(p11_di_exh.running_rev) OTE(p11_dint_to_hmi[6].3) ];
					N: [XIC(p11_di_exh.ready) OTE(p11_dint_to_hmi[6].4) ,XIC(p11_di_exh.ctrl_from_net) OTE(p11_dint_to_hmi[6].5) ,XIC(p11_di_exh.ref_from_net) OTE(p11_dint_to_hmi[6].6) ,XIC(p11_di_exh.at_reference) OTE(p11_dint_to_hmi[6].7) ];
					N: [XIC(p11_di_recirc.faulted) OTE(p11_dint_to_hmi[6].8) ,XIC(p11_di_recirc.warning) OTE(p11_dint_to_hmi[6].9) ,XIC(p11_di_recirc.running_fwd) OTE(p11_dint_to_hmi[6].10) ,XIC(p11_di_recirc.running_rev) OTE(p11_dint_to_hmi[6].11) ];
					N: [XIC(p11_di_recirc.ready) OTE(p11_dint_to_hmi[6].12) ,XIC(p11_di_recirc.ctrl_from_net) OTE(p11_dint_to_hmi[6].13) ,XIC(p11_di_recirc.ref_from_net) OTE(p11_dint_to_hmi[6].14) ,XIC(p11_di_recirc.at_reference) OTE(p11_dint_to_hmi[6].15) ];
					RC: "Sequence";
					N: OTE(p11r05.comment.4);
					N: MOV(0,p11_dint_to_hmi[7])MOV(p11r20_status,p11_dint_to_hmi[8]);
					N: MOV(0,p11r05_temp_ctrl_status)[XIC(p11r30_permissive_run) MOV(1,p11r05_temp_ctrl_status) ,XIC(p11r30_request_heat) MOV(2,p11r05_temp_ctrl_status) ,XIC(p11r20_state.31) MOV(8,p11r05_temp_ctrl_status) ,XIO(p11r30_permissive_run) MOV(4,p11r05_temp_ctrl_status) ,XIO(p11_di_burner_auto) MOV(7,p11r05_temp_ctrl_status) ];
					N: MOV(p11r05_temp_ctrl_status,p11_dint_to_hmi[9]);
					RC: "1 = Ready$N"
					    "2 = Running$N"
					    "3 = Stopped$N"
					    "4 = Fault$N"
					    "5 = Offline$N"
