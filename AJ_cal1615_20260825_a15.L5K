					N: [XIC(p01r13_state.2) ,XIC(p01r13_state.3) ,XIC(p01r13_state.4) ,XIC(p01r13_state.5) ,XIC(p01r13_state.6) ]OTE(p22r02_request_system_run);
					RC: "Sequence";
