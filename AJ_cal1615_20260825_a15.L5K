					N: XIC(p13r32.warning_ack.2)XIO(p13_di_recirc.warning)[OTU(p13r32.warning.2) ,OTU(p13r32.warning_ack.2) ];
					N: XIC(p13_di_recirc.ready)XIO(p13_di_recirc.ctrl_from_net)[TON(p13r32_timer_warning[3],?,?) ,XIC(p13r32_timer_warning[3].DN) OTL(p13r32.warning.3) ];
					N: XIC(p13r32.warning_ack.3)[XIC(p13_di_recirc.ctrl_from_net) ,XIO(p13_di_recirc.ready) ][OTU(p13r32.warning.3) ,OTU(p13r32.warning_ack.3) ];
					N: NEQ(p13r32.warning,p13r32.warning_ack)OTE(p13r32.unack_warning);
					RC: "Warnings";
					N: OTE(p13r32.comment.31);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P19_Advanced_Cooling (MAIN := "R01_Main",
	                              MODE := 0,
	                              DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					RC: "p19R01 Main$N"
					    "$N"
					    "This routine is called, continuously, from p19 System while the plc is in Run mode.  All other p19 System routines are called from this routine.";
					N: OTE(p19r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p19r01.comment (dint)$N"
					    "p19r01.oneshot (dint)$N"
					    "p19r01_timer_xxxx (timer)$N"
					    "p19r01_xxxx (any)$N"
					    "p19r01.fault (dint)$N"
					    "p19r01.warning (dint)$N"
					    "";
					N: OTE(p19r01.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p19r01.comment.2);
					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Parameters,0);
					N: JSR(R30_Temperature_Control,0);
					N: JSR(R31_Pump,0);
					N: JSR(R32_Pressure_Control,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p19R02$N"
					    "This routine is called, continuously, from p19R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p19r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p19r02.comment (dint)$N"
					    "p19r02.oneshot (dint)$N"
					    "p19r02_timer_xxxx (timer)$N"
					    "p19r02_xxxx (any)$N"
					    "p19r02.fault (dint)$N"
					    "p19r02.warning (dint)$N"
					    "";
					N: OTE(p19r02.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p19r02.comment.2);
					N: NEQ(p19_dint_to_hmi[2],0)OTE(p19r02_fault_exists);
					N: NEQ(p19_dint_to_hmi[4],0)OTE(p19r02_warning_exists);
					RC: "Requests";
					N: OTE(p19r02.comment.3);
					N: [XIC(p19r02.unack_fault) ,XIC(p19r03.unack_fault) ,XIC(p19r04.unack_fault) ,XIC(p19r05.unack_fault) ,XIC(p19r06.unack_fault) ,XIC(p19r07.unack_fault) ,XIC(p19r08.unack_fault) ,XIC(p19r09.unack_fault) ,XIC(p19r10.unack_fault) ,XIC(p19r30.unack_fault) ,XIC(p19r31.unack_fault) ]OTE(p19r02_unack_fault);
					N: [XIC(p19r02.unack_warning) ,XIC(p19r03.unack_warning) ,XIC(p19r04.unack_warning) ,XIC(p19r05.unack_warning) ,XIC(p19r06.unack_warning) ,XIC(p19r07.unack_warning) ,XIC(p19r08.unack_warning) ,XIC(p19r09.unack_warning) ,XIC(p19r10.unack_warning) ,XIC(p19r30.unack_warning) ,XIC(p19r31.unack_warning) ]OTE(p19r02_unack_warning);
					RC: "Sequence";
					N: OTE(p19r02.comment.4);
					RC: "Output Control";
					N: OTE(p19r02.comment.5);
					RC: "Faults";
					N: OTE(p19r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p19r02.fault,p19r02.fault_ack);
					N: XIC(FAULT)[TON(p19r02_timer_fault[0],?,?) ,XIC(p19r02_timer_fault[0].DN) OTL(p19r02.fault.0) ];
					N: XIC(p19r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p19r02.fault.0) ,OTU(p19r02.fault_ack.0) ];
					N: NEQ(p19r02.fault,p19r02.fault_ack)OTE(p19r02.unack_fault);
					RC: "Warnings";
					N: OTE(p19r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p19r02.warning,p19r02.warning_ack);
					N: XIC(FAULT)[TON(p19r02_timer_warning[0],?,?) ,XIC(p19r02_timer_warning[0].DN) OTL(p19r02.warning.0) ];
					N: XIO(FAULT)[OTU(p19r02.warning.0) ,OTU(p19r02.warning_ack.0) ];
