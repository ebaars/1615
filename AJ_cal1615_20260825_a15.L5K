			ROUTINE R01_Main 
					RC: "p30R01 System Main$N"
					    "$N"
					    "This routine is called, continuously, from p30 System while the plc is in Run mode.  All other p30 System routines are called from this routine.";
					N: OTE(p30r01.comment.0);
