			ROUTINE R11_VFD 
					RC: "p33r11$N"
					    "This routine is called, continuously, from p28R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p28r11.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p33r11.comment (dint)$N"
					    "p33r11.oneshot (dint)$N"
					    "p33r11_timer_xxxx (timer)$N"
					    "p33r11_xxxx (any)$N"
					    "p33r11.fault (dint)$N"
					    "p33r11.warning (dint)$N"
					    "";
					N: OTE(p28r11.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p28r11.comment.2);
					N: SYS_Toggle(p28_slitter_on,p02_dint_from_hmi.slt[1].9,p28r11_slitter_on)XIC(p28r11_slitter_on)OTE(p28r11_slitter_on);
					RC: "Requests";
					N: OTE(p28r11.comment.3);
					N: XIC(p01r13_permissive_drives)OTE(p28r11_permissive_run);
					N: [XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p28r11_slitter_on)OTE(p28r11_request_line_run);
					N: XIC(p28r11_slitter_on)XIC(p25r11_request_thread_fwd)OTE(p28r11_request_thread_fwd);
					N: XIC(p28r11_slitter_on)XIC(p25r11_request_thread_rev)OTE(p28r11_request_thread_rev);
					N: XIC(p01r09_request_line_jog)OTE(p28r11_request_line_jog);
					RC: "Outputs";
					N: OTE(p28r11.comment.5);
					N: [XIC(p28r11_request_line_run) ,XIC(p28r11_request_line_jog) ,XIC(p28r11_request_thread_fwd) ]OTE(p28_do_sltr.forward);
					N: XIC(p28r11_request_thread_rev)OTE(p28_do_sltr.reverse);
					N: XIC(p01r09_pb_global_reset)OTE(p28_do_sltr.fault_reset);
					RC: "Speed Control";
					N: OTE(p28r11.comment.6);
					N: XIC(p01r13_line_running)CPT(p28_ao_sltr_selected_speed,p01r12_master_ramped_speed+(p01r12_master_ramped_speed/100*p01_recipe_active.slitter_speed_sp));
					N: [XIC(p28r11_request_line_jog) ,XIC(p28r11_request_thread_fwd) ,XIC(p28r11_request_thread_rev) ]MOV(p01r12_master_ramped_speed,p28_ao_sltr_selected_speed);
					N: XIO(p01r13_line_running)XIO(p28r11_request_line_jog)XIO(p28r11_request_thread_fwd)XIO(p28r11_request_thread_rev)MOV(0,p28_ao_sltr_selected_speed);
					RC: "Faults";
					N: OTE(p28r11.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p28r11.fault,p28r11.fault_ack);
					N: XIC(p28_di_slitter.faulted)[TON(p28r11_timer_fault[0],?,?) ,XIC(p28r11_timer_fault[0].DN) OTL(p28r11.fault.0) ];
					N: XIC(p28r11.fault_ack.0)XIO(p28_di_slitter.faulted)XIC(p01r09_pb_global_reset)[OTU(p28r11.fault.0) ,OTU(p28r11.fault_ack.0) ];
					N: XIO(p28_di_slitter.ready)[TON(p28r11_timer_fault[2],?,?) ,XIC(p28r11_timer_fault[2].DN) OTL(p28r11.fault.2) ];
					N: XIC(p28r11.fault_ack.2)XIC(p28_di_slitter.ready)XIC(p01r09_pb_global_reset)[OTU(p28r11.fault.2) ,OTU(p28r11.fault_ack.2) ];
					N: XIC(p28_di_slitter.ready)XIO(p28_di_slitter.ctrl_from_net)[TON(p28r11_timer_fault[3],?,?) ,XIC(p28r11_timer_fault[3].DN) OTL(p28r11.fault.3) ];
					N: XIC(p28r11.fault_ack.3)[XIC(p28_di_slitter.ctrl_from_net) ,XIO(p28_di_slitter.ready) ]XIC(p01r09_pb_global_reset)[OTU(p28r11.fault.3) ,OTU(p28r11.fault_ack.3) ];
					N: XIO(p28_di_motor)[TON(p28r11_timer_fault[4],?,?) ,XIC(p28r11_timer_fault[4].DN) OTL(p28r11.fault.4) ];
					N: XIC(p28r11.fault_ack.4)XIC(p28_di_motor)XIC(p01r09_pb_global_reset)[OTU(p28r11.fault.4) ,OTU(p28r11.fault_ack.4) ];
					N: XIO(p28_di_brake)[TON(p28r11_timer_fault[5],?,?) ,XIC(p28r11_timer_fault[5].DN) OTL(p28r11.fault.5) ];
					N: XIC(p28r11.fault_ack.5)XIC(p28_di_brake)XIC(p01r09_pb_global_reset)[OTU(p28r11.fault.5) ,OTU(p28r11.fault_ack.5) ];
					N: NEQ(p28r11.fault,p28r11.fault_ack)OTE(p28r11.unack_fault);
					RC: "Warnings$N"
					    "These warnings will stop the line";
					N: OTE(p28r11.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p28r11.warning,p28r11.warning_ack);
					N: XIC(p28_di_slitter.warning)[TON(p28r11_timer_warning[0],?,?) ,XIC(p28r11_timer_warning[0].DN) OTL(p28r11.warning.0) ];
					N: XIO(p28_di_slitter.warning)[OTU(p28r11.warning.0) ,OTU(p28r11.warning_ack.0) ];
					N: NEQ(p28r11.warning,p28r11.warning_ack)OTE(p28r11.unack_warning);
			END_ROUTINE

	END_PROGRAM

