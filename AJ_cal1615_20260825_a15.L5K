					N: MOV(p19_param_pid2_ki,p19_real_to_hmi[49])MOV(p19_param_pid2_kd,p19_real_to_hmi[50])MOV(p19_param_pid2_ff,p19_real_to_hmi[51]);
					N: MOV(0,p19_real_to_hmi[52])MOV(0.0,p19_real_to_hmi[53])MOV(p19_param_tc01_dev,p19_real_to_hmi[54]);
					N: MOV(0,p19_real_to_hmi[55])MOV(0,p19_real_to_hmi[56])MOV(0,p19_real_to_hmi[57]);
					N: MOV(p19_param_zone_pressure,p19_real_to_hmi[58])MOV(0,p19_real_to_hmi[59])MOV(0,p19_real_to_hmi[60]);
					N: MOV(0,p19_real_to_hmi[61])MOV(0,p19_real_to_hmi[62])MOV(0,p19_real_to_hmi[63]);
