					N: JSR(R08_Warnings,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p11R02$N"
					    "This routine is called, continuously, from p11R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p11r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r02.comment (dint)$N"
					    "p11r02.oneshot (dint)$N"
					    "p11r02_timer_xxxx (timer)$N"
