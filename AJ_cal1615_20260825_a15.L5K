			ROUTINE R01_Main 
					RC: "p29r01 Main$N"
					    "$N"
					    "This routine is called, continuously, from p29 System while the plc is in Run mode.  All other p29 System routines are called from this routine.";
					N: OTE(p29r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r01.comment (dint)$N"
					    "p29r01.oneshot (dint)$N"
					    "p29r01_timer_xxxx (timer)$N"
					    "p29r01_xxxx (any)$N"
					    "p29r01.fault (dint)$N"
					    "p29r01.warning (dint)$N"
					    "";
					N: OTE(p29r01.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r01.comment.2);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R03_Input,0);
					N: JSR(R04_Output,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Winder_A_Speed_Control,0);
					N: JSR(R11_Winder_B_Speed_Control,0);
					N: JSR(R15_Winder_A_VFD,0);
					N: JSR(R16_Winder_B_VFD,0);
					N: JSR(R14_Winder_Common,0);
					N: JSR(R17_Winder_A_diameter_calc,0);
					N: JSR(R18_Winder_B_diameter_calc,0);
					N: JSR(R20_Winder_Turret_VFD,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p29R02$N"
					    "This routine is called, continuously, from p29R01 Main while the plc is in Run mode.";
					N: SBR()OTE(p29r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r02.comment (dint)$N"
					    "p29r02.oneshot (dint)$N"
					    "p29r02_timer_xxxx (timer)$N"
					    "p29r02_xxxx (any)$N"
					    "p29r02.fault (dint)$N"
					    "p29r02a_warnings (dint)$N"
					    "";
					N: OTE(p29r02.comment.1);
					RC: "Notes";
					N: OTE(p29r02.comment.2);
					N: NEQ(p29_dint_to_hmi[2],0)OTE(p29r02_fault_exists);
					N: NEQ(p29_dint_to_hmi[4],0)OTE(p29r02_warning_exists);
					N: SUB(p01_recipe_active.winder_tension_sp,p01_recipe_active.tension_deviation_sp,p29r02_tension_dev_min)ADD(p01_recipe_active.winder_tension_sp,p01_recipe_active.tension_deviation_sp,p29r02_tension_dev_max);
					RC: "Requests";
					N: OTE(p29r02.comment.3);
					N: [XIC(p29r02.unack_fault) ,XIC(p29r03.unack_fault) ,XIC(p29r04.unack_fault) ,XIC(p29r05.unack_fault) ,XIC(p29r06.unack_fault) ,XIC(p29r07.unack_fault) ,XIC(p29r08.unack_fault) ,XIC(p29r09.unack_fault) ,XIC(p29r10.unack_fault) ,XIC(p29r15.unack_fault) ,XIC(p29r16.unack_fault) ,XIC(p29r17.unack_fault) ,XIC(p29r18.unack_fault) ,XIC(p29r20.unack_fault) ]OTE(p29r02_unack_fault);
					N: [XIC(p29r02.unack_warning) ,XIC(p29r03.unack_warning) ,XIC(p29r04.unack_warning) ,XIC(p29r05.unack_warning) ,XIC(p29r06.unack_warning) ,XIC(p29r07.unack_warning) ,XIC(p29r08.unack_warning) ,XIC(p29r09.unack_warning) ,XIC(p29r10.unack_warning) ,XIC(p29r15.unack_warning) ,XIC(p29r16.unack_warning) ,XIC(p29r17.unack_warning) ,XIC(p29r18.unack_warning) ,XIC(p29r20.unack_warning) ]OTE(p29r02_unack_warning);
					RC: "Sequence";
					N: OTE(p29r02.comment.4);
					N: CPT(p29r02_wa_calc_torque_ref,p01_recipe_active.winder_torque_sp/3*p29r17_winder_a_avg_diam_inch);
					N: CPT(p29r02_wb_calc_torque_ref,p01_recipe_active.winder_torque_sp/3*p29r18_winder_b_avg_diam_inch);
					RC: "Output Control";
					N: OTE(p29r02.comment.5);
					N: [XIC(p29r15_wdra_active) ,XIC(p29r16_wdrb_active) ]TOF(p29r02_winder_selection_dwell,?,?);
					RC: "Faults";
					N: OTE(p29r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r02.fault,p29r02.fault_ack);
					N: XIC(FAULT)[TON(p29r02_timer_fault[0],?,?) ,XIC(p29r02_timer_fault[0].DN) OTL(p29r02.fault.0) ];
					N: XIC(p29r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r02.fault.0) ,OTU(p29r02.fault_ack.0) ];
					N: NEQ(p29r02.fault,p29r02.fault_ack)OTE(p29r02.unack_fault);
					RC: "Warnings";
					N: OTE(p29r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r02.warning,p29r02.warning_ack);
					N: XIC(FAULT)[TON(p29r02_timer_warning[0],?,?) ,XIC(p29r02_timer_warning[0].DN) OTL(p29r02.warning.0) ];
					N: XIO(FAULT)[OTU(p29r02.warning.0) ,OTU(p29r02.warning_ack.0) ];
					N: NEQ(p29r02.warning,p29r02.warning_ack)OTE(p29r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p29r03$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r03.comment (dint)$N"
					    "p29r03.oneshot (dint)$N"
					    "p29r03_timer_xxxx (timer)$N"
					    "p29r03_xxxx (any)$N"
					    "p29r03.fault (dint)$N"
					    "p29r03.warning (dint)$N"
					    "";
					N: OTE(p29r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r03.comment.2);
					RC: "Digital";
					N: OTE(p29r03.comment.3);
					N: [XIC(p00_io_winder:6:I.1) OTE(p29_di_wdr_a) ,XIC(p00_io_winder:6:I.2) OTE(p29_di_wdr_a_core_size) ,XIC(p00_io_winder:6:I.3) OTE(p29_di_wdr_a_reset_core) ,XIC(p00_io_winder:6:I.4) OTE(p29_di_wdr_a_start) ];
					N: [XIC(p00_io_winder:6:I.5) OTE(p29_di_wdr_a_stop) ,XIC(p00_io_winder:6:I.6) OTE(p29_di_wdr_b_core_size) ,XIC(p00_io_winder:6:I.7) OTE(p29_di_wdr_b_reset_core) ,XIC(p00_io_winder:6:I.8) OTE(p29_di_wdr_b_start) ];
					N: [XIC(p00_io_winder:6:I.9) OTE(p29_di_wdr_b_stop) ,XIC(p00_io_winder:6:I.10) OTE(p29_di_wdr_index_fwd) ,XIC(p00_io_winder:6:I.11) OTE(p29_di_wdr_jog) ,XIC(p00_io_winder:6:I.13) OTE(p289_di_turret_in_position_bit_1) ,XIC(p00_io_winder:6:I.14) OTE(p289_di_turret_in_position_bit_2) ,XIC(p00_io_winder:6:I.15) OTE(p289_di_turret_in_position_bit_3) ];
					N: [XIC(p00_io_line:3:I.0) OTE(p29_di_wa_motor) ,XIC(p00_io_line:3:I.1) OTE(p29_di_wa_brake) ,XIC(p00_io_line:3:I.2) OTE(p29_di_wb_motor) ,XIC(p00_io_line:3:I.1) OTE(p29_di_wb_brake) ,XIC(p00_io_line:2:I.15) OTE(p29_di_wt_motor) ];
					RC: "VFD Inputs";
					N: MOV(p00_vfd_wda:I.Data[0],p29_wda_status_word);
					N: XIC(p01r02.fault.16)FLL(0,p00_vfd_wdr_turret:I.Data[0],4);
					N: XIC(p01r02.fault.17)FLL(0,p00_vfd_wda:I.Data[0],4);
					N: XIC(p01r02.fault.18)FLL(0,p00_vfd_wdb:I.Data[0],4);
					N: MOV(p00_vfd_wdb:I.Data[0],p29_wdb_status_word);
					N: [XIC(p00_vfd_wdr_turret:I.Data[0].0) OTE(p29_di_wdr_turret.faulted) ,XIC(p00_vfd_wdr_turret:I.Data[0].1) OTE(p29_di_wdr_turret.warning) ,XIC(p00_vfd_wdr_turret:I.Data[0].2) OTE(p29_di_wdr_turret.running_fwd) ,XIC(p00_vfd_wdr_turret:I.Data[0].3) OTE(p29_di_wdr_turret.running_rev) ];
					N: [XIC(p00_vfd_wdr_turret:I.Data[0].4) OTE(p29_di_wdr_turret.ready) ,XIC(p00_vfd_wdr_turret:I.Data[0].5) OTE(p29_di_wdr_turret.ctrl_from_net) ,XIC(p00_vfd_wdr_turret:I.Data[0].6) OTE(p29_di_wdr_turret.ref_from_net) ,XIC(p00_vfd_wdr_turret:I.Data[0].7) OTE(p29_di_wdr_turret.at_reference) ];
					RC: "Analog";
					N: OTE(p29r03.comment.4);
					N: SYS_SCP(p29r03_wdr_dia_sensor_scp,p00_io_winder:2:I.Ch5Data,p29_wdr_diameter_input_min,p29_wdr_diameter_input_max,p29_wdr_diameter_output_min,p29_wdr_diameter_output_max,p29r03_sensor_input);
					N: SUB(p29r03_distance_to_core,p29r03_sensor_input,p29_ai_radius)CPT(p29_ai_wdr_dia_in,p29_ai_radius*2);
					N: CPT(p29_ai_wa_dia_ft,p29r17_winder_a_avg_diam_inch/12);
					N: CPT(p29_ai_wb_dia_ft,p29r18_winder_b_avg_diam_inch/12);
					N: SYS_SCP(p29r03_liner_wdr_lc_scp,IN_ai_lc01,p29_wdr_lc_input_min,p29_wdr_lc_input_max,p29_wdr_lc_output_min,p29_wdr_lc_output_max,p29_ai_wdr_lc);
					N: CPT(p29_ai_wdr_lc,p29_ai_wdr_lc*p29_param_lc_cal_factor);
					N: SYS_SCP(p29r03_wa_footage_scp,Local:3:I.Ch6Data,p29_wa_footage_input_min,p29_wa_footage_input_max,p29_wa_footage_output_min,p29_wa_footage_output_max,p29r13_ai_wa_footage_ft);
					N: SYS_SCP(p29r03_wb_footage_scp,Local:3:I.Ch7Data,p29_wb_footage_input_min,p29_wb_footage_input_max,p29_wb_footage_output_min,p29_wb_footage_output_max,p29r13_ai_wb_footage_ft);
					RC: "VFD";
					N: OTE(p29r03.comment.5);
					N: SYS_SCP(p29r03_wda_vfd_in_scaling,p00_vfd_wda:I.Data[1],p29r03_wda_vfd_input_min,p29r03_wda_vfd_input_max,p29r03_wda_vfd_output_min,p29r03_wda_vfd_output_max,p29r03_wa_scaled_vfd_in);
					N: SYS_RPM_TO_SPEED(p29r03_wa_speed_fb,p29_param_wa_gear_ratio,p29_ai_wa_dia_ft,p29r03_wa_scaled_vfd_in,p29_ai_wa_speed);
					N: CPT(p29_ai_wa_rpm,p29r03_wa_scaled_vfd_in*1);
					N: CPT(p29_ai_wa_amps,p00_vfd_wda:I.Data[2]*0.1);
					N: CPT(p29_ai_wa_torque,p00_vfd_wda:I.Data[3]*0.01);
					N: CPT(p29_ao_wa_torque_ref,p01_recipe_active.winder_tension_sp*p29r17_winder_a_avg_diam_inch*1.7/1220.64/6*100+10);
					N: XIO(p29r03_sample_timer.DN)TON(p29r03_sample_timer,?,?);
					N: XIC(p29r03_sample_timer.DN)[XIC(p29r03_wa_tq_fifo.DN) FFU(p29r03_wa_tq_buffer[0],p29r03_unload,p29r03_wa_tq_fifo,?,?) ,FFL(p29_ai_wa_torque,p29r03_wa_tq_buffer[0],p29r03_wa_tq_fifo,?,?) ,XIC(p29r03_wa_tq_fifo.DN) AVE(p29r03_wa_tq_buffer[0],0,p29r03_wa_ave_tq,p29r03_wa_tq_ave_ctrl,?,?) ];
					N: XIC(p29r03_wa_tq_fifo.ER)OTU(p29r03_wa_tq_fifo.ER);
					N: XIC(p29r03_wa_tq_ave_ctrl.ER)OTU(p29r03_wa_tq_ave_ctrl.ER);
					N: MOV(p29r03_wa_ave_tq,p29_ai_wa_torque);
					N: SYS_SCP(p29r03_hz,p00_vfd_wda:I.Data[1],0,2000,0,60,p29_ai_wa_hz);
					RC: "Winder B";
					N: NOP();
					N: sys_ACS880_inputs(add_sys_acs880_input_wdb,p00_vfd_wdb:I,vfd_wdb,vfd_status,p29_ai_wb_rpm,p29_ai_wb_amps,p29_ai_wb_hz,p29_ai_wb_torque,p29_ai_wb_speed,p29_ai_wb_dia_ft,p29_param_wb_gear_ratio);
					N: CPT(p29_ao_wb_torque_ref,p01_recipe_active.winder_tension_sp*p29r18_winder_b_avg_diam_inch*1.7/1220.64/6*100+10);
					N: XIC(p29r03_sample_timer.DN)[XIC(p29r03_wb_tq_fifo.DN) FFU(p29r03_wb_tq_buffer[0],p29r03_unload,p29r03_wb_tq_fifo,?,?) ,FFL(p29_ai_wb_torque,p29r03_wb_tq_buffer[0],p29r03_wb_tq_fifo,?,?) ,XIC(p29r03_wb_tq_fifo.DN) AVE(p29r03_wb_tq_buffer[0],0,p29r03_wb_ave_tq,p29r03_wb_tq_ave_ctrl,?,?) ];
					N: XIC(p29r03_wb_tq_fifo.ER)OTU(p29r03_wb_tq_fifo.ER);
					N: XIC(p29r03_wb_tq_ave_ctrl.ER)OTU(p29r03_wb_tq_ave_ctrl.ER);
					N: MOV(p29r03_wb_ave_tq,p29_ai_wb_torque);
					RC: "Winder Turret";
					N: NOP();
					N: XIC(p289_di_turret_in_position_bit_1)XIO(p289_di_turret_in_position_bit_2)XIC(p289_di_turret_in_position_bit_3)OTE(pb_wa_doff_position)OTE(di_request_move_a_to_doff);
					N: XIC(p289_di_turret_in_position_bit_1)XIO(p289_di_turret_in_position_bit_2)XIO(p289_di_turret_in_position_bit_3)OTE(pb_wa_run_position)OTE(di_request_move_a_to_run);
					N: XIC(p289_di_turret_in_position_bit_1)XIC(p289_di_turret_in_position_bit_2)XIC(p289_di_turret_in_position_bit_3)OTE(pb_wb_doff_position)OTE(di_request_move_b_to_doff);
					N: XIC(p289_di_turret_in_position_bit_1)XIC(p289_di_turret_in_position_bit_2)XIO(p289_di_turret_in_position_bit_3)OTE(pb_wb_run_position)OTE(di_request_move_b_to_run);
					N: CPT(p29_ai_wdr_turret_speed,p00_vfd_wdr_turret:I.Data[1]*1);
					N: CPT(p29_ai_wdr_turret_amps,p00_vfd_wdr_turret:I.Data[2]*1);
					N: SYS_SCP(p29r03_hz,p00_vfd_wdr_turret:I.Data[1],0,2000,0,60,p29_ai_wdr_turret_hz);
					RC: "New Winder";
					N: NOP();
					N: GSV(MODULE,p00_vfd_wdb,EntryStatus,vfd_status);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p29r04$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r04.comment (dint)$N"
					    "p29r04.oneshot (dint)$N"
					    "p29r04_timer_xxxx (timer)$N"
					    "p29r04_xxxx (any)$N"
					    "p29r04.fault (dint)$N"
					    "p29r04.warning (dint)$N"
					    "";
					N: OTE(p29r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r04.comment.2);
					RC: "Digital";
					N: OTE(p29r04.comment.3);
					N: MOV(p29_wda_control_word,p00_vfd_wda:O.Data[0]);
					N: [XIC(p29_do_wdr_turret.forward) OTE(p00_vfd_wdr_turret:O.Data[0].0) ,XIC(p29_do_wdr_turret.reverse) OTE(p00_vfd_wdr_turret:O.Data[0].1) ,XIC(p29_do_wdr_turret.fault_reset) OTE(p00_vfd_wdr_turret:O.Data[0].2) ,OTE(p00_vfd_wdr_turret:O.Data[0].5) ,OTE(p00_vfd_wdr_turret:O.Data[0].6) ];
					N: [XIC(p29r20_index_complete) OTE(p00_io_winder:4:O.2) ,XIC(p29r15_wdra_active) OTE(p00_io_winder:4:O.3) ,XIC(p29r16_wdrb_active) OTE(p00_io_winder:4:O.4) ];
					RC: "Analog";
					N: OTE(p29r04.comment.4);
					RC: "VFD";
					N: OTE(p29r04.comment.5);
					N: SYS_SPEED_TO_VFD(p29r04_wdra_speed_to_vfd,p29_param_wa_gear_ratio,p29_ai_wa_dia_ft,p29_ao_wdra_selected_speed,p29_ao_wda_vfd);
					N: SYS_SCP(p29r04_wda_vfd_out_scaling,p29_ao_wda_vfd,p29_wda_vfd_input_min,p29_wda_vfd_input_max,p29_wda_vfd_output_min,p29_wda_vfd_output_max,p00_vfd_wda:O.Data[1]);
					N: CPT(p00_vfd_wda:O.Data[2],p29r15_ao_torque*100);
					RC: "Winder B";
					N: NOP();
					N: sys_ACS880_Outputs(add_sys_acs880_wdr_outputs,p00_vfd_wdb:O,vfd_wdb,p29_param_wb_gear_ratio,p29_ai_wb_dia_ft,p29_ao_wdrb_selected_speed);
					N: MUL(p29r16_ao_torque,10,OUT_ao_wdr_torque);
					RC: "Turret";
					N: NOP();
					N: SYS_SPEED_TO_VFD(p29r04_wdr_turret_speed_to_vfd,p29_param_wdt_gear_ratio,p01_param_turret_dia_ft,p29_ao_wdr_turret_selected_speed,p00_vfd_wdr_turret:O.Data[1]);
					RC: "Faults";
					N: OTE(p29r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r04.fault,p29r04.fault_ack);
					N: XIC(FAULT)[TON(p29r04_timer_fault[0],?,?) ,XIC(p29r04_timer_fault[0].DN) OTL(p29r04.fault.0) ];
					N: XIC(p29r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r04.fault.0) ,OTU(p29r04.fault_ack.0) ];
					N: NEQ(p29r04.fault,p29r04.fault_ack)OTE(p29r04.unack_fault);
					RC: "Warnings";
					N: OTE(p29r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r04.warning,p29r04.warning_ack);
					N: XIC(FAULT)[TON(p29r04_timer_warning[0],?,?) ,XIC(p29r04_timer_warning[0].DN) OTL(p29r04.warning.0) ];
					N: XIO(FAULT)[OTU(p29r04.warning.0) ,OTU(p29r04.warning_ack.0) ];
					N: NEQ(p29r04.warning,p29r04.warning_ack)OTE(p29r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p29r05$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r05.comment (dint)$N"
					    "p29r05.oneshot (dint)$N"
					    "p29r05_timer_xxxx (timer)$N"
					    "p29r05_xxxx (any)$N"
					    "p29r05.fault (dint)$N"
					    "p29r05.warning (dint)$N"
					    "";
					N: OTE(p29r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r05.comment.2);
					RC: "Digital IO";
					N: OTE(p29r05.comment.3);
					N: [XIC(p29r15_wdra_active) OTE(p29_dint_to_hmi[0].0) ,XIC(p29r16_wdrb_active) OTE(p29_dint_to_hmi[0].1) ,XIC(turret_in_position) OTE(p29_dint_to_hmi[0].2) ,XIC(HMI) OTE(p29_dint_to_hmi[0].3) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[0].4) ,XIC(HMI) OTE(p29_dint_to_hmi[0].5) ,XIC(HMI) OTE(p29_dint_to_hmi[0].6) ,XIC(HMI) OTE(p29_dint_to_hmi[0].7) ];
					N: MOV(p29_wda_status_word,p29_dint_to_hmi[1]);
					N: MOV(p29_wdb_status_word,p29_dint_to_hmi[3]);
