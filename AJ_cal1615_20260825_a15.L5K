			ROUTINE R05_Dint_to_HMI 
					RC: "p19r05$N"
					    "This routine is called, continuously, from p19R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p19r05.comment.0);
