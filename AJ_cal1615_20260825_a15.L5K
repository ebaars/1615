					N: [XIC(HMI) OTE(p19_dint_to_hmi[0].8) ,XIC(HMI) OTE(p19_dint_to_hmi[0].9) ,XIC(HMI) OTE(p19_dint_to_hmi[0].10) ,XIC(HMI) OTE(p19_dint_to_hmi[0].11) ];
