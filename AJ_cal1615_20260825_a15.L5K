					N: [XIC(p22_di_close_nip_roll) ,XIO(p22_di_close_nip_roll) XIO(p22_di_open_nip_roll) [XIC(p20r13_state.2) ,XIC(p22_do_close_nip_roll) ] XIO(p22r02_nip_open) ]XIC(p01r09_estop_ok)OTE(p22_do_close_nip_roll);
