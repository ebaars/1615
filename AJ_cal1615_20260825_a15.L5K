			ROUTINE R09_Modes 
					RC: "p27r09$N"
					    "This routine is called, continuously, from p27r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p27r09.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p27r09.comment (dint)$N"
					    "p27r09.oneshot (dint)$N"
					    "p27r09_timer_xxxx (timer)$N"
					    "p27r09_xxxx (any)$N"
					    "p27r09.fault (dint)$N"
					    "p27r09.warning (dint)$N"
					    "";
					N: OTE(p27r09.comment.1);
					RC: "Tension Mode";
					N: OTE(p27r09.comment.2);
					N: SYS_Toggle(p27r09_a_enable_toggle,p02_dint_from_hmi.lpl[0].0,p27r05_lla_mode_tension);
					N: SYS_Toggle(p27r09_b_enable_toggle,p02_dint_from_hmi.lpl[0].2,p27r05_llb_mode_tension);
					RC: "Edge Guide Modes";
					N: OTE(p27r09.comment.3);
					RC: "Auto Start Sequence";
					N: OTE(p27r09.comment.4);
					RC: "Output Control";
					N: OTE(p27r09.comment.5);
					RC: "Faults";
					N: OTE(p27r09.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p27r09.fault,p27r09.fault_ack);
					N: XIC(FAULT)[TON(p27r09_timer_fault[0],?,?) ,XIC(p27r09_timer_fault[0].DN) OTL(p27r09.fault.0) ];
					N: XIC(p27r09.fault_ack.0)XIC(FAULT)XIC(p01r09_pb_global_reset)[OTU(p27r09.fault.0) ,OTU(p27r09.fault_ack.0) ];
					N: NEQ(p27r09.fault,p27r09.fault_ack)OTE(p27r09.unack_fault);
					RC: "Warnings";
					N: OTE(p27r09.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p27r09.warning,p27r09.warning_ack);
					N: XIC(FAULT)[TON(p27r09_timer_warning[0],?,?) ,XIC(p27r09_timer_warning[0].DN) OTL(p27r09.warning.0) ];
					N: XIO(FAULT)[OTU(p27r09.warning.0) ,OTU(p27r09.warning_ack.0) ];
					N: NEQ(p27r09.warning,p27r09.warning_ack)OTE(p27r09.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R10_Tension 
					RC: "p27r10$N"
					    "This routine is called, continuously, from p27R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p27r10.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p27r10.comment (dint)$N"
					    "p27r10.oneshot (dint)$N"
					    "p27r10_timer_xxxx (timer)$N"
					    "p27r10_xxxx (any)$N"
					    "p27r10.fault (dint)$N"
					    "p27r10a_warnings (dint)$N"
					    "";
					N: OTE(p27r10.comment.1);
					RC: "Notes";
					N: OTE(p27r10.comment.2);
					RC: "Requests";
					N: OTE(p27r10.comment.3);
					N: XIC(p27r03_lower_A_tension_on)MOV(p01_recipe_active.lower_poly_tension_sp,p27r10_lla_selected_tension);
					N: XIC(p27r03_lower_B_tension_on)MOV(p01_recipe_active.lower_poly_b_tension_sp,p27r10_llb_selected_tension);
					N: XIO(p27r03_lower_A_tension_on)MOV(p27_inactive_tension_sp,p27r10_lla_selected_tension);
					N: XIO(p27r03_lower_B_tension_on)MOV(p27_inactive_tension_sp,p27r10_llb_selected_tension);
					N: CPT(p27r10_unwind_a_dia_ft,p27_ao_dia_a/12);
					N: CPT(p27r10_unwind_b_dia_ft,p27_ao_dia_b/12);
					N: CPT(p27r10_unwind_a_brake_torque,p27r10_unwind_a_dia_ft/2*p27r10_lla_selected_tension);
					N: CPT(p27r10_unwind_b_brake_torque,p27r10_unwind_b_dia_ft/2*p27r10_llb_selected_tension);
					RC: "Output Control";
					N: OTE(p27r10.comment.5);
					RC: "Faults";
					N: OTE(p27r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p27r10.fault,p27r10.fault_ack);
					N: XIC(FAULT)[TON(p27r10_timer_fault[0],?,?) ,XIC(p27r10_timer_fault[0].DN) OTL(p27r10.fault.0) ];
					N: XIC(p27r10.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p27r10.fault.0) ,OTU(p27r10.fault_ack.0) ];
					N: NEQ(p27r10.fault,p27r10.fault_ack)OTE(p27r10.unack_fault);
					RC: "Warnings";
					N: OTE(p27r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p27r10.warning,p27r10.warning_ack);
					N: XIC(FAULT)[TON(p27r10_timer_warning[0],?,?) ,XIC(p27r10_timer_warning[0].DN) OTL(p27r10.warning.0) ];
					N: XIO(FAULT)[OTU(p27r10.warning.0) ,OTU(p27r10.warning_ack.0) ];
					N: NEQ(p27r10.warning,p27r10.warning_ack)OTE(p27r10.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

