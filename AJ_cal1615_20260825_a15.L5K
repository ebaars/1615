					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p22r03$N"
					    "This routine is called, continuously, from p22r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p22r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r03.comment (dint)$N"
					    "p25r03.oneshot (dint)$N"
					    "p25r03_timer_xxxx (timer)$N"
					    "p25r03_xxxx (any)$N"
					    "p25r03.fault (dint)$N"
					    "p25r03.warning (dint)$N"
					    "";
					N: OTE(p22r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p22r03.comment.2);
					RC: "Digital";
					N: OTE(p22r03.comment.3);
					N: [XIC(p00_io_letoff:6:I.3) OTE(p22_di_jog_fwd) ,XIC(p00_io_letoff:6:I.4) OTE(p22_di_jog_rev) ,XIC(p00_io_letoff:6:I.5) OTE(p22_di_jog) ,XIC(p00_io_letoff:6:I.6) OTE(p22_di_run) ,XIC(p00_io_letoff:6:I.7) OTE(p22_di_open_nip_roll) ,XIC(p00_io_letoff:6:I.8) OTE(p22_di_close_nip_roll) ];
					N: [XIC(p00_io_line:2:I.5) OTE(p22_di_therm) ,XIC(p00_io_line:2:I.6) OTE(p22_di_brake) ];
					RC: "VFD Inputs";
					N: MOV(p00_vfd_ts1:I.Data[0],p22_status_word);
					N: XIC(p01r02.fault.10)FLL(0,p00_vfd_ts1:I.Data[0],4);
					RC: "Analog";
					N: OTE(p22r03.comment.4);
					N: SYS_SCP(p22r03_lc_scp,Local:3:I.Ch0Data,p22r03_lc_input_min,p22r03_lc_input_max,p22r03_lc_output_min,p22r03_lc_output_max,p22_ai_ts1_lc);
					RC: "VFD";
					N: OTE(p22r03.comment.5);
					N: SYS_SCP(p22r03_vfd_in_scaling,p00_vfd_ts1:I.Data[1],p22r03_vfd_input_min,p22r03_vfd_input_max,p22r03_vfd_output_min,p22r03_vfd_output_max,p22r03_scaled_vfd_in);
					N: SYS_RPM_TO_SPEED(p22R03_ts1_vfd_rpm_to_speed,p22_ts1_gear_ratio,p22_ts1_roll_diameter_ft,p22r03_scaled_vfd_in,p22_ai_speed);
					N: CPT(p22_ai_amps,p00_vfd_ts1:I.Data[2]*0.1);
					N: CPT(p22_ai_torque,p00_vfd_ts1:I.Data[3]*0.01);
					N: XIO(p22r03_sample_timer.DN)TON(p22r03_sample_timer,?,?);
					N: XIC(p22r03_sample_timer.DN)[XIC(p22r03_tq_fifo.DN) FFU(p22r03_tq_buffer[0],p22r03_unload,p22r03_tq_fifo,?,?) ,FFL(p22_ai_torque,p22r03_tq_buffer[0],p22r03_tq_fifo,?,?) ,XIC(p22r03_tq_fifo.DN) AVE(p22r03_tq_buffer[0],0,p22r03_ave_tq,p22r03_tq_ave_ctrl,?,?) ];
					N: XIC(p22r03_tq_fifo.ER)OTU(p22r03_tq_fifo.ER);
					N: XIC(p22r03_tq_ave_ctrl.ER)OTU(p22r03_tq_ave_ctrl.ER);
					N: MOV(p22r03_ave_tq,p22_ai_torque);
					N: SYS_SCP(p22r03_hz,p00_vfd_ts1:I.Data[1],0,2000,0,60,p22_ai_hz);
					RC: "Faults";
					N: OTE(p22r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p22r03.fault,p22r03.fault_ack);
					N: XIC(FAULT)[TON(p22r03_timer_fault[0],?,?) ,XIC(p22r03_timer_fault[0].DN) OTL(p22r03.fault.0) ];
					N: XIC(p22r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p22r03.fault.0) ,OTU(p22r03.fault_ack.0) ];
					N: XIC(FAULT)[TON(p22r03_timer_fault[1],?,?) ,XIC(p22r03_timer_fault[1].DN) OTL(p22r03.fault.1) ];
					N: XIC(p22r03.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p22r03.fault.1) ,OTU(p22r03.fault_ack.1) ];
					N: NEQ(p22r03.fault,p22r03.fault_ack)OTE(p22r03.unack_fault);
					RC: "Warnings";
					N: OTE(p22r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p22r03.warning,p22r03.warning_ack);
					N: XIC(FAULT)[TON(p22r03_timer_warning[0],?,?) ,XIC(p22r03_timer_warning[0].DN) OTL(p22r03.warning.0) ];
					N: XIO(FAULT)[OTU(p22r03.warning.0) ,OTU(p22r03.warning_ack.0) ];
					N: NEQ(p22r03.warning,p22r03.warning_ack)OTE(p22r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p22r04$N"
					    "This routine is called, continuously, from p22r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p22r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p22r04.comment (dint)$N"
					    "p22r04.oneshot (dint)$N"
					    "p22r04_timer_xxxx (timer)$N"
					    "p22r04_xxxx (any)$N"
