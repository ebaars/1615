					N: XIC(p20r18_index_complete)[XIC(p20r15_request_tension) ,XIC(p20r16_request_tension) ][TON(p20r17_timer[0],?,?) ,OTE(p20r17_diameter_clac_active) ];
					N: XIC(p20r17_diameter_clac_active)XIO(p20r17_timer[1].DN)TON(p20r17_timer[1],?,?);
					N: XIC(p20r17_diameter_clac_active)LIM(0,p20_ai_letoff_dia,30)[XIC(p20r17_stack_ctrl.DN) FFU(p20r17_letoff_diam_avg_stack[0],p20r17_winder_a_unload,p20r17_stack_ctrl,?,?) ,XIC(p20r17_timer[1].DN) FFL(p20_ai_letoff_dia,p20r17_letoff_diam_avg_stack[0],p20r17_stack_ctrl,?,?) ,XIC(p20r17_timer[1].DN) AVE(p20r17_letoff_diam_avg_stack[0],0,p20r17_letoff_avg_diam_inch,p20r17_ave_control,?,?) ];
					N: XIC(p20r17_ave_control.ER)OTU(p20r17_ave_control.ER);
					N: XIC(p20r17_stack_ctrl.ER)OTU(p20r17_stack_ctrl.ER);
					RC: "Output Control";
					N: OTE(p20r17.comment.5);
					RC: "Faults";
					N: OTE(p20r17.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r17.fault,p20r17.fault_ack);
					N: XIC(FAULT)[TON(p20r17_timer_fault[0],?,?) ,XIC(p20r17_timer_fault[0].DN) OTL(p20r17.fault.0) ];
					N: XIC(p20r17.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r17.fault.0) ,OTU(p20r17.fault_ack.0) ];
					N: NEQ(p20r17.fault,p20r17.fault_ack)OTE(p20r17.unack_fault);
					RC: "Warnings";
					N: OTE(p20r17.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r17.warning,p20r17.warning_ack);
					N: XIC(FAULT)[TON(p20r17_timer_warning[0],?,?) ,XIC(p20r17_timer_warning[0].DN) OTL(p20r17.warning.0) ];
					N: XIO(FAULT)[OTU(p20r17.warning.0) ,OTU(p20r17.warning_ack.0) ];
					N: NEQ(p20r17.warning,p20r17.warning_ack)OTE(p20r17.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R18_Letoff_Turret_VFD 
					RC: "p20r18$N"
					    "This routine is called, continuously, from p20r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r18.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r18.comment (dint)$N"
					    "p20r18.oneshot (dint)$N"
					    "p20r18_timer_xxxx (timer)$N"
					    "p20r18_xxxx (any)$N"
					    "p20r18.fault (dint)$N"
					    "p20r18.warning (dint)$N"
					    "";
					N: OTE(p20r18.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r18.comment.2);
					N: EQU(p20r18.fault,0)XIC(p20_di_clutch_prs_ok)OTE(p20r18_permissive);
					N: XIC(p20_di_turret_fwd)XIO(p20r18_pb_index_rev)OTE(p20r18_pb_index_fwd);
					N: XIC(p20_di_turret_rev)XIO(p20r18_pb_index_fwd)OTE(p20r18_pb_index_rev);
					RC: "Requests";
					N: OTE(p20r18.comment.4);
					N: [XIC(p20r18_pb_index_fwd) XIC(p20r18_zero_speed) ,XIC(p20r18_request_index_fwd) XIO(p20r18_zero_speed) ]XIC(p20_di_clutch_prs_ok)XIO(p20r18.state.7)XIO(p20r18_pb_index_rev)XIO(p20r18_request_index_rev)OTE(p20r18_request_index_fwd);
					N: [XIC(p20r18_pb_index_rev) XIC(p20r18_zero_speed) ,XIC(p20r18_request_index_rev) XIO(p20r18_zero_speed) ]XIC(p20_di_clutch_prs_ok)XIO(p20r18.state.8)XIO(p20r18_pb_index_fwd)XIO(p20r18_request_index_fwd)OTE(p20r18_request_index_rev);
					N: XIC(p20r18_permissive)[[XIC(p20r18.state.2) ,XIC(p20r18.state.3) ,XIC(p20r18.state.4) ] XIC(p20r18_zero_speed) ,XIC(p20_request_run_index_dir) XIO(p20r18_zero_speed) ]OTE(p20_request_run_index_dir);
					N: XIC(p20r18_permissive)[XIC(p20r18.state.6) XIC(p20r18_zero_speed) ,XIC(p20_request_run_index_rev_dir) XIO(p20r18_zero_speed) ]OTE(p20_request_run_index_rev_dir);
					RC: "Sequence";
					N: OTE(p20r18.comment.7);
					N: LEQ(p20_ao_lo_turret_selected_speed,0.1)OTE(p20r18_zero_speed);
					N: [XIC(S:FS) ,XIC(p20r18.state.8) XIC(p20r18.state.0) ,XIO(p20r18_pb_index_fwd) XIO(p20r18_pb_index_rev) ][MOV(0,p20r18.state) ,OTL(p20r18.state.1) ];
					N: XIC(p20r18.state.1)XIC(p20r18.state.0)[XIC(p20r18_request_index_fwd) XIC(p20r18_pb_index_fwd) ,XIC(p20r18_request_index_rev) XIC(p20r18_pb_index_rev) ][MOV(0,p20r18.state) ,OTL(p20r18.state.2) ];
					N: XIC(p20r18.state.2)XIC(p20r18.state.0)XIO(p20_di_turret_pos)[MOV(0,p20r18.state) ,OTL(p20r18.state.3) ];
					N: XIC(p20r18.state.3)XIC(p20r18.state.0)XIC(p20_di_turret_pos)[MOV(0,p20r18.state) ,OTL(p20r18.state.4) ];
					N: XIC(p20r18.state.4)XIC(p20r18.state.0)XIO(p20_di_turret_pos)[MOV(0,p20r18.state) ,OTL(p20r18.state.5) ];
					N: XIC(p20r18.state.5)XIC(p20r18.state.0)XIC(p20r18_zero_speed)[MOV(0,p20r18.state) ,OTL(p20r18.state.6) ];
					N: XIC(p20r18.state.6)XIC(p20r18.state.0)XIC(p20r18_index_move_timer.DN)XIC(p20_di_turret_pos)[MOV(0,p20r18.state) ,OTL(p20r18.state.7) ];
					N: XIC(p20r18.state.7)XIC(p20r18.state.0)XIO(p20r18_pb_index_fwd)XIO(p20r18_pb_index_rev)[MOV(0,p20r18.state) ,OTL(p20r18.state.8) ];
					N: [XIC(S:FS) XIC(p20_di_turret_pos) ,XIC(p20r18.state.7) ,XIC(p20r18_index_complete) ]XIO(p20r18.state.2)OTE(p20r18_index_complete);
					N: OTE(p20r18.state.0);
					RC: "Sequencer Conditions";
					N: OTE(p20r18.comment.5);
					N: MOV(p20r18_index_time_offset,p20r18_index_time_offset);
					N: [XIC(p20r18.state.4) ,XIC(p20r18.state.5) ][TON(p20r18_index_timer,?,?) ,XIC(p20r18.state.5) ONS(p20r18.oneshot.0) MOV(p20r18_index_timer.ACC,p20r18_index_time) CPT(p20r18_index_time,p20r18_index_time+p20r18_index_time_offset) ];
					N: XIC(p20r18.state.5)MOV(p20r18_index_time,p20r18_index_move_timer.PRE);
					N: XIC(p20r18.state.6)TON(p20r18_index_move_timer,?,?);
					RC: "Outputs";
					N: OTE(p20r18.comment.6);
					N: [XIC(p20r18_request_index_fwd) XIC(p20_request_run_index_dir) ,XIC(p20r18_request_index_rev) XIC(p20_request_run_index_rev_dir) ]OTE(p20_do_wdr_turret.forward);
					N: [XIC(p20r18_request_index_fwd) XIC(p20_request_run_index_rev_dir) ,XIC(p20r18_request_index_rev) XIC(p20_request_run_index_dir) ]OTE(p20_do_wdr_turret.reverse);
					N: XIC(p01r09_pb_global_reset)OTE(p20_do_wdr_turret.fault_reset);
					RC: "Speed Control";
					N: OTE(p20r18.comment.8);
					N: [XIC(p20r18.state.2) ,XIC(p20r18.state.3) ,XIC(p20r18.state.4) ]MOV(p20_param_lo_turret_index_speed,p20r18_selected_speed);
					N: XIC(p20r18.state.6)CPT(p20r18_selected_speed,p20_param_lo_turret_index_speed/2);
					N: XIO(p20r18.state.2)XIO(p20r18.state.3)XIO(p20r18.state.4)XIO(p20r18.state.6)MOV(0,p20r18_selected_speed);
					N: SYS_ACC_DEC_RAMP(p20r18_acc_dec_ramp,p20r18_selected_speed,p20r18_accel_rate,p20r18_decel_rate,p01r02_plc_scan_time_in_sec,p20_ao_lo_turret_selected_speed)MOV(p20_ao_lo_turret_selected_speed,p20_ao_lo_turret_selected_speed);
					RC: "Faults";
					N: OTE(p20r18.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r18.fault,p20r18.fault_ack);
					N: XIC(p20_di_lo_turret.faulted)[TON(p20r18_timer_fault[0],?,?) ,XIC(p20r18_timer_fault[0].DN) OTL(p20r18.fault.0) ];
					N: XIC(p20r18.fault_ack.0)XIO(p20_di_lo_turret.faulted)XIC(p01r09_pb_global_reset)[OTU(p20r18.fault.0) ,OTU(p20r18.fault_ack.0) ];
					N: XIO(p20_di_lo_turret.ready)[TON(p20r18_timer_fault[2],?,?) ,XIC(p20r18_timer_fault[2].DN) OTL(p20r18.fault.2) ];
					N: XIC(p20r18.fault_ack.2)XIC(p20_di_lo_turret.ready)XIC(p01r09_pb_global_reset)[OTU(p20r18.fault.2) ,OTU(p20r18.fault_ack.2) ];
					N: XIC(p20_di_lo_turret.ready)XIO(p20_di_lo_turret.ctrl_from_net)[TON(p20r18_timer_fault[3],?,?) ,XIC(p20r18_timer_fault[3].DN) OTL(p20r18.fault.3) ];
					N: XIC(p20r18.fault_ack.3)[XIC(p20_di_lo_turret.ctrl_from_net) ,XIO(p20_di_lo_turret.ready) ]XIC(p01r09_pb_global_reset)[OTU(p20r18.fault.3) ,OTU(p20r18.fault_ack.3) ];
					N: XIO(p20_di_lo_turret_therm)[TON(p20r18_timer_fault[5],?,?) ,XIC(p20r18_timer_fault[5].DN) OTL(p20r18.fault.5) ];
					N: XIC(p20r18.fault_ack.5)XIC(p20_di_lo_turret_therm)XIC(p01r09_pb_global_reset)[OTU(p20r18.fault.5) ,OTU(p20r15.fault_ack.5) ];
					N: NEQ(p20r18.fault,p20r18.fault_ack)OTE(p20r18.unack_fault);
					RC: "Warnings";
					N: OTE(p20r18.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r18.warning,p20r18.warning_ack);
					N: XIC(p20_di_lo_turret.warning)[TON(p20r18_timer_warning[0],?,?) ,XIC(p20r18_timer_warning[0].DN) OTL(p20r18.warning.0) ];
					N: XIC(p20r18.warning_ack.0)XIO(p20_di_lo_turret.warning)[OTU(p20r18.warning.0) ,OTU(p20r18.warning_ack.0) ];
					N: XIO(p20_do_close_nip)XIO(p20r18_index_complete)[TON(p20r18_timer_warning[1],?,?) ,XIC(p20r18_timer_warning[1].DN) OTL(p20r18.warning.1) ];
					N: XIC(p20r18.warning_ack.1)[XIC(p20r18_index_complete) ,XIC(p20_do_close_nip) ][OTU(p20r18.warning.1) ,OTU(p20r18.warning_ack.1) ];
					N: XIO(p20_do_close_nip)XIO(p20r15_loa_on)XIO(p20r16_lob_on)[TON(p20r18_timer_warning[2],?,?) ,XIC(p20r18_timer_warning[2].DN) OTL(p20r18.warning.2) ];
					N: XIC(p20r18.warning_ack.2)[XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ,XIC(p20_do_close_nip) ][OTU(p20r18.warning.2) ,OTU(p20r18.warning_ack.2) ];
					N: XIC(AFI)[XIC(p20r18_pb_index_fwd) ,XIC(p20r18_pb_index_rev) ]XIO(p20_di_clutch_prs_ok)[TON(p20r18_timer_warning[3],?,?) ,XIC(p20r18_timer_warning[3].DN) OTL(p20r18.warning.3) ];
					N: XIC(p20r18.warning_ack.3)[XIC(p20_di_clutch_prs_ok) ,XIO(p20r18_pb_index_fwd) XIO(p20r18_pb_index_rev) ][OTU(p20r18.warning.3) ,OTU(p20r18.warning_ack.3) ];
					N: NEQ(p20r18.warning,p20r18.warning_ack)OTE(p20r18.unack_warning);
			END_ROUTINE

	END_PROGRAM

	PROGRAM P21_Splice_Press (MAIN := "R01_Main",
	                          MODE := 0,
	                          DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					RC: "P21r01 Main$N"
					    "$N"
					    "This routine is called, continuously, from P21 System while the plc is in Run mode.  All other P21 System routines are called from this routine.";
					N: OTE(P21r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "P21r01.comment (dint)$N"
					    "P21r01.oneshot (dint)$N"
					    "P21r01_timer_xxxx (timer)$N"
					    "P21r01_xxxx (any)$N"
					    "P21r01.fault (dint)$N"
					    "P21r01.warning (dint)$N"
