					N: Limit_Clamp(p01_sys_lc,50,p02_real_from_hmi.zone_1[54],0)MOV(p02_real_from_hmi.zone_1[54],p11_param_tc01_dev);
					N: MOV(p02_real_from_hmi.zone_1[55],p11_param_lfl_hl)MOV(p02_real_from_hmi.zone_1[56],p11_param_lfl_hhl);
					N: MOV(p02_real_from_hmi.zone_1[57],p11_param_shutdown_temp)MOV(p02_real_from_hmi.zone_1[58],p11_param_zone_pressure);
					N: MOV(p02_real_from_hmi.zone_1[59],p11_param_fast_to_soak)MOV(p02_real_from_hmi.zone_1[60],p11_param_soak_to_fast);
					N: MOV(p02_real_from_hmi.zone_1[61],p02_real_from_hmi.zone_1[61])MOV(p02_real_from_hmi.zone_1[62],p02_real_from_hmi.zone_1[62]);
					N: MOV(p02_real_from_hmi.zone_1[63],p02_real_from_hmi.zone_1[63])MOV(p02_real_from_hmi.zone_1[64],p02_real_from_hmi.zone_1[64]);
					N: MOV(p02_real_from_hmi.zone_1[65],p02_real_from_hmi.zone_1[65])MOV(p02_real_from_hmi.zone_1[66],p02_real_from_hmi.zone_1[66]);
					N: Limit_Clamp(p01_sys_lc,100,p02_real_from_hmi.zone_1[68],0)MOV(p02_real_from_hmi.zone_1[68],p11r30_cv_man_sp);
					RC: "Requests";
					N: OTE(p11r10.comment.3);
					RC: "Timer Presets$N"
					    "Set in P01R11";
					N: OTE(p11r10.comment.4);
					RC: "Motor Starter Faults";
					N: MOV(p01_param_oven_timer_presets[0],p11r31_timer_fault[0].PRE)MOV(p01_param_oven_timer_presets[0],p11r31_timer_fault[3].PRE);
					N: MOV(p01_param_oven_timer_presets[0],p11r32_timer_fault[0].PRE)MOV(p01_param_oven_timer_presets[0],p11r32_timer_fault[3].PRE);
					RC: "Motor Thermistor Fault";
					N: MOV(p01_param_oven_timer_presets[1],p11r31_timer_fault[1].PRE)MOV(p01_param_oven_timer_presets[1],p11r32_timer_fault[1].PRE);
					RC: "Motor Off While Chamber is Too Hot";
					N: MOV(p01_param_oven_timer_presets[2],p11r31_timer_warning[0].PRE)MOV(p01_param_oven_timer_presets[2],p11r32_timer_warning[0].PRE);
					RC: "Motor Fan Flow Warning";
					N: MOV(p01_param_oven_timer_presets[3],p11r31_timer_warning[1].PRE);
					N: MOV(p01_param_oven_timer_presets[3],p11r32_timer_warning[1].PRE)MOV(p01_param_oven_timer_presets[3],p11r32_timer_warning[2].PRE);
					N: MOV(p01_param_oven_timer_presets[4],p01_param_oven_timer_presets[4])MOV(p01_param_oven_timer_presets[5],p01_param_oven_timer_presets[5]);
					RC: "Software High Limit Fault";
					N: MOV(p01_param_oven_timer_presets[6],p11r30_timer_fault[0].PRE);
					RC: "Hardware High Limit and all Burner Safeties, Burner Off Warning";
					N: MOV(p01_param_oven_timer_presets[7],p11r30_timer_fault[1].PRE)MOV(p01_param_oven_timer_presets[7],p11r30_timer_fault[5].PRE)MOV(p01_param_oven_timer_presets[7],p11r30_timer_fault[6].PRE);
					N: MOV(p01_param_oven_timer_presets[7],p11r31_timer_warning[3].PRE)MOV(p01_param_oven_timer_presets[7],p11r32_timer_warning[3].PRE);
					N: MOV(p01_param_oven_timer_presets[7],p11r30_timer_fault[7].PRE)MOV(p01_param_oven_timer_presets[7],p11r30_timer_fault[8].PRE)MOV(p01_param_oven_timer_presets[7],p11r30_timer_fault[9].PRE);
					RC: "RTD Failure (Faults and Warnings)";
					N: MOV(p01_param_oven_timer_presets[8],p11r30_timer_fault[2].PRE)MOV(p01_param_oven_timer_presets[8],p11r30_timer_warning[1].PRE)MOV(p01_param_oven_timer_presets[8],p11r30_timer_warning[2].PRE);
					RC: "LEL Level Fault and Warning";
					N: MOV(p01_param_oven_timer_presets[10],p11r30_timer_fault[4].PRE)MOV(p01_param_oven_timer_presets[10],p11r30_timer_warning[4].PRE);
					N: MOV(p01_param_oven_timer_presets[11],p11r30_timer_fault[10].PRE)MOV(p01_param_oven_timer_presets[11],p11r30_timer_fault[11].PRE)MOV(p01_param_oven_timer_presets[11],p11r30_timer_fault[12].PRE);
					RC: "Spares";
					N: MOV(p01_param_oven_timer_presets[11],p01_param_oven_timer_presets[11])MOV(p01_param_oven_timer_presets[12],p01_param_oven_timer_presets[12])MOV(p01_param_oven_timer_presets[13],p01_param_oven_timer_presets[13]);
					RC: "Temperature Control Deviation Warning";
					N: MOV(p01_param_oven_timer_presets[14],p11r30_timer_warning[0].PRE);
					RC: "Zone in Manual";
					N: MOV(p01_param_oven_timer_presets[17],p11r30_timer_warning[3].PRE)MOV(p01_param_oven_timer_presets[17],p01_param_oven_timer_presets[17]);
					RC: "Oven Pressure High Limit Warning";
					N: MOV(p01_param_oven_timer_presets[18],p11r02_timer_warning[0].PRE);
					RC: "Zone Filter Dirty Warning";
					N: MOV(p01_param_oven_timer_presets[19],p11r30_timer_warning[6].PRE)MOV(p01_param_oven_timer_presets[19],p11r30_timer_warning[7].PRE);
					N: MOV(p01_param_oven_timer_presets[19],p11r30_timer_warning[8].PRE);
					RC: "Spares";
					N: MOV(p01_param_oven_timer_presets[20],p01_param_oven_timer_presets[20]);
					RC: "Temperature Control State Timers";
					N: MOV(p01_param_oven_timer_presets[21],p11r20_timer_state_3.PRE)MOV(p01_param_oven_timer_presets[22],p11r20_timer_state_4.PRE);
					N: MOV(p01_param_oven_timer_presets[23],p11r20_timer_state_7.PRE)MOV(p01_param_oven_timer_presets[24],p11r20_timer_state_11.PRE);
					N: MOV(p01_param_oven_timer_presets[25],p01_param_oven_timer_presets[25])MOV(p01_param_oven_timer_presets[26],p01_param_oven_timer_presets[26]);
					RC: "Burner Start Dwell";
					N: MOV(p01_param_oven_timer_presets[27],p01_param_oven_timer_presets[27]);
					RC: "Shutdown Temperature Delay";
					N: MOV(p01_param_oven_timer_presets[28],p11r02_timer_safe_temp[0].PRE)MOV(p01_param_oven_timer_presets[28],p11r02_timer_safe_temp[1].PRE);
					RC: "Spares";
					N: MOV(p01_param_oven_timer_presets[29],p01_param_oven_timer_presets[29]);
					N: MOV(p01_param_oven_timer_presets[30],p01_param_oven_timer_presets[30])MOV(p01_param_oven_timer_presets[31],p01_param_oven_timer_presets[31]);
					RC: "Output Control";
					N: OTE(p11r10.comment.5);
					RC: "Faults";
					N: OTE(p11r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p11r10.fault,p11r10.fault_ack);
					N: XIC(FAULT)[TON(p11r10_timer_fault[0],?,?) ,XIC(p11r10_timer_fault[0].DN) OTL(p11r10.fault.0) ];
					N: XIC(p11r10.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p11r10.fault.0) ,OTU(p11r10.fault_ack.0) ];
					N: NEQ(p11r10.fault,p11r10.fault_ack)OTE(p11r10.unack_fault);
					RC: "Warnings";
					N: OTE(p11r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p11r10.warning,p11r10.warning_ack);
					N: XIC(FAULT)[TON(p11r10_timer_warning[0],?,?) ,XIC(p11r10_timer_warning[0].DN) OTL(p11r10.warning.0) ];
					N: XIO(FAULT)[OTU(p11r10.warning.0) ,OTU(p11r10.warning_ack.0) ];
					N: NEQ(p11r10.warning,p11r10.warning_ack)OTE(p11r10.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R20_Temp_Sequence 
					RC: "p11r15$N"
					    "This routine is called, continuously, from p11R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p11r20.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r15.comment (dint)$N"
					    "p11r15.oneshot (dint)$N"
					    "p11r15_timer_xxxx (timer)$N"
					    "p11r15_xxxx (any)$N"
					    "p11r15.fault (dint)$N"
					    "p11r15.warning (dint)$N"
					    "";
					N: OTE(p11r20.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p11r20.comment.2);
					RC: "Requests";
					N: OTE(p11r20.comment.3);
					RC: "Sequence";
					N: OTE(p11r20.comment.4);
					N: [XIC(S:FS) ,XIC(p11r20_state.13) ][MOV(0,p11r20_state) ,OTL(p11r20_state.1) ];
					N: XIC(p11r20_state.1)XIC(p11_di_burner_auto)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.2) ];
					N: [XIC(p11r20_state.2) ,XIC(p11r20_state.11) ,XIC(p11r20_state.12) ,XIC(p11r20_state.13) ]XIC(p11r30_request_heat)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.3) ];
					N: XIC(p11r20_state.3)XIC(p11_di_recirc_flow_ok)XIC(p11r20_state.0)XIC(p11r20_timer_state_3.DN)[MOV(0,p11r20_state) ,OTL(p11r20_state.4) ];
					N: XIC(p11r20_state.4)XIC(p11_di_exh_flow_ok)XIC(p11r20_timer_state_4.DN)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.5) ];
					N: XIC(p11r20_state.5)XIC(p11_di_burner_safeties_ok)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.6) ,OTL(p11r20_safeties_ok) ];
					N: XIC(p11r20_state.6)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.7) ];
					N: XIC(p11r20_state.7)XIC(p11_di_flame_on)XIC(p11r20_timer_state_7.DN)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.8) ];
					N: [XIC(p11r20_state.8) ,XIC(p11r20_state.10) XIO(p11r30_request_soak_control) ,XIC(p11r20_state.31) XIO(p11r30_request_manual) ]XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.9) ];
					N: XIC(p11r20_state.9)XIC(p11r30_request_soak_control)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.10) ];
					N: [[LEQ(p11r20_status,10) GEQ(p11r20_status,3) ,XIC(p11r20_state.31) ] ,XIC(p11r20_state.2) XIO(p11_di_burner_auto) ]XIO(p11r30_request_heat)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.11) ];
					N: XIC(p11r20_state.11)XIO(p11_di_flame_on)XIC(p11r20_timer_state_11.DN)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.12) ];
					N: [XIC(p11r20_state.11) ,XIC(p11r20_state.12) ]XIC(p11r02_shutdown_temp)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.13) ];
					N: [XIC(p11r20_state.9) ,XIC(p11r20_state.10) ]XIC(p11r30_request_manual)XIC(p11r20_state.0)[MOV(0,p11r20_state) ,OTL(p11r20_state.31) ];
					N: [XIC(p11r20_state.3) ,XIC(p11r20_state.4) ,XIC(p11r20_state.5) ,XIC(p11r20_state.6) ,XIC(p11r20_state.7) ,XIC(p11r20_state.8) ,XIC(p11r20_state.9) ,XIC(p11r20_state.10) ,XIC(p11r20_state.11) ]OTE(p11r12_Oven_auto_run_on);
					N: OTL(p11r20_state.0);
					N: SYS_ENC(p01_sys_enc,p11r20_state,p11r20_status);
					RC: "Output Control";
					N: OTE(p11r20.comment.5);
					N: XIC(p11_di_recirc_flow_ok)TON(p11r20_timer_state_3,?,?);
					N: XIC(p11_di_exh_flow_ok)XIC(p11_di_exh_flow_ok)TON(p11r20_timer_state_4,?,?);
					N: XIC(p11_di_flame_on)TON(p11r20_timer_state_7,?,?);
					N: XIO(p11_di_recirc_flow_ok)XIO(p11_di_exh_flow_ok)TON(p11r20_timer_state_11,?,?);
					RC: "Faults";
					N: OTE(p11r20.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p11r20.fault,p11r20.fault_ack);
					N: XIC(FAULT)[TON(p11r20_timer_fault[0],?,?) ,XIC(p11r10_timer_fault[0].DN) OTL(p11r10.fault.0) ];
					N: XIC(p11r20.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p11r20.fault.0) ,OTU(p11r20.fault_ack.0) ];
					N: NEQ(p11r20.fault,p11r20.fault_ack)OTE(p11r20.unack_fault);
					RC: "Warnings";
					N: OTE(p11r20.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p11r20.warning,p11r20.warning_ack);
					N: XIC(FAULT)[TON(p11r20_timer_warning[0],?,?) ,XIC(p11r20_timer_warning[0].DN) OTL(p11r20.warning.0) ];
					N: XIO(FAULT)[OTU(p11r20.warning.0) ,OTU(p11r20.warning_ack.0) ];
					N: NEQ(p11r20.warning,p11r20.warning_ack)OTE(p11r20.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R30_Temperature_Control 
					RC: "p11r16$N"
					    "This routine is called, continuously, from p11R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p11r30.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r16.comment (dint)$N"
					    "p11r16.oneshot (dint)$N"
					    "p11r16_timer_xxxx (timer)$N"
					    "p11r16_xxxx (any)$N"
					    "p11r16.fault (dint)$N"
					    "p11r16.warning (dint)$N"
					    "";
					N: OTE(p11r30.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p11r30.comment.2);
					N: [XIC(p02_dint_from_hmi.zone_1[4].16) ,XIC(p02_dint_from_hmi.global[6].10) ]OTE(p11r30_pb_zone_on);
					N: [XIC(p02_dint_from_hmi.zone_1[4].17) ,XIC(p02_dint_from_hmi.global[6].11) ]OTE(p11r30_pb_zone_off);
					N: XIC(p02_dint_from_hmi.zone_1[4].18)[OTE(p11r30_pb_manual) ,OTU(p02_dint_from_hmi.zone_1[4].18) ];
					N: XIC(p02_dint_from_hmi.zone_1[4].19)OTE(p11r30_pb_auto);
					N: MOV(p01_recipe_active.zone_1.temp_sp,p11r30_pid_temp_sp);
					N: XIC(p01r09_open_oven)MOV(p01_param_open_oven_temp,p11r30_pid_temp_sp);
					RC: "Multiply by 10,$N"
					    "Scaled back down in the PID$N"
					    "Use Dint for PID";
					N: [MUL(p11_ai_tc01,10,p11r30_pid_temp_pv) ,XIC(p11r30.warning.1) MUL(p11_ai_tc02,10,p11r30_pid_temp_pv) ];
					RC: "Requests";
					N: OTE(p11r30.comment.3);
					N: XIC(p23_di_impreg_exhaust_running)XIO(p23r02.fault.1)EQU(p11r31.fault,0)EQU(p11r32.fault,0)EQU(p23r13.fault,0)OTE(p11r30_vfds_ok);
					N: EQU(p11r30.fault,0)[XIC(p23_di_impreg_tank_up) XIC(p01r13_permissive_oxidizer) ,XIO(p23_di_impreg_tank_up) ]XIO(p23r02.fault.0)XIO(p11r30.fault.4)XIO(p12r30.fault.4)XIC(p11r30_vfds_ok)OTE(p11r30_permissive_run);
					N: [XIC(p11r30_pb_zone_on) ,XIC(p11r30_request_heat) ]XIO(p11r30_pb_zone_off)XIC(p11r30_permissive_run)XIC(p11_di_burner_auto)OTE(p11r30_request_heat);
					N: [XIC(p11r30_pb_manual) ,XIC(p11r30_request_manual) ]XIO(p11r30_pb_auto)XIC(p11r30_permissive_run)OTE(p11r30_request_manual);
					N: LES(p11r30_pid_temp_sp_error,p11r30_temp_deviation_setpoint)ONS(p11r30.oneshot.2)OTL(p11r30_request_deviation_warning);
					N: [XIO(p11r30_request_heat) ,NEQ(p11r30_pid_temp_sp,p11r30_pid_temp_sp_last) ]OTU(p11r30_request_deviation_warning);
					N: LES(p11r30_pid_temp.ERR,p11_param_fast_to_soak)OTL(p11r30_request_soak_control);
					N: GRT(p11r30_pid_temp.ERR,p11_param_soak_to_fast)OTU(p11r30_request_soak_control);
					RC: "Sequence";
					N: OTE(p11r30.comment.4);
					N: CPT(p11r30_pid_temp_sp_error,ABS(p11r30_pid_temp.ERR))MOV(p11r30_pid_temp_sp,p11r30_pid_temp_sp_last);
					RC: "Configure PID";
					N: OTE(p11r30.comment.5);
					N: XIC(p11r30_request_heat)MOV(p11r30_pid_temp_sp,p11r30_pid_temp.SP);
					N: XIO(p11r30_request_heat)MOV(0,p11r30_pid_temp.SP);
					RC: "Need?  If PID is at 100% and grossly overshoots(appears to freeze at 100%), this $Qkick$Q will $Qreset$Q the PID and get it working again.";
					N: [XIC(p11r20_state.9) ,XIC(p11r20_state.10) ]EQU(p11r30_pid_temp.OUT,100)LES(p11r30_pid_temp.ERR,3.0)OTE(p11r30_request_PID_shot);
					N: [XIC(p11r20_state.31) ,XIC(p11r20_state.13) ,XIO(p11r20_state.9) XIO(p11r20_state.10) ,XIC(p11r30_request_PID_shot) ,XIO(p11r30_request_heat_last) ]OTE(p11r30_pid_temp.SWM);
					N: [XIO(p11r30_request_heat) ,XIO(p11r20_state.9) XIO(p11r20_state.10) ]MOV(0.0,p11r30_pid_temp.SO);
					N: XIC(p11r20_state.12)MOV(100.0,p11r30_pid_temp.SO);
					N: XIC(p11r20_state.31)MOV(p11r30_cv_man_sp,p11r30_pid_temp.SO);
					N: XIC(p11r30_request_PID_shot)MOV(50,p11r30_pid_temp.SO);
					N: [MOV(0,p11r30_pid_temp.MINCV) MOV(100,p11r30_pid_temp.MAXCV) ,MOV(0,p11r30_pid_temp.MINI) MOV(10000,p11r30_pid_temp.MAXI) ,MOV(p11r30_pid_temp.MINI,p11r30_pid_temp.MINS) MOV(1000,p11r30_pid_temp.MAXS) ][OTE(p11r30_pid_temp.NOZC) ,XIC(AFI) OTE(p11r30_pid_temp.CA) ,XIC(AFI) OTE(p11r30_pid_temp.PE) ,OTE(p11r30_pid_temp.NOBC) ];
					N: LES(p11r30_pid_temp.UPD,0.01)MOV(0.01,p11r30_pid_temp.UPD);
					N: [MOV(p11_param_pid1_kp,p11r30_pid_temp.KP) MOV(p11_param_pid1_ki,p11r30_pid_temp.KI) ,MOV(p11_param_pid1_kd,p11r30_pid_temp.KD) MOV(p11_param_pid1_ff,p11r30_pid_temp.BIAS) ];
					N: XIC(p11r30_request_soak_control)[MOV(p11_param_pid2_kp,p11r30_pid_temp.KP) MOV(p11_param_pid2_ki,p11r30_pid_temp.KI) ,MOV(p11_param_pid2_kd,p11r30_pid_temp.KD) MOV(p11_param_pid2_ff,p11r30_pid_temp.BIAS) ];
					N: MOV(p11r30_pid_temp.BIAS,p11r30_pid_temp.BIAS)PID(p11r30_pid_temp,p11r30_pid_temp_pv,0,p11r16_pid_temp_cv,0,0,0);
					RC: "Output Control";
					N: OTE(p11r30.comment.6);
					N: XIC(p11r30_request_heat)OTE(p11_do_enable_burner);
					N: [XIC(p11_di_flame_failure) ,XIC(p11_do_rst_flame) ]XIC(p01r09_pb_global_reset)OTE(p11_do_rst_flame);
					N: MOV(p11r30_pid_temp.OUT,p11_ao_cv);
					RC: "Faults";
					N: OTE(p11r30.comment.30);
