					N: [XIC(p12r30.fault.8) OTE(p12_dint_to_hmi[0].8) ,XIC(p12r30.fault.9) OTE(p12_dint_to_hmi[0].9) ,XIC(p12r30.fault.10) OTE(p12_dint_to_hmi[0].10) ,XIC(p12r30.fault.11) OTE(p12_dint_to_hmi[0].11) ];
