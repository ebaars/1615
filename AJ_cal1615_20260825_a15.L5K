					N: [XIC(p12r32.fault.0) OTE(p12_dint_to_hmi[0].20) ,XIC(p12r32.fault.1) OTE(p12_dint_to_hmi[0].21) ,XIC(p12r32.fault.2) OTE(p12_dint_to_hmi[0].22) ,XIC(p12r32.fault.3) OTE(p12_dint_to_hmi[0].23) ];
					N: [XIC(p12r20.fault.0) OTE(p12_dint_to_hmi[0].24) ,XIC(p12r20.fault.1) OTE(p12_dint_to_hmi[0].25) ,XIC(p12r20.fault.2) OTE(p12_dint_to_hmi[0].26) ,XIC(p12r20.fault.3) OTE(p12_dint_to_hmi[0].27) ];
					N: [XIC(HMI) OTE(p12_dint_to_hmi[0].28) ,XIC(HMI) OTE(p12_dint_to_hmi[0].29) ,XIC(HMI) OTE(p12_dint_to_hmi[0].30) ,XIC(HMI) OTE(p12_dint_to_hmi[0].31) ];
					RC: "Sequence";
