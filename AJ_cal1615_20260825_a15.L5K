					RC: "Sequence";
					N: OTE(p13r20.comment.4);
					N: [XIC(S:FS) ,XIC(p13r20_state.6) ][MOV(0,p13r20_state) ,OTL(p13r20_state.1) ];
					N: XIC(p13r20_state.1)XIC(p13r30_request_cool)XIC(p13r20_state.0)[MOV(0,p13r20_state) ,OTL(p13r20_state.2) ];
