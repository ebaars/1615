					N: CPT(p19_ai_prs,p19_ai_prs-6);
					N: CPT(p19_ai_tc01,p00_io_winder:3:I.Ch0Data*0.1)ADD(p19_ai_tc01,p19_param_tc01z,p19_ai_tc01);
