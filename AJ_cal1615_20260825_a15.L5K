			ROUTINE R08_Warnings 
					RC: "p12r08$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r08.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r08.comment (dint)$N"
					    "p12r08.oneshot (dint)$N"
					    "p12r08_timer_xxxx (timer)$N"
					    "p12r08_xxxx (any)$N"
					    "p12r08.fault (dint)$N"
					    "p12r08.warning (dint)$N"
					    "";
					N: OTE(p12r08.comment.1);
