					N: EQU(p12r30.fault,0)[XIC(p23_di_impreg_tank_up) XIC(p01r13_permissive_oxidizer) ,XIO(p23_di_impreg_tank_up) ]XIC(p12r30_vfds_ok)XIO(p23r02.fault.0)XIO(p11r30.fault.4)XIO(p12r30.fault.4)OTE(p12r30_permissive_run);
					N: [XIC(p12r30_pb_zone_on) ,XIC(p12r30_request_heat) ]XIO(p12r30_pb_zone_off)XIC(p12r30_permissive_run)XIC(p12_di_burner_auto)OTE(p12r30_request_heat);
					N: [XIC(p12r30_pb_manual) ,XIC(p12r30_request_manual) ]XIO(p12r30_pb_auto)XIC(p12r30_permissive_run)OTE(p12r30_request_manual);
					N: LES(p12r30_pid_temp_sp_error,p12r30_temp_deviation_setpoint)ONS(p12r30.oneshot.2)OTL(p12r30_request_deviation_warning);
					N: [XIO(p12r30_request_heat) ,NEQ(p12r30_pid_temp_sp,p12r30_pid_temp_sp_last) ]OTU(p12r30_request_deviation_warning);
					N: LES(p12r30_pid_temp.ERR,p12_param_fast_to_soak)OTL(p12r30_request_soak_control);
