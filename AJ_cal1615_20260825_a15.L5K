			                                  DefaultData := 0.00000000e+000);
			IN_param_master_accel_rate : REAL (Description := "Input Parameter$NAcel Ramp$Nx/second",
			                                      Usage := Input,
			                                      RADIX := Float,
			                                      Required := Yes,
