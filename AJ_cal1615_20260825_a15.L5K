					N: EQU(p21r16.fault,0)OTE(p21r16_permissive_run);
					N: [XIC(p21r16_pb_heater_on) ,XIC(p21r16_request_heat) ]XIO(p21r16_pb_heater_off)XIC(p21r16_permissive_run)OTE(p21r16_request_heat);
					RC: "Sequence";
					N: OTE(p21r16.comment.4);
					RC: "PID Control$N"
					    "$N"
					    "";
					N: OTE(p21r16.comment.5);
					N: XIO(p21r16_request_heat)MOV(0,p21_pid_splice_press_temp.SP);
					N: XIO(p21r16_request_heat)MOV(0,p21_pid_splice_press_temp.SO);
					N: XIO(p21r16_request_heat)OTE(p21_pid_splice_press_temp.SWM);
					N: XIC(p21r16_request_heat)MOV(p01_recipe_active.platen_temp_sp,p21_pid_splice_press_temp.SP);
					N: MOV(p21_ai_splice_platen_temp,p21r16_pid_temp_pv);
					N: [MOV(p02_real_from_hmi.splice[44],p21_pid_splice_press_temp.KP) MOV(p02_real_from_hmi.splice[45],p21_pid_splice_press_temp.KI) ,MOV(p02_real_from_hmi.splice[46],p21_pid_splice_press_temp.KD) MOV(p02_real_from_hmi.splice[47],p21_pid_splice_press_temp.BIAS) ];
					N: MOV(p21_pid_splice_press_temp.BIAS,p21_pid_splice_press_temp.BIAS)PID(p21_pid_splice_press_temp,p21r16_pid_temp_pv,0,p21r16_pid_temp_cv,0,0,0);
					RC: "Output Control$N"
					    "";
					N: OTE(p21r16.comment.6);
					N: MOV(p21r16_pid_temp_cv,p21_ao_splice_platen_temp_cv);
					N: XIC(p21r16_request_heat)OTE(p21_do_enable_platen_heater);
					RC: "Faults";
					N: OTE(p21r16.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p21r16.fault,p21r16.fault_ack);
					N: XIO(p21_di_platen_hi_temp_ok)[TON(p21r16_timer_fault[0],?,?) ,XIC(p21r16_timer_fault[0].DN) OTL(p21r16.fault.0) ];
					N: XIC(p21r16.fault_ack.0)XIC(p21_di_platen_hi_temp_ok)XIC(p01r09_pb_global_reset)[OTU(p21r16.fault.0) ,OTU(p21r16.fault_ack.0) ];
					N: XIC(p21_di_tc_bo)[TON(p21r16_timer_fault[1],?,?) ,XIC(p21r16_timer_fault[1].DN) OTL(p21r16.fault.1) ];
					N: XIC(p21r16.fault_ack.1)XIO(p21_di_tc_bo)XIC(p01r09_pb_global_reset)[OTU(p21r16.fault.1) ,OTU(p21r16.fault_ack.1) ];
					N: XIO(p21_di_tc_bo)GRT(p21_ai_splice_platen_temp,475)[TON(p21r16_timer_fault[2],?,?) ,XIC(p21r16_timer_fault[2].DN) OTL(p21r16.fault.2) ];
					N: XIC(p21r16.fault_ack.2)[LES(p21_ai_splice_platen_temp,460) ,XIC(p21_di_tc_bo) ]XIC(p01r09_pb_global_reset)[OTU(p21r16.fault.2) ,OTU(p21r16.fault_ack.2) ];
					N: NEQ(p21r16.fault,p21r16.fault_ack)OTE(p21r16.unack_fault);
					RC: "Warnings";
					N: OTE(p21r16.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p21r16.warning,p21r16.warning_ack);
					N: XIC(p01r13_state.2)XIO(p21r16_request_heat)[TON(p21r16_timer_warning[0],?,?) ,XIC(p21r16_timer_warning[0].DN) OTL(p21r16.warning.0) ];
					N: XIC(p21r16.warning_ack.0)[XIC(p21r16_request_heat) ,XIO(p01r13_state.2) ][OTU(p21r16.warning.0) ,OTU(p21r16.warning_ack.0) ];
					N: NEQ(p21r16.warning,p21r16.warning_ack)OTE(p21r16.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P22_Tension_Stand_1 (MAIN := "R01_Main",
	                             MODE := 0,
	                             DisableFlag := 0)
			TAG
