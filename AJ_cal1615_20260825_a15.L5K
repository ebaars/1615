			ROUTINE R32_Recirc_VFD 
					RC: "p12r32$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r32.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r32.comment (dint)$N"
					    "p12r32.oneshot (dint)$N"
					    "p12r32_timer_xxxx (timer)$N"
					    "p12r32_xxxx (any)$N"
					    "p12r32.fault (dint)$N"
					    "p12r32.warning (dint)$N"
					    "";
					N: OTE(p12r32.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r32.comment.2);
					N: [XIC(p02_dint_from_hmi.zone_2[4].8) ,XIC(p12r20_state.3) ONS(p12r32.oneshot.0) ]OTE(p12r32_pb_start);
					N: [XIC(p02_dint_from_hmi.zone_2[4].7) ,XIO(p23r02.warning.0) XIO(p11r30.warning.4) XIO(p12r30.warning.4) XIC(p11r02_shutdown_temp) XIC(p12r02_shutdown_temp) [ONS(p12r32.oneshot.1) ,XIC(p02_dint_from_hmi.global[6].7) ] ]OTE(p12r32_pb_stop);
					N: [XIC(p02_dint_from_hmi.zone_2[4].8) ,XIC(p12r20_state.1) ]OTU(p12r32_fan_pb_stopped);
					N: LEQ(p12_ai_recirc_rpm,p01_param_fan_zero_speed)OTE(p12r32_vfd_stopped);
					RC: "Requests";
					N: OTE(p12r32.comment.3);
					N: XIO(p01r02.fault.3)XIO(p12r32.warning.3)EQU(p12r32.fault,0)OTE(p12r32_run_permissive);
					N: [XIC(p12r32_pb_start) ,XIC(p12r32_request_auto_run) ]XIO(p12r32_pb_stop)XIC(p12r32_run_permissive)OTE(p12r32_request_auto_run);
					RC: "Output Control";
					N: OTE(p12r32.comment.5);
					N: XIC(p12r32_request_auto_run)OTE(p12_do_recirc.forward);
					N: XIC(p01r09_pb_global_reset)OTE(p12_do_recirc.fault_reset);
					RC: "Select Speed Setpoint";
					N: OTE(p12r32.comment.4);
					N: XIC(p12r32_request_auto_run)MOV(p01_recipe_active.zone_2.recirc_sp,p12_ao_recirc_selected_speed);
					N: XIC(p01r09_open_oven)MOV(p01_param_open_oven_recirc_sp,p12_ao_recirc_selected_speed);
					N: XIO(p12r32_request_auto_run)MOV(0,p12_ao_recirc_selected_speed);
					RC: "Faults";
					N: OTE(p12r32.comment.29);
					N: XIC(p01r09_pb_global_reset)MOV(p12r32.fault,p12r32.fault_ack);
					N: XIC(p12_di_recirc.faulted)[TON(p12r32_timer_fault[0],?,?) ,XIC(p12r32_timer_fault[0].DN) OTL(p12r32.fault.0) ];
					N: XIC(p12r32.fault_ack.0)XIO(p12_di_recirc.faulted)XIC(p01r09_pb_global_reset)[OTU(p12r32.fault.0) ,OTU(p12r32.fault_ack.0) ];
					N: XIO(p12_di_recirc_fan_mtr_ts)[TON(p12r32_timer_fault[1],?,?) ,XIC(p12r32_timer_fault[1].DN) OTL(p12r32.fault.1) ];
					N: XIC(p12r32.fault_ack.1)XIC(p12_di_recirc_fan_mtr_ts)XIC(p01r09_pb_global_reset)[OTU(p12r32.fault.1) ,OTU(p12r32.fault_ack.1) ];
					N: XIO(p12_di_recirc.ready)[TON(p12r32_timer_fault[2],?,?) ,XIC(p12r32_timer_fault[2].DN) OTL(p12r32.fault.2) ];
					N: XIC(p12r32.fault_ack.2)XIC(p12_di_recirc.ready)XIC(p01r09_pb_global_reset)[OTU(p12r32.fault.2) ,OTU(p12r32.fault_ack.2) ];
					N: XIC(p12_di_recirc.ready)XIO(p12_di_recirc.ctrl_from_net)[TON(p12r32_timer_fault[3],?,?) ,XIC(p12r32_timer_fault[3].DN) OTL(p12r32.fault.3) ];
					N: XIC(p12r32.fault_ack.3)[XIO(p12_di_recirc.ready) ,XIC(p12_di_recirc.ctrl_from_net) ]XIC(p01r09_pb_global_reset)[OTU(p12r32.fault.3) ,OTU(p12r32.fault_ack.3) ];
					N: NEQ(p12r32.fault,p12r32.fault_ack)OTE(p12r32.unack_fault);
					RC: "Warnings";
					N: OTE(p12r32.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r32.warning,p12r32.warning_ack);
					N: XIO(p12r32_request_auto_run)XIO(p12r02_shutdown_temp)[TON(p12r32_timer_warning[0],?,?) ,XIC(p12r32_timer_warning[0].DN) OTL(p12r32.warning.0) ];
					N: XIC(p12r32.warning_ack.0)[XIC(p12r02_shutdown_temp) ,XIC(p12r32_request_auto_run) ][OTU(p12r32.warning.0) ,OTU(p12r32.warning_ack.0) ];
					N: [XIC(p12_di_recirc.running_fwd) XIO(p12_di_recirc_flow_ok) ,XIO(p12_di_recirc.running_fwd) XIC(p12_di_recirc_flow_ok) ][TON(p12r32_timer_warning[1],?,?) ,XIC(p12r32_timer_warning[1].DN) OTL(p12r32.warning.1) ];
					N: XIC(p12r32.warning_ack.1)[XIC(p12_di_recirc.running_fwd) XIC(p12_di_recirc_flow_ok) ,XIO(p12_di_recirc.running_fwd) XIO(p12_di_recirc_flow_ok) ][OTU(p12r32.warning.1) ,OTU(p12r32.warning_ack.1) ];
					N: XIC(p12_di_recirc.warning)[TON(p12r32_timer_warning[2],?,?) ,XIC(p12r32_timer_warning[2].DN) OTL(p12r32.warning.2) ];
					N: XIC(p12r32.warning_ack.2)XIO(p12_di_recirc.warning)[OTU(p12r32.warning.2) ,OTU(p12r32.warning_ack.2) ];
					N: XIC(p12_di_recirc.ready)XIO(p12_di_recirc.ctrl_from_net)[TON(p12r32_timer_warning[3],?,?) ,XIC(p12r32_timer_warning[3].DN) OTL(p12r32.warning.3) ];
					N: XIC(p12r32.warning_ack.3)[XIC(p12_di_recirc.ctrl_from_net) ,XIO(p12_di_recirc.ready) ][OTU(p12r32.warning.3) ,OTU(p12r32.warning_ack.3) ];
					N: NEQ(p12r32.warning,p12r32.warning_ack)OTE(p12r32.unack_warning);
					RC: "Warnings";
					N: OTE(p12r32.comment.31);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P13_Zone_3 (MAIN := "R01_Main",
	                    MODE := 0,
	                    DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					RC: "p13R01 Main$N"
					    "$N"
					    "This routine is called, continuously, from p13 System while the plc is in Run mode.  All other p13 System routines are called from this routine.";
					N: OTE(p13r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p13r01.comment (dint)$N"
					    "p13r01.oneshot (dint)$N"
					    "p13r01_timer_xxxx (timer)$N"
					    "p13r01_xxxx (any)$N"
					    "p13r01.fault (dint)$N"
