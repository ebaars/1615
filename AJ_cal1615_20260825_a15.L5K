					N: XIC(p23r12_permissive_jog)[XIC(p23r12_request_jog_fwd) ,XIC(p23r12_request_jog_rev) ]OTE(p23_do_servo_ds.jog_enable);
					N: XIC(p23r12_permissive_jog)XIC(p23r12_request_start)XIC(p23r12_timer[0].DN)XIO(p23r12_request_zero)OTE(p23_do_servo_ds.drive_halt_0_halt);
					N: XIC(p23r12_permissive_jog)XIC(p23r12_request_start)XIC(p23r12_timer[0].DN)XIO(p23r12_request_zero)OTE(p23_do_servo_ds.drive_enable);
