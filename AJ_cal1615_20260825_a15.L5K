			ROUTINE R11_Servo_Operator_Side 
					RC: "Tag Usage$N"
					    "$N"
					    "p23r11.comment (dint)$N"
					    "p23r11.oneshot (dint)$N"
					    "p23r11_timer_xxxx (timer)$N"
					    "p23r11_xxxx (any)$N"
					    "p23r11.fault (dint)$N"
					    "p23r11a_warnings (dint)$N"
					    "";
					N: OTE(p23r11.comment.1);
					RC: "Notes$N"
					    "";
					N: OTE(p23r11.comment.2);
					RC: "Input$N"
					    "Mayer Rod Operator Side$N"
					    "Ready for Operation$N"
					    "Bit 14/15$N"
					    "00: Not Ready$N"
					    "01:(bb)$N"
					    "10: (Ab)$N"
					    "11: (AF)";
					N: XIO(p23_di_servo_os.operation_bit_14)XIO(p23_di_servo_os.operation_bit_15)OTE(p23r11_servo_not_ready);
					N: XIC(p23_di_servo_os.operation_bit_14)XIO(p23_di_servo_os.operation_bit_15)OTE(p23r11_servo_status_bb);
					N: XIO(p23_di_servo_os.operation_bit_14)XIC(p23_di_servo_os.operation_bit_15)OTE(p23r11_servo_status_ab);
					N: XIC(p23_di_servo_os.operation_bit_14)XIC(p23_di_servo_os.operation_bit_15)OTE(p23r11_servo_status_af);
					RC: "Requests";
					N: OTE(p23r11.comment.3);
					N: XIO(p01r09.fault.0)EQU(p23r11.fault,0)OTE(p23r11_permissive_jog);
					N: [XIC(p02_dint_from_hmi.impreg[1].20) ,XIC(p23r11_request_start) ]XIC(p23r11_permissive_jog)XIO(p02_dint_from_hmi.impreg[1].21)OTE(p23r11_request_start);
					N: XIC(p02_dint_from_hmi.impreg[1].5)XIC(p23r11_permissive_jog)XIO(p23r11_request_jog_rev)XIO(p23r11_request_position)OTE(p23r11_request_jog_fwd);
					N: XIC(p02_dint_from_hmi.impreg[1].6)XIC(p23r11_permissive_jog)XIO(p23r11_request_jog_fwd)XIO(p23r11_request_position)OTE(p23r11_request_jog_rev);
					N: XIC(p02_dint_from_hmi.impreg[1].10)XIC(p23_di_servo_os.stand_still)XIC(p23r11_permissive_jog)XIO(p23r11_request_jog_fwd)XIO(p23r11_request_jog_rev)OTE(p23r11_request_position);
					N: XIC(p02_dint_from_hmi.impreg[1].7)XIC(p23r11_permissive_jog)OTE(p23r11_request_zero);
					N: XIO(p01r13_line_running)XIC(p23r11_request_position)OTL(p23r11_gap_sequence_enabled);
					N: XIC(p01r13_line_running)XIC(p23r11.state.1)OTU(p23r11_gap_sequence_enabled);
					RC: "Position Control";
					N: OTE(p23r11.comment.4);
					N: XIC(p23r11_request_zero)CPT(p23_ao_servo_os_zero_offset,p02_real_from_hmi.impreg[1]*2);
					N: XIO(p23r11_request_zero)TON(p23r11_timer[0],?,?);
