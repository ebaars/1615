					N: GRT(p23r12_selected_position,0.01)LEQ(p23r12_selected_position,0.011)MOV(p23r12_offsets[2],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.011)LEQ(p23r12_selected_position,0.012)MOV(p23r12_offsets[3],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.012)LEQ(p23r12_selected_position,0.013)MOV(p23r12_offsets[4],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.013)LEQ(p23r12_selected_position,0.014)MOV(p23r12_offsets[5],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.014)LEQ(p23r12_selected_position,0.015)MOV(p23r12_offsets[6],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.015)LEQ(p23r12_selected_position,0.016)MOV(p23r12_offsets[7],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.016)LEQ(p23r12_selected_position,0.017)MOV(p23r12_offsets[8],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.017)LEQ(p23r12_selected_position,0.018)MOV(p23r12_offsets[9],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.018)LEQ(p23r12_selected_position,0.019)MOV(p23r12_offsets[10],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.019)LEQ(p23r12_selected_position,0.02)MOV(p23r12_offsets[11],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.02)LEQ(p23r12_selected_position,0.021)MOV(p23r12_offsets[12],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.021)LEQ(p23r12_selected_position,0.022)MOV(p23r12_offsets[13],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.022)LEQ(p23r12_selected_position,0.023)MOV(p23r12_offsets[14],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.023)LEQ(p23r12_selected_position,0.024)MOV(p23r12_offsets[15],p23r12_pos_offset);
					N: GRT(p23r12_selected_position,0.024)LEQ(p23r12_selected_position,0.025)MOV(p23r12_offsets[16],p23r12_pos_offset);
