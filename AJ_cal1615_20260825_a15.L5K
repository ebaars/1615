					N: XIC(p12_di_tc02_bo)[TON(p12r30_timer_warning[2],?,?) ,XIC(p12r30_timer_warning[2].DN) OTL(p12r30.warning.2) ];
					N: XIC(p12r30.warning_ack.2)XIO(p12_di_tc02_bo)[OTU(p12r30.warning.2) ,OTU(p12r30.warning_ack.2) ];
					N: XIC(p12r30_request_manual)[TON(p12r30_timer_warning[3],?,?) ,XIC(p12r30_timer_warning[3].DN) OTL(p12r30.warning.3) ];
					N: XIC(p12r30.warning_ack.3)XIO(p12r30_request_manual)[OTU(p12r30.warning.3) ,OTU(p12r30.warning_ack.3) ];
					N: GEQ(p12_ai_lfl,p12_param_lfl_hl)[TON(p12r30_timer_warning[4],?,?) ,XIC(p12r30_timer_warning[4].DN) OTL(p12r30.warning.4) ];
					N: XIC(p12r30.warning_ack.4)CMP(p12_ai_lfl<(p12_param_lfl_hl-5))[OTU(p12r30.warning.4) ,OTU(p12r30.warning_ack.4) ];
