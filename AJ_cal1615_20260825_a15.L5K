			ROUTINE R10_Retraction 
					RC: "p30r10$N"
					    "This routine is called, continuously, from p30R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p30r10.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p30r10.comment (dint)$N"
					    "p30r10.oneshot (dint)$N"
					    "p30r10_timer_xxxx (timer)$N"
					    "p30r10_xxxx (any)$N"
					    "p30r10.fault (dint)$N"
					    "p30r10a_warnings (dint)$N"
					    "";
					N: OTE(p30r10.comment.1);
					RC: "Notes";
					N: OTE(p30r10.comment.2);
					N: XIO(p01r09.fault.0)EQU(p30r10.fault,0)XIC(p30r10_safety_pins_stowed)OTE(p30r10_run_permissive);
					N: XIC(p30_di_pin_1)XIC(p30_di_pin_2)XIC(p30_di_pin_3)XIC(p30_di_pin_4)XIC(p30_di_pin_5)XIC(p30_di_pin_6)XIC(p30_di_pin_7)XIC(p30_di_pin_8)OTE(p30r10_safety_pins_stowed);
					RC: "Requests";
					N: OTE(p30r10.comment.3);
					N: XIC(p30r09_mode_open)XIO(p30_di_retraction_up_ls)[XIC(p30r10_run_permissive) ,XIO(p30r10_safety_pins_stowed) ]OTE(p30r10_request_open);
					N: XIC(p30r09_mode_close)XIO(p30_di_retraction_down_ls)XIC(p30r10_run_permissive)OTE(p30r10_request_close);
					N: [XIC(p30r10_request_close) ,XIC(p30r10_request_open) ]TON(p30r10_motion_monitor_dwell,?,?)XIC(p30r10_motion_monitor_dwell.DN)OTE(p30r10_request_monitor);
					RC: "Output Control";
					N: OTE(p30r10.comment.5);
					N: XIC(p30r10_request_close)OTE(p30_do_rotation_fwd);
					N: XIC(p30r10_request_open)OTE(p30_do_rotation_rev);
					N: XIC(p30r10_request_monitor)OTE(p30_do_retract_motion);
					N: XIC(p30r10.fault.0)XIC(p01r09_pb_global_reset)OTE(p30_do_retract_reset);
					RC: "Faults";
					N: OTE(p30r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p30r10.fault,p30r10.fault_ack);
					N: XIC(p30_di_rotation_fault)[TON(p30r10_timer_fault[0],?,?) ,XIC(p30r10_timer_fault[0].DN) OTL(p30r10.fault.0) ];
					N: XIC(p30r10.fault_ack.0)XIO(p30_di_rotation_fault)XIC(p01r09_pb_global_reset)[OTU(p30r10.fault.0) ,OTU(p30r10.fault_ack.0) ];
					N: XIC(FAULT)[TON(p30r10_timer_fault[1],?,?) ,XIC(p30r10_timer_fault[1].DN) OTL(p30r10.fault.1) ];
					N: XIC(p30r10.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p30r10.fault.1) ,OTU(p30r10.fault_ack.1) ];
					N: NEQ(p30r10.fault,p30r10.fault_ack)OTE(p30r10.unack_fault);
					RC: "Warnings";
					N: OTE(p30r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p30r10.warning,p30r10.warning_ack);
					N: XIO(p30r10_safety_pins_stowed)[TON(p30r10_timer_warning[0],?,?) ,XIC(p30r10_timer_warning[0].DN) OTL(p30r10.warning.0) ];
					N: XIC(p30r10.warning_ack.0)XIC(p30r10_safety_pins_stowed)[OTU(p30r10.warning.0) ,OTU(p30r10.warning_ack.0) ];
					N: NEQ(p30r10.warning,p30r10.warning_ack)OTE(p30r10.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P31_WAC (Description := "Winder Accumulator",
	                 MODE := 0,
	                 DisableFlag := 0)
			TAG
				A00 OF hmi_dint[0].0 (RADIX := Decimal);
				A01 OF hmi_dint[0].1 (RADIX := Decimal);
				A02 OF hmi_dint[0].2 (RADIX := Decimal);
