					N: XIC(FAULT)[TON(p12r07_timer_fault[0],?,?) ,XIC(p12r07_timer_fault[0].DN) OTL(p12r07.fault.0) ];
					N: XIC(p12r07.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r07.fault.0) ,OTU(p12r07.fault_ack.0) ];
					N: NEQ(p12r07.fault,p12r07.fault_ack)OTE(p12r07.unack_fault);
