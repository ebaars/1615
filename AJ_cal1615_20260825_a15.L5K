					N: [XIC(p02_dint_from_hmi.impreg[1].12) ,XIC(p23r12_request_start) ]XIC(p23r12_permissive_jog)XIO(p02_dint_from_hmi.impreg[1].13)OTE(p23r12_request_start);
					N: XIC(p02_dint_from_hmi.impreg[1].0)XIC(p23r12_permissive_jog)XIO(p23r12_request_jog_rev)XIO(p23r12_request_position)OTE(p23r12_request_jog_fwd);
					N: XIC(p02_dint_from_hmi.impreg[1].1)XIC(p23r12_permissive_jog)XIO(p23r12_request_jog_fwd)XIO(p23r12_request_position)OTE(p23r12_request_jog_rev);
					N: XIC(p02_dint_from_hmi.impreg[1].10)XIC(p23_di_servo_ds.stand_still)XIC(p23r12_permissive_jog)XIO(p23r12_request_jog_fwd)XIO(p23r12_request_jog_rev)OTE(p23r12_request_position);
