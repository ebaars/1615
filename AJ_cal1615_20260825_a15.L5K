			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			Ack : DINT (Usage := InOut,
			               RADIX := Decimal,
			               Required := Yes,
			               Visible := Yes);
			Alarm : DINT (Usage := Input,
			                 RADIX := Decimal,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIO(Alarm.0)OTU(Ack.0);
				N: XIO(Alarm.1)OTU(Ack.1);
				N: XIO(Alarm.2)OTU(Ack.2);
				N: XIO(Alarm.3)OTU(Ack.3);
				N: XIO(Alarm.4)OTU(Ack.4);
				N: XIO(Alarm.5)OTU(Ack.5);
				N: XIO(Alarm.6)OTU(Ack.6);
				N: XIO(Alarm.7)OTU(Ack.7);
				N: XIO(Alarm.8)OTU(Ack.8);
				N: XIO(Alarm.9)OTU(Ack.9);
				N: XIO(Alarm.10)OTU(Ack.10);
				N: XIO(Alarm.11)OTU(Ack.11);
				N: XIO(Alarm.12)OTU(Ack.12);
				N: XIO(Alarm.13)OTU(Ack.13);
				N: XIO(Alarm.14)OTU(Ack.14);
				N: XIO(Alarm.15)OTU(Ack.15);
				N: XIO(Alarm.16)OTU(Ack.16);
				N: XIO(Alarm.17)OTU(Ack.17);
				N: XIO(Alarm.18)OTU(Ack.18);
				N: XIO(Alarm.19)OTU(Ack.19);
				N: XIO(Alarm.20)OTU(Ack.20);
				N: XIO(Alarm.21)OTU(Ack.21);
				N: XIO(Alarm.22)OTU(Ack.22);
				N: XIO(Alarm.23)OTU(Ack.23);
				N: XIO(Alarm.24)OTU(Ack.24);
				N: XIO(Alarm.25)OTU(Ack.25);
				N: XIO(Alarm.26)OTU(Ack.26);
				N: XIO(Alarm.27)OTU(Ack.27);
				N: XIO(Alarm.28)OTU(Ack.28);
				N: XIO(Alarm.29)OTU(Ack.29);
				N: XIO(Alarm.30)OTU(Ack.30);
				N: XIO(Alarm.31)OTU(Ack.31);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION sys_ACS880_inputs (Description := "System AOI$NACS880 Inputs",
	                                                 Revision := "1.0",
	                                                 ExecutePrescan := No,
	                                                 ExecutePostscan := No,
	                                                 ExecuteEnableInFalse := No,
	                                                 CreatedDate := "2023-03-06T19:03:31.866Z",
	                                                 CreatedBy := "DESKTOP-UJLNSL3\cal1615",
	                                                 EditedDate := "2023-03-07T15:48:43.148Z",
	                                                 EditedBy := "DESKTOP-UJLNSL3\cal1615",
	                                                 SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			IN_vfd_inputs : AB:ETHERNET_MODULE_INT_24Bytes:I:0 (Usage := InOut,
			                         Required := Yes,
			                         Visible := Yes);
			IN_vfd_data : vfd_data_ACS880 (Usage := InOut,
			                       Required := Yes,
			                       Visible := Yes);
			IN_vfd_status : DINT (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			Out_RPM : REAL (Usage := Output,
			                   RADIX := Float,
			                   Required := Yes,
			                   Visible := Yes,
			                   ExternalAccess := Read Only,
			                   DefaultData := 0.00000000e+000);
			Out_Amps : REAL (Usage := Output,
			                    RADIX := Float,
			                    Required := Yes,
			                    Visible := Yes,
			                    ExternalAccess := Read Only,
			                    DefaultData := 0.00000000e+000);
			Out_Hz : REAL (Usage := Output,
			                  RADIX := Float,
			                  Required := Yes,
			                  Visible := Yes,
			                  ExternalAccess := Read Only,
			                  DefaultData := 0.00000000e+000);
			Out_TorquePct : REAL (Usage := Output,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         ExternalAccess := Read Only,
			                         DefaultData := 0.00000000e+000);
			Out_Speed : REAL (Usage := Output,
			                     RADIX := Float,
			                     Required := Yes,
			                     Visible := Yes,
			                     ExternalAccess := Read Only,
			                     DefaultData := 0.00000000e+000);
			IN_Roll_Diameter : REAL (Usage := Input,
			                            RADIX := Float,
			                            Required := Yes,
			                            Visible := Yes,
			                            DefaultData := 0.00000000e+000);
			IN_Gear_Reduction : REAL (Usage := Input,
			                             RADIX := Float,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			afi : BOOL (RADIX := Decimal,
			              ExternalAccess := Read/Write,
			              DefaultData := 0);
			comm_ok : BOOL (RADIX := Decimal,
			                  ExternalAccess := Read/Write,
			                  DefaultData := 0);
			NPRPM : DINT (RADIX := Decimal,
			                ExternalAccess := Read/Write,
			                DefaultData := 0);
			NPHz : DINT (RADIX := Decimal,
			               ExternalAccess := Read/Write,
			               DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: OTU(afi);
				RC: "Status Word - Data[0]";
				N: MOV(IN_vfd_inputs.Data[0],IN_vfd_data.In_DriveStatus);
				N: LIM(16384,IN_vfd_status,20479)[OTE(comm_ok) ,OTE(IN_vfd_data.OUT_Comm_Status) ];
				RC: "Clear the Data from the VFD on a communication error";
				N: XIO(comm_ok)MOV(0,IN_vfd_inputs.Data[0]);
				RC: "Status Word - Data[0]";
				N: MOV(IN_vfd_inputs.Data[0],IN_vfd_data.In_DriveStatus);
				RC: "Map the Drive Status Word to the individual bits";
				N: [XIC(IN_vfd_data.In_DriveStatus.0) OTE(IN_vfd_data.In_DriveStatus_RDY_ON) ,XIC(IN_vfd_data.In_DriveStatus.1) OTE(IN_vfd_data.In_DriveStatus_RDY_RUN) ,XIC(IN_vfd_data.In_DriveStatus.2) OTE(IN_vfd_data.In_DriveStatus_RDY_REF) ,XIC(IN_vfd_data.In_DriveStatus.3) OTE(IN_vfd_data.In_DriveStatus_TRIPPED) ];
				RC: "Map the Drive Status Word to the individual bits";
				N: [XIC(IN_vfd_data.In_DriveStatus.4) OTE(IN_vfd_data.In_DriveStatus_OFF_2_STA) ,XIC(IN_vfd_data.In_DriveStatus.5) OTE(IN_vfd_data.In_DriveStatus_OFF_3_STA) ,XIC(IN_vfd_data.In_DriveStatus.6) OTE(IN_vfd_data.In_DriveStatus_SWC_ON_INHIB) ,XIC(IN_vfd_data.In_DriveStatus.7) OTE(IN_vfd_data.In_DriveStatus_ALARM) ];
				RC: "Map the Drive Status Word to the individual bits";
				N: [XIC(IN_vfd_data.In_DriveStatus.8) OTE(IN_vfd_data.In_DriveStatus_AT_SETPOINT) ,XIC(IN_vfd_data.In_DriveStatus.9) OTE(IN_vfd_data.In_DriveStatus_REMOTE) ,XIC(IN_vfd_data.In_DriveStatus.10) OTE(IN_vfd_data.In_DriveStatus_ABOVE_LIMIT) ,XIC(IN_vfd_data.In_DriveStatus.11) OTE(IN_vfd_data.In_DriveStatus_EXT_CTRL_LOC) ];
				RC: "Map the Drive Status Word to the individual bits";
				N: [XIC(IN_vfd_data.In_DriveStatus.12) OTE(IN_vfd_data.In_DriveStatus_EXT_RUN_ENABLE) ,XIC(IN_vfd_data.In_DriveStatus.13) NOP() ,XIC(IN_vfd_data.In_DriveStatus.14) NOP() ,XIC(IN_vfd_data.In_DriveStatus.15) OTE(IN_vfd_data.In_DriveStatus_FBA_ERROR) ];
				RC: "Status Word - Data[1] - Actual Speed";
				N: CPT(IN_vfd_data.In_OutputRPM,(IN_vfd_inputs.Data[1] * IN_vfd_inputs.Data[3]) / 20000);
				RC: "Status Word - Data[2] - Actual Motor Current";
				N: MOV(IN_vfd_inputs.Data[2],IN_vfd_data.In_OutputCurrent);
				RC: "Status Word - Data[3] - Speed Scaling";
				N: MOV(IN_vfd_inputs.Data[3],IN_vfd_data.In_SpeedScaling);
				RC: "Status Word - Data[4] - Nameplate Hz";
				N: MOV(IN_vfd_inputs.Data[4],IN_vfd_data.In_MotorNPHz);
				RC: "Status Word - Data[5] - Nameplate RPM";
				N: MOV(IN_vfd_inputs.Data[5],IN_vfd_data.In_MotorNPRPM);
				RC: "Status Word - Data[6] - Actual Motor Torque %";
				N: MOV(IN_vfd_inputs.Data[6],IN_vfd_data.IN_OutputTorque);
				RC: "Status Word - Data[7] - Actual Motor Hz";
				N: CPT(IN_vfd_data.IN_OutputHz,(IN_vfd_inputs.Data[7] * IN_vfd_inputs.Data[8]) / 20000);
				RC: "Analog Input Scaling: Convert to Real and scale as necessary";
				N: MOV(0,Out_RPM)CPT(Out_RPM,IN_vfd_data.In_OutputRPM);
				N: [MOV(0,NPRPM) CPT(NPRPM,IN_vfd_data.In_MotorNPRPM) ,LES(NPRPM,1000) MOV(1800,NPRPM) MOV(1800,IN_vfd_data.In_MotorNPRPM) ];
				N: [MOV(0,NPHz) CPT(NPHz,IN_vfd_data.In_MotorNPHz) ,LES(NPHz,50) MOV(60,NPHz) MOV(60,IN_vfd_data.In_MotorNPHz) ];
				N: MOV(0,Out_Amps)CPT(Out_Amps,IN_vfd_data.In_OutputCurrent * 1);
				N: MOV(0,Out_Hz)CPT(Out_Hz,IN_vfd_data.IN_OutputHz * 0.1);
				N: MOV(0,Out_TorquePct)CPT(Out_TorquePct,IN_vfd_data.IN_OutputTorque * 0.01);
				N: CPT(Out_Speed,Out_RPM /IN_Gear_Reduction*3.14159265359*IN_Roll_Diameter);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION sys_ACS880_Outputs (Description := "System AOI$NACS880 Outputs",
	                                                  Revision := "1.0",
	                                                  ExecutePrescan := No,
	                                                  ExecutePostscan := No,
	                                                  ExecuteEnableInFalse := No,
	                                                  CreatedDate := "2023-03-06T20:28:57.583Z",
	                                                  CreatedBy := "AzureAD\ErikBaars",
	                                                  EditedDate := "2023-03-06T20:35:38.521Z",
	                                                  EditedBy := "AzureAD\ErikBaars",
	                                                  SoftwareRevision := "v16.05")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			IO_vfd_outputs : AB:ETHERNET_MODULE_INT_24Bytes:O:0 (Usage := InOut,
			                          Required := Yes,
			                          Visible := Yes);
			IO_vfd_data : vfd_data_ACS880 (Description := "VFD Data Object",
			                       Usage := InOut,
			                       Required := Yes,
			                       Visible := Yes);
			IN_Gear_Reduction : REAL (Usage := Input,
			                             RADIX := Float,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0.00000000e+000);
			IN_Roll_Diameter : REAL (Usage := Input,
			                            RADIX := Float,
			                            Required := Yes,
			                            Visible := Yes,
			                            DefaultData := 0.00000000e+000);
			IN_Speed_Setpoint : REAL (Usage := Input,
			                             RADIX := Float,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0.00000000e+000);
			Out_Speed_Command : REAL (Usage := Output,
			                             RADIX := Float,
			                             Required := No,
			                             Visible := Yes,
			                             ExternalAccess := Read Only,
			                             DefaultData := 0.00000000e+000);
			OUT_Speed_RPM : REAL (Usage := Output,
			                         RADIX := Float,
			                         Required := No,
			                         Visible := Yes,
			                         ExternalAccess := Read Only,
			                         DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			speed_hz : REAL (Description := "Speed Setpoint in Hz",
			                   RADIX := Float,
			                   ExternalAccess := Read/Write,
			                   DefaultData := 0.00000000e+000);
			speed_pct : REAL (Description := "Motor Speed Percent",
			                    RADIX := Float,
			                    ExternalAccess := Read/Write,
			                    DefaultData := 0.00000000e+000);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: [XIC(IO_vfd_data.Out_DriveLogicRslt_OFF1_CONTROL) OTE(IO_vfd_data.Out_DriveLogicRslt.0) ,XIC(IO_vfd_data.Out_DriveLogicRslt_OFF2_CONTROL) OTE(IO_vfd_data.Out_DriveLogicRslt.1) ,XIC(IO_vfd_data.Out_DriveLogicRslt_OFF3_CONTROL) OTE(IO_vfd_data.Out_DriveLogicRslt.2) ,XIC(IO_vfd_data.Out_DriveLogicRslt_INHIBIT_OPERATION) OTE(IO_vfd_data.Out_DriveLogicRslt.3) ];
				N: [XIC(IO_vfd_data.Out_DriveLogicRslt_RAMP_OUT_ZERO) OTE(IO_vfd_data.Out_DriveLogicRslt.4) ,XIC(IO_vfd_data.Out_DriveLogicRslt_RAMP_HOLD) OTE(IO_vfd_data.Out_DriveLogicRslt.5) ,XIC(IO_vfd_data.Out_DriveLogicRslt_RAMP_IN_ZERO) OTE(IO_vfd_data.Out_DriveLogicRslt.6) ,XIC(IO_vfd_data.Out_DriveLogicRslt_RESET) OTE(IO_vfd_data.Out_DriveLogicRslt.7) ];
				N: [XIC(IO_vfd_data.Out_DriveLogicRslt_REMOTE_CMD) OTE(IO_vfd_data.Out_DriveLogicRslt.10) ,XIC(IO_vfd_data.Out_DriveLogicRslt_EXT_CTRL_LOC) OTE(IO_vfd_data.Out_DriveLogicRslt.11) ];
				RC: "Command Word - Data[0] - Control Word";
				N: MOV(IO_vfd_data.Out_DriveLogicRslt,IO_vfd_outputs.Data[0]);
				RC: "RPM Command=(setpoint in units/minute)/(shaft circumference in units)*gear reduction between motor and roll$N"
				    "";
				N: CPT(OUT_Speed_RPM,IN_Speed_Setpoint/( 3.14159265359*IN_Roll_Diameter)*IN_Gear_Reduction);
				RC: "Scale the Speed Setpoint to the speed scaling parameter of the drive";
				N: [CPT(IO_vfd_data.Out_Commanded_SPEED,OUT_Speed_RPM * 20000/IO_vfd_data.In_SpeedScaling) ,LES(IO_vfd_data.Out_Commanded_SPEED,-20000) MOV(-20000,IO_vfd_data.Out_Commanded_SPEED) ,GRT(IO_vfd_data.Out_Commanded_SPEED,20000) MOV(20000,IO_vfd_data.Out_Commanded_SPEED) ,MOV(IO_vfd_data.Out_Commanded_SPEED,Out_Speed_Command) ];
				RC: "Command Word - Data[1] - Commanded Speed";
				N: [XIC(IO_vfd_data.In_DriveStatus_RDY_ON) MOV(IO_vfd_data.Out_Commanded_SPEED,IO_vfd_outputs.Data[1]) ,XIO(IO_vfd_data.In_DriveStatus_RDY_ON) MOV(0,IO_vfd_outputs.Data[1]) ];
				RC: "Command Word - Data [2] - Max Torque";
				N: [XIC(IO_vfd_data.In_DriveStatus_RDY_ON) CPT(IO_vfd_outputs.Data[2],IO_vfd_data.Out_Commanded_Torque*10) ,XIO(IO_vfd_data.In_DriveStatus_RDY_ON) MOV(0,IO_vfd_outputs.Data[2]) ];
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION sys_ACS_FENA21 (Revision := "1.0",
	                                              ExecutePrescan := No,
	                                              ExecutePostscan := No,
	                                              ExecuteEnableInFalse := No,
	                                              CreatedDate := "2023-03-07T13:10:33.630Z",
	                                              CreatedBy := "AzureAD\ErikBaars",
	                                              EditedDate := "2023-03-07T13:11:35.633Z",
	                                              EditedBy := "AzureAD\ErikBaars",
	                                              SoftwareRevision := "v16.05")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			vfd_abb_data : vfd_data_ACS880 (Usage := InOut,
			                        Required := Yes,
			                        Visible := Yes);
			IN_START : BOOL (Usage := Input,
			                    RADIX := Decimal,
			                    Required := Yes,
			                    Visible := Yes,
			                    DefaultData := 0);
			IN_GLOBAL_RESET : BOOL (Usage := Input,
			                           RADIX := Decimal,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0);
			IN_DRIVE_PERMISSIVE : BOOL (Usage := Input,
			                               RADIX := Decimal,
			                               Required := Yes,
			                               Visible := Yes,
			                               DefaultData := 0);
			OUT_FAULT : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read Only,
			                     DefaultData := 0);
			OUT_ALARM : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read Only,
			                     DefaultData := 0);
			OUT_ENABLED : BOOL (Usage := Output,
			                       RADIX := Decimal,
			                       Required := No,
			                       Visible := Yes,
			                       ExternalAccess := Read Only,
			                       DefaultData := 0);
			DRIVE_NOT_READY_FAULT : BOOL (Usage := Output,
			                                 RADIX := Decimal,
			                                 Required := No,
			                                 Visible := No,
			                                 ExternalAccess := Read Only,
			                                 DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
		END_LOCAL_TAGS

		ROUTINE Logic 
				RC: "ABB ACS800 ABB PROTOCOL DRIVE CONTROL";
				N: NOP();
				RC: "Permissive";
				N: NOP();
				N: OTE(vfd_abb_data.Out_DriveLogicRslt_INHIBIT_OPERATION)OTE(vfd_abb_data.Out_DriveLogicRslt_OFF2_CONTROL);
				N: XIC(IN_DRIVE_PERMISSIVE)OTE(vfd_abb_data.Out_DriveLogicRslt_OFF3_CONTROL);
				RC: "Requests";
				N: NOP();
				N: [OTE(vfd_abb_data.Out_DriveLogicRslt_RAMP_OUT_ZERO) ,OTE(vfd_abb_data.Out_DriveLogicRslt_RAMP_HOLD) ,OTE(vfd_abb_data.Out_DriveLogicRslt_RAMP_IN_ZERO) ,OTE(vfd_abb_data.Out_DriveLogicRslt_REMOTE_CMD) ,OTU(vfd_abb_data.Out_DriveLogicRslt_EXT_CTRL_LOC) ];
				N: XIO(vfd_abb_data.In_DriveStatus_SWC_ON_INHIB)XIC(vfd_abb_data.In_DriveStatus_RDY_ON)XIC(vfd_abb_data.Out_DriveLogicRslt_INHIBIT_OPERATION)XIC(IN_START)[OTE(vfd_abb_data.Out_DriveLogicRslt_OFF1_CONTROL) ,OTE(OUT_ENABLED) ];
				N: XIC(IN_GLOBAL_RESET)XIC(vfd_abb_data.In_DriveStatus_TRIPPED)OTE(vfd_abb_data.Out_DriveLogicRslt_RESET);
				RC: "Faults";
				N: NOP();
				N: XIC(vfd_abb_data.In_DriveStatus_TRIPPED)OTE(OUT_FAULT);
				RC: "Warnings";
				N: NOP();
				N: XIC(vfd_abb_data.In_DriveStatus_ALARM)OTE(OUT_ALARM);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

