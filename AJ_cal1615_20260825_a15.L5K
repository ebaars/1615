	ADD_ON_INSTRUCTION_DEFINITION sys_Filter (Description := "System$NFilter",
	                                          Revision := "1.0",
	                                          Vendor := "Rockwell Automation",
	                                          ExecutePrescan := No,
	                                          ExecutePostscan := No,
	                                          ExecuteEnableInFalse := No,
	                                          CreatedDate := "2025-12-22T20:37:26.573Z",
	                                          CreatedBy := "LITZLER\TSG",
	                                          EditedDate := "2025-12-22T20:38:18.521Z",
	                                          EditedBy := "LITZLER\TSG",
	                                          SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			filter : REAL (Usage := Input,
			                  RADIX := Float,
			                  Required := Yes,
			                  Visible := Yes,
			                  DefaultData := 0.00000000e+000);
			In_real : REAL (Usage := Input,
			                   RADIX := Float,
			                   Required := Yes,
			                   Visible := Yes,
			                   DefaultData := 0.00000000e+000);
			Out_Real : REAL (Usage := Output,
			                    RADIX := Float,
			                    Required := Yes,
			                    Visible := Yes,
			                    ExternalAccess := Read Only,
			                    DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			LDL2_01 : LEAD_LAG_SEC_ORDER (ExternalAccess := Read/Write,
