			ROUTINE R16_Letoff_B_VFD 
					RC: "p27r15$N"
					    "This routine is called, continuously, from p27r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r16.comment.0);
