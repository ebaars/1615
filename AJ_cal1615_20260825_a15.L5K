					N: XIC(p01r09_pb_global_reset)MOV(p20r16.warning,p20r16.warning_ack);
					N: XIC(p20_vfd_di_lob.warning)[TON(p20r16_timer_warning[0],?,?) ,XIC(p20r16_timer_warning[0].DN) OTL(p20r16.warning.0) ];
					N: XIC(p20r16.warning_ack.0)XIO(p20_vfd_di_lob.warning)[OTU(p20r16.warning.0) ,OTU(p20r16.warning_ack.0) ];
