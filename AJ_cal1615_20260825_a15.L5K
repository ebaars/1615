					N: OTE(p20r10.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r10.comment.2);
					N: EQU(p20r10.fault,0)OTE(p20r10_run_permissive);
					RC: "Requests";
					N: OTE(p20r10.comment.3);
					N: XIC(p20r10_run_permissive)[XIC(p20r15_request_tension) ,XIC(p20r16_request_tension) ]OTE(p20r10_tension_request);
					RC: "Auto Start Sequence";
					N: OTE(p20r10.comment.4);
					RC: "Configure PID$N"
					    "The tension loadcell feedback is compared to its setpoint in a PID control.$N"
					    "With the PID output at 50%, error is made to be 0$N"
					    "Error is added or subtracted to the Tension of the previous drive to calculate the required Tension of the drive.$N"
					    "A gain factor is used to dampen the error effect on the drive Tension.";
					N: OTE(p20r10.comment.5);
					N: TON(p20r10_timer[0],?,?);
					N: XIO(p20r13_state.8)XIO(p20r13_state.4)MOV(p20r10_param_normal_gain,p20r10_param_psn_gain);
					N: [XIC(p20r13_state.4) ,XIC(p20r13_state.8) ]MOV(p20r10_param_fill_gain,p20r10_param_psn_gain);
					RC: "TENSION CONTROL PID$N"
					    "Arm the PID Parameters$N"
					    "Minimum Control Valve Position = x % (per manufacturer)";
					N: OTE(p20r10.comment.8);
					N: XIO(p20r10_tension_request)OTE(p20r10_pid_tens.SWM);
					N: XIC(p20r10_pid_tens.SWM)MOV(65,p20r10_pid_tens.SO);
					N: MOV(p01_recipe_active.letoff_tension_sp,p20r10_pid_tens.SP)MOV(p20_ai_lc01,p20r10_pid_tens_pv);
					N: MOV(p02_real_from_hmi.letoff[40],p20r10_pid_tens.KP)MOV(p02_real_from_hmi.letoff[41],p20r10_pid_tens.KI)MOV(p02_real_from_hmi.letoff[42],p20r10_pid_tens.KD)MOV(p02_real_from_hmi.letoff[43],p20r10_pid_tens.UPD)MOV(p20r10_pid_tens.BIAS,p20r10_pid_tens.BIAS);
					N: XIC(p20r13_state.8)MOV(p20_param_high_kp,p20r10_pid_tens.KP)MOV(p20_param_high_ki,p20r10_pid_tens.KI)MOV(p20_param_high_upd,p20r10_pid_tens.UPD);
					N: OTE(p20r10_pid_tens.NOBC);
					N: PID(p20r10_pid_tens,p20r10_pid_tens_pv,0,p20r10_pid_tens_cv,0,0,0);
					N: CPT(p20r10_speed_offset_tens,(p20r10_pid_tens_cv-50)*p20r10_param_psn_gain*-1);
					N: [XIC(p20_di_loa_fwd_dir) XIC(p20r15_request_thread_rev) ,XIO(p20_di_loa_fwd_dir) XIC(p20r15_request_thread_fwd) ,XIC(p20_di_lob_fwd_dir) XIC(p20r16_request_thread_rev) ,XIO(p20_di_lob_fwd_dir) XIC(p20r16_request_thread_fwd) ]CPT(p20r10_speed_offset_tens,(p20r10_pid_tens_cv-50)*p20r10_param_psn_gain*1);
					RC: "POSITION CONTROL PID$N"
					    "Arm the PID Parameters$N"
					    "Minimum Control Valve Position = x % (per manufacturer)";
					N: OTE(p20r10.comment.9);
					N: MOV(100,p20r10_param_acc_full_psn);
					N: MOV(p20r10_param_acc_full_psn,p20r10_pid_psn.SP);
					N: XIO(p20r13_state.5)MOV(100,p20r10_pid_psn.SO)OTE(p20r10_pid_psn.SWM);
					N: MOV(p20r13_ai_acc_pct,p20r10_pid_psn_pv);
					N: MOV(p20r10_pid_psn.KP,p20r10_pid_psn.KP)MOV(p20r10_pid_psn.KI,p20r10_pid_psn.KI)MOV(p20r10_pid_psn.KD,p20r10_pid_psn.KD)MOV(p20r10_pid_psn.UPD,p20r10_pid_psn.UPD);
					N: OTE(p20r10_pid_psn.NOBC);
					N: MOV(p20r10_pid_psn.BIAS,p20r10_pid_psn.BIAS)PID(p20r10_pid_psn,p20r10_pid_psn_pv,0,p20r10_pid_psn_cv,0,0,0);
					N: CPT(p20r10_speed_offset_psn,(p20r10_pid_psn_cv-50)*p20r10_param_psn_gain);
					RC: "Output Control";
					N: OTE(p20r10.comment.10);
					N: [MOV(p20r10_speed_offset_tens,p20r10_speed_offset) ,XIO(p20r10_tension_request) MOV(p20r10_speed_offset_psn,p20r10_speed_offset) ];
					RC: "Faults";
					N: OTE(p20r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r10.fault,p20r10.fault_ack);
					N: XIC(FAULT)[TON(p20r10_timer_fault[0],?,?) ,XIC(p20r10_timer_fault[0].DN) OTL(p20r10.fault.0) ];
					N: XIC(p20r10.fault_ack.0)XIC(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r10.fault.0) ,OTU(p20r10.fault_ack.0) ];
					N: NEQ(p20r10.fault,p20r10.fault_ack)OTE(p20r10.unack_fault);
					RC: "Warnings";
					N: OTE(p20r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r10.warning,p20r10.warning_ack);
					N: XIC(FAULT)[TON(p20r10_timer_warning[0],?,?) ,XIC(p20r10_timer_warning[0].DN) OTL(p20r10.warning.0) ];
					N: XIO(FAULT)[OTU(p20r10.warning.0) ,OTU(p20r10.warning_ack.0) ];
					N: NEQ(p20r10.warning,p20r10.warning_ack)OTE(p20r10.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R11_Feedroll 
					RC: "p20r11$N"
					    "This routine is called, continuously, from p20R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p20r11.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r11.comment (dint)$N"
					    "p20r11.oneshot (dint)$N"
					    "p20r11_timer_xxxx (timer)$N"
					    "p20r11_xxxx (any)$N"
					    "p20r11.fault (dint)$N"
