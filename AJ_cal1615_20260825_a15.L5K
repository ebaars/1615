			ROUTINE R02_Misc_Control 
					RC: "p13R02$N"
					    "This routine is called, continuously, from p13R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p13r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p13r02.comment (dint)$N"
					    "p13r02.oneshot (dint)$N"
					    "p13r02_timer_xxxx (timer)$N"
					    "p13r02_xxxx (any)$N"
					    "p13r02.fault (dint)$N"
					    "p13r02.warning (dint)$N"
					    "";
					N: OTE(p13r02.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p13r02.comment.2);
					N: NEQ(p13_dint_to_hmi[0],0)OTE(p13r02_fault_exists);
					N: NEQ(p13_dint_to_hmi[2],0)OTE(p13r02_warning_exists);
					RC: "Requests";
					N: OTE(p13r02.comment.3);
					N: [XIC(p13r02.unack_fault) ,XIC(p13r03.unack_fault) ,XIC(p13r04.unack_fault) ,XIC(p13r05.unack_fault) ,XIC(p13r06.unack_fault) ,XIC(p13r07.unack_fault) ,XIC(p13r08.unack_fault) ,XIC(p13r09.unack_fault) ,XIC(p13r10.unack_fault) ,XIC(p13r20.unack_fault) ,XIC(p13r30.unack_fault) ,XIC(p13r31.unack_fault) ,XIC(p13r32.unack_fault) ]OTE(p13r02_unack_fault);
					N: [XIC(p13r02.unack_warning) ,XIC(p13r03.unack_warning) ,XIC(p13r04.unack_warning) ,XIC(p13r05.unack_warning) ,XIC(p13r06.unack_warning) ,XIC(p13r07.unack_warning) ,XIC(p13r08.unack_warning) ,XIC(p13r09.unack_warning) ,XIC(p13r10.unack_warning) ,XIC(p13r20.unack_warning) ,XIC(p13r30.unack_warning) ,XIC(p13r31.unack_warning) ,XIC(p13r32.unack_warning) ]OTE(p13r02_unack_warning);
					RC: "Sequence";
					N: OTE(p13r02.comment.4);
					N: LES(p13_ai_tc01,p13_param_shutdown_temp)LES(p13_ai_tc02,p13_param_shutdown_temp)XIO(p13r30.warning.1)XIO(p13r30.warning.2)OTE(p13r02_safe_temp);
					N: XIC(p13r02_safe_temp)[TON(p13r02_timer_safe_temp[0],?,?) ,XIC(p13r02_timer_safe_temp[0].DN) OTL(p13r02_shutdown_temp) ];
					N: [XIO(p13r30.warning.1) GRT(p13_ai_tc01,p01_param_temp_limit) ,XIO(p13r30.warning.2) GRT(p13_ai_tc02,p13_param_shutdown_temp) ]OTE(p13r02_not_safe_temp);
					N: XIC(p13r02_not_safe_temp)[TON(p13r02_timer_safe_temp[1],?,?) ,XIC(p13r02_timer_safe_temp[1].DN) OTU(p13r02_shutdown_temp) ];
					RC: "Output Control";
					N: OTE(p13r02.comment.5);
					RC: "Faults";
					N: OTE(p13r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p13r02.fault,p13r02.fault_ack);
					N: XIC(FAULT)[TON(p13r02_timer_fault[0],?,?) ,XIC(p13r02_timer_fault[0].DN) OTL(p13r02.fault.0) ];
					N: XIC(p13r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p13r02.fault.0) ,OTU(p13r02.fault_ack.0) ];
					N: NEQ(p13r02.fault,p13r02.fault_ack)OTE(p13r02.unack_fault);
					RC: "Warnings";
					N: OTE(p13r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p13r02.warning,p13r02.warning_ack);
					RC: "Probably need to add a FIFO for the pressure.";
					N: XIC(FAULT)[TON(p13r02_timer_warning[0],?,?) ,XIC(p13r02_timer_warning[0].DN) OTL(p13r02.warning.0) ];
					N: XIO(FAULT)[OTU(p13r02.warning.0) ,OTU(p13r02.warning_ack.0) ];
					N: NEQ(p13r02.warning,p13r02.warning_ack)OTE(p13r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p13r03$N"
					    "This routine is called, continuously, from p13R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p13r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p13r03.comment (dint)$N"
					    "p13r03.oneshot (dint)$N"
					    "p13r03_timer_xxxx (timer)$N"
					    "p13r03_xxxx (any)$N"
					    "p13r03.fault (dint)$N"
					    "p13r03.warning (dint)$N"
					    "";
					N: OTE(p13r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p13r03.comment.2);
					RC: "Digital";
					N: OTE(p13r03.comment.3);
					N: [XIC(Local:5:I.Data.0) OTE(p13_di_recirc_flow_ok) ,XIC(Local:5:I.Data.1) OTE(p13_di_exh_flow_ok) ,XIC(p00_io_oven:4:I.7) OTE(p13_di_filter_clean) ];
					N: [XIC(p00_io_oven:2:I.Ch4OverrangeAlarm) OTE(p13_di_tc01_bo) ,XIC(p00_io_oven:2:I.Ch5OverrangeAlarm) OTE(p13_di_tc02_bo) ];
					N: [XIC(p00_io_prc:1:I.5) OTE(p13_di_recirc_fan_mtr_ts) ,XIC(p00_io_prc:1:I.6) OTE(p13_di_exh_fan_mtr_ts) ];
					N: XIC(p00_io_oven:4:I.0)OTE(p13_di_door_open);
					N: [XIC(p00_vfd_z3_exhaust:I.Data[0].0) OTE(p13_di_exh.faulted) ,XIC(p00_vfd_z3_exhaust:I.Data[0].1) OTE(p13_di_exh.warning) ,XIC(p00_vfd_z3_exhaust:I.Data[0].2) OTE(p13_di_exh.running_fwd) ,XIC(p00_vfd_z3_exhaust:I.Data[0].3) OTE(p13_di_exh.running_rev) ];
					N: [XIC(p00_vfd_z3_exhaust:I.Data[0].4) OTE(p13_di_exh.ready) ,XIC(p00_vfd_z3_exhaust:I.Data[0].5) OTE(p13_di_exh.ctrl_from_net) ,XIC(p00_vfd_z3_exhaust:I.Data[0].6) OTE(p13_di_exh.ref_from_net) ,XIC(p00_vfd_z3_exhaust:I.Data[0].7) OTE(p13_di_exh.at_reference) ];
					N: XIC(p01r02.fault.6)MOV(0,p00_vfd_z3_exhaust:I.Data[0]);
					N: [XIC(p00_vfd_z3_recirc:I.Data[0].0) OTE(p13_di_recirc.faulted) ,XIC(p00_vfd_z3_recirc:I.Data[0].1) OTE(p13_di_recirc.warning) ,XIC(p00_vfd_z3_recirc:I.Data[0].2) OTE(p13_di_recirc.running_fwd) ,XIC(p00_vfd_z3_recirc:I.Data[0].3) OTE(p13_di_recirc.running_rev) ];
					N: [XIC(p00_vfd_z3_recirc:I.Data[0].4) OTE(p13_di_recirc.ready) ,XIC(p00_vfd_z3_recirc:I.Data[0].5) OTE(p13_di_recirc.ctrl_from_net) ,XIC(p00_vfd_z3_recirc:I.Data[0].6) OTE(p13_di_recirc.ref_from_net) ,XIC(p00_vfd_z3_recirc:I.Data[0].7) OTE(p13_di_recirc.at_reference) ];
					N: XIC(p01r02.fault.5)MOV(0,p00_vfd_z3_recirc:I.Data[0]);
					RC: "Analog";
					N: OTE(p13r03.comment.4);
					N: CPT(p13_ai_tc01,p00_io_oven:2:I.Ch4Data*0.1)ADD(p13_ai_tc01,p13_param_tc01z,p13_ai_tc01);
					N: CPT(p13_ai_tc02,p00_io_oven:2:I.Ch5Data*0.1)ADD(p13_ai_tc02,p13_param_tc02z,p13_ai_tc02);
					RC: "VFD";
					N: OTE(p13r03.comment.5);
					N: CPT(p13_ai_recirc_rpm,p00_vfd_z3_recirc:I.Data[1]*1);
					N: CPT(p13_ai_recirc_amps,p00_vfd_z3_recirc:I.Data[2]*0.1);
					N: CPT(p13_ai_recirc_hz_max,p00_vfd_z3_recirc:I.Data[4]*0.1)SYS_SCP(p13r03_hz,p00_vfd_z3_recirc:I.Data[1],0,1750,0,p13_ai_recirc_hz_max,p13_ai_recirc_hz);
					N: CPT(p13_ai_exhaust_rpm,p00_vfd_z3_exhaust:I.Data[1]*1);
					N: CPT(p13_ai_exhaust_amps,p00_vfd_z3_exhaust:I.Data[2]*0.1);
					N: CPT(p13_ai_exhaust_hz_max,p00_vfd_z3_exhaust:I.Data[4]*0.1)SYS_SCP(p13r03_hz,p00_vfd_z3_exhaust:I.Data[1],0,1750,0,p13_ai_exhaust_hz_max,p13_ai_exhaust_hz);
					RC: "Faults";
					N: OTE(p13r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p13r03.fault,p13r03.fault_ack);
					N: XIC(FAULT)[TON(p13r03_timer_fault[0],?,?) ,XIC(p13r03_timer_fault[0].DN) OTL(p13r03.fault.0) ];
					N: XIC(p13r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p13r03.fault.0) ,OTU(p13r03.fault_ack.0) ];
					N: NEQ(p13r03.fault,p13r03.fault_ack)OTE(p13r03.unack_fault);
					RC: "Warnings";
					N: OTE(p13r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p13r03.warning,p13r03.warning_ack);
					N: XIC(FAULT)[TON(p13r03_timer_warning[0],?,?) ,XIC(p13r03_timer_warning[0].DN) OTL(p13r03.warning.0) ];
					N: XIO(FAULT)[OTU(p13r03.warning.0) ,OTU(p13r03.warning_ack.0) ];
					N: NEQ(p13r03.warning,p13r03.warning_ack)OTE(p13r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p13r04$N"
					    "This routine is called, continuously, from p13R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p13r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p13r04.comment (dint)$N"
					    "p13r04.oneshot (dint)$N"
					    "p13r04_timer_xxxx (timer)$N"
					    "p13r04_xxxx (any)$N"
					    "p13r04.fault (dint)$N"
					    "p13r04.warning (dint)$N"
					    "";
					N: OTE(p13r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p13r04.comment.2);
					RC: "Digital";
					N: OTE(p13r04.comment.3);
					N: [XIC(p13_do_exh.forward) OTE(p00_vfd_z3_exhaust:O.Data[0].0) ,XIC(p13_do_exh.reverse) OTE(p00_vfd_z3_exhaust:O.Data[0].1) ,XIC(p13_do_exh.fault_reset) OTE(p00_vfd_z3_exhaust:O.Data[0].2) ,OTE(p00_vfd_z3_exhaust:O.Data[0].6) ,OTE(p00_vfd_z3_exhaust:O.Data[0].5) ];
					N: [XIC(p13_do_recirc.forward) OTE(p00_vfd_z3_recirc:O.Data[0].0) ,XIC(p13_do_recirc.reverse) OTE(p00_vfd_z3_recirc:O.Data[0].1) ,XIC(p13_do_recirc.fault_reset) OTE(p00_vfd_z3_recirc:O.Data[0].2) ,OTE(p00_vfd_z3_recirc:O.Data[0].5) ,OTE(p00_vfd_z3_recirc:O.Data[0].6) ];
					RC: "Analog";
					N: OTE(p13r04.comment.4);
					N: SYS_SCP(p01_sys_scp,p13_ao_cv,p13_hc_input_min,p13_hc_input_max,p13_hc_output_min,p13_hc_output_max,p00_io_oven:0:O.Ch2Data);
					RC: "VFD";
					N: OTE(p13r04.comment.5);
					N: SYS_SCP(p01_sys_scp,p13_ao_exhaust_selected_speed,p13_exhaust_input_min,p13_exhaust_input_max,p13_exhaust_output_min,p13_exhaust_output_max,p00_vfd_z3_exhaust:O.Data[1]);
					N: SYS_SCP(p01_sys_scp,p13_ao_recirc_selected_speed,p13_recirc_input_min,p13_recirc_input_max,p13_recirc_output_min,p13_recirc_output_max,p00_vfd_z3_recirc:O.Data[1]);
					RC: "Faults";
					N: OTE(p13r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p13r04.fault,p13r04.fault_ack);
					N: XIC(FAULT)[TON(p13r04_timer_fault[0],?,?) ,XIC(p13r04_timer_fault[0].DN) OTL(p13r04.fault.0) ];
					N: XIC(p13r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p13r04.fault.0) ,OTU(p13r04.fault_ack.0) ];
					N: NEQ(p13r04.fault,p13r04.fault_ack)OTE(p13r04.unack_fault);
					RC: "Warnings";
					N: OTE(p13r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p13r04.warning,p13r04.warning_ack);
					N: XIC(FAULT)[TON(p13r04_timer_warning[0],?,?) ,XIC(p13r04_timer_warning[0].DN) OTL(p13r04.warning.0) ];
					N: XIO(FAULT)[OTU(p13r04.warning.0) ,OTU(p13r04.warning_ack.0) ];
					N: NEQ(p13r04.warning,p13r04.warning_ack)OTE(p13r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p13r05$N"
					    "This routine is called, continuously, from p13R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p13r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p13r05.comment (dint)$N"
					    "p13r05.oneshot (dint)$N"
					    "p13r05_timer_xxxx (timer)$N"
					    "p13r05_xxxx (any)$N"
					    "p13r05.fault (dint)$N"
					    "p13r05.warning (dint)$N"
					    "";
					N: OTE(p13r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p13r05.comment.2);
					RC: "0,1 = Alarms$N"
					    "2,3 = Warnings$N"
					    "4,5 = Process Indicators$N"
					    "6-15 Status";
					N: OTE(p13r05.comment.3);
					N: [EQU(p13r30.fault,0) OTE(p13_dint_to_hmi[4].0) ,XIC(p13r30_vfds_ready) OTE(p13_dint_to_hmi[4].1) ,XIC(HMI) OTE(p13_dint_to_hmi[4].2) ,XIC(HMI) OTE(p13_dint_to_hmi[4].3) ];
					N: [XIC(p13r31_request_auto_run) OTE(p13_dint_to_hmi[4].4) ,XIC(p13r31_vfd_stopped) OTE(p13_dint_to_hmi[4].5) ,XIC(p13r31_request_auto_stop) OTE(p13_dint_to_hmi[4].6) ,XIC(HMI) OTE(p13_dint_to_hmi[4].7) ];
					N: [XIC(p13r32_request_auto_run) OTE(p13_dint_to_hmi[4].8) ,XIO(p13r32_request_auto_run) OTE(p13_dint_to_hmi[4].9) ,XIC(p13r32_request_auto_stop) OTE(p13_dint_to_hmi[4].10) ,XIC(HMI) OTE(p13_dint_to_hmi[4].11) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[4].12) ,XIC(HMI) OTE(p13_dint_to_hmi[4].13) ,XIC(HMI) OTE(p13_dint_to_hmi[4].14) ,XIC(HMI) OTE(p13_dint_to_hmi[4].15) ];
					N: [XIC(p13r30_request_cool) OTE(p13_dint_to_hmi[4].16) ,XIO(p13r30_request_cool) OTE(p13_dint_to_hmi[4].17) ,XIC(p13r30_request_manual) OTE(p13_dint_to_hmi[4].18) ,XIO(p13r30_request_manual) OTE(p13_dint_to_hmi[4].19) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[4].20) ,XIC(HMI) OTE(p13_dint_to_hmi[4].21) ,XIC(HMI) OTE(p13_dint_to_hmi[4].22) ,XIC(HMI) OTE(p13_dint_to_hmi[4].23) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[4].24) ,XIC(HMI) OTE(p13_dint_to_hmi[4].25) ,XIC(HMI) OTE(p13_dint_to_hmi[4].26) ,XIC(HMI) OTE(p13_dint_to_hmi[4].27) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[4].28) ,XIC(HMI) OTE(p13_dint_to_hmi[4].29) ,XIC(HMI) OTE(p13_dint_to_hmi[4].30) ,XIC(HMI) OTE(p13_dint_to_hmi[4].31) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[5].0) ,XIC(HMI) OTE(p13_dint_to_hmi[5].1) ,XIC(p13_di_filter_clean) OTE(p13_dint_to_hmi[5].2) ,XIC(HMI) OTE(p13_dint_to_hmi[5].3) ];
					N: [XIC(p13_di_door_open) OTE(p13_dint_to_hmi[5].4) ,XIC(p13_di_exh_fan_mtr_ts) OTE(p13_dint_to_hmi[5].5) ,XIC(p13_di_exh_flow_ok) OTE(p13_dint_to_hmi[5].6) ,XIC(HMI) OTE(p13_dint_to_hmi[5].7) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[5].8) ,XIC(HMI) OTE(p13_dint_to_hmi[5].9) ,XIC(p13_di_recirc_fan_mtr_ts) OTE(p13_dint_to_hmi[5].10) ,XIC(p13_di_recirc_flow_ok) OTE(p13_dint_to_hmi[5].11) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[5].12) ,XIC(HMI) OTE(p13_dint_to_hmi[5].13) ,XIC(p13_di_tc01_bo) OTE(p13_dint_to_hmi[5].14) ,XIC(p13_di_tc02_bo) OTE(p13_dint_to_hmi[5].15) ];
					N: [XIC(p13_di_exh.faulted) OTE(p13_dint_to_hmi[6].0) ,XIC(p13_di_exh.warning) OTE(p13_dint_to_hmi[6].1) ,XIC(p13_di_exh.running_fwd) OTE(p13_dint_to_hmi[6].2) ,XIC(p13_di_exh.running_rev) OTE(p13_dint_to_hmi[6].3) ];
					N: [XIC(p13_di_exh.ready) OTE(p13_dint_to_hmi[6].4) ,XIC(p13_di_exh.ctrl_from_net) OTE(p13_dint_to_hmi[6].5) ,XIC(p13_di_exh.ref_from_net) OTE(p13_dint_to_hmi[6].6) ,XIC(p13_di_exh.at_reference) OTE(p13_dint_to_hmi[6].7) ];
					N: [XIC(p13_di_recirc.faulted) OTE(p13_dint_to_hmi[6].8) ,XIC(p13_di_recirc.warning) OTE(p13_dint_to_hmi[6].9) ,XIC(p13_di_recirc.running_fwd) OTE(p13_dint_to_hmi[6].10) ,XIC(p13_di_recirc.running_rev) OTE(p13_dint_to_hmi[6].11) ];
					N: [XIC(p13_di_recirc.ready) OTE(p13_dint_to_hmi[6].12) ,XIC(p13_di_recirc.ctrl_from_net) OTE(p13_dint_to_hmi[6].13) ,XIC(p13_di_recirc.ref_from_net) OTE(p13_dint_to_hmi[6].14) ,XIC(p13_di_recirc.at_reference) OTE(p13_dint_to_hmi[6].15) ];
					RC: "Sequence";
					N: OTE(p13r05.comment.4);
					N: MOV(0,p13_dint_to_hmi[7])MOV(p13r20_status,p13_dint_to_hmi[8]);
					N: MOV(0,p13r05_temp_ctl_status)[XIC(p13r30_permissive_run) MOV(1,p13r05_temp_ctl_status) ,XIC(p13r30_request_cool) MOV(2,p13r05_temp_ctl_status) ,XIC(p13r20_state.31) MOV(8,p13r05_temp_ctl_status) ,XIO(p13r30_permissive_run) MOV(4,p13r05_temp_ctl_status) ];
					N: MOV(p13r05_temp_ctl_status,p13_dint_to_hmi[9]);
					RC: "1 = Ready$N"
					    "2 = Running$N"
					    "3 = $N"
					    "4 = Fault$N"
					    "5 = Offline$N"
					    "6 = Auto Stop";
					N: MOV(5,p13r05_exh_status)[EQU(p13r31.fault,0) MOV(1,p13r05_exh_status) ,XIC(p13_di_exh.running_fwd) MOV(2,p13r05_exh_status) ,XIC(p13r31_vfd_stopped) MOV(3,p13r05_exh_status) ,NEQ(p13r31.fault,0) MOV(4,p13r05_exh_status) ];
					N: MOV(p13r05_exh_status,p13_dint_to_hmi[10]);
					N: MOV(5,p13r05_recirc_status)[EQU(p13r32.fault,0) MOV(1,p13r05_recirc_status) ,XIC(p13_di_recirc.running_fwd) MOV(2,p13r05_recirc_status) ,XIC(p13r32_vfd_stopped) MOV(3,p13r05_recirc_status) ,NEQ(p13r32.fault,0) MOV(4,p13r05_recirc_status) ];
					N: MOV(p13r05_recirc_status,p13_dint_to_hmi[11]);
					N: MOV(0,p13_dint_to_hmi[12])MOV(0,p13_dint_to_hmi[13])MOV(0,p13_dint_to_hmi[14])MOV(0,p13_dint_to_hmi[15]);
					RC: "Output Control";
					N: OTE(p13r05.comment.5);
					RC: "Faults";
					N: OTE(p13r05.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p13r05.fault,p13r05.fault_ack);
					N: XIC(FAULT)[TON(p13r05_timer_fault[0],?,?) ,XIC(p13r05_timer_fault[0].DN) OTL(p13r05.fault.0) ];
					N: XIC(p13r05.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p13r05.fault.0) ,OTU(p13r05.fault_ack.0) ];
					N: NEQ(p13r05.fault,p13r05.fault_ack)OTE(p13r05.unack_fault);
					RC: "Warnings";
					N: OTE(p13r05.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p13r05.warning,p13r05.warning_ack);
					N: XIC(FAULT)[TON(p13r05_timer_warning[0],?,?) ,XIC(p13r05_timer_warning[0].DN) OTL(p13r05.warning.0) ];
					N: XIO(FAULT)[OTU(p13r05.warning.0) ,OTU(p13r05.warning_ack.0) ];
					N: NEQ(p13r05.warning,p13r05.warning_ack)OTE(p13r05.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R06_Real_to_HMI 
					RC: "Notes:$N"
					    "";
					N: OTE(p13r06.comment.2);
					RC: "Analog Input";
					N: OTE(p13r06.comment.3);
					N: MOV(p13_ai_tc01,p13_real_to_hmi[0])MOV(p13_ai_tc02,p13_real_to_hmi[1])CPT(p13_real_to_hmi[2],p13r30_pid_temp_pv);
					N: MOV(0,p13_real_to_hmi[3])MOV(0,p13_real_to_hmi[4])MOV(0,p13_real_to_hmi[5]);
					N: MOV(0,p13_real_to_hmi[6])MOV(0,p13_real_to_hmi[7])MOV(p13_ai_exhaust_hz,p13_real_to_hmi[8]);
					N: MOV(p13_ai_exhaust_amps,p13_real_to_hmi[9])MOV(p13_ai_exhaust_rpm,p13_real_to_hmi[10])MOV(p13_ai_exhaust_pct,p13_real_to_hmi[11]);
					N: MOV(p13_ai_recirc_hz,p13_real_to_hmi[12])MOV(p13_ai_recirc_amps,p13_real_to_hmi[13])MOV(p13_ai_recirc_rpm,p13_real_to_hmi[14]);
					N: MOV(p13_ai_recirc_pct,p13_real_to_hmi[15])MOV(0.0,p13_real_to_hmi[16])MOV(0.0,p13_real_to_hmi[17]);
					N: MOV(0,p13_real_to_hmi[18])MOV(0,p13_real_to_hmi[19])MOV(0,p13_real_to_hmi[20]);
					N: MOV(0,p13_real_to_hmi[21])MOV(0,p13_real_to_hmi[22])MOV(0,p13_real_to_hmi[23]);
					RC: "Analog Output";
					N: OTE(p13r06.comment.4);
					N: MOV(p13_ao_cv,p13_real_to_hmi[24])MOV(0,p13_real_to_hmi[25])MOV(0,p13_real_to_hmi[26]);
					N: MOV(0,p13_real_to_hmi[27])MOV(p13_ao_exhaust_selected_speed,p13_real_to_hmi[28])MOV(0,p13_real_to_hmi[29]);
					N: MOV(p13_ao_recirc_selected_speed,p13_real_to_hmi[30])MOV(0,p13_real_to_hmi[31]);
					N: MOV(0,p13_real_to_hmi[32])MOV(0,p13_real_to_hmi[33]);
					N: MOV(0,p13_real_to_hmi[34])MOV(0,p13_real_to_hmi[35])MOV(0,p13_real_to_hmi[36]);
					N: MOV(0,p13_real_to_hmi[37])MOV(0,p13_real_to_hmi[38])MOV(0,p13_real_to_hmi[39]);
					RC: "Configuration Parameters";
					N: OTE(p13r06.comment.5);
					N: MOV(p13_param_tc01z,p13_real_to_hmi[40])MOV(p13_param_tc02z,p13_real_to_hmi[41])MOV(0,p13_real_to_hmi[42]);
					N: MOV(0,p13_real_to_hmi[43])MOV(p13_param_pid1_kp,p13_real_to_hmi[44])MOV(p13_param_pid1_ki,p13_real_to_hmi[45]);
					N: MOV(p13_param_pid1_kd,p13_real_to_hmi[46])MOV(p13_param_pid1_ff,p13_real_to_hmi[47])MOV(p13_param_pid2_kp,p13_real_to_hmi[48]);
					N: MOV(p13_param_pid2_ki,p13_real_to_hmi[49])MOV(p13_param_pid2_kd,p13_real_to_hmi[50])MOV(p13_param_pid2_ff,p13_real_to_hmi[51]);
					N: MOV(p13_param_tc01_hl,p13_real_to_hmi[52])MOV(0.0,p13_real_to_hmi[53])MOV(p13_param_tc01_dev,p13_real_to_hmi[54]);
					N: MOV(p13_param_lfl_hl,p13_real_to_hmi[55])MOV(p13_param_lfl_hhl,p13_real_to_hmi[56])MOV(p13_param_shutdown_temp,p13_real_to_hmi[57]);
					N: MOV(p13_param_zone_pressure,p13_real_to_hmi[58])MOV(p13_param_fast_to_soak,p13_real_to_hmi[59])MOV(p13_param_soak_to_fast,p13_real_to_hmi[60]);
					N: MOV(0,p13_real_to_hmi[61])MOV(0,p13_real_to_hmi[62])MOV(0,p13_real_to_hmi[63]);
					RC: "Setpoints";
					N: OTE(p13r06.comment.6);
					N: MOV(0,p13_real_to_hmi[64])MOV(0,p13_real_to_hmi[65])MOV(0,p13_real_to_hmi[66]);
					N: MOV(p13r30_pid_temp_sp,p13_real_to_hmi[67])MOV(p13r30_cv_man_sp,p13_real_to_hmi[68])MOV(0,p13_real_to_hmi[69]);
					N: MOV(0,p13_real_to_hmi[70])MOV(0,p13_real_to_hmi[71]);
					RC: "Misc Info";
					N: OTE(p13r06.comment.7);
					N: MOV(p13r30_pid_temp_pv,p13_real_to_hmi[72])MOV(0,p13_real_to_hmi[73]);
					N: MOV(0,p13_real_to_hmi[74])MOV(0,p13_real_to_hmi[75]);
					N: MOV(0,p13_real_to_hmi[76])MOV(0,p13_real_to_hmi[77]);
					N: MOV(0,p13_real_to_hmi[78])MOV(0,p13_real_to_hmi[79]);
					RC: "Faults";
					N: OTE(p13r06.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p13r06.fault,p13r06.fault_ack);
					N: XIC(FAULT)[TON(p13r06_timer_fault[0],?,?) ,XIC(p13r06_timer_fault[0].DN) OTL(p13r06.fault.0) ];
					N: XIC(p13r06.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p13r06.fault.0) ,OTU(p13r06.fault_ack.0) ];
					N: NEQ(p13r06.fault,p13r06.fault_ack)OTE(p13r06.unack_fault);
					RC: "Warnings";
					N: OTE(p13r06.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p13r06.warning,p13r06.warning_ack);
					N: XIC(FAULT)[TON(p13r06_timer_warning[0],?,?) ,XIC(p13r06_timer_warning[0].DN) OTL(p13r06.warning.0) ];
					N: XIO(FAULT)[OTU(p13r06.warning.0) ,OTU(p13r06.warning_ack.0) ];
					N: NEQ(p13r06.warning,p13r06.warning_ack)OTE(p13r06.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R07_Alarms 
					RC: "p13r07$N"
					    "This routine is called, continuously, from p13R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p13r07.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p13r07.comment (dint)$N"
					    "p13r07.oneshot (dint)$N"
					    "p13r07_timer_xxxx (timer)$N"
					    "p13r07_xxxx (any)$N"
					    "p13r07.fault (dint)$N"
					    "p13r07.warning (dint)$N"
					    "";
					N: OTE(p13r07.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p13r07.comment.2);
					RC: "Alarms";
					N: OTE(p13r07.comment.3);
					N: [XIC(HMI) OTE(p13_dint_to_hmi[0].0) ,XIC(HMI) OTE(p13_dint_to_hmi[0].1) ,XIC(p13r30.fault.2) OTE(p13_dint_to_hmi[0].2) ,XIC(HMI) OTE(p13_dint_to_hmi[0].3) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[0].4) ,XIC(HMI) OTE(p13_dint_to_hmi[0].5) ,XIC(HMI) OTE(p13_dint_to_hmi[0].6) ,XIC(HMI) OTE(p13_dint_to_hmi[0].7) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[0].8) ,XIC(p13r30.fault.9) OTE(p13_dint_to_hmi[0].9) ,XIC(HMI) OTE(p13_dint_to_hmi[0].10) ,XIC(HMI) OTE(p13_dint_to_hmi[0].11) ];
					N: [XIC(HMI) OTE(p13_dint_to_hmi[0].12) ,XIC(HMI) OTE(p13_dint_to_hmi[0].13) ,XIC(HMI) OTE(p13_dint_to_hmi[0].14) ,XIC(HMI) OTE(p13_dint_to_hmi[0].15) ];
