					N: XIC(p20r16_lob_on)[XIO(p01r13_line_running) ,XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p20r13_state.4)XIO(p20r16_request_stop)OTE(p20r16_request_over_speed);
					N: XIC(p20r16_lob_on)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p20r13_state.5)XIO(p20r16_request_stop)OTE(p20r16_request_position);
					N: XIC(p20r16_permissive_run)XIC(p20_di_lob_fwd_dir)[XIC(p20_di_lob_jog) XIC(p20r16_zero_speed) ,XIC(p20r16_request_jog_fwd) XIO(p20r16_zero_speed) ]OTE(p20r16_request_jog_fwd);
					N: XIC(p20r16_permissive_run)XIO(p20_di_lob_fwd_dir)[XIC(p20_di_lob_jog) XIC(p20r16_zero_speed) ,XIC(p20r16_request_jog_rev) XIO(p20r16_zero_speed) ]OTE(p20r16_request_jog_rev);
					N: XIC(p20r16_lob_on)[XIC(p20_di_lob_fwd_dir) [XIC(p22r11_request_thread_fwd) ,XIC(p25r11_request_thread_fwd) ] ,XIO(p20_di_lob_fwd_dir) [XIC(p22r11_request_thread_rev) ,XIC(p25r11_request_thread_rev) ] ]OTE(p20r16_request_thread_fwd);
					N: XIC(p20r16_lob_on)[XIC(p20_di_lob_fwd_dir) [XIC(p22r11_request_thread_rev) ,XIC(p25r11_request_thread_rev) ] ,XIO(p20_di_lob_fwd_dir) [XIC(p22r11_request_thread_fwd) ,XIC(p25r11_request_thread_fwd) ] ]OTE(p20r16_request_thread_rev);
					N: LEQ(p20_ai_lob_speed,0.1)OTE(p20r16_zero_speed);
					RC: "Outputs";
					N: OTE(p20r16.comment.5);
					N: XIC(p20r16_permissive_run)[XIC(p20_di_lob_fwd_dir) [XIC(p20r16_request_tension) ,XIC(p20r16_request_position) ,XIC(p20r16_request_over_speed) ] ,XIC(p20r16_request_thread_fwd) ,XIC(p20r16_request_jog_fwd) ]OTE(p20_vfd_do_lob.forward);
					N: XIC(p20r16_permissive_run)[XIO(p20_di_lob_fwd_dir) [XIC(p20r16_request_tension) ,XIC(p20r16_request_position) ,XIC(p20r16_request_over_speed) ] ,XIC(p20r16_request_thread_rev) ,XIC(p20r16_request_jog_rev) ]OTE(p20_vfd_do_lob.reverse);
					N: XIC(p01r09_pb_global_reset)OTE(p20_vfd_do_lob.fault_reset);
					RC: "Speed Control";
					N: OTE(p20r16.comment.6);
					N: CPT(p20r16_lob_selected_speed,ABS(p22_ao_selected_speed)*1);
					N: CPT(p20r16_lob_selected_speed,p20r16_lob_selected_speed+(p20r16_lob_selected_speed*p20r10_speed_offset));
					N: XIC(p20r16_request_over_speed)[[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ] [LES(p01r12_master_ramped_speed,10) MOV(p20_param_lof_slow_fill,p20r16_lob_selected_speed) ,GEQ(p01r12_master_ramped_speed,10) MOV(p20_param_lof_fast_fill,p20r16_lob_selected_speed) ] ,XIO(p01r13_line_running) MOV(p20_param_lof_stop_fill,p20r16_lob_selected_speed) ];
					N: [XIC(p20r16_request_jog_fwd) ,XIC(p20r16_request_jog_rev) ]XIC(p20_di_lob_jog)MOV(p20_param_letoff_jog_speed,p20r16_lob_selected_speed);
					N: XIO(p20r16_request_tension)XIO(p20r16_request_over_speed)XIO(p20r16_request_position)XIO(p20r16_request_thread_fwd)XIO(p20r16_request_thread_rev)XIO(p20_di_lob_jog)MOV(0,p20r16_lob_selected_speed);
					N: XIC(p20r16_request_tension)XIC(p20r13_state.1)MOV(p20_param_high_accel_rate,p20r16_lob_accel)MOV(p20_param_high_decel_rate,p20r16_lob_decel);
					N: XIC(p20r16_request_tension)XIC(p20r13_state.2)MOV(p20_param_norm_accel_rate,p20r16_lob_accel)MOV(p20_param_norm_decel_rate,p20r16_lob_decel);
					N: XIC(p20_di_lob_jog)MOV(p20_param_jog_accel_rate,p20r16_lob_accel)MOV(p20_param_jog_decel_rate,p20r16_lob_decel);
					N: XIC(p20r13_state.8)CPT(p20_ao_lob_selected_speed,ABS(p22_ao_selected_speed)*1);
					N: XIO(p20r13_state.8)SYS_ACC_DEC_RAMP(p20r16_loa_accel_decel_ramp,p20r16_lob_selected_speed,p20r16_lob_accel,p20r16_lob_decel,p01r02_plc_scan_time_in_sec,p20_ao_lob_selected_speed)MOV(p20_ao_lob_selected_speed,p20_ao_lob_selected_speed);
					N: XIO(p20r16_permissive_run)MOV(0,p20_ao_lob_selected_speed);
					RC: "Torque";
					N: OTE(p20r16.comment.29);
					N: MOV(p20_param_run_torque,p20_ao_lob_torque);
					RC: "Faults";
					N: OTE(p20r16.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r16.fault,p20r16.fault_ack);
					N: XIC(p20_vfd_di_lob.faulted)[TON(p20r16_timer_fault[0],?,?) ,XIC(p20r16_timer_fault[0].DN) OTL(p20r16.fault.0) ];
					N: XIC(p20r16.fault_ack.0)XIO(p20_vfd_di_lob.faulted)XIC(p01r09_pb_global_reset)[OTU(p20r16.fault.0) ,OTU(p20r16.fault_ack.0) ];
					N: XIO(p20_vfd_di_lob.ready)[TON(p20r16_timer_fault[2],?,?) ,XIC(p20r16_timer_fault[2].DN) OTL(p20r16.fault.2) ];
					N: XIC(p20r16.fault_ack.2)XIC(p20_vfd_di_lob.ready)XIC(p01r09_pb_global_reset)[OTU(p20r16.fault.2) ,OTU(p20r16.fault_ack.2) ];
					N: XIC(p20_vfd_di_lob.ready)XIO(p20_vfd_di_lob.ctrl_from_net)[TON(p20r16_timer_fault[3],?,?) ,XIC(p20r16_timer_fault[3].DN) OTL(p20r16.fault.3) ];
					N: XIC(p20r16.fault_ack.3)[XIC(p20_vfd_di_lob.ctrl_from_net) ,XIO(p20_vfd_di_lob.ready) ]XIC(p01r09_pb_global_reset)[OTU(p20r16.fault.3) ,OTU(p20r16.fault_ack.3) ];
					N: XIO(p20_di_lob_motor_thermostat)[TON(p20r16_timer_fault[4],?,?) ,XIC(p20r16_timer_fault[4].DN) OTL(p20r16.fault.4) ];
					N: XIC(p20r16.fault.4)XIC(p20_di_lob_motor_thermostat)XIC(p01r09_pb_global_reset)[OTU(p20r16.fault.4) ,OTU(p20r16.fault_ack.4) ];
					N: XIO(p20_di_lob_brake_thermostat)[TON(p20r16_timer_fault[5],?,?) ,XIC(p20r16_timer_fault[5].DN) OTL(p20r16.fault.5) ];
					N: XIC(p20r16.fault.5)XIC(p20_di_lob_brake_thermostat)XIC(p01r09_pb_global_reset)[OTU(p20r16.fault.5) ,OTU(p20r16.fault_ack.5) ];
