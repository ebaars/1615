					N: XIC(p23r15.fault_ack.3)[XIC(p23_di_metering_roll.ctrl_from_net) ,XIO(p23_di_metering_roll.ready) ]XIC(p01r09_pb_global_reset)[OTU(p23r15.fault.3) ,OTU(p23r15.fault_ack.3) ];
					N: XIO(p23_di_therm)[TON(p23r15_timer_fault[4],?,?) ,XIC(p23r15_timer_fault[4].DN) OTL(p23r15.fault.4) ];
					N: XIC(p23r15.fault_ack.4)XIC(p23_di_therm)XIC(p01r09_pb_global_reset)[OTU(p23r15.fault.4) ,OTU(p23r15.fault_ack.4) ];
