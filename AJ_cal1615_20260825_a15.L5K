					N: MOV(p01_param_master_jog_speed,p22_param_ts1_jog_speed);
					N: MOV(p01_param_master_jog_speed,p23_param_mtr_jog_speed);
					N: MOV(p01_param_master_jog_speed,p25_param_ts2_jog_speed);
					RC: "Requests";
					N: OTE(p01r12.comment.3);
					N: [XIC(p22r09_mode_thread) [XIC(p22r11_request_thread_fwd) XIC(p22r09_pb_jog_fwd) ,XIC(p22r11_request_thread_rev) XIC(p22r09_pb_jog_rev) ] ,XIC(p25r09_mode_thread) [XIC(p25r11_request_thread_fwd) XIC(p25r09_pb_jog_fwd) ,XIC(p25r11_request_thread_rev) XIC(p25r09_pb_jog_rev) ] ]OTE(p01r12_request_any_jog_thread);
					RC: "Line Speed Master Control";
					N: OTE(p01r12.comment.4);
					N: XIC(p01r13_line_running)XIC(p01r09_mode_run)[MOV(p01_param_master_accel,p01r12_accel_rate) MOV(p01_param_master_decel,p01r12_decel_rate) ,MOV(p01_recipe_active.line_speed_sp,p01r12_selected_line_speed) ];
					N: XIC(p01r13_line_slow_ramp)XIC(p01r09_mode_run)[MOV(p01_param_master_accel,p01r12_accel_rate) MOV(p01_param_master_decel,p01r12_decel_rate) ,MOV(p01_param_slow_speed_sp,p01r12_selected_line_speed) ];
					N: [XIC(p01r09_pb_line_jog) XIC(p01r09_request_line_jog) ,XIC(p01r12_request_any_jog_thread) ][MOV(p01_param_master_jog_accel,p01r12_accel_rate) MOV(p01_param_master_jog_decel,p01r12_decel_rate) ,MOV(p01_param_master_jog_speed,p01r12_selected_line_speed) ];
					N: [XIO(p01r09_request_line_jog) XIO(p01r12_request_any_jog_thread) ,XIC(p01r09_request_line_jog) XIO(p01r09_pb_line_jog) ][XIO(p01r13_line_running) XIO(p01r13_line_slow_ramp) ,XIC(p01r13_state.8) ]MOV(0,p01r12_selected_line_speed);
					N: SYS_ACC_DEC_RAMP(p01r12_master_acel_decel_ramp,p01r12_selected_line_speed,p01r12_accel_rate,p01r12_decel_rate,p01r02_plc_scan_time_in_sec,p01r12_ramped_setpoint)MOV(p01r12_ramped_setpoint,p01r12_ramped_setpoint);
					N: XIC(p01r13_state.7)EQU(p01r12_selected_line_speed,p01r12_master_ramped_speed)OTE(p01r12_line_at_speed);
					RC: "Output Control";
					N: OTE(p01r12.comment.5);
					N: XIC(p01r13_permissive_drives)MOV(p01r12_ramped_setpoint,p01r12_master_ramped_speed);
					N: [XIC(p01r09.fault.0) ,XIO(p01r13_permissive_drives) ][MOV(0,p01r12_master_ramped_speed) ,MOV(0,p01r12_ramped_setpoint) ];
					N: EQU(p01r12_master_ramped_speed,0)OTE(p01r12_zero_line_speed);
					RC: "Faults";
					N: OTE(p01r12.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p01r12.fault,p01r12.fault_ack);
					N: XIC(FAULT)[TON(p01r12_timer_fault[0],?,?) ,XIC(p01r12_timer_fault[0].DN) OTL(p01r12.fault.0) ];
					N: XIC(p01r12.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p01r12.fault.0) ,OTU(p01r12.fault_ack.0) ];
					N: NEQ(p01r12.fault,p01r12.fault_ack)OTE(p01r12.unack_fault);
					RC: "Warnings";
					N: OTE(p01r12.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p01r12.warning,p01r12.warning_ack);
					N: XIC(FAULT)[TON(p01r12_timer_warning[0],?,?) ,XIC(p01r12_timer_warning[0].DN) OTL(p01r12.warning.0) ];
					N: XIO(FAULT)[OTU(p01r12.warning.0) ,OTU(p01r12.warning_ack.0) ];
					N: NEQ(p01r12.warning,p01r12.warning_ack)OTE(p01r12.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R13_Line_Start_Sequence 
					RC: "p01r13$N"
					    "This routine is called, continuously, from P01R01 Main while the plc is in Run mode.";
					N: SBR()OTE(p01r13.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p01r13.comment (dint)$N"
					    "p01r13.oneshot (dint)$N"
					    "p01r13_timer_xxxx (timer)$N"
					    "p01r13_xxxx (any)$N"
					    "p01r13.fault (dint)$N"
					    "p01r13.warning (dint)$N"
					    "";
					N: OTE(p01r13.comment.1);
					RC: "Notes$N"
					    "Any high tension fault will allow line drive jogging to clear the high tension";
					N: OTE(p01r13.comment.2);
					N: [XIC(p11r30.fault.4) ,XIC(p12r30.fault.4) ,XIC(p23r02.fault.0) ]OTE(p01r13_LFL_stop);
					N: XIC(p11r30_request_heat)XIO(p11r30.warning.0)XIC(p12r30_request_heat)XIO(p12r30.warning.0)XIC(p13r30_request_cool)XIO(p13r30.warning.0)[TON(p01r13_temperature_status_check,?,?) ,XIC(p01r13_temperature_status_check.DN) OTE(p01r13_oven_temp_ok) ];
					N: [XIC(p02_dint_from_hmi.global[6].4) ,XIC(p29r11_line_start) ]OTE(p01r13_pb_start);
					N: [XIC(p02_dint_from_hmi.global[6].5) ,XIC(p29r11_line_stop) ,XIO(p01r09_open_oven) XIC(p01r13_LFL_stop) ]OTE(p01r13_pb_stop);
					N: MOV(p01_param_start_delay,p01_param_start_delay)CPT(p01r13_timer_line_start_warning_dwell.PRE,p01_param_start_delay*1000);
					RC: "Requests";
					N: OTE(p01r13.comment.3);
					N: XIC(p01r09_mode_run)OTE(p01r13_system_mode_run);
					RC: "VFD Warnings";
					N: XIC(p01r13_system_mode_run)[EQU(p20r15.warning,0) ,XIO(aaa_aaa_temp) ]EQU(p20r16.warning,0)[[XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ,XIC(p20r02_letoff_selection_dwell.DN) ] XIC(p20r18_index_complete) ,XIC(p20_do_close_nip) ][XIC(p29r15_wdra_active) ,XIC(p29r16_wdrb_active) ,XIC(p29r02_winder_selection_dwell.DN) ]XIC(p00_wac.OUT_Not_Normal_Stop)OTE(p01r13_permissive_line_run);
					RC: "System Modes, Line Accel/Decel Control, Line Start Sequence$N"
					    "Tension Stands - Speed Tension and VFD Faults$N"
					    "Winder  VFD Faults";
					N: EQU(p01r09.fault,0)EQU(p01r09.fault1,0)EQU(p01r12.fault,0)EQU(p01r13.fault,0)EQU(p20r10.fault,0)EQU(p20r15.fault,0)EQU(p20r16.fault,0)EQU(p22r11.fault,0)EQU(p23r15.fault,0)EQU(p25r11.fault,0)EQU(p28r11.fault,0)EQU(p29r15.fault,0)EQU(p29r16.fault,0)XIC(p00_wac.OUT_Not_EStop)XIO(p31r09.fault.0)OTE(p01r13_permissive_drives);
					N: XIC(p01_int_from_oxidizer[0].9)XIC(p01_int_from_oxidizer[1].0)XIC(p01_int_from_oxidizer[0].14)OTE(p01r13_permissive_oxidizer);
					N: [EQU(p01r14.fault,0) XIC(p23_di_impreg_tank_up) [XIC(p01r13_oven_temp_ok) ,XIC(p01r09_open_oven) ] XIC(p01r13_permissive_oxidizer) ,XIO(p23_di_impreg_tank_up) ]OTE(p01r13_permissive_oven);
					N: XIC(p01r13_permissive_drives)XIC(p01r13_permissive_oven)XIC(p01r13_permissive_line_run)XIC(p00_wac.OUT_Not_Fast_Stop)XIC(p01r13_pb_start)OTL(p01r13_request_run);
					RC: "Line Stop PBs";
					N: OTE(p01r13.comment.15);
					RC: "All Line Stop PBs and HMI Line Stop Activation PB/Modes";
					N: [XIO(Local:4:I.Data.4) ,XIC(p11r31.fault.0) ,XIO(Local:4:I.Data.12) ,XIC(p12r31.fault.0) ,XIC(p01r13_pb_stop) ,XIO(p01r13_permissive_line_run) ,XIO(p01r13_permissive_drives) ,XIO(p01r13_permissive_oven) ,XIO(p22r09_mode_run) ,XIO(p25r09_mode_run) ]OTE(p01r13_request_stop);
					RC: "Line Start / Stop State selections$N"
					    "Value of p01r13_state is binary$N"
					    "state.0  - value =1$N"
					    "state.1 - value =2$N"
					    "state.2 - value =4, etc";
					N: OTE(p01r13.comment.5);
					N: [XIC(S:FS) ,XIC(p01r13_state.9) XIC(p01r13_state.0) ][MOV(0,p01r13_state) ,OTL(p01r13_state.1) ];
					N: XIC(p01r13_state.1)XIC(p01r13_state.0)XIC(p01r13_request_run)XIO(p01r13_request_stop)[MOV(0,p01r13_state) ,OTL(p01r13_state.2) ];
					N: XIC(p01r13_state.2)XIC(p01r13_state.0)[MOV(0,p01r13_state) ,OTL(p01r13_state.3) ];
					N: XIC(p01r13_state.3)XIC(p01r13_state.0)XIC(p01r13_check_status)[MOV(0,p01r13_state) ,OTL(p01r13_state.4) ];
					N: XIC(p01r13_state.4)XIC(p01r13_state.0)XIC(p01r13_tension_ok)[MOV(0,p01r13_state) ,OTL(p01r13_state.5) ];
					N: XIC(p01r13_state.5)XIC(p01r13_state.0)XIC(p01r13_timer_switch_to_stretch_dwell.DN)[MOV(0,p01r13_state) ,OTL(p01r13_state.6) ];
					N: XIC(p01r13_state.6)XIC(p01r13_state.0)[MOV(0,p01r13_state) ,OTL(p01r13_state.7) ];
					N: [XIC(p01r13_state.5) ,XIC(p01r13_request_stop) ,XIO(p01r13_permissive_drives) ,XIO(p01r13_permissive_line_run) ,XIO(p01r13_permissive_oven) ,XIO(p00_wac.OUT_Not_Fast_Stop) ]OTU(p01r13_request_run);
					N: [XIC(p01r13_state.4) ,XIC(p01r13_state.5) ,XIC(p01r13_state.6) ,XIC(p01r13_state.7) ]XIC(p01r13_state.0)XIO(p01r13_request_run)XIC(p01r13_request_stop)[MOV(0,p01r13_state) ,OTL(p01r13_state.8) ];
					N: [XIC(p01r13_state.8) XIC(p01r13_state.0) [XIC(p01r13_timer_line_stop_dwell.DN) ,LEQ(p01r12_master_ramped_speed,0) ] ,XIO(p01r13_permissive_drives) ][MOV(0,p01r13_state) ,OTL(p01r13_state.9) ];
					N: XIC(p01r13_state.4)OTE(p01r13_line_slow_ramp);
					N: [XIC(p01r13_state.5) ,XIC(p01r13_state.6) ,XIC(p01r13_state.7) ,XIC(p01r13_state.8) ]OTE(p01r13_line_running);
					N: OTL(p01r13_state.0);
					N: SYS_ENC(p01r13_line_start,p01r13_state,p01r13_status);
					N: [GRT(p01r13_status,9) ,LES(p01r13_status,2) ]MOV(3,p01r13_state);
					RC: "Output Control";
					N: OTE(p01r13.comment.6);
					N: XIC(p01r13_state.3)TON(p01r13_timer_line_start_warning_dwell,?,?);
					N: [CMP(ABS(p20r10_pid_tens.ERR)<=p01_param_tension_deviation) ,XIO(p20_di_acc_empty) ]OTE(p01r13_letoff_tension_ok);
					N: CMP(ABS(p22r10_pid_psn.ERR)<=p01_param_tension_deviation)OTE(p01r13_ts1_tension_ok);
					N: CMP(ABS(p25r10_pid_psn.ERR)<=p01_param_tension_deviation)OTE(p01r13_ts2_tension_ok);
					N: CMP(ABS(p29r10_tension_error)<=p01_param_tension_deviation)OTE(p01r13_winder_tension_ok);
					N: XIC(p01r13_state.4)[XIC(p01r13_letoff_tension_ok) XIC(p01r13_ts1_tension_ok) XIC(p01r13_ts2_tension_ok) XIC(p01r13_winder_tension_ok) ,EQU(p01r12_master_ramped_speed,p01r12_selected_line_speed) TON(p01r13_check_status_timer,?,?) XIC(p01r13_check_status_timer.DN) ][TON(p01r13_check_tension,?,?) ,XIC(p01r13_check_tension.DN) OTE(p01r13_tension_ok) ];
					N: SUB(p01r13_timer_line_start_warning_dwell.PRE,250,p01r13_check_status_time)GRT(p01r13_timer_line_start_warning_dwell.ACC,p01r13_check_status_time)OTE(p01r13_check_status);
					N: XIC(p01r13_state.5)TON(p01r13_timer_switch_to_stretch_dwell,?,?);
					N: XIC(p01r13_state.8)MOV(60000,p01r13_timer_line_stop_dwell.PRE)TON(p01r13_timer_line_stop_dwell,?,?);
					RC: "Faults";
					N: OTE(p01r13.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p01r13.fault,p01r13.fault_ack);
					N: XIC(FAULT)[TON(p01r13_timer_fault[0],?,?) ,XIC(p01r13_timer_fault[0].DN) OTL(p01r13.fault.0) ];
					N: XIC(p01r13.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p01r13.fault.0) ,OTU(p01r13.fault_ack.0) ];
					N: XIC(FAULT)[TON(p01r13_timer_fault[1],?,?) ,XIC(p01r13_timer_fault[1].DN) OTL(p01r13.fault.1) ];
					N: XIC(p01r13.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p01r13.fault.1) ,OTU(p01r13.fault_ack.1) ];
					N: NEQ(p01r13.fault,p01r13.fault_ack)OTE(p01r13.unack_fault);
					RC: "Warnings";
					N: OTE(p01r13.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p01r13.warning,p01r13.warning_ack);
					N: XIC(FAULT)[TON(p01r13_timer_warning[0],?,?) ,XIC(p01r13_timer_warning[0].DN) OTL(p01r13.warning.0) ];
					N: XIO(FAULT)[OTU(p01r13.warning.0) ,OTU(p01r13.warning_ack.0) ];
					N: NEQ(p01r13.warning,p01r13.warning_ack)OTE(p01r13.unack_warning);
