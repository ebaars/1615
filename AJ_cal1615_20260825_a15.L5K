					N: XIC(p23r12.warning_ack.0)XIO(p23_di_servo_ds.class_2_diagnostic)[OTU(p23r12.warning.0) ,OTU(p23r12.warning_ack.0) ];
					N: NEQ(p23r12.warning,p23r12.warning_ack)OTE(p23r12.unack_warning);
