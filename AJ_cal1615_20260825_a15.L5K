			ROUTINE R01_Main 
					RC: "Main Routine$N"
					    "Calls all Soubroutines ones a scan";
					N: NOP();
					N: JSR(R02_PIDE,0);
			END_ROUTINE

			FBD_ROUTINE R02_PIDE (SheetSize := "Letter - 8.5 x 11 in",
			                      SheetOrientation := Landscape)
				SHEET  (Name := "")
					IREF  (ID := 0,
					       X := 80,
					       Y := 540,
					       Operand := "1",
					       HideDescription := No)
					END_IREF

					IREF  (ID := 1,
					       X := 60,
					       Y := 40,
					       Operand := "p01_recipe_active.ts2_tension_sp",
					       HideDescription := No)
					END_IREF

					IREF  (ID := 2,
					       X := 120,
					       Y := 160,
					       Operand := "p25_ai_ts2_lc",
					       HideDescription := No)
					END_IREF

					IREF  (ID := 3,
					       X := 200,
					       Y := 460,
					       Operand := "p25r10_pid_manual_request",
					       HideDescription := No)
					END_IREF

					IREF  (ID := 4,
					       X := 180,
					       Y := 380,
					       Operand := "p25r10_tension_request",
					       HideDescription := No)
					END_IREF

					OREF  (ID := 5,
					       X := 880,
					       Y := 100,
					       Operand := "p25r20_pide_cv",
					       HideDescription := No)
					END_OREF

					PIDE_BLOCK  (ID := 6,
					             X := 380,
					             Y := 60,
					             Operand := "PIDE_02",
					             VisiblePins := "EnableIn, PV, SPProg, RatioProg, CVProg, FF, HandFB, ProgProgReq, ProgOperReq, ProgCasRatReq, ProgAutoReq, ProgManualReq, ProgOverrideReq, ProgHandReq, OperProgReq, CVEU, CV, SP, PVHHAlarm, PVHAlarm, PVLAlarm, PVLLAlarm, PVROCPosAlarm, PVROCNegAlarm, DevHHAlarm, DevHAlarm, DevLAlarm, DevLLAlarm, ProgOper, CasRat, Auto, Manual, Override, Hand",
					             HideDescription := No,
					             AutotuneTag := "AutoT")
					END_PIDE_BLOCK

					WIRE  (FromElementID := 0,
					       FromParameter := "",
					       ToElementID := 6,
					       ToParameter := "OperProgReq")
					END_WIRE

					WIRE  (FromElementID := 1,
					       FromParameter := "",
					       ToElementID := 6,
					       ToParameter := "PV")
					END_WIRE

					WIRE  (FromElementID := 2,
					       FromParameter := "",
					       ToElementID := 6,
					       ToParameter := "SPProg")
					END_WIRE

					WIRE  (FromElementID := 3,
					       FromParameter := "",
					       ToElementID := 6,
					       ToParameter := "ProgManualReq")
					END_WIRE

					WIRE  (FromElementID := 4,
					       FromParameter := "",
					       ToElementID := 6,
					       ToParameter := "ProgAutoReq")
					END_WIRE

					WIRE  (FromElementID := 6,
					       FromParameter := "CVEU",
					       ToElementID := 5,
					       ToParameter := "")
					END_WIRE

				END_SHEET

			END_FBD_ROUTINE

	END_PROGRAM

	PROGRAM P01_System (MAIN := "R01_Main",
	                    MODE := 0,
	                    DisableFlag := 0)
			TAG
				Limit_Clamp : sys_Limit_Clamp (Description := "Limit Clamp") := [1,0.00000000e+000,0.00000000e+000];
				tmrFlash : TIMER[4] (Description := "Flash Timer") := [[0,1000,300],[0,1000,0],[0,500,300],[0,500,0]];
			END_TAG

			ROUTINE R01_Main 
					RC: "p01r01 Main$N"
					    "$N"
					    "This routine is called while the plc is in Run mode.  All other p01  routines are called from this routine.";
					N: OTE(p01r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p01r01.comment (dint)$N"
					    "p01r01.oneshot (dint)$N"
					    "p01r01_timer_xxxx (timer)$N"
					    "p01r01_xxxx (any)$N"
					    "p01r01.fault (dint)$N"
					    "p01r01.warning (dint)$N"
					    "";
					N: OTE(p01r01.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p01r01.comment.2);
					N: OTU(AFI)OTU(FAULT)OTU(HMI);
					N: JSR(R03_Inputs,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Annunciators,0);
					N: JSR(R11_Oven_Timer_Presets,0);
					N: JSR(R12_Line_Accel_Decel_Control,0);
					N: JSR(R13_Line_Start_Sequence,0);
					N: JSR(R14_Oxidizer,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R04_Outputs,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p01R02$N"
					    "This routine is called continuously from p01r01 Main while the plc is in Run mode.";
					N: SBR()OTE(p01r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p01r02.comment (dint)$N"
					    "p01r02.oneshot (dint)$N"
					    "p01r02_timer_xxxx (timer)$N"
					    "p01r02_xxxx (any)$N"
					    "p01r02.fault (dint)$N"
					    "p01r02.warning (dint)$N"
					    "";
					N: OTE(p01r02.comment.1);
					RC: "LFL Alarms";
					N: OTE(p01r02.comment.2);
					N: OTE(p01r02.comment.7);
					N: XIO(p11r31_request_auto_run)XIO(p11r32_request_auto_run)XIO(p12r31_request_auto_run)XIO(p12r32_request_auto_run)XIO(p13r31_request_auto_run)XIO(p13r32_request_auto_run)XIO(p23r13_request_auto_run)XIO(p23_do_enable_impreg_exhaust_fan)OTE(p01r02_all_fans_stopped);
					RC: "Notes";
					N: OTE(p01r02.comment.6);
					N: XIC(p01r13_line_running)XIO(p01r02_timer_batch.DN)TON(p01r02_timer_batch,?,?);
					N: XIC(p01r02_timer_batch.DN)ADD(1,p01r02_batch_run_time,p01r02_batch_run_time);
					N: GEQ(p01r02_batch_run_time,60)[ADD(1,p01r02_batch_run_time_hrs,p01r02_batch_run_time_hrs) ,MOV(0,p01r02_batch_run_time) ,OTL(p01_dint_to_hmi[6].2) ];
					N: XIC(p02_dint_from_hmi.global[6].3)OTU(p01_dint_to_hmi[6].2)OTU(p02_dint_from_hmi.global[6].3);
					RC: "Requests";
					N: OTE(p01r02.comment.3);
					N: NEQ(p01_dint_to_hmi[2],0)OTE(p01r02_fault_exists);
					N: NEQ(p01_dint_to_hmi[4],0)OTE(p01r02_warnings_exists);
					N: [XIC(p01r02.unack_fault) ,XIC(p01r03.unack_fault) ,XIC(p01r04.unack_fault) ,XIC(p01r05.unack_fault) ,XIC(p01r06.unack_fault) ,XIC(p01r07.unack_fault) ,XIC(p01r08.unack_fault) ,XIC(p01r09.unack_fault) ,XIC(p01r10.unack_fault) ,XIC(p01r11.unack_fault) ,XIC(p01r12.unack_fault) ,XIC(p01r13.unack_fault) ]OTE(p01r02_unack_fault);
					N: [XIC(p01r02.unack_warning) ,XIC(p01r03.unack_warning) ,XIC(p01r04.unack_warning) ,XIC(p01r05.unack_warning) ,XIC(p01r06.unack_warning) ,XIC(p01r07.unack_warning) ,XIC(p01r08.unack_warning) ,XIC(p01r09.unack_warning) ,XIC(p01r10.unack_warning) ,XIC(p01r11.unack_warning) ,XIC(p01r12.unack_warning) ,XIC(p01r13.unack_warning) ]OTE(p01r02_unack_warning);
					RC: "Sequence";
					N: OTE(p01r02.comment.4);
					N: GSV(TASK,MainTask,LastScanTime,p01r02_plc_scan_time)CPT(p01r02_plc_scan_time_in_sec,p01r02_plc_scan_time/1000000);
					N: GSV(FAULTLOG,?,MinorFaultBits,p01r02_plc_faults);
					N: XIO(p01r02_timer_second[1].DN)TON(p01r02_timer_second[0],?,?);
					N: XIC(p01r02_timer_second[0].DN)TON(p01r02_timer_second[1],?,?);
					N: XIO(p01r02_timer_half_second_off.DN)TON(p01r02_timer_half_second_on,?,?);
					N: XIC(p01r02_timer_half_second_on.DN)TON(p01r02_timer_half_second_off,?,?);
					RC: "Ethernet Communication$N"
					    "Monitoring";
					N: GSV(MODULE,p00_vfd_imp_supply,EntryStatus,p01r02_vfd_comm_2[0]);
					N: LIM(16384,p01r02_vfd_comm_2[0],20479)OTE(p01r02_ethernet_comm.0);
					N: GSV(MODULE,p00_vfd_z1_recirc,EntryStatus,p01r02_vfd_comm_2[1]);
					N: LIM(16384,p01r02_vfd_comm_2[1],20479)OTE(p01r02_ethernet_comm.1);
					N: GSV(MODULE,p00_vfd_z1_exhaust,EntryStatus,p01r02_vfd_comm_2[2]);
					N: LIM(16384,p01r02_vfd_comm_2[2],20479)OTE(p01r02_ethernet_comm.2);
					N: GSV(MODULE,p00_vfd_z2_recirc,EntryStatus,p01r02_vfd_comm_2[3]);
					N: LIM(16384,p01r02_vfd_comm_2[3],20479)OTE(p01r02_ethernet_comm.3);
					N: GSV(MODULE,p00_vfd_z2_exhaust,EntryStatus,p01r02_vfd_comm_2[4]);
					N: LIM(16384,p01r02_vfd_comm_2[4],20479)OTE(p01r02_ethernet_comm.4);
					N: GSV(MODULE,p00_vfd_z3_recirc,EntryStatus,p01r02_vfd_comm_2[5]);
					N: LIM(16384,p01r02_vfd_comm_2[5],20479)OTE(p01r02_ethernet_comm.5);
					N: GSV(MODULE,p00_vfd_z3_exhaust,EntryStatus,p01r02_vfd_comm_2[6]);
					N: LIM(16384,p01r02_vfd_comm_2[6],20479)OTE(p01r02_ethernet_comm.6);
					N: GSV(MODULE,p00_vfd_loa,EntryStatus,p01r02_vfd_comm_2[7]);
					N: LIM(16384,p01r02_vfd_comm_2[7],20479)OTE(p01r02_ethernet_comm.7);
