			ROUTINE R20_Temp_Sequence 
					RC: "p12r15$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r20.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r15.comment (dint)$N"
					    "p12r15.oneshot (dint)$N"
					    "p12r15_timer_xxxx (timer)$N"
					    "p12r15_xxxx (any)$N"
					    "p12r15.fault (dint)$N"
					    "p12r15.warning (dint)$N"
					    "";
					N: OTE(p12r20.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r20.comment.2);
					RC: "Requests";
					N: OTE(p12r20.comment.3);
					RC: "Sequence";
					N: OTE(p12r20.comment.4);
					N: [XIC(S:FS) ,XIC(p12r20_state.13) ][MOV(0,p12r20_state) ,OTL(p12r20_state.1) ];
					N: XIC(p12r20_state.1)XIC(p12_di_burner_auto)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.2) ];
					N: [XIC(p12r20_state.2) ,XIC(p12r20_state.11) ,XIC(p12r20_state.12) ,XIC(p12r20_state.13) ]XIC(p12r30_request_heat)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.3) ];
					N: XIC(p12r20_state.3)XIC(p12_di_recirc_flow_ok)XIC(p12r20_state.0)XIC(p12r20_timer_state_3.DN)[MOV(0,p12r20_state) ,OTL(p12r20_state.4) ];
					N: XIC(p12r20_state.4)XIC(p12_di_exh_flow_ok)XIC(p12r20_timer_state_4.DN)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.5) ];
					N: XIC(p12r20_state.5)XIC(p12_di_burner_safeties_ok)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.6) ,OTL(p12r20_safeties_ok) ];
					N: XIC(p12r20_state.6)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.7) ];
					N: XIC(p12r20_state.7)XIC(p12_di_flame_on)XIC(p12r20_timer_state_7.DN)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.8) ];
					N: [XIC(p12r20_state.8) ,XIC(p12r20_state.10) XIO(p12r30_request_soak_control) ,XIC(p12r20_state.31) XIO(p12r30_request_manual) ]XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.9) ];
					N: XIC(p12r20_state.9)XIC(p12r30_request_soak_control)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.10) ];
					N: [[LEQ(p12r20_status,10) GEQ(p12r20_status,3) ,XIC(p12r20_state.31) ] ,XIC(p12r20_state.2) XIO(p12_di_burner_auto) ]XIO(p12r30_request_heat)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.11) ];
					N: XIC(p12r20_state.11)XIO(p12_di_flame_on)XIC(p12r20_timer_state_11.DN)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.12) ];
					N: [XIC(p12r20_state.11) ,XIC(p12r20_state.12) ]XIC(p12r02_shutdown_temp)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.13) ];
					N: [XIC(p12r20_state.9) ,XIC(p12r20_state.10) ]XIC(p12r30_request_manual)XIC(p12r20_state.0)[MOV(0,p12r20_state) ,OTL(p12r20_state.31) ];
					N: OTL(p12r20_state.0);
					N: SYS_ENC(p01_sys_enc,p12r20_state,p12r20_status);
					RC: "Output Control";
					N: OTE(p12r20.comment.5);
					N: XIC(p12_di_recirc_flow_ok)TON(p12r20_timer_state_3,?,?);
					N: XIC(p12_di_exh_flow_ok)XIC(p12_di_exh_flow_ok)TON(p12r20_timer_state_4,?,?);
					N: XIC(p12_di_flame_on)TON(p12r20_timer_state_7,?,?);
					N: XIO(p12_di_recirc_flow_ok)XIO(p12_di_exh_flow_ok)TON(p12r20_timer_state_11,?,?);
					RC: "Faults";
					N: OTE(p12r20.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r20.fault,p12r20.fault_ack);
					N: XIC(FAULT)[TON(p12r20_timer_fault[0],?,?) ,XIC(p12r10_timer_fault[0].DN) OTL(p12r10.fault.0) ];
					N: XIC(p12r20.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r20.fault.0) ,OTU(p12r20.fault_ack.0) ];
					N: NEQ(p12r20.fault,p12r20.fault_ack)OTE(p12r20.unack_fault);
					RC: "Warnings";
					N: OTE(p12r20.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p12r20.warning,p12r20.warning_ack);
					N: XIC(FAULT)[TON(p12r20_timer_warning[0],?,?) ,XIC(p12r20_timer_warning[0].DN) OTL(p12r20.warning.0) ];
					N: XIO(FAULT)[OTU(p12r20.warning.0) ,OTU(p12r20.warning_ack.0) ];
					N: NEQ(p12r20.warning,p12r20.warning_ack)OTE(p12r20.unack_warning);
					N: RET();
			END_ROUTINE

