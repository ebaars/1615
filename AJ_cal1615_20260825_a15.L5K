					N: XIC(p13r20_state.3)XIC(p13_di_recirc_flow_ok)XIC(p13r20_state.0)XIC(p13r20_timer_state_3.DN)[MOV(0,p13r20_state) ,OTL(p13r20_state.4) ];
					N: XIC(p13r20_state.4)XIC(p13_di_exh_flow_ok)XIC(p13r20_timer_state_4.DN)XIC(p13r20_state.0)[MOV(0,p13r20_state) ,OTL(p13r20_state.5) ];
					N: [[LEQ(p13r20_status,5) GEQ(p13r20_status,3) ,XIC(p13r20_state.31) ] ,XIC(p13r20_state.2) ]XIO(p13r30_request_cool)XIC(p13r20_state.0)[MOV(0,p13r20_state) ,OTL(p13r20_state.6) ];
					N: XIC(p13r20_state.5)XIC(p13r30_request_manual)XIC(p13r20_state.0)[MOV(0,p13r20_state) ,OTL(p13r20_state.31) ];
					N: OTL(p13r20_state.0);
					N: SYS_ENC(p01_sys_enc,p13r20_state,p13r20_status);
					RC: "Output Control";
					N: OTE(p13r20.comment.5);
