			ROUTINE R07_Alarms 
					RC: "p12r07$N"
					    "This routine is called, continuously, from p12R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p12r07.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p12r07.comment (dint)$N"
					    "p12r07.oneshot (dint)$N"
					    "p12r07_timer_xxxx (timer)$N"
					    "p12r07_xxxx (any)$N"
					    "p12r07.fault (dint)$N"
					    "p12r07.warning (dint)$N"
					    "";
					N: OTE(p12r07.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p12r07.comment.2);
					RC: "Alarms";
					N: OTE(p12r07.comment.3);
					N: [XIC(p12r30.fault.0) OTE(p12_dint_to_hmi[0].0) ,XIC(p12r30.fault.1) OTE(p12_dint_to_hmi[0].1) ,XIC(p12r30.fault.2) OTE(p12_dint_to_hmi[0].2) ,XIC(p12r30.fault.3) OTE(p12_dint_to_hmi[0].3) ];
