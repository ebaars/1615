					N: XIC(p23r15_permissive_jog)XIC(p01r13_state.1)[XIC(p23_di_vfd_jog_fwd) XIC(p23r15_zero_speed) ,XIC(p23r15_request_jog_fwd) XIO(p23r15_zero_speed) ]OTE(p23r15_request_jog_fwd);
					N: XIC(p23r15_permissive_jog)XIC(p01r13_state.1)[XIC(p23_di_vfd_jog_rev) XIC(p23r15_zero_speed) ,XIC(p23r15_request_jog_rev) XIO(p23r15_zero_speed) ]OTE(p23r15_request_jog_rev);
					N: [XIC(p25r11_request_thread_fwd) XIC(p23r15_zero_speed) ,XIC(p23r15_request_thread_fwd) XIO(p23r15_zero_speed) ]OTE(p23r15_request_thread_fwd);
					N: [XIC(p25r11_request_thread_rev) XIC(p23r15_zero_speed) ,XIC(p23r15_request_thread_rev) XIO(p23r15_zero_speed) ]OTE(p23r15_request_thread_rev);
					N: LEQ(p23_ao_selected_speed,0.1)OTE(p23r15_zero_speed);
