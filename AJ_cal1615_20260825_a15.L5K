					N: [MUL(p12_ai_tc01,10,p12r30_pid_temp_pv) ,XIC(p12r30.warning.1) MUL(p12_ai_tc02,10,p12r30_pid_temp_pv) ];
					RC: "Requests";
					N: OTE(p12r30.comment.3);
