			ROUTINE R02_Misc_Control 
					RC: "p22R02$N"
					    "This routine is called, continuously, from p22R01 Main while the plc is in Run mode.";
					N: SBR()OTE(p22r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
