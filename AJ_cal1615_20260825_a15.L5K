					N: XIC(FAULT)[TON(p12r07_timer_warning[0],?,?) ,XIC(p12r07_timer_warning[0].DN) OTL(p12r07.warning.0) ];
					N: XIO(FAULT)[OTU(p12r07.warning.0) ,OTU(p12r07.warning_ack.0) ];
