					N: XIC(FAULT)[TON(p19r05_timer_warning[0],?,?) ,XIC(p19r05_timer_warning[0].DN) OTL(p19r05.warning.0) ];
					N: XIO(FAULT)[OTU(p19r05.warning.0) ,OTU(p19r05.warning_ack.0) ];
					N: NEQ(p19r05.warning,p19r05.warning_ack)OTE(p19r05.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R06_Real_to_HMI 
					RC: "Notes:$N"
					    "";
					N: OTE(p19r06.comment.2);
					RC: "Analog Input";
					N: OTE(p19r06.comment.3);
