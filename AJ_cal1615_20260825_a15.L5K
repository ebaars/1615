					RC: "Output Control";
					N: OTE(p01r02.comment.5);
					N: MOV(480,p01_param_process_air_max)MOV(500,p01_param_process_air_hl);
					N: MOV(120,p01_param_temp_limit)MOV(785,p01_param_heater_hl);
					N: XIO(p01r02_flash_timer_off.TT)TON(p01r02_flash_timer_on,?,?);
