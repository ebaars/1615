					N: XIC(p12r30.fault_ack.8)[XIC(p12_di_exh.running_fwd) XIC(p12_di_exh_flow_ok) ,XIO(p12r30_request_heat) ]XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.8) ,OTU(p12r30.fault_ack.8) ];
