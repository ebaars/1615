					N: XIC(p13_di_exh_flow_ok)TON(p13r20_timer_state_4,?,?);
					RC: "Faults";
					N: OTE(p13r20.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p13r20.fault,p13r20.fault_ack);
					N: XIC(FAULT)[TON(p13r20_timer_fault[0],?,?) ,XIC(p13r10_timer_fault[0].DN) OTL(p13r10.fault.0) ];
					N: XIC(p13r20.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p13r20.fault.0) ,OTU(p13r20.fault_ack.0) ];
					N: NEQ(p13r20.fault,p13r20.fault_ack)OTE(p13r20.unack_fault);
