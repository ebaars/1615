					N: OTE(p11r02.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p11r02.comment.2);
					N: NEQ(p11_dint_to_hmi[0],0)OTE(p11r02_fault_exists);
					N: NEQ(p11_dint_to_hmi[2],0)OTE(p11r02_warning_exists);
					RC: "Requests";
					N: OTE(p11r02.comment.3);
					N: [XIC(p11r02.unack_fault) ,XIC(p11r03.unack_fault) ,XIC(p11r04.unack_fault) ,XIC(p11r05.unack_fault) ,XIC(p11r06.unack_fault) ,XIC(p11r07.unack_fault) ,XIC(p11r08.unack_fault) ,XIC(p11r09.unack_fault) ,XIC(p11r10.unack_fault) ,XIC(p11r20.unack_fault) ,XIC(p11r30.unack_fault) ,XIC(p11r31.unack_fault) ,XIC(p11r32.unack_fault) ]OTE(p11r02_unack_fault);
					N: [XIC(p11r02.unack_warning) ,XIC(p11r03.unack_warning) ,XIC(p11r04.unack_warning) ,XIC(p11r05.unack_warning) ,XIC(p11r06.unack_warning) ,XIC(p11r07.unack_warning) ,XIC(p11r08.unack_warning) ,XIC(p11r09.unack_warning) ,XIC(p11r10.unack_warning) ,XIC(p11r20.unack_warning) ,XIC(p11r30.unack_warning) ,XIC(p11r31.unack_warning) ,XIC(p11r32.unack_warning) ]OTE(p11r02_unack_warning);
					RC: "Sequence";
					N: OTE(p11r02.comment.4);
					N: LES(p11_ai_tc01,p11_param_shutdown_temp)LES(p11_ai_tc02,p11_param_shutdown_temp)XIO(p11r30.warning.1)XIO(p11r30.warning.2)OTE(p11r02_safe_temp);
					N: XIC(p11r02_safe_temp)[TON(p11r02_timer_safe_temp[0],?,?) ,XIC(p11r02_timer_safe_temp[0].DN) OTL(p11r02_shutdown_temp) ];
					N: [XIO(p11r30.warning.1) GRT(p11_ai_tc01,p01_param_temp_limit) ,XIO(p11r30.warning.2) GRT(p11_ai_tc02,p11_param_shutdown_temp) ]OTE(p11r02_not_safe_temp);
					N: XIC(p11r02_not_safe_temp)[TON(p11r02_timer_safe_temp[1],?,?) ,XIC(p11r02_timer_safe_temp[1].DN) OTU(p11r02_shutdown_temp) ];
					N: XIC(p11r30_pb_zone_off)OTU(p11r02_shutdown_temp);
					RC: "Output Control";
					N: OTE(p11r02.comment.5);
					RC: "Faults";
					N: OTE(p11r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p11r02.fault,p11r02.fault_ack);
					N: XIC(FAULT)[TON(p11r02_timer_fault[0],?,?) ,XIC(p11r02_timer_fault[0].DN) OTL(p11r02.fault.0) ];
					N: XIC(p11r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p11r02.fault.0) ,OTU(p11r02.fault_ack.0) ];
					N: NEQ(p11r02.fault,p11r02.fault_ack)OTE(p11r02.unack_fault);
					RC: "Warnings";
					N: OTE(p11r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p11r02.warning,p11r02.warning_ack);
					RC: "Probably need to add a FIFO for the pressure.";
					N: LES(p11_ai_prs,p11_param_zone_pressure)[TON(p11r02_timer_warning[0],?,?) ,XIC(p11r02_timer_warning[0].DN) OTL(p11r02.warning.0) ];
					N: XIC(p11r02.warning_ack.0)CMP(p11_ai_prs>(p11_param_zone_pressure+0.002))[OTU(p11r02.warning.0) ,OTU(p11r02.warning_ack.0) ];
					N: NEQ(p11r02.warning,p11r02.warning_ack)OTE(p11r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p11r03$N"
					    "This routine is called, continuously, from p11R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p11r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r03.comment (dint)$N"
					    "p11r03.oneshot (dint)$N"
					    "p11r03_timer_xxxx (timer)$N"
					    "p11r03_xxxx (any)$N"
					    "p11r03.fault (dint)$N"
					    "p11r03.warning (dint)$N"
					    "";
					N: OTE(p11r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p11r03.comment.2);
					RC: "Digital";
					N: OTE(p11r03.comment.3);
					N: [XIC(Local:4:I.Data.0) OTE(p11_di_burner_auto) ,XIC(Local:4:I.Data.1) OTE(p11_di_high_limit_temp_ok) ,XIC(Local:4:I.Data.2) OTE(p11_di_burner_safeties_ok) ,XIC(Local:4:I.Data.3) OTE(p11_di_recirc_flow_ok) ];
					N: [XIC(Local:4:I.Data.4) OTE(p11_di_exh_flow_ok) ,XIC(Local:4:I.Data.5) OTE(p11_di_flame_failure) ,XIC(Local:4:I.Data.6) OTE(p11_di_flame_on) ,XIC(p00_io_oven:2:I.Ch0OverrangeAlarm) OTE(p11_di_tc01_bo) ,XIC(p00_io_oven:2:I.Ch1OverrangeAlarm) OTE(p11_di_tc02_bo) ];
					N: [XIC(p00_io_prc:1:I.1) OTE(p11_di_recirc_fan_mtr_ts) ,XIC(p00_io_prc:1:I.2) OTE(p11_di_exh_fan_mtr_ts) ];
					N: [XIC(p00_io_oven:3:I.0) OTE(p11_di_sp0) ,XIC(p00_io_oven:3:I.1) OTE(p11_di_fresh_air_clean) ,XIC(p00_io_oven:3:I.2) OTE(p11_di_zone_air_clean) ,XIC(p00_io_oven:3:I.3) OTE(p11_di_sp00) ];
					N: [XIC(p00_io_oven:3:I.4) OTE(p11_di_door_open) ,XIC(p00_io_oven:3:I.5) OTE(p11_di_sp1) ,XIC(p00_io_oven:3:I.6) OTE(p11_di_sp2) ,XIC(p00_io_oven:3:I.7) OTE(p11_di_sp3) ];
					N: [XIC(p00_vfd_z1_exhaust:I.Data[0].0) OTE(p11_di_exh.faulted) ,XIC(p00_vfd_z1_exhaust:I.Data[0].1) OTE(p11_di_exh.warning) ,XIC(p00_vfd_z1_exhaust:I.Data[0].2) OTE(p11_di_exh.running_fwd) ,XIC(p00_vfd_z1_exhaust:I.Data[0].3) OTE(p11_di_exh.running_rev) ];
					N: [XIC(p00_vfd_z1_exhaust:I.Data[0].4) OTE(p11_di_exh.ready) ,XIC(p00_vfd_z1_exhaust:I.Data[0].5) OTE(p11_di_exh.ctrl_from_net) ,XIC(p00_vfd_z1_exhaust:I.Data[0].6) OTE(p11_di_exh.ref_from_net) ,XIC(p00_vfd_z1_exhaust:I.Data[0].7) OTE(p11_di_exh.at_reference) ];
					N: XIC(p01r02.fault.2)MOV(0,p00_vfd_z1_exhaust:I.Data[0]);
					N: [XIC(p00_vfd_z1_recirc:I.Data[0].0) OTE(p11_di_recirc.faulted) ,XIC(p00_vfd_z1_recirc:I.Data[0].1) OTE(p11_di_recirc.warning) ,XIC(p00_vfd_z1_recirc:I.Data[0].2) OTE(p11_di_recirc.running_fwd) ,XIC(p00_vfd_z1_recirc:I.Data[0].3) OTE(p11_di_recirc.running_rev) ];
					N: [XIC(p00_vfd_z1_recirc:I.Data[0].4) OTE(p11_di_recirc.ready) ,XIC(p00_vfd_z1_recirc:I.Data[0].5) OTE(p11_di_recirc.ctrl_from_net) ,XIC(p00_vfd_z1_recirc:I.Data[0].6) OTE(p11_di_recirc.ref_from_net) ,XIC(p00_vfd_z1_recirc:I.Data[0].7) OTE(p11_di_recirc.at_reference) ];
					N: XIC(p01r02.fault.1)MOV(0,p00_vfd_z1_recirc:I.Data[0]);
					RC: "Analog";
					N: OTE(p11r03.comment.4);
					N: SYS_SCP(p01_sys_scp,p00_io_letoff:1:I.Ch4Data,p11_prs_input_min,p11_prs_input_max,p11_prs_output_min,p11_prs_output_max,p11_ai_prs);
					N: SYS_SCP(p01_sys_scp,p00_io_oven:1:I.Ch0Data,p11_lfl_input_min,p11_lfl_input_max,p11_lfl_output_min,p11_lfl_output_max,p11_ai_lfl);
					N: CPT(p11_ai_tc01,p00_io_oven:2:I.Ch0Data*0.1)ADD(p11_ai_tc01,p11_param_tc01z,p11_ai_tc01);
					N: CPT(p11_ai_tc02,p00_io_oven:2:I.Ch1Data*0.1)ADD(p11_ai_tc02,p11_param_tc02z,p11_ai_tc02);
					RC: "VFD";
					N: OTE(p11r03.comment.5);
					N: CPT(p11_ai_recirc_rpm,ABS(p00_vfd_z1_recirc:I.Data[1])*1);
					N: CPT(p11_ai_recirc_amps,p00_vfd_z1_recirc:I.Data[2]*0.1);
					N: CPT(p11_ai_recirc_hz_max,p00_vfd_z1_recirc:I.Data[4]*0.1)SYS_SCP(p11r03_hz,p00_vfd_z1_recirc:I.Data[1],0,1750,0,p11_ai_recirc_hz_max,p11_ai_recirc_hz);
					N: CPT(p11_ai_exh_rpm,ABS(p00_vfd_z1_exhaust:I.Data[1])*1);
					N: CPT(p11_ai_exh_amps,p00_vfd_z1_exhaust:I.Data[2]*0.1);
					N: CPT(p11_ai_exh_hz_max,p00_vfd_z1_exhaust:I.Data[4]*0.1)SYS_SCP(p11r03_hz,p00_vfd_z1_exhaust:I.Data[1],0,1750,0,p11_ai_exh_hz_max,p11_ai_exh_hz);
					RC: "Faults";
					N: OTE(p11r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p11r03.fault,p11r03.fault_ack);
					N: XIC(FAULT)[TON(p11r03_timer_fault[0],?,?) ,XIC(p11r03_timer_fault[0].DN) OTL(p11r03.fault.0) ];
					N: XIC(p11r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p11r03.fault.0) ,OTU(p11r03.fault_ack.0) ];
					N: NEQ(p11r03.fault,p11r03.fault_ack)OTE(p11r03.unack_fault);
					RC: "Warnings";
					N: OTE(p11r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p11r03.warning,p11r03.warning_ack);
					N: XIC(FAULT)[TON(p11r03_timer_warning[0],?,?) ,XIC(p11r03_timer_warning[0].DN) OTL(p11r03.warning.0) ];
					N: XIO(FAULT)[OTU(p11r03.warning.0) ,OTU(p11r03.warning_ack.0) ];
					N: NEQ(p11r03.warning,p11r03.warning_ack)OTE(p11r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p11r04$N"
					    "This routine is called, continuously, from p11R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p11r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p11r04.comment (dint)$N"
					    "p11r04.oneshot (dint)$N"
					    "p11r04_timer_xxxx (timer)$N"
					    "p11r04_xxxx (any)$N"
					    "p11r04.fault (dint)$N"
					    "p11r04.warning (dint)$N"
					    "";
					N: OTE(p11r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p11r04.comment.2);
					RC: "Digital";
