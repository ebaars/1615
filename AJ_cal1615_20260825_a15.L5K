					RC: "Sequence";
					N: OTE(p24r10.comment.4);
					RC: "Output Control";
					N: OTE(p24r10.comment.5);
					N: XIC(p24r10_edge_guide_auto_request)OTE(p24_do_edge_guide_input_1);
					N: XIO(p24r10_edge_guide_auto_request)OTE(p24_do_edge_guide_input_2);
					N: XIC(p24r10_edge_guide_center_request)OTE(p24_do_edge_guide_input_3);
					N: XIC(p24r10_edge_guide_jog_left_request)OTE(p24_do_edge_guide_input_4);
					N: XIC(p24r10_edge_guide_jog_right_request)OTE(p24_do_edge_guide_input_5);
					RC: "Faults";
					N: OTE(p24r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p24r10.fault,p24r10.fault_ack);
					N: XIC(FAULT)[TON(p24r10_timer_fault[0],?,?) ,XIC(p24r10_timer_fault[0].DN) OTL(p24r10.fault.0) ];
					N: XIC(p24r10.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p24r10.fault.0) ,OTU(p24r10.fault_ack.0) ];
					N: NEQ(p24r10.fault,p24r10.fault_ack)OTE(p24r10.unack_fault);
					RC: "Warnings";
					N: OTE(p24r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p24r10.warning,p24r10.warning_ack);
					N: XIC(FAULT)[TON(p24r10_timer_warning[0],?,?) ,XIC(p24r10_timer_warning[0].DN) OTL(p24r10.warning.0) ];
					N: XIO(FAULT)[OTU(p24r10.warning.0) ,OTU(p24r10.warning_ack.0) ];
					N: NEQ(p24r10.warning,p24r10.warning_ack)OTE(p24r10.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P25_Tension_Stand_2 (MAIN := "R01_Main",
	                             MODE := 0,
	                             DisableFlag := 0)
			TAG
				param_payout_speed : Setpoint  := [2.00000000e-001,0.00000000e+000,0.00000000e+000];
				sys_limit_clamp : sys_Limit_Clamp  := [1,0.00000000e+000,0.00000000e+000];
			END_TAG

			ROUTINE R01_Main 
					RC: "p25R01 System Main$N"
					    "$N"
					    "This routine is called, continuously, from p25 System while the plc is in Run mode.  All other p25 System routines are called from this routine.";
					N: OTE(p25r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r01.comment (dint)$N"
					    "p25r01.oneshot (dint)$N"
					    "p25r01_timer_xxxx (timer)$N"
					    "p25r01_xxxx (any)$N"
					    "p25r01.fault (dint)$N"
					    "p25r01a_warnings (dint)$N"
					    "";
					N: OTE(p25r01.comment.1);
					RC: "Notes";
					N: OTE(p25r01.comment.2);
					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Speed_Control,0);
					N: JSR(R11_VFD,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p25R02$N"
					    "This routine is called, continuously, from p25R01 Main while the plc is in Run mode.";
					N: SBR()OTE(p25r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r02.comment (dint)$N"
					    "p25r02.oneshot (dint)$N"
					    "p25r02_timer_xxxx (timer)$N"
					    "p25r02_xxxx (any)$N"
					    "p25r02.fault (dint)$N"
					    "p25r02a_warnings (dint)$N"
					    "";
					N: OTE(p25r02.comment.1);
					RC: "Notes";
					N: OTE(p25r02.comment.2);
					N: NEQ(p25_dint_to_hmi[2],0)OTE(p25r02_fault_exists);
					N: NEQ(p25_dint_to_hmi[4],0)OTE(p25r02_warning_exists);
					N: SUB(p01_recipe_active.ts2_tension_sp,p01_recipe_active.tension_deviation_sp,p25r02_tension_dev_min)ADD(p01_recipe_active.ts2_tension_sp,p01_recipe_active.tension_deviation_sp,p25r02_tension_dev_max);
					N: MOV(0.0,param_payout_speed.Lo)MOV(1.0,param_payout_speed.Hi)MOV(param_payout_speed.SP,param_payout_speed.SP)sys_Limit_Clamp(sys_limit_clamp,param_payout_speed.Hi,param_payout_speed.Lo,param_payout_speed.SP)MOV(param_payout_speed.SP,p25_param_payout_speed_factor);
					RC: "Requests";
					N: OTE(p25r02.comment.3);
					N: [XIC(p25r02.unack_fault) ,XIC(p25r03.unack_fault) ,XIC(p25r04.unack_fault) ,XIC(p25r05.unack_fault) ,XIC(p25r06.unack_fault) ,XIC(p25r07.unack_fault) ,XIC(p25r08.unack_fault) ,XIC(p25r09.unack_fault) ,XIC(p25r10.unack_fault) ,XIC(p25r11.unack_fault) ]OTE(p25r02_unack_fault);
					N: [XIC(p25r02.unack_warning) ,XIC(p25r03.unack_warning) ,XIC(p25r04.unack_warning) ,XIC(p25r05.unack_warning) ,XIC(p25r06.unack_warning) ,XIC(p25r07.unack_warning) ,XIC(p25r08.unack_warning) ,XIC(p25r09.unack_warning) ,XIC(p25r10.unack_warning) ,XIC(p25r11.unack_warning) ]OTE(p25r02_unack_warning);
					RC: "Sequence";
					N: OTE(p25r02.comment.4);
					RC: "Output Control";
					N: OTE(p25r02.comment.5);
					RC: "Faults";
					N: OTE(p25r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r02.fault,p25r02.fault_ack);
					N: XIC(FAULT)[TON(p25r02_timer_fault[0],?,?) ,XIC(p25r02_timer_fault[0].DN) OTL(p25r02.fault.0) ];
					N: XIC(p25r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r02.fault.0) ,OTU(p25r02.fault_ack.0) ];
					N: NEQ(p25r02.fault,p25r02.fault_ack)OTE(p25r02.unack_fault);
					RC: "Warnings";
					N: OTE(p25r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r02.warning,p25r02.warning_ack);
					N: XIC(FAULT)[TON(p25r02_timer_warning[0],?,?) ,XIC(p25r02_timer_warning[0].DN) OTL(p25r02.warning.0) ];
					N: XIO(FAULT)[OTU(p25r02.warning.0) ,OTU(p25r02.warning_ack.0) ];
					N: NEQ(p25r02.warning,p25r02.warning_ack)OTE(p25r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p25r03$N"
					    "This routine is called, continuously, from p25r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p25r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r03.comment (dint)$N"
					    "p25r03.oneshot (dint)$N"
					    "p25r03_timer_xxxx (timer)$N"
					    "p25r03_xxxx (any)$N"
					    "p25r03.fault (dint)$N"
					    "p25r03.warning (dint)$N"
					    "";
					N: OTE(p25r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p25r03.comment.2);
					RC: "Digital";
					N: OTE(p25r03.comment.3);
					N: [XIC(p00_io_winder:5:I.8) OTE(p25_di_jog_fwd) ,XIC(p00_io_winder:5:I.9) OTE(p25_di_jog_rev) ,XIC(p00_io_winder:5:I.10) OTE(p25_di_jog) ,XIC(p00_io_winder:5:I.11) OTE(p25_di_run) ];
					N: [XIC(p00_io_line:2:I.11) OTE(p25_di_therm) ,XIC(p00_io_line:2:I.12) OTE(p25_di_brake) ];
					RC: "VFD Inputs";
					N: MOV(p00_vfd_ts2:I.Data[0],p25_status_word);
					N: XIC(p01r02.fault.14)FLL(0,p00_vfd_ts2:I.Data[0],4);
					RC: "Analog";
					N: OTE(p25r03.comment.4);
					N: SYS_SCP(p25r03_lc_scp,p00_io_winder:2:I.Ch4Data,p25r03_lc_input_min,p25r03_lc_input_max,p25r03_lc_output_min,p25r03_lc_output_max,p25_ai_ts2_lc);
					RC: "VFD";
					N: OTE(p25r03.comment.5);
					N: SYS_SCP(p25r03_vfd_in_scaling,p00_vfd_ts2:I.Data[1],p25r03_vfd_input_min,p25r03_vfd_input_max,p25r03_vfd_output_min,p25r03_vfd_output_max,p25r03_scaled_vfd_in);
					N: SYS_RPM_TO_SPEED(p25R03_ts2_vfd_rpm_to_speed,p25_ts2_gear_ratio,p25_ts2_roll_diameter_ft,p25r03_scaled_vfd_in,p25_ai_speed);
					N: CPT(p25_ai_amps,p00_vfd_ts2:I.Data[2]*0.1);
					N: CPT(p25_ai_torque,p00_vfd_ts2:I.Data[3]*0.01);
					N: XIO(p25r03_sample_timer.DN)TON(p25r03_sample_timer,?,?);
					N: XIC(p25r03_sample_timer.DN)[XIC(p25r03_tq_fifo.DN) FFU(p25r03_tq_buffer[0],p25r03_unload,p25r03_tq_fifo,?,?) ,FFL(p25_ai_torque,p25r03_tq_buffer[0],p25r03_tq_fifo,?,?) ,XIC(p25r03_tq_fifo.DN) AVE(p25r03_tq_buffer[0],0,p25r03_ave_tq,p25r03_tq_ave_ctrl,?,?) ];
					N: XIC(p25r03_tq_fifo.ER)OTU(p25r03_tq_fifo.ER);
					N: XIC(p25r03_tq_ave_ctrl.ER)OTU(p25r03_tq_ave_ctrl.ER);
					N: MOV(p25r03_ave_tq,p25_ai_torque);
					N: SYS_SCP(p25r03_hz,p00_vfd_ts2:I.Data[1],0,2000,0,60,p25_ai_hz);
					RC: "Faults";
					N: OTE(p25r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r03.fault,p25r03.fault_ack);
					N: XIC(FAULT)[TON(p25r03_timer_fault[0],?,?) ,XIC(p25r03_timer_fault[0].DN) OTL(p25r03.fault.0) ];
					N: XIC(p25r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r03.fault.0) ,OTU(p25r03.fault_ack.0) ];
					N: XIC(FAULT)[TON(p25r03_timer_fault[1],?,?) ,XIC(p25r03_timer_fault[1].DN) OTL(p25r03.fault.1) ];
					N: XIC(p25r03.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r03.fault.1) ,OTU(p25r03.fault_ack.1) ];
					N: NEQ(p25r03.fault,p25r03.fault_ack)OTE(p25r03.unack_fault);
					RC: "Warnings";
					N: OTE(p25r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r03.warning,p25r03.warning_ack);
					N: XIC(FAULT)[TON(p25r03_timer_warning[0],?,?) ,XIC(p25r03_timer_warning[0].DN) OTL(p25r03.warning.0) ];
					N: XIO(FAULT)[OTU(p25r03.warning.0) ,OTU(p25r03.warning_ack.0) ];
					N: NEQ(p25r03.warning,p25r03.warning_ack)OTE(p25r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p25r04$N"
					    "This routine is called, continuously, from p25r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p25r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r04.comment (dint)$N"
					    "p25r04.oneshot (dint)$N"
					    "p25r04_timer_xxxx (timer)$N"
					    "p25r04_xxxx (any)$N"
					    "p25r04.fault (dint)$N"
					    "p25r04.warning (dint)$N"
					    "";
					N: OTE(p25r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p25r04.comment.2);
					RC: "Digital";
					N: OTE(p25r04.comment.3);
					N: MOV(p25_control_word,p00_vfd_ts2:O.Data[0]);
					RC: "Analog";
					N: OTE(p25r04.comment.4);
					RC: "VFD";
					N: OTE(p25r04.comment.5);
					N: SYS_SPEED_TO_VFD(p25r04_speed_to_vfd_ts2_scp,p25_ts2_gear_ratio,p25_ts2_roll_diameter_ft,p25_ao_selected_speed,p25_ao_vfd);
					N: SYS_SCP(p25r03_vfd_out_scaling,p25_ao_vfd,p25_vfd_input_min,p25_vfd_input_max,p25_vfd_output_min,p25_vfd_output_max,p00_vfd_ts2:O.Data[1]);
					N: CPT(p00_vfd_ts2:O.Data[2],p25_ao_torque*100);
					RC: "Faults";
					N: OTE(p25r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r04.fault,p25r04.fault_ack);
					N: XIC(FAULT)[TON(p25r04_timer_fault[0],?,?) ,XIC(p25r04_timer_fault[0].DN) OTL(p25r04.fault.0) ];
					N: XIC(p25r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r04.fault.0) ,OTU(p25r04.fault_ack.0) ];
					N: NEQ(p25r04.fault,p25r04.fault_ack)OTE(p25r04.unack_fault);
					RC: "Warnings";
					N: OTE(p25r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r04.warning,p25r04.warning_ack);
					N: XIC(FAULT)[TON(p25r04_timer_warning[0],?,?) ,XIC(p25r04_timer_warning[0].DN) OTL(p25r04.warning.0) ];
					N: XIO(FAULT)[OTU(p25r04.warning.0) ,OTU(p25r04.warning_ack.0) ];
					N: NEQ(p25r04.warning,p25r04.warning_ack)OTE(p25r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p25r05$N"
					    "This routine is called, continuously, from p25r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p25r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r05.comment (dint)$N"
					    "p25r05.oneshot (dint)$N"
					    "p25r05_timer_xxxx (timer)$N"
					    "p25r05_xxxx (any)$N"
					    "p25r05.fault (dint)$N"
					    "p25r05.warning (dint)$N"
					    "";
					N: OTE(p25r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p25r05.comment.2);
					RC: "Digital IO";
					N: OTE(p25r05.comment.3);
					N: [XIC(HMI) OTE(p25_dint_to_hmi[0].0) ,XIC(HMI) OTE(p25_dint_to_hmi[0].1) ,XIC(HMI) OTE(p25_dint_to_hmi[0].2) ,XIC(HMI) OTE(p25_dint_to_hmi[0].3) ];
					N: [XIC(HMI) OTE(p25_dint_to_hmi[0].4) ,XIC(HMI) OTE(p25_dint_to_hmi[0].5) ,XIC(HMI) OTE(p25_dint_to_hmi[0].6) ,XIC(HMI) OTE(p25_dint_to_hmi[0].7) ];
					N: [XIC(p25_di_therm) OTE(p25_dint_to_hmi[0].8) ,XIC(p25_di_brake) OTE(p25_dint_to_hmi[0].9) ,XIC(HMI) OTE(p25_dint_to_hmi[0].10) ,XIC(HMI) OTE(p25_dint_to_hmi[0].11) ];
					N: [XIC(p25_di_ts2.faulted) OTE(p25_dint_to_hmi[0].12) ,XIC(p25_di_ts2.warning) OTE(p25_dint_to_hmi[0].13) ,XIC(p25_di_ts2.running_fwd) OTE(p25_dint_to_hmi[0].14) ,XIC(p25_di_ts2.running_rev) OTE(p25_dint_to_hmi[0].15) ];
					N: [XIC(p25_di_ts2.ready) OTE(p25_dint_to_hmi[0].16) ,XIC(p25_di_ts2.ctrl_from_net) OTE(p25_dint_to_hmi[0].17) ,XIC(p25_di_ts2.ref_from_net) OTE(p25_dint_to_hmi[0].18) ,XIC(p25_di_ts2.at_reference) OTE(p25_dint_to_hmi[0].19) ];
					N: MOV(p25_status_word,p25_dint_to_hmi[1]);
					N: [XIC(HMI) OTE(p25_dint_to_hmi[6].0) ,XIC(HMI) OTE(p25_dint_to_hmi[6].1) ,XIC(HMI) OTE(p25_dint_to_hmi[6].2) ,XIC(HMI) OTE(p25_dint_to_hmi[6].3) ];
					N: [XIC(HMI) OTE(p25_dint_to_hmi[6].4) ,XIC(HMI) OTE(p25_dint_to_hmi[6].5) ,XIC(HMI) OTE(p25_dint_to_hmi[6].6) ,XIC(HMI) OTE(p25_dint_to_hmi[6].7) ];
					N: [XIC(HMI) OTE(p25_dint_to_hmi[6].8) ,XIC(HMI) OTE(p25_dint_to_hmi[6].9) ,XIC(HMI) OTE(p25_dint_to_hmi[6].10) ,XIC(HMI) OTE(p25_dint_to_hmi[6].11) ];
					N: [XIC(HMI) OTE(p25_dint_to_hmi[6].16) ,XIO(HMI) OTE(p25_dint_to_hmi[6].17) ,XIC(HMI) OTE(p25_dint_to_hmi[6].18) ,XIC(HMI) OTE(p25_dint_to_hmi[6].19) ];
					N: MOV(0,p25_dint_to_hmi[7])[XIC(p25r09_mode_jog) MOV(1,p25_dint_to_hmi[7]) ,XIC(p25r09_mode_run) MOV(2,p25_dint_to_hmi[7]) ,XIC(p25r09_mode_thread) MOV(3,p25_dint_to_hmi[7]) ];
					RC: "Sequence";
					N: OTE(p25r05.comment.4);
					RC: "Output Control";
					N: OTE(p25r05.comment.5);
					RC: "Faults";
					N: OTE(p25r05.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r05.fault,p25r05.fault_ack);
					N: XIC(FAULT)[TON(p25r05_timer_fault[0],?,?) ,XIC(p25r05_timer_fault[0].DN) OTL(p25r05.fault.0) ];
					N: XIC(p25r05.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r05.fault.0) ,OTU(p25r05.fault_ack.0) ];
					N: NEQ(p25r05.fault,p25r05.fault_ack)OTE(p25r05.unack_fault);
					RC: "Warnings";
					N: OTE(p25r05.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r05.warning,p25r05.warning_ack);
					N: XIC(FAULT)[TON(p25r05_timer_warning[0],?,?) ,XIC(p25r05_timer_warning[0].DN) OTL(p25r05.warning.0) ];
					N: XIO(FAULT)[OTU(p25r05.warning.0) ,OTU(p25r05.warning_ack.0) ];
					N: NEQ(p25r05.warning,p25r05.warning_ack)OTE(p25r05.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R06_Real_to_HMI 
					RC: "Notes:$N"
					    "";
					N: OTE(p25r06.comment.2);
					N: XIO(p25r06_sample_timer.DN)TON(p25r06_sample_timer,?,?);
					N: XIC(p25r06_sample_timer.DN)[XIC(p25r06_lc_ctrl.DN) FFU(p25r06_lc_buffer[0],p25r06_unload,p25r06_lc_ctrl,?,?) ,FFL(p25_ai_ts2_lc,p25r06_lc_buffer[0],p25r06_lc_ctrl,?,?) ,XIC(p25r06_lc_ctrl.DN) AVE(p25r06_lc_buffer[0],0,p25r06_ave_lc,p25r06_lc_ave_ctrl,?,?) ];
					N: XIC(p25r06_lc_ctrl.ER)OTU(p25r06_lc_ctrl.ER);
					N: XIC(p25r06_lc_ave_ctrl.ER)OTU(p25r06_lc_ave_ctrl.ER);
					RC: "Analog Input";
