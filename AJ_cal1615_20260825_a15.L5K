					N: [XIC(p12_di_door_open) OTE(p12_dint_to_hmi[5].4) ,XIC(p12_di_exh_fan_mtr_ts) OTE(p12_dint_to_hmi[5].5) ,XIC(p12_di_exh_flow_ok) OTE(p12_dint_to_hmi[5].6) ,XIO(p12_di_flame_failure) OTE(p12_dint_to_hmi[5].7) ];
					N: [XIC(p12_di_flame_on) OTE(p12_dint_to_hmi[5].8) ,XIC(p12_di_high_limit_temp_ok) OTE(p12_dint_to_hmi[5].9) ,XIC(p12_di_recirc_fan_mtr_ts) OTE(p12_dint_to_hmi[5].10) ,XIC(p12_di_recirc_flow_ok) OTE(p12_dint_to_hmi[5].11) ];
					N: [XIC(HMI) OTE(p12_dint_to_hmi[5].12) ,XIC(p12_di_fresh_air_clean) OTE(p12_dint_to_hmi[5].13) ,XIC(p12_di_tc01_bo) OTE(p12_dint_to_hmi[5].14) ,XIC(p12_di_tc02_bo) OTE(p12_dint_to_hmi[5].15) ];
					N: [[XIC(p12_di_exh.running_fwd) ,XIC(p12_di_exh.running_rev) ] OTE(p12_dint_to_hmi[5].16) ,[XIC(p12_di_exh.running_fwd) ,XIC(p12_di_exh.running_rev) ] OTE(p12_dint_to_hmi[5].17) ,XIC(p12_di_tc01_bo) OTE(p12_dint_to_hmi[5].18) ,XIC(p12_di_tc02_bo) OTE(p12_dint_to_hmi[5].19) ];
					N: [XIC(p12_di_recirc.running_fwd) OTE(p12_dint_to_hmi[5].24) ,XIC(p12_di_exh.running_fwd) OTE(p12_dint_to_hmi[5].25) ,XIC(p12_di_tc01_bo) OTE(p12_dint_to_hmi[5].26) ,XIC(p12_di_tc02_bo) OTE(p12_dint_to_hmi[5].27) ];
					N: [XIC(p12_di_exh.faulted) OTE(p12_dint_to_hmi[6].0) ,XIC(p12_di_exh.warning) OTE(p12_dint_to_hmi[6].1) ,XIC(p12_di_exh.running_fwd) OTE(p12_dint_to_hmi[6].2) ,XIC(p12_di_exh.running_rev) OTE(p12_dint_to_hmi[6].3) ];
					N: [XIC(p12_di_exh.ready) OTE(p12_dint_to_hmi[6].4) ,XIC(p12_di_exh.ctrl_from_net) OTE(p12_dint_to_hmi[6].5) ,XIC(p12_di_exh.ref_from_net) OTE(p12_dint_to_hmi[6].6) ,XIC(p12_di_exh.at_reference) OTE(p12_dint_to_hmi[6].7) ];
					N: [XIC(p12_di_recirc.faulted) OTE(p12_dint_to_hmi[6].8) ,XIC(p12_di_recirc.warning) OTE(p12_dint_to_hmi[6].9) ,XIC(p12_di_recirc.running_fwd) OTE(p12_dint_to_hmi[6].10) ,XIC(p12_di_recirc.running_rev) OTE(p12_dint_to_hmi[6].11) ];
					N: [XIC(p12_di_recirc.ready) OTE(p12_dint_to_hmi[6].12) ,XIC(p12_di_recirc.ctrl_from_net) OTE(p12_dint_to_hmi[6].13) ,XIC(p12_di_recirc.ref_from_net) OTE(p12_dint_to_hmi[6].14) ,XIC(p12_di_recirc.at_reference) OTE(p12_dint_to_hmi[6].15) ];
					RC: "Sequence";
					N: OTE(p12r05.comment.4);
					N: MOV(0,p12_dint_to_hmi[7])MOV(p12r20_status,p12_dint_to_hmi[8]);
					N: MOV(0,p12r05_Temp_ctl_status)[XIC(p12r30_permissive_run) MOV(1,p12r05_Temp_ctl_status) ,XIC(p12r30_request_heat) MOV(2,p12r05_Temp_ctl_status) ,XIC(p12r20_state.31) MOV(8,p12r05_Temp_ctl_status) ,XIO(p12r30_permissive_run) MOV(4,p12r05_Temp_ctl_status) ,XIO(p12_di_burner_auto) MOV(7,p12r05_Temp_ctl_status) ];
					N: MOV(p12r05_Temp_ctl_status,p12_dint_to_hmi[9]);
					RC: "1 = Ready$N"
					    "2 = Running$N"
					    "3 = $N"
					    "4 = Fault$N"
					    "5 = Offline$N"
					    "6 = Auto Stop";
					N: MOV(5,p12r05_exh_status)[EQU(p12r31.fault,0) MOV(1,p12r05_exh_status) ,[XIC(p12_di_exh.running_fwd) ,XIC(p12_di_exh.running_rev) ] MOV(2,p12r05_exh_status) ,XIC(p12r31_vfd_stopped) MOV(3,p12r05_exh_status) ,NEQ(p12r31.fault,0) MOV(4,p12r05_exh_status) ];
					N: MOV(p12r05_exh_status,p12_dint_to_hmi[10]);
					N: MOV(5,p12r05_recirc_status)[EQU(p12r32.fault,0) MOV(1,p12r05_recirc_status) ,[XIC(p12_di_recirc.running_fwd) ,XIC(p12_di_recirc.running_rev) ] MOV(2,p12r05_recirc_status) ,XIC(p12r32_vfd_stopped) MOV(3,p12r05_recirc_status) ,NEQ(p12r32.fault,0) MOV(4,p12r05_recirc_status) ];
					N: MOV(p12r05_recirc_status,p12_dint_to_hmi[11]);
					N: MOV(0,p12_dint_to_hmi[12])MOV(0,p12_dint_to_hmi[13])MOV(0,p12_dint_to_hmi[14])MOV(0,p12_dint_to_hmi[15]);
					RC: "Output Control";
					N: OTE(p12r05.comment.5);
					RC: "Faults";
					N: OTE(p12r05.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p12r05.fault,p12r05.fault_ack);
					N: XIC(FAULT)[TON(p12r05_timer_fault[0],?,?) ,XIC(p12r05_timer_fault[0].DN) OTL(p12r05.fault.0) ];
					N: XIC(p12r05.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r05.fault.0) ,OTU(p12r05.fault_ack.0) ];
					N: NEQ(p12r05.fault,p12r05.fault_ack)OTE(p12r05.unack_fault);
					RC: "Warnings";
					N: OTE(p12r05.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p12r05.warning,p12r05.warning_ack);
					N: XIC(FAULT)[TON(p12r05_timer_warning[0],?,?) ,XIC(p12r05_timer_warning[0].DN) OTL(p12r05.warning.0) ];
					N: XIO(FAULT)[OTU(p12r05.warning.0) ,OTU(p12r05.warning_ack.0) ];
					N: NEQ(p12r05.warning,p12r05.warning_ack)OTE(p12r05.unack_warning);
					N: RET();
			END_ROUTINE

