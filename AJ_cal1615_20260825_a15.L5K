					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Sequence,0);
					N: JSR(R16_Temperature_Control,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p21R02$N"
					    "This routine is called, continuously, from p21R01 Main while the plc is in Run mode.";
					N: SBR()OTE(p21r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p21r02.comment (dint)$N"
					    "p21r02.oneshot (dint)$N"
					    "p21r02_timer_xxxx (timer)$N"
					    "p21r02_xxxx (any)$N"
					    "p21r02.fault (dint)$N"
					    "p21r02a_warnings (dint)$N"
					    "";
					N: OTE(p21r02.comment.1);
					RC: "Notes";
					N: OTE(p21r02.comment.2);
					N: NEQ(p21_dint_to_hmi[2],0)OTE(p21r02_fault_exists);
					N: NEQ(p21_dint_to_hmi[4],0)OTE(p21r02_warning_exists);
					RC: "Requests";
					N: OTE(p21r02.comment.3);
					N: [XIC(p21r02.unack_fault) ,XIC(p21r03.unack_fault) ,XIC(p21r04.unack_fault) ,XIC(p21r05.unack_fault) ,XIC(p21r06.unack_fault) ,XIC(p21r07.unack_fault) ,XIC(p21r08.unack_fault) ,XIC(p21r09.unack_fault) ,XIC(p21r10.unack_fault) ,XIC(p21r16.unack_fault) ]OTE(p21r02_unack_fault);
					N: [XIC(p21r02.unack_warning) ,XIC(p21r03.unack_warning) ,XIC(p21r04.unack_warning) ,XIC(p21r05.unack_warning) ,XIC(p21r06.unack_warning) ,XIC(p21r07.unack_warning) ,XIC(p21r08.unack_warning) ,XIC(p21r09.unack_warning) ,XIC(p21r10.unack_warning) ,XIC(p21r16.unack_warning) ]OTE(p21r02_unack_warning);
					RC: "Sequence";
					N: OTE(p21r02.comment.4);
					RC: "Output Control";
					N: OTE(p21r02.comment.5);
					RC: "Faults";
					N: OTE(p21r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p21r02.fault,p21r02.fault_ack);
					N: XIC(FAULT)[TON(p21r02_timer_fault[0],?,?) ,XIC(p21r02_timer_fault[0].DN) OTL(p21r02.fault.0) ];
					N: XIC(p21r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p21r02.fault.0) ,OTU(p21r02.fault_ack.0) ];
					N: NEQ(p21r02.fault,p21r02.fault_ack)OTE(p21r02.unack_fault);
					RC: "Warnings";
					N: OTE(p21r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p21r02.warning,p21r02.warning_ack);
					N: XIC(FAULT)[TON(p21r02_timer_warning[0],?,?) ,XIC(p21r02_timer_warning[0].DN) OTL(p21r02.warning.0) ];
					N: XIO(FAULT)[OTU(p21r02.warning.0) ,OTU(p21r02.warning_ack.0) ];
					N: NEQ(p21r02.warning,p21r02.warning_ack)OTE(p21r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p21r03$N"
					    "This routine is called, continuously, from p21R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p21r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p21r03.comment (dint)$N"
					    "p21r03.oneshot (dint)$N"
					    "p21r03_timer_xxxx (timer)$N"
					    "p21r03_xxxx (any)$N"
					    "p21r03.fault (dint)$N"
					    "p21r03.warning (dint)$N"
					    "";
					N: OTE(p21r03.comment.1);
					RC: "Notes:$N"
					    "";
