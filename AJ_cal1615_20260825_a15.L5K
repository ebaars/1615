					N: CMP(p12r30_pid_temp.PV<(p12_param_tc01_hl-5))OTE(p12r16_temp_ok);
					N: XIC(p12r30.fault_ack.0)XIC(p12r16_temp_ok)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.0) ,OTU(p12r30.fault_ack.0) ];
					N: XIO(p12_di_high_limit_temp_ok)[TON(p12r30_timer_fault[1],?,?) ,XIC(p12r30_timer_fault[1].DN) OTL(p12r30.fault.1) ];
					N: XIC(p12r30.fault_ack.1)XIC(p12_di_high_limit_temp_ok)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.1) ,OTU(p12r30.fault_ack.1) ];
					N: XIC(p12_di_tc01_bo)XIC(p12_di_tc02_bo)[TON(p12r30_timer_fault[2],?,?) ,XIC(p12r30_timer_fault[2].DN) OTL(p12r30.fault.2) ];
					N: XIC(p12r30.fault_ack.2)[XIO(p12_di_tc01_bo) ,XIO(p12_di_tc02_bo) ]XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.2) ,OTU(p12r30.fault_ack.2) ];
					N: XIC(FAULT)[TON(p12r30_timer_fault[3],?,?) ,XIC(p12r30_timer_fault[3].DN) OTL(p12r30.fault.3) ];
					N: XIC(p12r30.fault_ack.3)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.3) ,OTU(p12r30.fault_ack.3) ];
					N: [GEQ(p12_ai_lfl,p12_param_lfl_hhl) ,XIC(p12_di_sp00) ][TON(p12r30_timer_fault[4],?,?) ,XIC(p12r30_timer_fault[4].DN) OTL(p12r30.fault.4) ];
					N: XIC(p12r30.fault_ack.4)CMP(p12_ai_lfl<(p12_param_lfl_hhl-5))XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.4) ,OTU(p12r30.fault_ack.4) ];
