					N: XIC(p20r15.fault_ack.0)XIO(p20_vfd_di_loa.faulted)XIC(p01r09_pb_global_reset)[OTU(p20r15.fault.0) ,OTU(p20r15.fault_ack.0) ];
					N: XIO(p20_vfd_di_loa.ready)[TON(p20r15_timer_fault[2],?,?) ,XIC(p20r15_timer_fault[2].DN) OTL(p20r15.fault.2) ];
					N: XIC(p20r15.fault_ack.2)XIC(p20_vfd_di_loa.ready)XIC(p01r09_pb_global_reset)[OTU(p20r15.fault.2) ,OTU(p20r15.fault_ack.2) ];
					N: XIC(p20_vfd_di_loa.ready)XIO(p20_vfd_di_loa.ctrl_from_net)[TON(p20r15_timer_fault[3],?,?) ,XIC(p20r15_timer_fault[3].DN) OTL(p20r15.fault.3) ];
					N: XIC(p20r15.fault_ack.3)[XIC(p20_vfd_di_loa.ctrl_from_net) ,XIO(p20_vfd_di_loa.ready) ]XIC(p01r09_pb_global_reset)[OTU(p20r15.fault.3) ,OTU(p20r15.fault_ack.3) ];
					N: XIO(p20_di_loa_temp)[TON(p20r15_timer_fault[4],?,?) ,XIC(p20r15_timer_fault[4].DN) OTL(p20r15.fault.4) ];
					N: XIC(p20r15.fault.4)XIC(p20_di_loa_temp)XIC(p01r09_pb_global_reset)[OTU(p20r15.fault.4) ,OTU(p20r15.fault_ack.4) ];
					N: XIO(p20_di_loa_brake)[TON(p20r15_timer_fault[5],?,?) ,XIC(p20r15_timer_fault[5].DN) OTL(p20r15.fault.5) ];
					N: XIC(p20r15.fault.5)XIC(p20_di_loa_brake)XIC(p01r09_pb_global_reset)[OTU(p20r15.fault.5) ,OTU(p20r15.fault_ack.5) ];
