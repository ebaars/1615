					N: [XIC(HMI) OTE(p12_dint_to_hmi[4].12) ,XIC(HMI) OTE(p12_dint_to_hmi[4].13) ,XIC(HMI) OTE(p12_dint_to_hmi[4].14) ,XIC(HMI) OTE(p12_dint_to_hmi[4].15) ];
					N: [XIC(p12r30_request_heat) OTE(p12_dint_to_hmi[4].16) ,XIO(p12r30_request_heat) OTE(p12_dint_to_hmi[4].17) ,XIC(p12r30_request_manual) OTE(p12_dint_to_hmi[4].18) ,XIO(p12r30_request_manual) OTE(p12_dint_to_hmi[4].19) ];
					N: [XIC(HMI) OTE(p12_dint_to_hmi[4].20) ,XIC(HMI) OTE(p12_dint_to_hmi[4].21) ,XIC(HMI) OTE(p12_dint_to_hmi[4].22) ,XIC(HMI) OTE(p12_dint_to_hmi[4].23) ];
