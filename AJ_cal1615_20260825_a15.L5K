					N: XIC(p12r30.fault_ack.9)[XIO(p12_di_door_open) ,XIO(p12_di_burner_auto) ]XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.9) ,OTU(p12r30.fault_ack.9) ];
					N: XIO(p12_do_enable_burner)XIC(p12_di_flame_on)[TON(p12r30_timer_fault[10],?,?) ,XIC(p12r30_timer_fault[10].DN) OTL(p12r30.fault.10) ];
					N: XIC(p12r30.fault_ack.10)XIO(p12_di_flame_on)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.10) ,OTU(p12r30.fault_ack.10) ];
					N: XIC(p12r30_request_heat_last)XIO(p23_di_supply_speed_ok)[TON(p12r30_timer_fault[11],?,?) ,XIC(p12r30_timer_fault[11].DN) OTL(p12r30.fault.11) ];
					N: XIC(p12r30.fault_ack.11)XIO(p12r30_request_heat)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.11) ,OTU(p12r30.fault_ack.11) ];
					N: XIC(p12r30_request_heat_last)XIO(p23_di_exhaust_speed_ok)[TON(p12r30_timer_fault[12],?,?) ,XIC(p12r30_timer_fault[12].DN) OTL(p12r30.fault.12) ];
					N: XIC(p12r30.fault_ack.12)XIO(p11r30_request_heat)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.12) ,OTU(p12r30.fault_ack.12) ];
					N: XIC(FAULT)[TON(p12r30_timer_fault[13],?,?) ,XIC(p12r30_timer_fault[13].DN) OTU(p12r30.fault.13) ];
					N: XIC(p12r30.fault_ack.13)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.13) ,OTU(p12r30.fault_ack.13) ];
					N: XIC(FAULT)[TON(p12r30_timer_fault[14],?,?) ,XIC(p12r30_timer_fault[14].DN) OTU(p12r30.fault.14) ];
					N: XIC(p12r30.fault_ack.14)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p12r30.fault.14) ,OTU(p12r30.fault_ack.14) ];
					N: XIC(FAULT)[TON(p12r30_timer_fault[15],?,?) ,XIC(p12r30_timer_fault[15].DN) OTU(p12r30.fault.15) ];
