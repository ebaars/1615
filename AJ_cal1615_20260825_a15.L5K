					N: XIC(p20r15_request_over_speed)[[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ] [LES(p01r12_master_ramped_speed,10) MOV(p20_param_lof_slow_fill,p20r15_loa_selected_speed) ,GEQ(p01r12_master_ramped_speed,10) MOV(p20_param_lof_fast_fill,p20r15_loa_selected_speed) ] ,XIO(p01r13_line_running) MOV(p20_param_lof_stop_fill,p20r15_loa_selected_speed) ];
					N: [XIC(p20r15_request_jog_fwd) ,XIC(p20r15_request_jog_rev) ]XIC(p20_di_loa_jog)MOV(p20_param_letoff_jog_speed,p20r15_loa_selected_speed);
					N: XIO(p20r15_request_tension)XIO(p20r15_request_over_speed)XIO(p20r15_request_position)XIO(p20r15_request_thread_fwd)XIO(p20r15_request_thread_rev)XIO(p20_di_loa_jog)MOV(0,p20r15_loa_selected_speed);
					N: XIC(p20r15_request_tension)[XIC(p20r13_state.1) ,XIC(p20r13_state.5) ]MOV(p20_param_high_accel_rate,p20r15_loa_accel)MOV(p20_param_high_decel_rate,p20r15_loa_decel);
					N: XIC(p20r15_request_tension)XIC(p20r13_state.2)MOV(p20_param_norm_accel_rate,p20r15_loa_accel)MOV(p20_param_norm_decel_rate,p20r15_loa_decel);
					N: XIC(p20_di_loa_jog)MOV(p20_param_jog_accel_rate,p20r15_loa_accel)MOV(p20_param_jog_decel_rate,p20r15_loa_decel);
					N: XIC(p20r13_state.8)CPT(p20_ao_loa_selected_speed,ABS(p22_ao_selected_speed)*1);
					N: XIO(p20r13_state.8)SYS_ACC_DEC_RAMP(p20r15_loa_accel_decel_ramp,p20r15_loa_selected_speed,p20r15_loa_accel,p20r15_loa_decel,p01r02_plc_scan_time_in_sec,p20_ao_loa_selected_speed)MOV(p20_ao_loa_selected_speed,p20_ao_loa_selected_speed);
