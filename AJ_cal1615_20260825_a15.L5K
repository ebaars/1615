			ROUTINE R30_Temperature_Control 
					RC: "p19r16$N"
					    "This routine is called, continuously, from p19R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p19r30.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p19r16.comment (dint)$N"
					    "p19r16.oneshot (dint)$N"
					    "p19r16_timer_xxxx (timer)$N"
					    "p19r16_xxxx (any)$N"
					    "p19r16.fault (dint)$N"
					    "p19r16.warning (dint)$N"
					    "";
					N: OTE(p19r30.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p19r30.comment.2);
					N: [XIC(p02_dint_from_hmi.zone_3[4].16) ,XIC(p02_dint_from_hmi.global[6].10) ]OTE(p19r30_pb_zone_on);
					N: [XIC(p02_dint_from_hmi.zone_3[4].17) ,XIC(p02_dint_from_hmi.global[6].11) ]OTE(p19r30_pb_zone_off);
					N: XIC(p02_dint_from_hmi.adv_cooling[4].18)[OTE(p19r30_pb_manual) ,OTU(p02_dint_from_hmi.adv_cooling[4].18) ];
					N: XIC(p02_dint_from_hmi.adv_cooling[4].17)OTE(p19r30_pb_auto);
					N: MOV(p01_recipe_active.adv_cooling_temp_sp,p19r30_pid_temp_sp);
					RC: "Multiply by 10,$N"
					    "Scaled back down in the PID$N"
					    "Use Dint for PID";
					N: MUL(p19_ai_tc01,10,p19r30_pid_temp_pv);
					RC: "Requests";
					N: OTE(p19r30.comment.3);
					N: XIO(p19r30.fault.0)OTE(p19r30_permissive_run);
					N: [XIC(p19r30_pb_zone_on) ,XIC(p19r30_request_cool) ]XIO(p19r30_pb_zone_off)XIC(p19r30_permissive_run)OTE(p19r30_request_cool);
					N: [XIC(p19r30_pb_manual) ,XIC(p19r30_request_manual) ]XIO(p19r30_pb_auto)XIC(p19r30_permissive_run)OTE(p19r30_request_manual);
					RC: "Sequence";
					N: OTE(p19r30.comment.4);
					RC: "Configure PID";
					N: OTE(p19r30.comment.5);
					N: XIC(p19r30_request_manual)OTE(p19r30_pid_temp.SWM);
					N: XIC(p19r30_request_cool)MOV(p19r30_pid_temp_sp,p19r30_pid_temp.SP);
					N: XIO(p19r30_request_cool)MOV(100,p19r30_pid_temp.SP);
					N: XIO(p19r30_request_cool)MOV(0,p19r30_pid_temp.SO);
					N: XIC(p19r30_request_manual)MOV(p19r30_cv_man_sp,p19r30_pid_temp.SO);
					N: LES(p19r30_pid_temp.UPD,0.01)MOV(0.01,p19r30_pid_temp.UPD);
					N: [MOV(p19_param_pid2_kp,p19r30_pid_temp.KP) MOV(p19_param_pid2_ki,p19r30_pid_temp.KI) ,MOV(p19_param_pid2_kd,p19r30_pid_temp.KD) MOV(p19_param_pid2_ff,p19r30_pid_temp.BIAS) ];
					N: MOV(p19r30_pid_temp.BIAS,p19r30_pid_temp.BIAS)PID(p19r30_pid_temp,p19r30_pid_temp_pv,0,p19r16_pid_temp_cv,0,0,0);
					RC: "Output Control";
					N: OTE(p19r30.comment.6);
					N: MOV(p19r30_pid_temp.OUT,p19_ao_cv);
					RC: "Faults";
					N: OTE(p19r30.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p19r30.fault,p19r30.fault_ack);
					N: XIC(p19_di_tc01_bo)[TON(p19r30_timer_fault[2],?,?) ,XIC(p19r30_timer_fault[2].DN) OTL(p19r30.fault.2) ];
					N: XIC(p19r30.fault_ack.2)XIO(p19_di_tc01_bo)XIC(p01r09_pb_global_reset)[OTU(p19r30.fault.2) ,OTU(p19r30.fault_ack.2) ];
					N: NEQ(p19r30.fault,p19r30.fault_ack)OTE(p19r30.unack_fault);
					RC: "Warnings";
					N: OTE(p19r30.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p19r30.warning,p19r30.warning_ack);
					N: XIC(p19r30_request_cool)GRT(p19r30_pid_temp.ERR,p19_param_tc01_dev)[TON(p19r30_timer_warning[0],?,?) ,XIC(p19r30_timer_warning[0].DN) OTL(p19r30.warning.0) ];
					N: XIC(p19r30.warning_ack.0)[CMP(p19r30_pid_temp.ERR+2<p19_param_tc01_dev) ,XIO(p19r30_request_cool) ][OTU(p19r30.warning.0) ,OTU(p19r30.warning_ack.0) ];
					N: XIC(p19_di_tc01_bo)[TON(p19r30_timer_warning[1],?,?) ,XIC(p19r30_timer_warning[1].DN) OTL(p19r30.warning.1) ];
					N: XIC(p19r30.warning_ack.1)XIO(p19_di_tc01_bo)[OTU(p19r30.warning.1) ,OTU(p19r30.warning_ack.1) ];
					N: XIC(p19r30_request_manual)[TON(p19r30_timer_warning[3],?,?) ,XIC(p19r30_timer_warning[3].DN) OTL(p19r30.warning.3) ];
					N: XIC(p19r30.warning_ack.3)XIO(p19r30_request_manual)[OTU(p19r30.warning.3) ,OTU(p19r30.warning_ack.3) ];
					N: NEQ(p19r30.warning,p19r30.warning_ack)OTE(p19r30.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R31_Pump 
					RC: "p19r31$N"
					    "This routine is called, continuously, from p19R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p19r31.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p19r31.comment (dint)$N"
					    "p19r31.oneshot (dint)$N"
					    "p19r31_timer_xxxx (timer)$N"
					    "p19r31_xxxx (any)$N"
					    "p19r31.fault (dint)$N"
					    "p19r31.warning (dint)$N"
					    "";
					N: OTE(p19r31.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p19r31.comment.2);
					N: XIC(p02_dint_from_hmi.adv_cooling[4].0)OTE(p19r31_pb_start);
					N: XIC(p02_dint_from_hmi.adv_cooling[4].1)OTE(p19r31_pb_stop);
					RC: "Requests";
					N: OTE(p19r31.comment.3);
					N: EQU(p19r31.fault,0)OTE(p19r31_run_permissive);
					N: [XIC(p19r31_pb_start) ,XIC(p19r31_request_manual_run) ]XIO(p13r30_request_cool)XIO(p19r30_request_cool)XIO(p19r31_pb_stop)OTE(p19r31_request_manual_run);
					N: [XIC(p19r31_request_manual_run) ,XIC(p13r30_request_cool) ,XIC(p19r30_request_cool) ]XIC(p19r31_run_permissive)OTE(p19r31_request_auto_run);
					RC: "Sequence";
					N: OTE(p19r31.comment.4);
					N: XIC(AFI)XIC(p19_do_pump)GRT(p19_ai_prs,p19_param_zone_pressure)[TON(p11r31_timer_prs,?,?) ,XIC(p11r31_timer_prs.DN) OTL(p19r31_request_a00) ];
					N: XIO(p19_do_pump)OTU(p19r31_request_a00);
					RC: "Output Control";
					N: OTE(p19r31.comment.5);
					N: XIC(p19r31_request_auto_run)OTE(p19_do_pump);
					RC: "Faults";
					N: OTE(p19r31.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p19r31.fault,p19r31.fault_ack);
					N: [XIO(p19r31_request_a00) MOV(5000,p19r31_timer_fault[0].PRE) ,XIC(p19r31_request_a00) MOV(1000,p19r31_timer_fault[0].PRE) ];
					N: XIC(AFI)XIC(p19_do_pump)LES(p19_ai_prs,p19_param_zone_pressure)[TON(p19r31_timer_fault[0],?,?) ,XIC(p19r31_timer_fault[0].DN) OTL(p19r31.fault.0) ];
					N: XIC(p19r31.fault_ack.0)XIO(p19_do_pump)XIC(p01r09_pb_global_reset)[OTU(p19r31.fault.0) ,OTU(p19r31.fault_ack.0) ];
					N: [XIO(p19_do_pump) XIC(p19_di_pump) ,XIC(p19_do_pump) XIO(p19_di_pump) ][TON(p19r31_timer_fault[1],?,?) ,XIC(p19r31_timer_fault[1].DN) OTL(p19r31.fault.1) ];
					N: XIC(p19r31.fault_ack.1)XIO(p19_do_pump)XIO(p19_di_pump)XIC(p01r09_pb_global_reset)[OTU(p19r31.fault.1) ,OTU(p19r31.fault_ack.1) ];
					N: NEQ(p19r31.fault,p19r31.fault_ack)OTE(p19r31.unack_fault);
					RC: "Warnings";
					N: OTE(p19r31.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p19r31.warning,p19r31.warning_ack);
					RC: "Probably need to add a FIFO for the pressure.";
					N: XIC(p13r30_request_cool)XIO(p19_do_pump)[TON(p19r31_timer_warning[0],?,?) ,XIC(p19r31_timer_warning[0].DN) OTL(p19r31.warning.0) ];
					N: [XIO(p13r30_request_cool) ,XIC(p19_do_pump) ][OTU(p19r31.warning.0) ,OTU(p19r31.warning_ack.0) ];
					N: NEQ(p19r31.warning,p19r31.warning_ack)OTE(p19r31.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R32_Pressure_Control 
					RC: "p19r16$N"
					    "This routine is called, continuously, from p19R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p19r32.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p19r16.comment (dint)$N"
					    "p19r16.oneshot (dint)$N"
					    "p19r16_timer_xxxx (timer)$N"
					    "p19r16_xxxx (any)$N"
					    "p19r16.fault (dint)$N"
					    "p19r16.warning (dint)$N"
					    "";
					N: OTE(p19r32.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p19r32.comment.2);
					N: OTE(p19r32_pb_zone_on);
					N: XIC(AFI)OTE(p19r32_pb_zone_off);
					N: XIC(AFI)OTE(p19r32_pb_manual);
					N: OTE(p19r32_pb_auto);
					N: MOV(p02_real_from_hmi.adv_cooling[66],p19r32_pid_prs_sp);
					RC: "Multiply by 10,$N"
					    "Scaled back down in the PID$N"
					    "Use Dint for PID";
					N: MUL(p19_ai_prs,10,p19r32_pid_temp_pv);
					RC: "Requests";
					N: OTE(p19r32.comment.3);
					N: XIO(p19r32.fault.0)OTE(p19r32_permissive_run);
					N: [XIC(p19r32_pb_zone_on) ,XIC(p19r32_request_cool) ]XIO(p19r32_pb_zone_off)XIC(p19r32_permissive_run)OTE(p19r32_request_cool);
					N: [XIC(p19r32_pb_manual) ,XIC(p19r32_request_manual) ]XIO(p19r32_pb_auto)XIC(p19r32_permissive_run)OTE(p19r32_request_manual);
					RC: "Sequence";
					N: OTE(p19r32.comment.4);
					RC: "Configure PID";
					N: OTE(p19r32.comment.5);
					N: XIC(p19r32_request_manual)OTE(p19r32_pid_prs.SWM);
					N: XIC(p19r32_request_cool)MOV(p19r32_pid_prs_sp,p19r32_pid_prs.SP);
					N: XIO(p19r32_request_cool)MOV(100,p19r32_pid_prs.SP);
					N: XIO(p19r32_request_cool)MOV(0,p19r32_pid_prs.SO);
					N: XIC(p19r32_request_manual)MOV(p19r32_cv_man_sp,p19r32_pid_prs.SO);
					N: LES(p19r32_pid_prs.UPD,0.01)MOV(0.01,p19r32_pid_prs.UPD);
					N: [MOV(p19_param_prs_pid_kp,p19r32_pid_prs.KP) MOV(p19_param_prs_pid_ki,p19r32_pid_prs.KI) ,MOV(p19_param_prs_pid_kd,p19r32_pid_prs.KD) MOV(p19_param_prs_pid_ff,p19r32_pid_prs.BIAS) ];
					N: MOV(p19r32_pid_prs.BIAS,p19r32_pid_prs.BIAS)PID(p19r32_pid_prs,p19r32_pid_temp_pv,0,p19r32_pid_temp_cv,0,0,0);
					RC: "Output Control";
					N: OTE(p19r32.comment.6);
					N: MOV(p19r32_pid_prs.OUT,p19_ao_prs_cv);
					RC: "Faults";
					N: OTE(p19r32.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p19r32.fault,p19r32.fault_ack);
					N: XIC(AFI)[TON(p19r32_timer_fault[2],?,?) ,XIC(p19r32_timer_fault[2].DN) OTL(p19r32.fault.2) ];
					N: XIC(p19r32.fault_ack.2)XIO(AFI)XIC(p01r09_pb_global_reset)[OTU(p19r32.fault.2) ,OTU(p19r32.fault_ack.2) ];
					N: NEQ(p19r32.fault,p19r32.fault_ack)OTE(p19r32.unack_fault);
					RC: "Warnings";
					N: OTE(p19r32.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p19r32.warning,p19r32.warning_ack);
					N: XIC(p19r32_request_cool)GRT(p19r32_pid_prs.ERR,p19_param_prs_dev)[TON(p19r32_timer_warning[0],?,?) ,XIC(p19r32_timer_warning[0].DN) OTL(p19r32.warning.0) ];
					N: [CMP(p19r32_pid_prs.ERR+2<p19_param_prs_dev) ,XIO(p19r32_request_cool) ][OTU(p19r32.warning.0) ,OTU(p19r32.warning_ack.0) ];
					N: XIC(AFI)[TON(p19r32_timer_warning[1],?,?) ,XIC(p19r32_timer_warning[1].DN) OTL(p19r32.warning.1) ];
					N: XIO(AFI)[OTU(p19r32.warning.1) ,OTU(p19r32.warning_ack.1) ];
					N: XIC(AFI)[TON(p19r32_timer_warning[3],?,?) ,XIC(p19r32_timer_warning[3].DN) OTL(p19r32.warning.3) ];
					N: XIO(AFI)[OTU(p19r32.warning.3) ,OTU(p19r32.warning_ack.3) ];
					N: NEQ(p19r32.warning,p19r32.warning_ack)OTE(p19r32.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P20_Letoff (MAIN := "R01_Main",
	                    MODE := 0,
	                    DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					RC: "p20R01 System Main$N"
					    "$N"
					    "This routine is called, continuously, from p20 System while the plc is in Run mode.  All other p20 System routines are called from this routine.";
					N: OTE(p20r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r01.comment (dint)$N"
					    "p20r01.oneshot (dint)$N"
					    "p20r01_timer_xxxx (timer)$N"
					    "p20r01_xxxx (any)$N"
					    "p20r01.fault (dint)$N"
					    "p20r01.warning (dint)$N"
					    "";
					N: OTE(p20r01.comment.1);
					RC: "Notes";
					N: OTE(p20r01.comment.2);
					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Letoff_Speed_Control,0);
					N: JSR(R11_Feedroll,0);
					N: JSR(R13_Accumulator,0);
					N: JSR(R15_Letoff_A_VFD,0);
					N: JSR(R16_Letoff_B_VFD,0);
					N: JSR(R17_Letoff_Diameter_Calc,0);
					N: JSR(R18_Letoff_Turret_VFD,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p20r02$N"
					    "This routine is called, continuously, from p20r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r02.comment (dint)$N"
					    "p20r02.oneshot (dint)$N"
					    "p20r02_timer_xxxx (timer)$N"
					    "p20r02_xxxx (any)$N"
					    "p20r02.fault (dint)$N"
					    "p20r02.warning (dint)$N"
					    "";
					N: OTE(p20r02.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r02.comment.2);
					N: LEQ(p22_ao_selected_speed,0)MOV(p20_acc_fill_time_sec,p20_acc_fill_time_sec);
					N: GRT(p22_ao_selected_speed,0)CPT(p20_acc_fill_time_sec,p20_ai_acc_pstn/p01r12_selected_line_speed*60);
					N: XIO(p01r13_line_slow_ramp)XIO(p01r13_line_running)MOV(0,p20_acc_fill_time_sec);
					N: CPT(p20r02_letoff_dia_ft,p20r17_letoff_avg_diam_inch/12);
					RC: "Requests";
					N: OTE(p20r02.comment.3);
					N: NEQ(p20_dint_to_hmi[2],0)OTE(p20r02_fault_exists);
					N: NEQ(p20_dint_to_hmi[4],0)OTE(p20r02_warning_exists);
					N: [XIC(p20r02.unack_fault) ,XIC(p20r03.unack_fault) ,XIC(p20r04.unack_fault) ,XIC(p20r05.unack_fault) ,XIC(p20r06.unack_fault) ,XIC(p20r07.unack_fault) ,XIC(p20r08.unack_fault) ,XIC(p20r09.unack_fault) ,XIC(p20r10.unack_fault) ,XIC(p20r11.unack_fault) ,XIC(p20r13.unack_fault) ,XIC(p20r14.unack_fault) ,XIC(p20r15.unack_fault) ,XIC(p20r16.unack_fault) ,XIC(p20r17.unack_fault) ,XIC(p20r18.unack_fault) ]OTE(p20r02_unack_fault);
					N: [XIC(p20r02.unack_warning) ,XIC(p20r03.unack_warning) ,XIC(p20r04.unack_warning) ,XIC(p20r05.unack_warning) ,XIC(p20r06.unack_warning) ,XIC(p20r07.unack_warning) ,XIC(p20r08.unack_warning) ,XIC(p20r09.unack_warning) ,XIC(p20r10.unack_warning) ,XIC(p20r11.unack_warning) ,XIC(p20r13.unack_warning) ,XIC(p20r14.unack_warning) ,XIC(p20r15.unack_warning) ,XIC(p20r16.unack_warning) ,XIC(p20r17.unack_warning) ,XIC(p20r18.unack_warning) ]OTE(p20r02_unack_warning);
					RC: "Sequence";
					N: OTE(p20r02.comment.4);
					RC: "Output Control";
					N: OTE(p20r02.comment.5);
					N: [XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ]TOF(p20r02_letoff_selection_dwell,?,?);
					RC: "Faults";
					N: OTE(p20r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r02.fault,p20r02.fault_ack);
					N: XIC(FAULT)[TON(p20r02_timer_fault[0],?,?) ,XIC(p20r02_timer_fault[0].DN) OTL(p20r02.fault.0) ];
					N: XIC(p20r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r02.fault.0) ,OTU(p20r02.fault_ack.0) ];
					N: NEQ(p20r02.fault,p20r02.fault_ack)OTE(p20r02.unack_fault);
					RC: "Warnings";
					N: OTE(p20r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r02.warning,p20r02.warning_ack);
					N: XIC(FAULT)[TON(p20r02_timer_warning[0],?,?) ,XIC(p20r02_timer_warning[0].DN) OTL(p20r02.warning.0) ];
					N: XIO(FAULT)[OTU(p20r02.warning.0) ,OTU(p20r02.warning_ack.0) ];
					N: NEQ(p20r02.warning,p20r02.warning_ack)OTE(p20r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p20r03$N"
					    "This routine is called, continuously, from p20r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r03.comment (dint)$N"
					    "p20r03.oneshot (dint)$N"
					    "p20r03_timer_xxxx (timer)$N"
					    "p20r03_xxxx (any)$N"
					    "p20r03.fault (dint)$N"
					    "p20r03.warning (dint)$N"
					    "";
					N: OTE(p20r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r03.comment.2);
					RC: "Digital";
					N: OTE(p20r03.comment.3);
					N: [XIC(p00_io_letoff:4:I.0) OTE(p20_di_loa_active) ,XIC(p00_io_letoff:4:I.1) OTE(p20_di_loa_start) ,XIC(p00_io_letoff:4:I.2) OTE(p20_di_loa_stop) ,XIC(p00_io_letoff:4:I.3) OTE(p20_di_loa_fwd_dir) ,XIC(p00_io_letoff:4:I.4) OTE(p20_di_loa_jog) ];
					N: [XIC(p00_io_letoff:4:I.5) OTE(p20_di_lob_start) ,XIC(p00_io_letoff:4:I.6) OTE(p20_di_lob_stop) ,XIC(p00_io_letoff:4:I.7) OTE(p20_di_lob_fwd_dir) ,XIC(p00_io_letoff:4:I.8) OTE(p20_di_lob_jog) ];
					N: [XIC(p00_io_letoff:4:I.9) OTE(p20_di_turret_fwd) ,XIC(p00_io_letoff:4:I.10) OTE(p20_di_turret_rev) ,XIC(p00_io_letoff:4:I.13) OTE(p20_di_turret_pos) ,XIC(p00_io_letoff:4:I.15) OTE(p20_di_clutch_prs_ok) ];
					N: [XIC(p00_io_letoff:5:I.5) OTE(p20_di_lfr_jog_fwd) ,XIC(p00_io_letoff:5:I.6) OTE(p20_di_lfr_jog_rev) ,XIC(p00_io_letoff:5:I.7) OTE(p20_di_lfr_nip_close) ,XIC(p00_io_letoff:5:I.8) OTE(p20_di_lof_acc_fill) ];
					N: XIC(p00_io_letoff:5:I.11)OTE(p20_di_acc_door_open);
					N: [XIC(p00_io_letoff:6:I.0) OTE(p20_di_acc_full) ,XIC(p00_io_letoff:6:I.1) OTE(p20_di_acc_empty) ];
					RC: "Letoff A VFD";
					N: [XIC(p00_vfd_loa:I.Data[0].0) OTE(p20_vfd_di_loa.faulted) ,XIC(p00_vfd_loa:I.Data[0].1) OTE(p20_vfd_di_loa.warning) ,XIC(p00_vfd_loa:I.Data[0].2) OTE(p20_vfd_di_loa.running_fwd) ,XIC(p00_vfd_loa:I.Data[0].3) OTE(p20_vfd_di_loa.running_rev) ];
					N: [XIC(p00_vfd_loa:I.Data[0].4) OTE(p20_vfd_di_loa.ready) ,XIC(p00_vfd_loa:I.Data[0].5) OTE(p20_vfd_di_loa.ctrl_from_net) ,XIC(p00_vfd_loa:I.Data[0].6) OTE(p20_vfd_di_loa.ref_from_net) ,XIC(p00_vfd_loa:I.Data[0].7) OTE(p20_vfd_di_loa.at_reference) ];
					N: XIC(p01r02.fault.7)FLL(0,p00_vfd_loa:I.Data[0],4);
					N: [XIC(p00_io_line:2:I.0) OTE(p20_di_loa_temp) ,XIC(p00_io_line:2:I.1) OTE(p20_di_loa_brake) ];
					RC: "Letoff B VFD";
					N: [XIC(p00_vfd_lob:I.Data[0].0) OTE(p20_vfd_di_lob.faulted) ,XIC(p00_vfd_lob:I.Data[0].1) OTE(p20_vfd_di_lob.warning) ,XIC(p00_vfd_lob:I.Data[0].2) OTE(p20_vfd_di_lob.running_fwd) ,XIC(p00_vfd_lob:I.Data[0].3) OTE(p20_vfd_di_lob.running_rev) ];
					N: [XIC(p00_vfd_lob:I.Data[0].4) OTE(p20_vfd_di_lob.ready) ,XIC(p00_vfd_lob:I.Data[0].5) OTE(p20_vfd_di_lob.ctrl_from_net) ,XIC(p00_vfd_lob:I.Data[0].6) OTE(p20_vfd_di_lob.ref_from_net) ,XIC(p00_vfd_lob:I.Data[0].7) OTE(p20_vfd_di_lob.at_reference) ];
					N: XIC(p01r02.fault.8)FLL(0,p00_vfd_lob:I.Data[0],4);
					N: [XIC(p00_io_line:2:I.2) OTE(p20_di_lob_motor_thermostat) ,XIC(p00_io_line:2:I.1) OTE(p20_di_lob_brake_thermostat) ];
					RC: "Letoff Turret VFD";
					N: [XIC(p00_vfd_lo_turret:I.Data[0].0) OTE(p20_di_lo_turret.faulted) ,XIC(p00_vfd_lo_turret:I.Data[0].1) OTE(p20_di_lo_turret.warning) ,XIC(p00_vfd_lo_turret:I.Data[0].2) OTE(p20_di_lo_turret.running_fwd) ,XIC(p00_vfd_lo_turret:I.Data[0].3) OTE(p20_di_lo_turret.running_rev) ];
					N: [XIC(p00_vfd_lo_turret:I.Data[0].4) OTE(p20_di_lo_turret.ready) ,XIC(p00_vfd_lo_turret:I.Data[0].5) OTE(p20_di_lo_turret.ctrl_from_net) ,XIC(p00_vfd_lo_turret:I.Data[0].6) OTE(p20_di_lo_turret.ref_from_net) ,XIC(p00_vfd_lo_turret:I.Data[0].7) OTE(p20_di_lo_turret.at_reference) ];
					N: XIC(p01r02.fault.9)FLL(0,p00_vfd_lo_turret:I.Data[0],4);
					N: XIC(p00_io_line:2:I.4)OTE(p20_di_lo_turret_therm);
					RC: "Analog";
					N: OTE(p20r03.comment.4);
					N: SYS_SCP(p20r03_sensor_scp,p00_io_letoff:1:I.Ch0Data,p20_dia_input_min,p20_dia_input_max,p20_dia_output_min,p20_dia_output_max,p20r03_sensor_input);
					N: [XIC(p20r15_loa_on) MOV(p20r03_loa_distance_to_core,p20r03_distance_to_core) ,XIC(p20r16_lob_on) MOV(p20r03_lob_distance_to_core,p20r03_distance_to_core) ];
					N: SUB(p20r03_distance_to_core,p20r03_sensor_input,p20r03_lo_radius)CPT(p20_ai_letoff_dia,p20r03_lo_radius*2);
					N: SYS_SCP(p20r03_accumulator_scp,p00_io_letoff:1:I.Ch1Data,p20_acc_input_min,p20_acc_input_max,p20_acc_output_min,p20_acc_output_max,p20_ai_acc_pstn);
					N: SYS_SCP(p20r03_load_cell,Local:3:I.Ch1Data,p20_lc_input_min,p20_lc_input_max,p20_lc_output_min,p20_lc_output_max,p20_ai_lc01);
					N: SYS_SCP(p20r03_accumulator_pct_scp,p00_io_letoff:1:I.Ch1Data,p20_acc_input_min,p20_acc_input_max,0,100,p20r13_ai_acc_pct);
					N: SYS_SCP(p20r03_Loa_footage_scp,Local:3:I.Ch4Data,p20_loa_footage_input_min,p20_loa_footage_input_max,p20_loa_footage_output_min,p20_loa_footage_output_max,p20r13_ai_loa_footage_ft);
					N: SYS_SCP(p20r03_Lob_footage_scp,Local:3:I.Ch5Data,p20_lob_footage_input_min,p20_lob_footage_input_max,p20_lob_footage_output_min,p20_lob_footage_output_max,p20r13_ai_lob_footage_ft);
					RC: "VFD";
					N: OTE(p20r03.comment.5);
					N: SYS_RPM_TO_SPEED(p20r03_loa_speed_fb,p20_param_loa_gear_ratio,p20r02_letoff_dia_ft,p00_vfd_loa:I.Data[1],p20_ai_loa_speed);
					N: CPT(p20_ai_loa_speed,ABS(p20_ai_loa_speed));
					N: CPT(p20_loa_ai_amps,p00_vfd_loa:I.Data[2]*0.1);
					N: CPT(p20_loa_ai_torque,p00_vfd_loa:I.Data[5]*0.01);
					N: CPT(p20_loa_ai_rpm,p00_vfd_loa:I.Data[1]*0.1);
					N: SYS_SCP(p13r03_hz,p00_vfd_loa:I.Data[1],0,3500,0,60,p20_loa_ai_hz);
					N: SYS_RPM_TO_SPEED(p20r03_lob_speed_fb,p20_param_lob_gear_ratio,p20r02_letoff_dia_ft,p00_vfd_lob:I.Data[1],p20_ai_lob_speed);
					N: CPT(p20_ai_lob_speed,ABS(p20_ai_lob_speed));
					N: CPT(p20_lob_ai_amps,p00_vfd_lob:I.Data[2]*0.1);
					N: CPT(p20_lob_ai_torque,p00_vfd_lob:I.Data[5]*0.01);
					N: CPT(p20_lob_ai_rpm,p00_vfd_lob:I.Data[1]*0.1);
					N: SYS_SCP(p13r03_hz,p00_vfd_lob:I.Data[1],0,1800,0,60,p20_lob_ai_hz);
					N: SYS_RPM_TO_SPEED(p20r03_lo_turret_speed_fb,p20_param_lo_turret_gear_ratio,p01_param_turret_dia_ft,p00_vfd_lo_turret:I.Data[1],p20_ai_lo_turret_speed);
					N: CPT(p20_ai_lo_turret_amps,p00_vfd_lo_turret:I.Data[2]*0.1);
					N: SYS_SCP(p13r03_hz,p00_vfd_lo_turret:I.Data[1],0,1800,0,60,p20_ai_lo_turret_hz);
					RC: "Faults";
					N: OTE(p20r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r03.fault,p20r03.fault_ack);
					N: XIC(FAULT)[TON(p20r03_timer_fault[0],?,?) ,XIC(p20r03_timer_fault[0].DN) OTL(p20r03.fault.0) ];
					N: XIC(p20r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r03.fault.0) ,OTU(p20r03.fault_ack.0) ];
					N: NEQ(p20r03.fault,p20r03.fault_ack)OTE(p20r03.unack_fault);
					RC: "Warnings";
					N: OTE(p20r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r03.warning,p20r03.warning_ack);
					N: XIC(FAULT)[TON(p20r03_timer_warning[0],?,?) ,XIC(p20r03_timer_warning[0].DN) OTL(p20r03.warning.0) ];
					N: XIO(FAULT)[OTU(p20r03.warning.0) ,OTU(p20r03.warning_ack.0) ];
					N: NEQ(p20r03.warning,p20r03.warning_ack)OTE(p20r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p20r04$N"
					    "This routine is called, continuously, from p20r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r04.comment (dint)$N"
					    "p20r04.oneshot (dint)$N"
					    "p20r04_timer_xxxx (timer)$N"
					    "p20r04_xxxx (any)$N"
					    "p20r04.fault (dint)$N"
					    "p20r04.warning (dint)$N"
					    "";
					N: OTE(p20r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r04.comment.2);
					RC: "Digital";
					N: OTE(p20r04.comment.3);
					N: [XIC(p20r16_lob_on) OTE(p00_io_letoff:3:O.0) ,XIC(p20r15_loa_on) OTE(p00_io_letoff:3:O.1) ,XIC(p20r18_index_complete) OTE(p00_io_letoff:3:O.2) ,XIC(p01r02_do_green_stack_light_lel) OTE(p00_io_letoff:3:O.3) ,XIC(p01r02_do_red_stack_light_LINE) OTE(p00_io_letoff:3:O.6) ,[XIC(p01r02_do_yellow_stack_light) OTE(p00_io_letoff:3:O.13) ,[[XIC(metering_roll_close.TT) ,[XIC(p00_io_letoff:7:I.4) ,XIC(p00_io_letoff:7:I.3) ] XIC(p01r02_timer_half_second_off.TT) XIO(metering_roll_alarm.DN) ] OTE(p00_io_letoff:3:O.15) ,[XIC(p01r13_timer_line_start_warning_dwell.TT) ,XIC(p01r02_timer_half_second_on.DN) XIC(p00_io_oven:4:I.4) XIO(retraction_delay_timer.DN) ,XIC(p11r30.fault.5) ,XIC(p11r30.warning.0) ,XIC(p12r30.fault.5) ,XIC(p12r30.warning.0) ] OTE(p00_io_winder:4:O.1) ] ] ];
					RC: "Temp moved$N"
					    "do acc high pressure and do acc enable tension";
					N: [XIC(p20_do_engage_lfr_clutch) OTE(p00_io_letoff:3:O.8) ,XIC(p20_do_close_nip) OTE(p00_io_letoff:3:O.9) ,XIC(p20_do_acc_enable_tension) OTE(p00_io_letoff:3:O.10) ,XIC(AFI) XIC(p20_do_acc_high_prs) OTE(p00_io_letoff:3:O.11) ];
					N: [XIC(p20_do_enable_lfr_rev) OTE(p00_io_line:1:O.1) ,XIC(p20_do_enable_lfr_fwd) OTE(p00_io_line:1:O.2) ];
					RC: "VFD Outputs";
					N: [XIC(p20_vfd_do_loa.forward) OTE(p00_vfd_loa:O.Data[0].0) ,XIC(p20_vfd_do_loa.reverse) OTE(p00_vfd_loa:O.Data[0].1) ,XIC(p20_vfd_do_loa.fault_reset) OTE(p00_vfd_loa:O.Data[0].2) ,OTE(p00_vfd_loa:O.Data[0].5) ,OTE(p00_vfd_loa:O.Data[0].6) ];
					N: [XIC(p20_vfd_do_lob.forward) OTE(p00_vfd_lob:O.Data[0].0) ,XIC(p20_vfd_do_lob.reverse) OTE(p00_vfd_lob:O.Data[0].1) ,XIC(p20_vfd_do_lob.fault_reset) OTE(p00_vfd_lob:O.Data[0].2) ,OTE(p00_vfd_lob:O.Data[0].5) ,OTE(p00_vfd_lob:O.Data[0].6) ];
					N: [XIC(p20_do_wdr_turret.forward) OTE(p00_vfd_lo_turret:O.Data[0].0) ,XIC(p20_do_wdr_turret.reverse) OTE(p00_vfd_lo_turret:O.Data[0].1) ,XIC(p20_do_wdr_turret.fault_reset) OTE(p00_vfd_lo_turret:O.Data[0].2) ,OTE(p00_vfd_lo_turret:O.Data[0].5) ,OTE(p00_vfd_lo_turret:O.Data[0].6) ];
					RC: "Analog";
					N: OTE(p20r04.comment.4);
					N: SYS_SCP(p20r04_acc_ctr_prs,p20_ao_acc_ctr_prs,p20_acc_ctr_prs_input_min,p20_acc_ctr_prs_input_max,p20_acc_ctr_prs_output_min,p20_acc_ctr_prs_output_max,p00_io_letoff:0:O.Ch0Data);
					N: SYS_SCP(p20r04_acc_ten_prs,p20_ao_acc_ten_prs,p20_acc_ten_prs_input_min,p20_acc_ten_prs_input_max,p20_acc_ten_prs_output_min,p20_acc_ten_prs_output_max,p00_io_letoff:0:O.Ch1Data);
					N: XIC(AFI)SYS_SCP(p20r04_acc_fill_prs,p20_ao_acc_fill_prs,p20_acc_fill_prs_input_min,p20_acc_fill_prs_input_max,p20_acc_fill_prs_output_min,p20_acc_fill_prs_output_max,p00_io_letoff:0:O.Ch2Data);
					RC: "VFD";
					N: OTE(p20r04.comment.5);
					N: SYS_SPEED_TO_VFD(p20r04_loa_speed_to_vfd,p20_param_loa_gear_ratio,p20r02_letoff_dia_ft,p20_ao_loa_selected_speed,p00_vfd_loa:O.Data[1]);
					N: CPT(p00_vfd_loa:O.Data[2],p20_ao_loa_torque*100);
					N: SYS_SPEED_TO_VFD(p20r04_lob_speed_to_vfd,p20_param_lob_gear_ratio,p20r02_letoff_dia_ft,p20_ao_lob_selected_speed,p00_vfd_lob:O.Data[1]);
					N: CPT(p00_vfd_lob:O.Data[2],p20_ao_lob_torque*100);
					N: SYS_SPEED_TO_VFD(p20r04_lo_turret_speed_to_vfd,p20_param_lo_turret_gear_ratio,p01_param_turret_dia_ft,p20_ao_lo_turret_selected_speed,p00_vfd_lo_turret:O.Data[1]);
					RC: "Faults";
					N: OTE(p20r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p20r04.fault,p20r04.fault_ack);
					N: XIC(FAULT)[TON(p20r04_timer_fault[0],?,?) ,XIC(p20r04_timer_fault[0].DN) OTL(p20r04.fault.0) ];
					N: XIC(p20r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p20r04.fault.0) ,OTU(p20r04.fault_ack.0) ];
					N: NEQ(p20r04.fault,p20r04.fault_ack)OTE(p20r04.unack_fault);
					RC: "Warnings";
					N: OTE(p20r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p20r04.warning,p20r04.warning_ack);
					N: XIC(FAULT)[TON(p20r04_timer_warning[0],?,?) ,XIC(p20r04_timer_warning[0].DN) OTL(p20r04.warning.0) ];
					N: XIO(FAULT)[OTU(p20r04.warning.0) ,OTU(p20r04.warning_ack.0) ];
					N: NEQ(p20r04.warning,p20r04.warning_ack)OTE(p20r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p20r05$N"
					    "This routine is called, continuously, from p20r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p20r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p20r05.comment (dint)$N"
					    "p20r05.oneshot (dint)$N"
					    "p20r05_timer_xxxx (timer)$N"
					    "p20r05_xxxx (any)$N"
					    "p20r05.fault (dint)$N"
					    "p20r05.warning (dint)$N"
					    "";
					N: OTE(p20r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p20r05.comment.2);
					RC: "Digital IO";
					N: OTE(p20r05.comment.3);
					N: [XIC(p20_di_loa_active) OTE(p20_dint_to_hmi[0].0) ,XIO(p20_di_loa_active) OTE(p20_dint_to_hmi[0].1) ,XIC(p20r18_index_complete) OTE(p20_dint_to_hmi[0].2) ,XIC(p20_di_clutch_prs_ok) OTE(p20_dint_to_hmi[0].3) ];
					N: [XIC(p20_di_acc_full) OTE(p20_dint_to_hmi[0].4) ,XIC(p20_di_acc_empty) OTE(p20_dint_to_hmi[0].5) ,XIC(p20_do_close_nip) OTE(p20_dint_to_hmi[0].6) ,XIC(HMI) OTE(p20_dint_to_hmi[0].7) ];
					N: [XIC(p20r09_accumulator_auto) OTE(p20_dint_to_hmi[0].8) ,XIC(HMI) OTE(p20_dint_to_hmi[0].9) ,XIC(HMI) OTE(p20_dint_to_hmi[0].10) ,XIC(HMI) OTE(p20_dint_to_hmi[0].11) ];
					N: [XIC(HMI) OTE(p20_dint_to_hmi[0].12) ,XIC(HMI) OTE(p20_dint_to_hmi[0].13) ,XIC(HMI) OTE(p20_dint_to_hmi[0].14) ,XIC(HMI) OTE(p20_dint_to_hmi[0].15) ];
					N: [XIC(p20_vfd_di_loa.faulted) OTE(p20_dint_to_hmi[1].0) ,XIC(p20_vfd_di_loa.warning) OTE(p20_dint_to_hmi[1].1) ,XIC(p20_vfd_di_loa.running_fwd) OTE(p20_dint_to_hmi[1].2) ,XIC(p20_vfd_di_loa.running_rev) OTE(p20_dint_to_hmi[1].3) ];
					N: [XIC(p20_vfd_di_loa.ready) OTE(p20_dint_to_hmi[1].4) ,XIC(p20_vfd_di_loa.ctrl_from_net) OTE(p20_dint_to_hmi[1].5) ,XIC(p20_vfd_di_loa.ref_from_net) OTE(p20_dint_to_hmi[1].6) ,XIC(p20_vfd_di_loa.at_reference) OTE(p20_dint_to_hmi[1].7) ];
					N: [XIC(p20_vfd_di_lob.faulted) OTE(p20_dint_to_hmi[1].8) ,XIC(p20_vfd_di_lob.warning) OTE(p20_dint_to_hmi[1].9) ,XIC(p20_vfd_di_lob.running_fwd) OTE(p20_dint_to_hmi[1].10) ,XIC(p20_vfd_di_lob.running_rev) OTE(p20_dint_to_hmi[1].11) ];
					N: [XIC(p20_vfd_di_lob.ready) OTE(p20_dint_to_hmi[1].12) ,XIC(p20_vfd_di_lob.ctrl_from_net) OTE(p20_dint_to_hmi[1].13) ,XIC(p20_vfd_di_lob.ref_from_net) OTE(p20_dint_to_hmi[1].14) ,XIC(p20_vfd_di_lob.at_reference) OTE(p20_dint_to_hmi[1].15) ];
					N: [XIC(p20_di_lo_turret.faulted) OTE(p20_dint_to_hmi[1].16) ,XIC(p20_di_lo_turret.warning) OTE(p20_dint_to_hmi[1].17) ,XIC(p20_di_lo_turret.running_fwd) OTE(p20_dint_to_hmi[1].18) ,XIC(p20_di_lo_turret.running_rev) OTE(p20_dint_to_hmi[1].19) ];
					N: [XIC(p20_di_lo_turret.ready) OTE(p20_dint_to_hmi[1].20) ,XIC(p20_di_lo_turret.ctrl_from_net) OTE(p20_dint_to_hmi[1].21) ,XIC(p20_di_lo_turret.ref_from_net) OTE(p20_dint_to_hmi[1].22) ,XIC(p20_di_lo_turret.at_reference) OTE(p20_dint_to_hmi[1].23) ];
					N: [XIC(HMI) OTE(p20_dint_to_hmi[6].0) ,XIC(HMI) OTE(p20_dint_to_hmi[6].1) ,XIC(HMI) OTE(p20_dint_to_hmi[6].2) ,XIC(HMI) OTE(p20_dint_to_hmi[6].3) ];
					N: [XIC(HMI) OTE(p20_dint_to_hmi[6].4) ,XIC(HMI) OTE(p20_dint_to_hmi[6].5) ,XIC(HMI) OTE(p20_dint_to_hmi[6].6) ,XIC(HMI) OTE(p20_dint_to_hmi[6].7) ];
					N: [XIC(HMI) OTE(p20_dint_to_hmi[6].8) ,XIC(HMI) OTE(p20_dint_to_hmi[6].9) ,XIC(HMI) OTE(p20_dint_to_hmi[6].10) ,XIC(HMI) OTE(p20_dint_to_hmi[6].11) ];
					N: [XIC(HMI) OTE(p20_dint_to_hmi[6].16) ,XIO(HMI) OTE(p20_dint_to_hmi[6].17) ,XIC(HMI) OTE(p20_dint_to_hmi[6].18) ,XIC(HMI) OTE(p20_dint_to_hmi[6].19) ];
					N: MOV(p20r13_status,p20_dint_to_hmi[7]);
					RC: "Sequence";
					N: OTE(p20r05.comment.4);
					RC: "Output Control";
