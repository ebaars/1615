					N: XIC(p12r30.warning_ack.0)[CMP(p12r30_pid_temp_sp_error+2<p12_param_tc01_dev) ,XIO(p12r30_request_deviation_warning) ][OTU(p12r30.warning.0) ,OTU(p12r30.warning_ack.0) ];
					N: XIC(p12_di_tc01_bo)[TON(p12r30_timer_warning[1],?,?) ,XIC(p12r30_timer_warning[1].DN) OTL(p12r30.warning.1) ];
