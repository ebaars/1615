					N: XIC(p12r30.warning_ack.5)XIC(p12_di_burner_auto)[OTU(p12r30.warning.5) ,OTU(p12r30.warning_ack.5) ];
					N: XIO(p12_di_fresh_air_clean)[TON(p12r30_timer_warning[6],?,?) ,XIC(p12r30_timer_warning[6].DN) OTL(p12r30.warning.6) ];
					N: XIC(p12r30.warning_ack.6)XIC(p12_di_fresh_air_clean)[OTU(p12r30.warning.6) ,OTU(p12r30.warning_ack.6) ];
					N: XIO(p12_di_zone_air_clean)[TON(p12r30_timer_warning[7],?,?) ,XIC(p12r30_timer_warning[7].DN) OTL(p12r30.warning.7) ];
					N: XIC(p12r30.warning_ack.7)XIC(p12_di_zone_air_clean)[OTU(p12r30.warning.7) ,OTU(p12r30.warning_ack.7) ];
