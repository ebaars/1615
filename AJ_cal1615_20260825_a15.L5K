					N: [XIC(p19r30_request_cool) OTE(p19_dint_to_hmi[0].16) ,XIO(p19r30_request_cool) OTE(p19_dint_to_hmi[0].17) ,XIC(p19r30_request_manual) OTE(p19_dint_to_hmi[0].18) ,XIO(p19r30_request_manual) OTE(p19_dint_to_hmi[0].19) ];
					N: [XIC(HMI) OTE(p19_dint_to_hmi[0].20) ,XIC(HMI) OTE(p19_dint_to_hmi[0].21) ,XIC(HMI) OTE(p19_dint_to_hmi[0].22) ,XIC(HMI) OTE(p19_dint_to_hmi[0].23) ];
					N: [XIC(HMI) OTE(p19_dint_to_hmi[0].24) ,XIC(HMI) OTE(p19_dint_to_hmi[0].25) ,XIC(HMI) OTE(p19_dint_to_hmi[0].26) ,XIC(HMI) OTE(p19_dint_to_hmi[0].27) ];
					N: [XIC(HMI) OTE(p19_dint_to_hmi[0].28) ,XIC(HMI) OTE(p19_dint_to_hmi[0].29) ,XIC(HMI) OTE(p19_dint_to_hmi[0].30) ,XIC(HMI) OTE(p19_dint_to_hmi[0].31) ];
					N: [XIC(p19_do_pump) OTE(p19_dint_to_hmi[1].0) ,XIC(HMI) OTE(p19_dint_to_hmi[1].1) ,XIC(HMI) OTE(p19_dint_to_hmi[1].2) ,XIC(HMI) OTE(p19_dint_to_hmi[1].3) ];
					N: [XIC(HMI) OTE(p19_dint_to_hmi[1].4) ,XIC(HMI) OTE(p19_dint_to_hmi[1].5) ,XIC(HMI) OTE(p19_dint_to_hmi[1].6) ,XIC(HMI) OTE(p19_dint_to_hmi[1].7) ];
					N: [XIC(HMI) OTE(p19_dint_to_hmi[1].8) ,XIC(HMI) OTE(p19_dint_to_hmi[1].9) ,XIC(HMI) OTE(p19_dint_to_hmi[1].10) ,XIC(HMI) OTE(p19_dint_to_hmi[1].11) ];
					N: [XIC(HMI) OTE(p19_dint_to_hmi[1].12) ,XIC(HMI) OTE(p19_dint_to_hmi[1].13) ,XIC(p19_di_tc01_bo) OTE(p19_dint_to_hmi[1].14) ,XIC(p19_di_tc02_bo) OTE(p19_dint_to_hmi[1].15) ];
					RC: "Sequence";
