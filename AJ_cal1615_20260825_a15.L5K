					N: XIC(p23r12_request_zero)OTE(p23_do_servo_ds.ready_for_operation_bit_17);
					N: [XIO(p23r12_gap_sequence_enabled) XIC(p23r12_request_position) ,XIC(p23r12_gap_sequence_enabled) [XIC(p23r12.state.2) ,XIC(p23r12.state.5) ] ]OTE(p23_do_servo_ds.command_value_accept);
					N: OTE(p23r12.comment.7);
					N: [XIC(p23r12.state.8) XIC(p23r12.state.0) ,XIO(p23r12_servo_status_af) ,XIC(S:FS) ][MOV(0,p23r12.state) ,OTL(p23r12.state.1) ];
					N: XIC(p23r12.state.1)XIC(p23r12.state.0)XIC(p23r12_request_position)[MOV(0,p23r12.state) ,OTL(p23r12.state.2) ];
					N: XIC(p23r12.state.2)XIC(p23r12.state.0)XIO(p23_di_servo_ds.stand_still)[MOV(0,p23r12.state) ,OTL(p23r12.state.3) ];
					N: XIC(p23r12.state.3)XIC(p23r12.state.0)XIC(p23_di_servo_ds.at_target_pos)[MOV(0,p23r12.state) ,OTL(p23r12.state.4) ];
					N: XIC(p23r12.state.4)XIC(p23r12.state.0)XIC(p23r12_step_4_dwell.DN)[MOV(0,p23r12.state) ,OTL(p23r12.state.5) ];
					N: XIC(p23r12.state.5)XIC(p23r12.state.0)XIO(p23_di_servo_ds.stand_still)[MOV(0,p23r12.state) ,OTL(p23r12.state.6) ];
					N: XIC(p23r12.state.6)XIC(p23r12.state.0)XIC(p23_di_servo_ds.at_target_pos)[MOV(0,p23r12.state) ,OTL(p23r12.state.7) ];
					N: XIC(p23r12.state.7)XIC(p23r12.state.0)[MOV(0,p23r12.state) ,OTL(p23r12.state.8) ];
					N: OTE(p23r12.state.0);
