					N: [XIC(HMI) OTE(p22_dint_to_hmi[4].20) ,XIC(HMI) OTE(p22_dint_to_hmi[4].21) ,XIC(HMI) OTE(p22_dint_to_hmi[4].22) ,XIC(HMI) OTE(p22_dint_to_hmi[4].23) ];
					N: [XIC(HMI) OTE(p22_dint_to_hmi[4].24) ,XIC(HMI) OTE(p22_dint_to_hmi[4].25) ,XIC(HMI) OTE(p22_dint_to_hmi[4].26) ,XIC(HMI) OTE(p22_dint_to_hmi[4].27) ];
					N: [XIC(HMI) OTE(p22_dint_to_hmi[4].28) ,XIC(HMI) OTE(p22_dint_to_hmi[4].29) ,XIC(HMI) OTE(p22_dint_to_hmi[4].30) ,XIC(HMI) OTE(p22_dint_to_hmi[4].31) ];
					RC: "Output Control";
					N: OTE(p22r08.comment.5);
					RC: "Faults";
					N: OTE(p22r08.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p22r08.fault,p22r08.fault_ack);
					N: XIC(FAULT)[TON(p22r08_timer_fault[0],?,?) ,XIC(p22r08_timer_fault[0].DN) OTL(p22r08.fault.0) ];
					N: XIC(p22r08.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p22r08.fault.0) ,OTU(p22r08.fault_ack.0) ];
					N: NEQ(p22r08.fault,p22r08.fault_ack)OTE(p22r08.unack_fault);
					RC: "Warnings";
					N: OTE(p22r08.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p22r08.warning,p22r08.warning_ack);
					N: XIC(FAULT)[TON(p22r08_timer_warning[0],?,?) ,XIC(p22r08_timer_warning[0].DN) OTL(p22r08.warning.0) ];
					N: XIO(FAULT)[OTU(p22r08.warning_ack.0) ,OTU(p22r08.warning.0) ];
					N: NEQ(p22r08.warning,p22r08.warning_ack)OTE(p22r08.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R09_Modes 
					RC: "p22r09$N"
					    "This routine is called, continuously, from p22r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p22r09.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p22r09.comment (dint)$N"
					    "p22r09.oneshot (dint)$N"
					    "p22r09_timer_xxxx (timer)$N"
					    "p22r09_xxxx (any)$N"
					    "p22r09.fault (dint)$N"
					    "p22r09.warning (dint)$N"
					    "";
					N: OTE(p22r09.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p22r09.comment.2);
					N: XIC(p22_di_jog_fwd)XIO(p22_di_jog_rev)OTE(p22r09_pb_jog_fwd);
					N: XIC(p22_di_jog_rev)XIO(p22_di_jog_fwd)OTE(p22r09_pb_jog_rev);
					RC: "Requests";
					N: OTE(p22r09.comment.3);
					N: XIC(p22_di_jog)OTE(p22r09_mode_jog);
					N: XIC(p22_di_run)OTE(p22r09_mode_run);
					N: [XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ]XIO(p22_di_jog)XIO(p22_di_run)OTE(p22r09_mode_thread);
					RC: "Sequence";
					N: OTE(p22r09.comment.4);
					RC: "Output Control";
					N: OTE(p22r09.comment.5);
					RC: "Faults";
					N: OTE(p22r09.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p22r09.fault,p22r09.fault_ack);
					N: XIC(FAULT)[TON(p22r09_timer_fault[0],?,?) ,XIC(p22r09_timer_fault[0].DN) OTL(p22r09.fault.0) ];
					N: XIC(p22r09.fault_ack.0)XIC(FAULT)XIC(p01r09_pb_global_reset)[OTU(p22r09.fault.0) ,OTU(p22r09.fault_ack.0) ];
					N: NEQ(p22r09.fault,p22r09.fault_ack)OTE(p22r09.unack_fault);
					RC: "Warnings";
					N: OTE(p22r09.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p22r09.warning,p22r09.warning_ack);
					N: XIO(p22r09_mode_run)[TON(p22r09_timer_warning[0],?,?) ,XIC(p22r09_timer_warning[0].DN) OTL(p22r09.warning.0) ];
					N: XIC(p22r09.warning_ack.0)XIC(p22r09_mode_run)[OTU(p22r09.warning.0) ,OTU(p22r09.warning_ack.0) ];
					N: XIC(p22r09_mode_thread)[TON(p22r09_timer_warning[1],?,?) ,XIC(p22r09_timer_warning[1].DN) OTL(p22r09.warning.1) ];
					N: XIC(p22r09.warning_ack.1)XIO(p22r09_mode_thread)[OTU(p22r09.warning.1) ,OTU(p22r09.warning_ack.1) ];
					N: NEQ(p22r09.warning,p22r09.warning_ack)OTE(p22r09.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R10_Speed_Control 
					RC: "p22r10$N"
					    "This routine is called, continuously, from p22R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p22r10.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p22r10.comment (dint)$N"
					    "p22r10.oneshot (dint)$N"
					    "p22r10_timer_xxxx (timer)$N"
					    "p22r10_xxxx (any)$N"
					    "p22r10.fault (dint)$N"
					    "p22r10a_warnings (dint)$N"
					    "";
					N: OTE(p22r10.comment.1);
					RC: "Notes";
					N: OTE(p22r10.comment.2);
					RC: "Requests";
					N: OTE(p22r10.comment.3);
					N: [XIC(p01r13_line_slow_ramp) ,XIC(p01r13_line_running) ]XIC(p23r15_pid_tension_control)OTE(p22r11_request_tension);
					N: CPT(p22r10_calc_speed_offset,p22_ai_speed-p22_ao_selected_speed);
					N: CPT(p22r10_pid_out,p22r10_calc_speed_offset*p22r10_speed_offset+50);
					RC: "Configure PID$N"
					    "The tension loadcell feedback is compared to its setpoint in a PID control.$N"
					    "With the PID output at 50%, error is made to be 0$N"
					    "Error is added or subtracted to the speed of the previous drive to calculate the required speed of the drive.$N"
					    "A gain factor is used to dampen the error effect on the drive speed.";
					N: OTE(p22r10.comment.4);
					N: MOV(p22_ai_ts1_lc,p22r10_pid_psn_pv);
					N: MOV(p01_recipe_active.ts1_tension_sp,p22r10_pid_psn.SP);
					N: MOV(p22r10_param_psn_gain,p22r10_param_psn_gain);
					N: XIO(p22r11_request_tension)MOV(50,p22r10_pid_psn.SO);
					N: XIO(p22r11_request_tension)OTE(p22r10_pid_psn.SWM);
					N: OTE(p22r10_pid_psn.NOBC);
					N: MOV(p02_real_from_hmi.ts1[40],p22r10_pid_psn.KP)MOV(p02_real_from_hmi.ts1[41],p22r10_pid_psn.KI)MOV(p02_real_from_hmi.ts1[42],p22r10_pid_psn.KD);
					N: MOV(p22r10_pid_psn.BIAS,p22r10_pid_psn.BIAS)PID(p22r10_pid_psn,p22r10_pid_psn_pv,0,p22r10_pid_psn_cv,0,0,0);
					RC: "Output Control";
					N: OTE(p22r10.comment.5);
					N: CPT(p22r10_speed_offset,(p22r10_pid_psn_cv-50)/p22r10_param_psn_gain*-1);
					RC: "Faults";
					N: OTE(p22r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p22r10.fault,p22r10.fault_ack);
					N: XIC(FAULT)[TON(p22r10_timer_fault[0],?,?) ,XIC(p22r10_timer_fault[0].DN) OTL(p22r10.fault.0) ];
					N: XIC(p22r10.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p22r10.fault.0) ,OTU(p22r10.fault_ack.0) ];
					N: NEQ(p22r10.fault,p22r10.fault_ack)OTE(p22r10.unack_fault);
					RC: "Warnings";
					N: OTE(p22r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p22r10.warning,p22r10.warning_ack);
					N: XIC(FAULT)[TON(p22r10_timer_warning[0],?,?) ,XIC(p22r10_timer_warning[0].DN) OTL(p22r10.warning.0) ];
					N: XIO(FAULT)[OTU(p22r10.warning.0) ,OTU(p22r10.warning_ack.0) ];
					N: NEQ(p22r10.warning,p22r10.warning_ack)OTE(p22r10.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R11_VFD 
					RC: "p22r11$N"
					    "This routine is called, continuously, from p22R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p22r11.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p22r11.comment (dint)$N"
					    "p22r11.oneshot (dint)$N"
					    "p22r11_timer_xxxx (timer)$N"
					    "p22r11_xxxx (any)$N"
					    "p22r11.fault (dint)$N"
					    "p22r11a_warnings (dint)$N"
					    "";
					N: OTE(p22r11.comment.1);
					RC: "Notes$N"
					    "";
					N: OTE(p22r11.comment.2);
					N: XIC(p01r13_permissive_drives)XIC(p01r13_state.1)OTE(p22r11_permissive_jog);
					RC: "Requests";
					N: OTE(p22r11.comment.3);
					N: XIC(p01r13_permissive_drives)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) [GRT(p22_ai_ts1_lc,p01_param_min_start_tension) ,XIC(p22r11_request_line_run) ] ]OTE(p22r11_request_line_run);
					N: XIC(p01r09_request_line_jog)OTE(p22r11_request_line_jog);
					N: EQU(p22_ao_selected_speed,0)OTE(p22r11_zero_speed);
					N: XIC(p22r11_permissive_jog)[XIC(p22r09_mode_thread) [XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ] [XIC(p22r09_pb_jog_fwd) XIC(p22r11_zero_speed) ,XIC(p22r11_request_thread_fwd) XIO(p22r11_zero_speed) ] ,XIC(p22r09_mode_thread) XIC(p25r09_mode_thread) [XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ] [XIC(p25r09_pb_jog_fwd) XIC(p22r11_zero_speed) ,XIC(p22r11_request_thread_fwd) XIO(p22r11_zero_speed) ] ]OTE(p22r11_request_thread_fwd);
					N: XIC(p22r11_permissive_jog)[XIC(p22r09_mode_thread) [XIC(p22r09_pb_jog_rev) XIC(p22r11_zero_speed) ,XIC(p22r11_request_thread_rev) XIO(p22r11_zero_speed) ] ,XIC(p22r09_mode_thread) XIC(p25r09_mode_thread) [XIC(p25r09_pb_jog_rev) XIC(p22r11_zero_speed) ,XIC(p22r11_request_thread_rev) XIO(p22r11_zero_speed) ] ]OTE(p22r11_request_thread_rev);
					N: XIC(p22r11_permissive_jog)XIC(p22r09_mode_jog)[XIC(p22r09_pb_jog_fwd) XIC(p22r11_zero_speed) ,XIC(p22r11_request_jog_fwd) XIO(p22r11_zero_speed) ]OTE(p22r11_request_jog_fwd);
					N: XIC(p22r11_permissive_jog)XIC(p22r09_mode_jog)[XIC(p22r09_pb_jog_rev) XIC(p22r11_zero_speed) ,XIC(p22r11_request_jog_rev) XIO(p22r11_zero_speed) ]OTE(p22r11_request_jog_rev);
					RC: "VFD Control";
					N: ABB_PROTOCOL_VFD(p22_ts1_vfd,p22_status_word,p22_control_word,p22r11_request_start,p01r09_pb_global_reset,p01r13_permissive_drives);
					RC: "Outputs";
					N: OTE(p22r11.comment.5);
					N: [XIC(p22r11_request_line_run) ,XIC(p22r11_request_line_jog) ,XIC(p22r11_request_jog_fwd) ,XIC(p22r11_request_thread_fwd) ,XIC(p22r11_request_jog_rev) ,XIC(p22r11_request_thread_rev) ]OTE(p22r11_request_start);
					RC: "Speed Control";
					N: OTE(p22r11.comment.6);
					N: [XIC(p22r11_request_line_run) ,XIC(p22r11_request_thread_fwd) ,XIC(p01r09_request_line_jog) ]MOV(p01r12_master_ramped_speed,p22_ao_selected_speed);
					N: XIC(p22r11_request_thread_rev)CPT(p22_ao_selected_speed,p01r12_master_ramped_speed*-1);
					N: XIC(p22r11_request_jog_fwd)XIC(p22r09_pb_jog_fwd)CPT(p22r11_selected_speed,p22_param_ts1_jog_speed*1);
					N: XIC(p22r11_request_jog_rev)XIC(p22r09_pb_jog_rev)CPT(p22r11_selected_speed,p22_param_ts1_jog_speed*-1);
					N: [XIC(p22r11_request_jog_fwd) XIO(p22r09_pb_jog_fwd) ,XIC(p22r11_request_jog_rev) XIO(p22r09_pb_jog_rev) ]MOV(0,p22r11_selected_speed);
					N: XIO(p22r11_request_thread_fwd)XIO(p22r11_request_thread_rev)XIO(p01r09_request_line_jog)XIO(p22r11_request_line_run)SYS_ACC_DEC_RAMP(p22r11_acc_decel_ramp,p22r11_selected_speed,p22_ts1_acc_rate,p22_ts1_decel_rate,p01r02_plc_scan_time_in_sec,p22_ao_selected_speed);
					N: XIC(p22r11_request_line_run)XIO(p01r09_stretch_mode)[GRT(p22r10_speed_offset,p22_ao_selected_speed) MOV(p22_ao_selected_speed,p22r10_speed_offset) ,LES(p22_ao_selected_speed,0) MOV(0,p22_ao_selected_speed) ,CPT(p22_ao_selected_speed,p01r12_master_ramped_speed+p22r10_speed_offset) ];
					N: XIC(p22r11_request_line_run)XIC(p01r09_stretch_mode)[CPT(p22r10_stretch,p01r12_master_ramped_speed/100*p01_recipe_active.ts1_stretch_sp) ,CPT(p22_ao_selected_speed,p01r12_master_ramped_speed+p22r10_stretch) ];
					N: [XIO(p22r11_request_line_run) XIO(p22r11_request_jog_fwd) XIO(p22r11_request_jog_rev) XIO(p22r11_request_thread_fwd) XIO(p22r11_request_thread_rev) XIO(p01r09_request_line_jog) ,XIO(p01r13_permissive_drives) ]MOV(0,p22_ao_selected_speed);
					N: MOV(p22r10_selected_torque,p22_ao_torque);
					RC: "Faults";
					N: OTE(p22r11.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p22r11.fault,p22r11.fault_ack);
					N: XIC(p22_status_word.3)[TON(p22r11_timer_fault[0],?,?) ,XIC(p22r11_timer_fault[0].DN) OTL(p22r11.fault.0) ];
					N: XIC(p22r11.fault_ack.0)XIO(p22_status_word.3)XIC(p01r09_pb_global_reset)[OTU(p22r11.fault.0) ,OTU(p22r11.fault_ack.0) ];
					N: XIC(FAULT)[TON(p22r11_timer_fault[1],?,?) ,XIC(p22r11_timer_fault[1].DN) OTL(p22r11.fault.1) ];
					N: XIC(p22r11.fault_ack.1)XIC(p01r09_pb_global_reset)[OTU(p22r11.fault.1) ,OTU(p22r11.fault_ack.1) ];
					N: XIO(p22_status_word.0)[TON(p22r11_timer_fault[2],?,?) ,XIC(p22r11_timer_fault[2].DN) OTL(p22r11.fault.2) ];
					N: XIC(p22r11.fault_ack.2)XIC(p22_status_word.0)XIC(p01r09_pb_global_reset)[OTU(p22r11.fault.2) ,OTU(p22r11.fault_ack.2) ];
					N: XIC(p22_status_word.1)XIO(p22_status_word.9)[TON(p22r11_timer_fault[3],?,?) ,XIC(p22r11_timer_fault[3].DN) OTL(p22r11.fault.3) ];
					N: XIC(p22r11.fault_ack.3)[XIC(p22_status_word.9) ,XIO(p22_status_word.1) ]XIC(p01r09_pb_global_reset)[OTU(p22r11.fault.3) ,OTU(p22r11.fault_ack.3) ];
					N: XIO(p22_di_therm)[TON(p22r11_timer_fault[4],?,?) ,XIC(p22r11_timer_fault[4].DN) OTL(p22r11.fault.4) ];
					N: XIC(p22r11.fault_ack.4)XIC(p22_di_therm)XIC(p01r09_pb_global_reset)[OTU(p22r11.fault.4) ,OTU(p22r11.fault_ack.4) ];
					N: XIO(p22_di_brake)[TON(p22r11_timer_fault[5],?,?) ,XIC(p22r11_timer_fault[5].DN) OTL(p22r11.fault.5) ];
					N: XIC(p22r11.fault_ack.5)XIC(p22_di_brake)XIC(p01r09_pb_global_reset)[OTU(p22r11.fault.5) ,OTU(p22r11.fault_ack.5) ];
					N: NEQ(p22r11.fault,p22r11.fault_ack)OTE(p22r11.unack_fault);
					RC: "Warnings$N"
					    "These warnings will stop the line";
					N: OTE(p22r11.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p22r11.warning,p22r11.warning_ack);
					N: XIC(p22_status_word.7)[TON(p22r11_timer_warning[0],?,?) ,XIC(p22r11_timer_warning[0].DN) OTL(p22r11.warning.0) ];
					N: XIC(p22r11.warning_ack.0)XIO(p22_status_word.7)XIC(p01r09_pb_global_reset)[OTU(p22r11.warning.0) ,OTU(p22r11.warning_ack.0) ];
					N: XIC(p22_ts1_vfd.OUT_ENABLED)LES(p22_ai_ts1_lc,p22r02_tension_dev_min)[TON(p22r11_timer_warning[1],?,?) ,XIC(p22r11_timer_warning[1].DN) OTL(p22r11.warning.1) ];
					N: [GEQ(p22_ai_ts1_lc,p22r02_tension_dev_min) ,XIO(p22_ts1_vfd.OUT_ENABLED) ]OTU(p22r11.warning.1);
					N: XIC(p22_ts1_vfd.OUT_ENABLED)GRT(p22_ai_ts1_lc,p22r02_tension_dev_max)[TON(p22r11_timer_warning[2],?,?) ,XIC(p22r11_timer_warning[2].DN) OTL(p22r11.warning.2) ];
					N: [GEQ(p22_ai_ts1_lc,p22r02_tension_dev_min) ,XIO(p22_ts1_vfd.OUT_ENABLED) ]OTU(p22r11.warning.2);
					N: SUB(p01_recipe_active.ts1_tension_sp,p01_recipe_active.tension_deviation_sp,p22r02_tension_dev_min);
					N: NEQ(p22r11.warning,p22r11.warning_ack)OTE(p22r11.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P23_Impreg (MAIN := "R01_Main",
	                    MODE := 0,
	                    DisableFlag := 0)
			TAG
				jog : BOOL (RADIX := Decimal) := 0;
				metering_roll : TIMER  := [519397,4500,0];
				p23r17 : routine  := [-1073741714,0,48,48,0,0,0,0,0,0];
				p23r17_request_line_run : BOOL (RADIX := Decimal) := 0;
			END_TAG

			ROUTINE R01_Main 
					RC: "p23r01 Main$N"
					    "$N"
					    "This routine is called, continuously, from p23 System while the plc is in Run mode.  All other p23 System routines are called from this routine.";
					N: OTE(p23r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p23r01.comment (dint)$N"
					    "p23r01.oneshot (dint)$N"
					    "p23r01_timer_xxxx (timer)$N"
					    "p23r01_xxxx (any)$N"
					    "p23r01.fault (dint)$N"
					    "p23r01.warning (dint)$N"
					    "";
					N: OTE(p23r01.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p23r01.comment.2);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R03_Inputs,0);
					N: JSR(R04_Outputs,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Parameters,0);
					N: JSR(R11_Servo_Operator_Side,0);
					N: JSR(R12_Servo_Drive_Side,0);
					N: JSR(R13_Supply_Fan_VFD,0);
					N: JSR(R15_Metering_Roll_VFD,0);
					N: JSR(R17_SPRING_ASSIST_VFD,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p23R02$N"
					    "This routine is called, continuously, from p23R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p23r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p23r02.comment (dint)$N"
					    "p23r02.oneshot (dint)$N"
					    "p23r02_timer_xxxx (timer)$N"
					    "p23r02_xxxx (any)$N"
					    "p23r02.fault (dint)$N"
					    "p23r02.warning (dint)$N"
					    "";
					N: OTE(p23r02.comment.1);
					RC: "Notes:$N"
					    "Dip Level controls";
					N: OTE(p23r02.comment.2);
					N: NEQ(p23_dint_to_hmi[2],0)OTE(p23r02_fault_exists);
					N: NEQ(p23_dint_to_hmi[4],0)OTE(p23r02_warning_exists);
					N: [XIC(p02_dint_from_hmi.impreg[0].18) ,XIC(p02_dint_from_hmi.global[6].10) ]OTE(p23r02_pb_start_exh);
					N: [XIC(p02_dint_from_hmi.impreg[0].19) ,XIO(p23r02.warning.0) XIO(p11r30.warning.4) XIO(p12r30.warning.4) XIC(p11r02_shutdown_temp) XIC(p12r02_shutdown_temp) [ONS(p23r02.oneshot.1) ,XIC(p02_dint_from_hmi.global[6].7) ] ]OTE(p23r02_pb_stop_exh);
					N: [ADD(p01_recipe_active.impreg_gap_sp,-0.005,p23r02_open_pos_real) ,MUL(p23r02_open_pos_real,10000,p23r02_open_pos_dint) ,DIV(p23r02_open_pos_dint,10000,p23_param_servo_open_position) ];
					RC: "Requests";
					N: OTE(p23r02.comment.3);
					N: [XIC(p23r02.unack_fault) ,XIC(p23r03.unack_fault) ,XIC(p23r04.unack_fault) ,XIC(p23r05.unack_fault) ,XIC(p23r06.unack_fault) ,XIC(p23r07.unack_fault) ,XIC(p23r08.unack_fault) ,XIC(p23r09.unack_fault) ,XIC(p23r12.unack_fault) ,XIC(p23r15.unack_fault) ]OTE(p23r02_unack_fault);
					N: [XIC(p23r02.unack_warning) ,XIC(p23r03.unack_warning) ,XIC(p23r04.unack_warning) ,XIC(p23r05.unack_warning) ,XIC(p23r06.unack_warning) ,XIC(p23r07.unack_warning) ,XIC(p23r08.unack_warning) ,XIC(p23r09.unack_warning) ,XIC(p23r12.unack_warning) ,XIC(p23r11.unack_warning) ,XIC(p23r15.unack_warning) ]OTE(p23r02_unack_warning);
					RC: "Sequence";
					N: OTE(p23r02.comment.4);
					N: [XIC(p23_di_metering_bar_close) ,XIC(p23r02_request_nip_close) ]XIO(p23_di_metering_bar_open)[OTE(p23r02_request_nip_close) ,TON(metering_roll_close,?,?) ];
					RC: "Output Control";
					N: OTE(p23r02.comment.5);
					N: [XIC(p23r02_pb_start_exh) ,XIC(p23_do_enable_impreg_exhaust_fan) ]XIO(p23r02_pb_stop_exh)XIO(p23r02.fault.1)OTE(p23_do_enable_impreg_exhaust_fan);
					N: XIC(p23r02_request_nip_close)XIO(p23_di_splice_jump)XIO(metering_roll_close.TT)OTE(p23_do_impreg_nip_close);
					RC: "Faults";
					N: OTE(p23r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p23r02.fault,p23r02.fault_ack);
					N: GEQ(p23_ai_lfl,p23_param_lfl_hhl)[TON(p23r02_timer_fault[0],?,?) ,XIC(p23r02_timer_fault[0].DN) OTL(p23r02.fault.0) ];
					N: XIC(p23r02.fault_ack.0)CMP(p23_ai_lfl<(p23_param_lfl_hhl-5))XIC(p01r09_pb_global_reset)[OTU(p23r02.fault.0) ,OTU(p23r02.fault_ack.0) ];
					N: [XIC(p23_do_enable_impreg_exhaust_fan) XIO(p23_di_impreg_exhaust_running) ,XIO(p23_do_enable_impreg_exhaust_fan) XIC(p23_di_impreg_exhaust_running) ][TON(p23r02_timer_fault[1],?,?) ,XIC(p23r02_timer_fault[1].DN) OTL(p23r02.fault.1) ];
					N: XIC(p23r02.fault_ack.1)XIO(p23_do_enable_impreg_exhaust_fan)XIO(p23_di_impreg_exhaust_running)XIC(p01r09_pb_global_reset)[OTU(p23r02.fault.1) ,OTU(p23r02.fault_ack.1) ];
					N: NEQ(p23r02.fault,p23r02.fault_ack)OTE(p23r02.unack_fault);
					RC: "Warnings";
					N: OTE(p23r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p23r02.warning,p23r02.warning_ack);
					N: GEQ(p23_ai_lfl,p23_param_lfl_hl)[TON(p23r02_timer_warning[0],?,?) ,XIC(p23r02_timer_warning[0].DN) OTL(p23r02.warning.0) ];
					N: CMP(p23_ai_lfl<(p23_param_lfl_hl-5))[OTU(p23r02.warning.0) ,OTU(p23r02.warning_ack.0) ];
					RC: "Probably need to add a FIFO for the pressure.";
					N: LES(p23_ai_prs,p23_param_zone_pressure)[TON(p23r02_timer_warning[1],?,?) ,XIC(p23r02_timer_warning[1].DN) OTL(p23r02.warning.1) ];
					N: XIC(p23r02.warning_ack.1)CMP(p23_ai_prs>(p23_param_zone_pressure+0.002))[OTU(p23r02.warning.1) ,OTU(p23r02.warning_ack.1) ];
					N: XIC(FAULT)[TON(p23r02_timer_warning[2],?,?) ,XIC(p23r02_timer_warning[2].DN) OTL(p23r02.warning.2) ];
					N: XIO(FAULT)[OTU(p23r02.warning.2) ,OTU(p23r02.warning_ack.2) ];
					N: XIC(p23_do_enable_impreg_exhaust_fan)XIO(p23_di_exhaust_speed_ok)[TON(p23r02_timer_warning[3],?,?) ,XIC(p23r02_timer_warning[3].DN) OTL(p23r02.warning.3) ];
					N: XIC(p23r02.warning_ack.3)[XIC(p23_di_exhaust_speed_ok) ,XIO(p23_do_enable_impreg_exhaust_fan) ][OTU(p23r02.warning.3) ,OTU(p23r02.warning_ack.3) ];
					N: NEQ(p23r02.warning,p23r02.warning_ack)OTE(p23r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Inputs 
					RC: "p23r03$N"
					    "This routine is called, continuously, from p23R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p23r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p23r03.comment (dint)$N"
					    "p23r03.oneshot (dint)$N"
					    "p23r03_timer_xxxx (timer)$N"
					    "p23r03_xxxx (any)$N"
					    "p23r03.fault (dint)$N"
					    "p23r03.warning (dint)$N"
					    "";
					N: OTE(p23r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p23r03.comment.2);
					RC: "Digital";
					N: OTE(p23r03.comment.3);
					RC: "Metering Roll VFD";
					N: [XIC(p00_vfd_mtr:I.Data[0].0) OTE(p23_di_metering_roll.faulted) ,XIC(p00_vfd_mtr:I.Data[0].1) OTE(p23_di_metering_roll.warning) ,XIC(p00_vfd_mtr:I.Data[0].2) OTE(p23_di_metering_roll.running_fwd) ,XIC(p00_vfd_mtr:I.Data[0].3) OTE(p23_di_metering_roll.running_rev) ];
					N: [XIC(p00_vfd_mtr:I.Data[0].4) OTE(p23_di_metering_roll.ready) ,XIC(p00_vfd_mtr:I.Data[0].5) OTE(p23_di_metering_roll.ctrl_from_net) ,XIC(p00_vfd_mtr:I.Data[0].6) OTE(p23_di_metering_roll.ref_from_net) ,XIC(p00_vfd_mtr:I.Data[0].7) OTE(p23_di_metering_roll.at_reference) ];
					N: XIC(p01r02.fault.11)FLL(0,p00_vfd_mtr:I.Data[0],4);
					N: [XIC(p00_vfd_sprng:I.Data[0].0) OTE(p23_di_spring.faulted) ,XIC(p00_vfd_sprng:I.Data[0].1) OTE(p23_di_spring.warning) ,XIC(p00_vfd_sprng:I.Data[0].2) OTE(p23_di_spring.running_fwd) ,XIC(p00_vfd_sprng:I.Data[0].3) OTE(p23_di_spring.running_rev) ];
					N: [XIC(p00_vfd_sprng:I.Data[0].4) OTE(p23_di_spring.ready) ,XIC(p00_vfd_sprng:I.Data[0].5) OTE(p23_di_spring.ctrl_from_net) ,XIC(p00_vfd_sprng:I.Data[0].6) OTE(p23_di_spring.ref_from_net) ,XIC(p00_vfd_sprng:I.Data[0].7) OTE(p23_di_spring.at_reference) ];
					RC: "Supply Fan VFD";
					N: [XIC(p00_vfd_imp_supply:I.Data[0].0) OTE(p23_di_supply.faulted) ,XIC(p00_vfd_imp_supply:I.Data[0].1) OTE(p23_di_supply.warning) ,XIC(p00_vfd_imp_supply:I.Data[0].2) OTE(p23_di_supply.running_fwd) ,XIC(p00_vfd_imp_supply:I.Data[0].3) OTE(p23_di_supply.running_rev) ];
					N: [XIC(p00_vfd_imp_supply:I.Data[0].4) OTE(p23_di_supply.ready) ,XIC(p00_vfd_imp_supply:I.Data[0].5) OTE(p23_di_supply.ctrl_from_net) ,XIC(p00_vfd_imp_supply:I.Data[0].6) OTE(p23_di_supply.ref_from_net) ,XIC(p00_vfd_imp_supply:I.Data[0].7) OTE(p23_di_supply.at_reference) ];
					N: XIC(p01r02.fault.0)MOV(0,p00_vfd_imp_supply:I.Data[0]);
					N: [XIC(Local:5:I.Data.3) OTE(p23_di_supply_speed_ok) ,XIC(Local:5:I.Data.4) OTE(p23_di_exhaust_speed_ok) ];
					N: [XIC(p00_io_letoff:7:I.0) OTE(p23_di_splice_jump) ,XIC(p00_io_letoff:7:I.1) OTE(p23_di_metering_bar_open) ,XIC(p00_io_letoff:7:I.2) OTE(p23_di_metering_bar_close) ,XIC(p00_io_letoff:7:I.3) XIC(metering_roll.DN) OTE(p23_di_vfd_jog_fwd) ,XIC(p00_io_letoff:7:I.4) XIC(metering_roll.DN) OTE(p23_di_vfd_jog_rev) ,XIC(p00_io_letoff:7:I.8) OTE(p23_di_impreg_tank_up) ,XIC(p00_io_letoff:7:I.9) OTE(p23_di_filter_clean) ];
					N: [XIC(p00_io_letoff:7:I.4) ,XIC(p00_io_letoff:7:I.3) ][TON(metering_roll,?,?) ,TON(metering_roll_alarm,?,?) ];
					N: [XIC(p00_io_letoff:7:I.13) OTE(p23_di_tank_level_low) ,XIC(p00_io_letoff:7:I.11) OTE(p23_di_though_level_low) ,XIC(p00_io_letoff:7:I.12) OTE(p23_di_tank_level_high) ];
					N: [XIC(p00_io_prc:1:I.0) OTE(p23_di_supply_motor_therm) ,XIC(p00_io_line:2:I.7) OTE(p23_di_therm) ,XIC(p00_io_line:2:I.9) OTE(p23_di_srv_op_ok) ,XIC(p00_io_line:2:I.10) OTE(p23_di_srv_ds_ok) ];
					N: [XIC(p00_io_line:3:I.4) OTE(p23r17_di_therm) ,XIC(p00_io_line:3:I.5) OTE(p23r17_di_brake) ];
					RC: "Mayer Rod Drive Side$N"
					    "Servo";
					N: [XIC(p00_srv_mtr_ds:I.Data[0].0) OTE(p23_di_servo_ds.mode_bit_0) ,XIC(p00_srv_mtr_ds:I.Data[0].1) OTE(p23_di_servo_ds.mode_bit_1) ,XIC(p00_srv_mtr_ds:I.Data[0].2) OTE(p23_di_servo_ds.homed) ,XIC(p00_srv_mtr_ds:I.Data[0].3) OTE(p23_di_servo_ds.stand_still) ,XIC(p00_srv_mtr_ds:I.Data[0].4) OTE(p23_di_servo_ds.at_target_pos) ,XIC(p00_srv_mtr_ds:I.Data[0].5) OTE(p23_di_servo_ds.command_change) ,XIC(p00_srv_mtr_ds:I.Data[0].6) OTE(p23_di_servo_ds.operator_mode_error) ,XIC(p00_srv_mtr_ds:I.Data[0].7) OTE(p23_di_servo_ds.drive_does_not_follow) ,XIC(p00_srv_mtr_ds:I.Data[0].11) OTE(p23_di_servo_ds.class_3_diagnostic) ,XIC(p00_srv_mtr_ds:I.Data[0].12) OTE(p23_di_servo_ds.class_2_diagnostic) ,XIC(p00_srv_mtr_ds:I.Data[0].13) OTE(p23_di_servo_ds.class_1_diagnostic) ,XIC(p00_srv_mtr_ds:I.Data[0].14) OTE(p23_di_servo_ds.operation_bit_14) ,XIC(p00_srv_mtr_ds:I.Data[0].15) OTE(p23_di_servo_ds.operation_bit_15) ];
					N: [XIC(p00_srv_mtr_os:I.Data[0].0) OTE(p23_di_servo_os.mode_bit_0) ,XIC(p00_srv_mtr_os:I.Data[0].1) OTE(p23_di_servo_os.mode_bit_1) ,XIC(p00_srv_mtr_os:I.Data[0].2) OTE(p23_di_servo_os.homed) ,XIC(p00_srv_mtr_os:I.Data[0].3) OTE(p23_di_servo_os.stand_still) ,XIC(p00_srv_mtr_os:I.Data[0].4) OTE(p23_di_servo_os.at_target_pos) ,XIC(p00_srv_mtr_os:I.Data[0].5) OTE(p23_di_servo_os.command_change) ,XIC(p00_srv_mtr_os:I.Data[0].6) OTE(p23_di_servo_os.operator_mode_error) ,XIC(p00_srv_mtr_os:I.Data[0].7) OTE(p23_di_servo_os.drive_does_not_follow) ,XIC(p00_srv_mtr_os:I.Data[0].11) OTE(p23_di_servo_os.class_3_diagnostic) ,XIC(p00_srv_mtr_os:I.Data[0].12) OTE(p23_di_servo_os.class_2_diagnostic) ,XIC(p00_srv_mtr_os:I.Data[0].13) OTE(p23_di_servo_os.class_1_diagnostic) ,XIC(p00_srv_mtr_os:I.Data[0].14) OTE(p23_di_servo_os.operation_bit_14) ,XIC(p00_srv_mtr_os:I.Data[0].15) OTE(p23_di_servo_os.operation_bit_15) ];
					N: XIC(p00_io_prc:1:I.8)OTE(p23_di_impreg_exhaust_running);
					RC: "Analog";
					N: OTE(p23r03.comment.4);
					N: SYS_SCP(p23r03_impreg_prs_scp,p00_io_letoff:1:I.Ch3Data,p23r03_impreg_prs_input_min,p23r03_impreg_prs_input_max,p23r03_impreg_prs_output_min,p23r03_impreg_prs_output_max,p23_ai_prs);
					N: SYS_SCP(p23r03_impreg_lfl_monitor,p00_io_letoff:1:I.Ch2Data,p23_ctr_lfl_input_min,p23_ctr_lfl_input_max,p23_ctr_lfl_output_min,p23_ctr_lfl_output_max,p23_ai_lfl);
					RC: "Metering Roll VFD";
					N: SYS_RPM_TO_SPEED(p23r03_metering_vfd_rpm_to_speed,p23_ctr_gear_ratio,p23_ctr_roll_diameter_ft,p00_vfd_mtr:I.Data[1],p23_ai_metering_roll_speed_fpm);
					N: CPT(p23_ai_metering_roll_amps,p00_vfd_mtr:I.Data[2]*0.1);
					N: SYS_SCP(p23r03_hz,p00_vfd_mtr:I.Data[1],0,1750,0,60,p23_ai_metering_roll_hz);
					RC: "Supply Fan VFD";
					N: CPT(p23_ai_supply_rpm,p00_vfd_imp_supply:I.Data[1]*1);
					N: CPT(p23_ai_supply_amps,p00_vfd_imp_supply:I.Data[2]*0.1);
					N: CPT(p23_ai_supply_hz,60*1);
					RC: "Servo Drive Side";
					N: CPT(p23_ai_servo_ds_velocity,p00_srv_mtr_ds:I.Data[1]*1);
					N: CPT(p23_ai_servo_ds_position,p00_srv_mtr_ds:I.Data[2]*0.1/2*0.001);
					N: [MUL(p23_ai_servo_ds_position,10000,p23_ai_ds_gap_dint) ,DIV(p23_ai_ds_gap_dint,10000,p23_ai_ds_masked_gap) ];
					N: CPT(p23_ai_servo_ds_torque,p00_srv_mtr_ds:I.Data[3]*0.1);
					RC: "Servo Operator Side";
					N: CPT(p23_ai_servo_os_velocity,p00_srv_mtr_os:I.Data[1]*1);
					N: CPT(p23_ai_servo_os_position,p00_srv_mtr_os:I.Data[2]*0.1/2*0.001);
					N: [MUL(p23_ai_servo_os_position,10000,p23_ai_os_gap_dint) ,DIV(p23_ai_os_gap_dint,10000,p23_ai_os_masked_gap) ];
					N: CPT(p23_ai_servo_os_torque,p00_srv_mtr_os:I.Data[3]*1);
					RC: "Faults";
					N: OTE(p23r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p23r03.fault,p23r03.fault_ack);
					N: XIC(FAULT)[TON(p23r03_timer_fault[0],?,?) ,XIC(p23r03_timer_fault[0].DN) OTL(p23r03.fault.0) ];
					N: XIC(p23r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p23r03.fault.0) ,OTU(p23r03.fault_ack.0) ];
					N: NEQ(p23r03.fault,p23r03.fault_ack)OTE(p23r03.unack_fault);
					RC: "Warnings";
					N: OTE(p23r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p23r03.warning,p23r03.warning_ack);
					N: XIC(FAULT)[TON(p23r03_timer_warning[0],?,?) ,XIC(p23r03_timer_warning[0].DN) OTL(p23r03.warning.0) ];
					N: XIO(FAULT)[OTU(p23r03.warning.0) ,OTU(p23r03.warning_ack.0) ];
					N: NEQ(p23r03.warning,p23r03.warning_ack)OTE(p23r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Outputs 
					RC: "p23r04$N"
					    "This routine is called, continuously, from p23R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p23r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p23r04.comment (dint)$N"
					    "p23r04.oneshot (dint)$N"
					    "p23r04_timer_xxxx (timer)$N"
					    "p23r04_xxxx (any)$N"
					    "p23r04.fault (dint)$N"
					    "p23r04.warning (dint)$N"
					    "";
					N: OTE(p23r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p23r04.comment.2);
					RC: "Digital";
					N: OTE(p23r04.comment.3);
					N: [XIC(p23_do_impreg.forward) OTE(p00_vfd_mtr:O.Data[0].0) ,XIC(p23_do_impreg.reverse) OTE(p00_vfd_mtr:O.Data[0].1) ,XIC(p23_do_impreg.fault_reset) OTE(p00_vfd_mtr:O.Data[0].2) ,OTE(p00_vfd_mtr:O.Data[0].5) ,OTE(p00_vfd_mtr:O.Data[0].6) ];
					N: [XIC(p23_do_Spring.forward) OTE(p00_vfd_sprng:O.Data[0].0) ,XIC(p23_do_Spring.reverse) OTE(p00_vfd_sprng:O.Data[0].1) ,XIC(p23_do_Spring.fault_reset) OTE(p00_vfd_sprng:O.Data[0].2) ,OTE(p00_vfd_sprng:O.Data[0].5) ,OTE(p00_vfd_sprng:O.Data[0].6) ];
					N: [XIC(p23_do_supply.forward) OTE(p00_vfd_imp_supply:O.Data[0].0) ,XIC(p23_do_supply.reverse) OTE(p00_vfd_imp_supply:O.Data[0].1) ,XIC(p23_do_supply.fault_reset) OTE(p00_vfd_imp_supply:O.Data[0].2) ,OTE(p00_vfd_imp_supply:O.Data[0].5) ,OTE(p00_vfd_imp_supply:O.Data[0].6) ];
					N: [XIC(p23_do_enable_impreg_exhaust_fan) OTE(p00_io_prc:0:O.0) ,XIC(p23_do_impreg_nip_close) OTE(p00_io_letoff:3:O.14) ];
					RC: "Mayer Rod Drive Side$N"
					    "Servo";
					N: [XIC(p23_do_servo_ds.command_value_accept) OTE(p00_srv_mtr_ds:O.Data[0].0) ,XIC(p23_do_servo_ds.fault_reset) OTE(p00_srv_mtr_ds:O.Data[0].5) ,XIC(p23_do_servo_ds.jog_forward) OTE(p00_srv_mtr_ds:O.Data[0].6) ,XIC(p23_do_servo_ds.jog_reverse) OTE(p00_srv_mtr_ds:O.Data[0].7) ];
					N: [XIC(p23_do_servo_ds.jog_enable) OTE(p00_srv_mtr_ds:O.Data[0].8) ,XIC(p23_do_servo_ds.drive_halt_0_halt) OTE(p00_srv_mtr_ds:O.Data[0].13) ,XIC(p23_do_servo_ds.drive_enable) OTE(p00_srv_mtr_ds:O.Data[0].15) ,XIC(p23_do_servo_ds.ready_for_operation_bit_16) OTE(p00_srv_mtr_ds:O.Data[0].16) ,XIC(p23_do_servo_ds.ready_for_operation_bit_17) OTE(p00_srv_mtr_ds:O.Data[0].17) ];
					RC: "Mayer Rod Operator Side$N"
					    "Servo";
					N: [XIC(p23_do_servo_os.command_value_accept) OTE(p00_srv_mtr_os:O.Data[0].0) ,XIC(p23_do_servo_os.fault_reset) OTE(p00_srv_mtr_os:O.Data[0].5) ,XIC(p23_do_servo_os.jog_forward) OTE(p00_srv_mtr_os:O.Data[0].6) ,XIC(p23_do_servo_os.jog_reverse) OTE(p00_srv_mtr_os:O.Data[0].7) ];
					N: [XIC(p23_do_servo_os.jog_enable) OTE(p00_srv_mtr_os:O.Data[0].8) ,XIC(p23_do_servo_os.drive_halt_0_halt) OTE(p00_srv_mtr_os:O.Data[0].13) ,XIC(p23_do_servo_os.drive_enable) OTE(p00_srv_mtr_os:O.Data[0].15) ,XIC(p23_do_servo_os.ready_for_operation_bit_16) OTE(p00_srv_mtr_os:O.Data[0].16) ,XIC(p23_do_servo_os.ready_for_operation_bit_17) OTE(p00_srv_mtr_os:O.Data[0].17) ];
					RC: "Analog";
					N: OTE(p23r04.comment.4);
					N: SYS_SPEED_TO_VFD(p23_spring_speed_to_vfd,p23_spring_gear_ratio,p23_spring_roll_diameter_ft,p23r17_adjusted_speed,p00_vfd_sprng:O.Data[1]);
					N: SYS_SPEED_TO_VFD(p23_cpr_speed_to_vfd,p23_cpr_gear_ratio,p23_cpr_roll_diameter_ft,p23_ao_selected_speed,p00_vfd_mtr:O.Data[1]);
					N: MOV(p23_ao_supply_selected_speed,p00_vfd_imp_supply:O.Data[1]);
					N: CPT(p00_srv_mtr_ds:O.Data[1],p23_ao_servo_ds_velocity_cmd*10000);
					N: CPT(p00_srv_mtr_ds:O.Data[2],p23_ao_servo_ds_position_cmd*10000);
					N: CPT(p00_srv_mtr_ds:O.Data[3],p23_ao_servo_ds_jog_vel_cmd*10000);
					N: CPT(p00_srv_mtr_ds:O.Data[4],p23_ao_servo_ds_zero_offset*10000);
					N: CPT(p00_srv_mtr_os:O.Data[1],p23_ao_servo_os_velocity_cmd*10000);
					N: CPT(p00_srv_mtr_os:O.Data[2],p23_ao_servo_os_position_cmd*10000);
					N: CPT(p00_srv_mtr_os:O.Data[3],p23_ao_servo_os_jog_vel_cmd*10000);
					N: CPT(p00_srv_mtr_os:O.Data[4],p23_ao_servo_os_zero_offset*10000);
					RC: "Faults";
					N: OTE(p23r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p23r04.fault,p23r04.fault_ack);
					N: XIC(FAULT)[TON(p23r04_timer_fault[0],?,?) ,XIC(p23r04_timer_fault[0].DN) OTL(p23r04.fault.0) ];
					N: XIC(p23r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p23r04.fault.0) ,OTU(p23r04.fault_ack.0) ];
					N: NEQ(p23r04.fault,p23r04.fault_ack)OTE(p23r04.unack_fault);
					RC: "Warnings";
					N: OTE(p23r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p23r04.warning,p23r04.warning_ack);
					N: XIC(FAULT)[TON(p23r04_timer_warning[0],?,?) ,XIC(p23r04_timer_warning[0].DN) OTL(p23r04.warning.0) ];
					N: XIO(FAULT)[OTU(p23r04.warning.0) ,OTU(p23r04.warning_ack.0) ];
					N: NEQ(p23r04.warning,p23r04.warning_ack)OTE(p23r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					RC: "p23r05$N"
					    "This routine is called, continuously, from p23R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p23r05.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p23r05.comment (dint)$N"
					    "p23r05.oneshot (dint)$N"
					    "p23r05_timer_xxxx (timer)$N"
					    "p23r05_xxxx (any)$N"
					    "p23r05.fault (dint)$N"
					    "p23r05.warning (dint)$N"
					    "";
					N: OTE(p23r05.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p23r05.comment.2);
					RC: "Requests";
					N: OTE(p23r05.comment.3);
					N: [XIC(p23_di_tank_level_low) OTE(p23_dint_to_hmi[0].0) ,XIC(p23_di_though_level_low) OTE(p23_dint_to_hmi[0].1) ,XIC(p23_di_tank_level_high) OTE(p23_dint_to_hmi[0].2) ,XIC(p23_do_enable_impreg_exhaust_fan) OTE(p23_dint_to_hmi[0].3) ];
					N: [XIC(HMI) OTE(p23_dint_to_hmi[0].4) ,XIC(HMI) OTE(p23_dint_to_hmi[0].5) ,XIC(HMI) OTE(p23_dint_to_hmi[0].6) ,XIC(HMI) OTE(p23_dint_to_hmi[0].7) ];
					N: [XIC(HMI) OTE(p23_dint_to_hmi[0].8) ,XIC(HMI) OTE(p23_dint_to_hmi[0].9) ,XIC(HMI) OTE(p23_dint_to_hmi[0].10) ,XIC(HMI) OTE(p23_dint_to_hmi[0].11) ];
					N: [XIC(HMI) OTE(p23_dint_to_hmi[0].12) ,XIC(HMI) OTE(p23_dint_to_hmi[0].13) ,XIC(HMI) OTE(p23_dint_to_hmi[0].14) ,XIC(HMI) OTE(p23_dint_to_hmi[0].15) ];
					N: [XIC(p23_do_enable_impreg_supply_fan) OTE(p23_dint_to_hmi[0].16) ,XIC(HMI) OTE(p23_dint_to_hmi[0].17) ,XIC(p23_di_impreg_tank_up) OTE(p23_dint_to_hmi[0].18) ,XIC(HMI) OTE(p23_dint_to_hmi[0].19) ];
					N: [XIC(HMI) OTE(p23_dint_to_hmi[0].20) ,XIC(HMI) OTE(p23_dint_to_hmi[0].21) ,XIC(HMI) OTE(p23_dint_to_hmi[0].22) ,XIC(HMI) OTE(p23_dint_to_hmi[0].23) ];
					N: [XIC(HMI) OTE(p23_dint_to_hmi[0].24) ,XIC(HMI) OTE(p23_dint_to_hmi[0].25) ,XIC(HMI) OTE(p23_dint_to_hmi[0].26) ,XIC(HMI) OTE(p23_dint_to_hmi[0].27) ];
					N: [XIC(HMI) OTE(p23_dint_to_hmi[0].28) ,XIC(HMI) OTE(p23_dint_to_hmi[0].29) ,XIC(HMI) OTE(p23_dint_to_hmi[0].30) ,XIC(HMI) OTE(p23_dint_to_hmi[0].31) ];
					N: [XIC(p23_di_metering_roll.faulted) OTE(p23_dint_to_hmi[1].0) ,XIC(p23_di_metering_roll.warning) OTE(p23_dint_to_hmi[1].1) ,XIC(p23_di_metering_roll.running_fwd) OTE(p23_dint_to_hmi[1].2) ,XIC(p23_di_metering_roll.running_rev) OTE(p23_dint_to_hmi[1].3) ];
					N: [XIC(p23_di_metering_roll.ready) OTE(p23_dint_to_hmi[1].4) ,XIC(p23_di_metering_roll.ctrl_from_net) OTE(p23_dint_to_hmi[1].5) ,XIC(p23_di_metering_roll.ref_from_net) OTE(p23_dint_to_hmi[1].6) ,XIC(p23_di_metering_roll.at_reference) OTE(p23_dint_to_hmi[1].7) ];
					N: [XIC(p23_di_supply.faulted) OTE(p23_dint_to_hmi[1].8) ,XIC(p23_di_supply.warning) OTE(p23_dint_to_hmi[1].9) ,XIC(p23_di_supply.running_fwd) OTE(p23_dint_to_hmi[1].10) ,XIC(p23_di_supply.running_rev) OTE(p23_dint_to_hmi[1].11) ];
					N: [XIC(p23_di_supply.ready) OTE(p23_dint_to_hmi[1].12) ,XIC(p23_di_supply.ctrl_from_net) OTE(p23_dint_to_hmi[1].13) ,XIC(p23_di_supply.ref_from_net) OTE(p23_dint_to_hmi[1].14) ,XIC(p23_di_supply.at_reference) OTE(p23_dint_to_hmi[1].15) ];
					N: [XIC(p23r12_servo_not_ready) OTE(p23_dint_to_hmi[1].16) ,XIC(p23r12_servo_status_bb) OTE(p23_dint_to_hmi[1].17) ,XIC(p23r12_servo_status_ab) OTE(p23_dint_to_hmi[1].18) ,XIC(p23r12_servo_status_af) OTE(p23_dint_to_hmi[1].19) ];
					N: XIC(p23r15_pid_tension_control)OTE(p23_dint_to_hmi[1].25);
					N: [XIO(p23_di_servo_ds.mode_bit_1) XIO(p23_di_servo_ds.mode_bit_0) OTE(p23_dint_to_hmi[3].8) ,XIC(p23_di_servo_ds.homed) OTE(p23_dint_to_hmi[3].9) ,XIC(p23_di_servo_ds.stand_still) OTE(p23_dint_to_hmi[3].10) ,XIC(p23_di_servo_ds.at_target_pos) OTE(p23_dint_to_hmi[3].11) ,XIC(p23_di_servo_ds.command_change) OTE(p23_dint_to_hmi[3].12) ,XIC(p23_di_servo_ds.operator_mode_error) OTE(p23_dint_to_hmi[3].13) ,XIC(p23_di_servo_ds.drive_does_not_follow) OTE(p23_dint_to_hmi[3].14) ,XIC(p23_di_servo_ds.class_3_diagnostic) OTE(p23_dint_to_hmi[3].15) ,XIC(p23_di_servo_ds.class_2_diagnostic) OTE(p23_dint_to_hmi[3].16) ,XIC(p23_di_servo_ds.class_1_diagnostic) OTE(p23_dint_to_hmi[3].17) ];
					N: [XIO(p23_di_servo_os.mode_bit_1) XIO(p23_di_servo_os.mode_bit_0) OTE(p23_dint_to_hmi[3].20) ,XIC(p23_di_servo_os.homed) OTE(p23_dint_to_hmi[3].21) ,XIC(p23_di_servo_os.stand_still) OTE(p23_dint_to_hmi[3].22) ,XIC(p23_di_servo_os.at_target_pos) OTE(p23_dint_to_hmi[3].23) ,XIC(p23_di_servo_os.command_change) OTE(p23_dint_to_hmi[3].24) ,XIC(p23_di_servo_os.operator_mode_error) OTE(p23_dint_to_hmi[3].25) ,XIC(p23_di_servo_os.drive_does_not_follow) OTE(p23_dint_to_hmi[3].26) ,XIC(p23_di_servo_os.class_3_diagnostic) OTE(p23_dint_to_hmi[3].27) ,XIC(p23_di_servo_os.class_2_diagnostic) OTE(p23_dint_to_hmi[3].28) ,XIC(p23_di_servo_os.class_1_diagnostic) OTE(p23_dint_to_hmi[3].29) ];
					N: MOV(0,p23_dint_to_hmi[5])[XIC(p23r11_servo_not_ready) MOV(0,p23_dint_to_hmi[5]) ,XIC(p23r11_servo_status_bb) MOV(1,p23_dint_to_hmi[5]) ,XIC(p23r11_servo_status_ab) MOV(2,p23_dint_to_hmi[5]) ,XIC(p23r11_servo_status_af) MOV(3,p23_dint_to_hmi[5]) ];
					N: MOV(0,p23_dint_to_hmi[6])[XIC(p23r12_servo_not_ready) MOV(0,p23_dint_to_hmi[6]) ,XIC(p23r12_servo_status_bb) MOV(1,p23_dint_to_hmi[6]) ,XIC(p23r12_servo_status_ab) MOV(2,p23_dint_to_hmi[6]) ,XIC(p23r12_servo_status_af) MOV(3,p23_dint_to_hmi[6]) ];
					N: SYS_ENC_WITH_ZERO_BIT(p23_servo_ds_error,p00_srv_mtr_ds:I.Data[4],p23_dint_to_hmi[10]);
					N: SYS_ENC_WITH_ZERO_BIT(p23_servo_os_error,p00_srv_mtr_os:I.Data[4],p23_dint_to_hmi[11]);
					N: SYS_ENC_WITH_ZERO_BIT(p23_servo_ds_warning,p00_srv_mtr_ds:I.Data[5],p23_dint_to_hmi[12]);
					N: SYS_ENC_WITH_ZERO_BIT(p23_servo_os_warning,p00_srv_mtr_os:I.Data[5],p23_dint_to_hmi[13]);
					RC: "1 = Ready$N"
					    "2 = Running$N"
					    "3 = Stopped$N"
					    "4 = Fault$N"
					    "5 = Offline$N"
					    "6 = Auto Stop";
					N: MOV(5,p23r05_supply_status)[EQU(p23r13.fault,0) MOV(1,p23r05_supply_status) ,XIC(p23_di_supply.running_fwd) MOV(2,p23r05_supply_status) ,XIC(p23r13_vfd_stopped) MOV(3,p23r05_supply_status) ,XIC(p23_di_supply.running_fwd) XIC(p32r13_request_auto_stop) MOV(6,p23r05_supply_status) ,NEQ(p23r13.fault,0) MOV(4,p23r05_supply_status) ];
					N: MOV(p23r05_supply_status,p23_dint_to_hmi[7]);
					RC: "Sequence";
					N: OTE(p23r05.comment.4);
					RC: "Output Control";
					N: OTE(p23r05.comment.5);
					RC: "Faults";
					N: OTE(p23r05.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p23r05.fault,p23r05.fault_ack);
					N: XIC(FAULT)[TON(p23r05_timer_fault[0],?,?) ,XIC(p23r05_timer_fault[0].DN) OTL(p23r05.fault.0) ];
					N: XIC(p23r05.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p23r05.fault.0) ,OTU(p23r05.fault_ack.0) ];
					N: NEQ(p23r05.fault,p23r05.fault_ack)OTE(p23r05.unack_fault);
					RC: "Warnings";
					N: OTE(p23r05.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p23r05.warning,p23r05.warning_ack);
					N: XIC(FAULT)[TON(p23r05_timer_warning[0],?,?) ,XIC(p23r05_timer_warning[0].DN) OTL(p23r05.warning.0) ];
					N: XIO(FAULT)[OTU(p23r05.warning.0) ,OTU(p23r05.warning_ack.0) ];
					N: NEQ(p23r05.warning,p23r05.warning_ack)OTE(p23r05.unack_warning);
					N: RET();
			END_ROUTINE

