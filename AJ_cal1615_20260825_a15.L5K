			ROUTINE R13_Supply_Fan_VFD 
					RC: "p23r13$N"
					    "This routine is called, continuously, from p23R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p23r13.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p23r13.comment (dint)$N"
					    "p23r13.oneshot (dint)$N"
					    "p23r13_timer_xxxx (timer)$N"
					    "p23r13_xxxx (any)$N"
					    "p23r13.fault (dint)$N"
					    "p23r13.warning (dint)$N"
					    "";
					N: OTE(p23r13.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p23r13.comment.2);
					N: [XIC(p02_dint_from_hmi.impreg[0].20) ,XIC(p02_dint_from_hmi.global[6].10) ]OTE(p23r13_pb_start);
					N: [XIC(p02_dint_from_hmi.impreg[0].21) ,XIO(p23r02.warning.0) XIO(p11r30.warning.4) XIO(p12r30.warning.4) XIC(p11r02_shutdown_temp) XIC(p12r02_shutdown_temp) [ONS(p23r13.oneshot.1) ,XIC(p02_dint_from_hmi.global[6].7) ] ]OTE(p23r13_pb_stop);
					N: LEQ(p23_ai_supply_rpm,p01_param_fan_zero_speed)OTE(p23r13_vfd_stopped);
					RC: "Requests";
					N: OTE(p23r13.comment.3);
					N: EQU(p23r13.fault,0)OTE(p23r13_run_permissive);
					N: [XIC(p23r13_pb_start) XIC(p23r13_vfd_stopped) ,XIC(p23r13_request_auto_run) ]XIO(p23r13_pb_stop)XIC(p23r13_run_permissive)OTE(p23r13_request_auto_run);
					RC: "Output Control";
					N: OTE(p23r13.comment.5);
					N: XIC(p23r13_request_auto_run)OTE(p23_do_supply.forward);
					N: XIC(p01r09_pb_global_reset)OTE(p23_do_supply.fault_reset);
