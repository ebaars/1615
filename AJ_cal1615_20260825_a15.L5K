					N: [XIC(p23r15_request_jog_fwd) XIC(p23_di_vfd_jog_fwd) ,XIC(p23r15_request_jog_rev) XIC(p23_di_vfd_jog_rev) ]MOV(p23_param_mtr_jog_speed,p23r15_selected_speed);
					N: [XIC(p23r15_request_jog_fwd) XIO(p23_di_vfd_jog_fwd) ,XIC(p23r15_request_jog_rev) XIO(p23_di_vfd_jog_rev) ]MOV(0,p23r15_selected_speed);
