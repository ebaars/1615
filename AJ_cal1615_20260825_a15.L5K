					N: MOV(2000,p01_param_oven_timer_presets[23])MOV(5000,p01_param_oven_timer_presets[24])MOV(5000,p01_param_oven_timer_presets[25]);
					N: MOV(15000,p01_param_oven_timer_presets[26])MOV(500,p01_param_oven_timer_presets[27])MOV(30000,p01_param_oven_timer_presets[28]);
					N: MOV(0,p01_param_oven_timer_presets[29])MOV(0,p01_param_oven_timer_presets[30])MOV(500,p01_param_oven_timer_presets[31]);
					RC: "Sequence";
					N: OTE(p01r11.comment.4);
					RC: "Output Control";
