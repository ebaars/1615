					N: [XIC(p28r02.unack_warning) ,XIC(p28r03.unack_warning) ,XIC(p28r04.unack_warning) ,XIC(p28r05.unack_warning) ,XIC(p28r06.unack_warning) ,XIC(p28r07.unack_warning) ,XIC(p28r08.unack_warning) ,XIC(p28r09.unack_warning) ,XIC(p28r11.unack_warning) ]OTE(p28r02_unack_warning);
					RC: "Sequence";
					N: OTE(p28r02.comment.4);
					RC: "Output Control";
					N: OTE(p28r02.comment.5);
					N: XIC(p28r11_slitter_on)OTE(p28_do_slt_air_supply_sv);
					RC: "Faults";
					N: OTE(p28r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p28r02.fault,p28r02.fault_ack);
					N: XIC(FAULT)[TON(p28r02_timer_fault[0],?,?) ,XIC(p28r02_timer_fault[0].DN) OTL(p28r02.fault.0) ];
					N: XIC(p28r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p28r02.fault.0) ,OTU(p28r02.fault_ack.0) ];
					N: NEQ(p28r02.fault,p28r02.fault_ack)OTE(p28r02.unack_fault);
					RC: "Warnings";
					N: OTE(p28r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p28r02.warning,p28r02.warning_ack);
					N: XIC(FAULT)[TON(p28r02_timer_warning[0],?,?) ,XIC(p28r02_timer_warning[0].DN) OTL(p28r02.warning.0) ];
					N: XIO(FAULT)[OTU(p28r02.warning.0) ,OTU(p28r02.warning_ack.0) ];
					N: NEQ(p28r02.warning,p28r02.warning_ack)OTE(p28r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Inputs 
					RC: "p28r03$N"
					    "This routine is called, continuously, from p28R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p28r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p28r03.comment (dint)$N"
					    "p28r03.oneshot (dint)$N"
					    "p28r03_timer_xxxx (timer)$N"
					    "p28r03_xxxx (any)$N"
					    "p28r03.fault (dint)$N"
					    "p28r03.warning (dint)$N"
					    "";
					N: OTE(p28r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p28r03.comment.2);
					RC: "Digital";
					N: OTE(p28r03.comment.3);
					N: [XIC(p00_io_line:2:I.13) OTE(p28_di_motor) ,XIC(p00_io_line:2:I.12) OTE(p28_di_brake) ];
					RC: "VFD Inputs";
					N: [XIC(p00_vfd_slitter:I.Data[0].0) OTE(p28_di_slitter.faulted) ,XIC(p00_vfd_slitter:I.Data[0].1) OTE(p28_di_slitter.warning) ,XIC(p00_vfd_slitter:I.Data[0].2) OTE(p28_di_slitter.running_fwd) ,XIC(p00_vfd_slitter:I.Data[0].3) OTE(p28_di_slitter.running_rev) ];
					N: [XIC(p00_vfd_slitter:I.Data[0].4) OTE(p28_di_slitter.ready) ,XIC(p00_vfd_slitter:I.Data[0].5) OTE(p28_di_slitter.ctrl_from_net) ,XIC(p00_vfd_slitter:I.Data[0].6) OTE(p28_di_slitter.ref_from_net) ,XIC(p00_vfd_slitter:I.Data[0].7) OTE(p28_di_slitter.at_reference) ];
					N: XIC(p01r02.fault.15)FLL(0,p00_vfd_slitter:I.Data[0],4);
					RC: "Analog";
					N: OTE(p28r03.comment.5);
					RC: "VFD$N"
					    "";
					N: SYS_RPM_TO_SPEED(p28r03_slitter_speed_fb,p28r04_slitter_gear_ratio,p28r04_slitter_roll_diameter_ft,p00_vfd_slitter:I.Data[1],p28_ai_slitter_speed);
					N: CPT(p28_ai_slitter_amps,p00_vfd_slitter:I.Data[2]*0.1);
					N: SYS_SCP(p28r03_hz,p00_vfd_slitter:I.Data[1],0,1800,0,60,p28_ai_slitter_hz);
					RC: "Faults";
					N: OTE(p28r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p28r03.fault,p28r03.fault_ack);
					N: XIC(FAULT)[TON(p28r03_timer_fault[0],?,?) ,XIC(p28r03_timer_fault[0].DN) OTL(p28r03.fault.0) ];
					N: XIC(p28r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p28r03.fault.0) ,OTU(p28r03.fault_ack.0) ];
					N: NEQ(p28r03.fault,p28r03.fault_ack)OTE(p28r03.unack_fault);
					RC: "Warnings";
					N: OTE(p28r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p28r03.warning,p28r03.warning_ack);
					N: XIC(FAULT)[TON(p28r03_timer_warning[0],?,?) ,XIC(p28r03_timer_warning[0].DN) OTL(p28r03.warning.0) ];
					N: XIO(FAULT)[OTU(p28r03.warning.0) ,OTU(p28r03.warning_ack.0) ];
					N: NEQ(p28r03.warning,p28r03.warning_ack)OTE(p28r03.unack_warning);
					N: RET();
			END_ROUTINE

