			ROUTINE R10_Speed_Control 
					RC: "p25r10$N"
					    "This routine is called, continuously, from p25R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p25r10.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r10.comment (dint)$N"
					    "p25r10.oneshot (dint)$N"
					    "p25r10_timer_xxxx (timer)$N"
					    "p25r10_xxxx (any)$N"
					    "p25r10.fault (dint)$N"
					    "p25r10a_warnings (dint)$N"
					    "";
					N: OTE(p25r10.comment.1);
					RC: "Notes";
					N: OTE(p25r10.comment.2);
					RC: "Requests";
					N: OTE(p25r10.comment.3);
					N: CPT(p25r10_calc_speed_offset,p25_ai_speed-p25_ao_selected_speed);
					N: CPT(p25r10_pid_out,p25r10_calc_speed_offset/p25r10_param_psn_gain+50);
					N: [XIC(p01r13_line_slow_ramp) ,XIC(p01r13_line_running) ]OTE(p25r10_tension_request);
					N: XIO(p25r10_tension_request)OTE(p25r10_pid_manual_request);
					RC: "Configure PID$N"
					    "The tension loadcell feedback is compared to its setpoint in a PID control.$N"
					    "With the PID output at 50%, error is made to be 0$N"
					    "Error is added or subtracted to the speed of the previous drive to calculate the required speed of the drive.$N"
					    "A gain factor is used to dampen the error effect on the drive speed.";
					N: OTE(p25r10.comment.4);
					N: MOV(p25_ai_ts2_lc,p25r10_pid_psn_pv);
					N: MOV(p01_recipe_active.ts2_tension_sp,p25r10_pid_psn.SP);
					N: XIO(p25r10_tension_request)MOV(50,p25r10_pid_psn.SO);
					N: XIO(p25r10_tension_request)OTE(p25r10_pid_psn.SWM);
					N: OTE(p25r10_pid_psn.NOBC);
					N: MOV(p02_real_from_hmi.ts2[40],p25r10_pid_psn.KP)MOV(p02_real_from_hmi.ts2[41],p25r10_pid_psn.KI)MOV(p02_real_from_hmi.ts2[42],p25r10_pid_psn.KD);
					N: MOV(p25r10_pid_psn.BIAS,p25r10_pid_psn.BIAS)PID(p25r10_pid_psn,p25r10_pid_psn_pv,0,p25r10_pid_psn_cv,p22r10_pid_psn,0,0);
					N: MOV(p25r10_param_psn_gain,p25r10_param_psn_gain);
					RC: "Output Control";
					N: OTE(p25r10.comment.5);
					N: CPT(p25r10_speed_offset,(p25r10_pid_psn_cv-50)/p25r10_param_psn_gain*1);
					RC: "20260820 - Accumulator payout speed boost moved to p29r15 so that only the winder is overspeeded.  Tension Stand 2 now stays on its own tension PID.";
					N: NOP();
					RC: "Faults";
					N: OTE(p25r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r10.fault,p25r10.fault_ack);
					N: XIC(FAULT)[TON(p25r10_timer_fault[0],?,?) ,XIC(p25r10_timer_fault[0].DN) OTL(p25r10.fault.0) ];
					N: XIC(p25r10.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r10.fault.0) ,OTU(p25r10.fault_ack.0) ];
					N: NEQ(p25r10.fault,p25r10.fault_ack)OTE(p25r10.unack_fault);
					RC: "Warnings";
					N: OTE(p25r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r10.warning,p25r10.warning_ack);
					N: XIC(FAULT)[TON(p25r10_timer_warning[0],?,?) ,XIC(p25r10_timer_warning[0].DN) OTL(p25r10.warning.0) ];
					N: XIO(FAULT)[OTU(p25r10.warning.0) ,OTU(p25r10.warning_ack.0) ];
					N: NEQ(p25r10.warning,p25r10.warning_ack)OTE(p25r10.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R11_VFD 
					RC: "p25r11$N"
					    "This routine is called, continuously, from p25R01 Main while the plc is in Run mode.$N"
					    "";
					N: SBR()OTE(p25r11.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p25r11.comment (dint)$N"
					    "p25r11.oneshot (dint)$N"
					    "p25r11_timer_xxxx (timer)$N"
					    "p25r11_xxxx (any)$N"
					    "p25r11.fault (dint)$N"
					    "p25r11a_warnings (dint)$N"
					    "";
					N: OTE(p25r11.comment.1);
					N: XIC(p01r13_permissive_drives)XIC(p01r13_state.1)OTE(p25r11_permissive_jog_thread);
					RC: "Notes$N"
					    "";
					N: OTE(p25r11.comment.2);
					RC: "Requests";
					N: OTE(p25r11.comment.3);
					N: XIC(p01r13_permissive_drives)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]OTE(p25r11_request_line_run);
					N: XIC(p01r09_request_line_jog)OTE(p25r11_request_line_jog);
					N: XIC(p25r11_permissive_jog_thread)XIC(p22r09_mode_thread)XIC(p25r09_mode_thread)[XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ][XIC(p25r09_pb_jog_fwd) XIC(p25r11_at_zero) ,XIC(p25r11_request_thread_fwd) XIO(p25r11_at_zero) ]OTE(p25r11_request_thread_fwd);
					N: XIC(p25r11_permissive_jog_thread)XIC(p22r09_mode_thread)XIC(p25r09_mode_thread)[XIC(p20r15_loa_on) ,XIC(p20r16_lob_on) ][XIC(p25r09_pb_jog_rev) XIC(p25r11_at_zero) ,XIC(p25r11_request_thread_rev) XIO(p25r11_at_zero) ]OTE(p25r11_request_thread_rev);
					N: XIC(p25r11_permissive_jog_thread)XIC(p25r09_mode_jog)[XIC(p25r09_pb_jog_fwd) XIC(p25r11_at_zero) ,XIC(p25r11_request_jog_fwd) XIO(p25r11_at_zero) ]OTE(p25r11_request_jog_fwd);
					N: XIC(p25r11_permissive_jog_thread)XIC(p25r09_mode_jog)[XIC(p25r09_pb_jog_rev) XIC(p25r11_at_zero) ,XIC(p25r11_request_jog_rev) XIO(p25r11_at_zero) ]OTE(p25r11_request_jog_rev);
					N: EQU(p25_ao_selected_speed,0)OTE(p25r11_at_zero);
					RC: "Sequencer";
					N: NOP();
					RC: "Sequencer Conditions";
					N: NOP();
					RC: "Outputs";
					N: OTE(p25r11.comment.5);
					N: ABB_PROTOCOL_VFD(p25_ts2_vfd,p25_status_word,p25_control_word,p25r11_vfd_start_request,p01r09_pb_global_reset,p01r13_permissive_drives);
					N: [XIC(p25r11_request_line_run) ,XIC(p25r11_request_line_jog) ,XIC(p25r11_request_jog_fwd) ,XIC(p25r11_request_thread_fwd) ,XIC(p25r11_request_jog_rev) ,XIC(p25r11_request_thread_rev) ]OTE(p25r11_vfd_start_request);
					RC: "Torque Control";
					N: NOP();
					N: MOV(p25_ai_torque,p25_ai_torque);
					N: MOV(300,p25_ao_torque);
					RC: "Speed Control";
					N: OTE(p25r11.comment.6);
					N: [XIC(p25r11_request_line_run) ,XIC(p25r11_request_thread_fwd) ]MOV(p01r12_master_ramped_speed,p25_ao_selected_speed);
					N: XIC(p25r11_request_thread_rev)CPT(p25_ao_selected_speed,p01r12_master_ramped_speed*-1);
					N: XIC(p25r11_request_jog_fwd)XIC(p25r09_pb_jog_fwd)CPT(p25r11_selected_speed,p25_param_ts2_jog_speed*1);
					N: XIC(p25r11_request_jog_rev)XIC(p25r09_pb_jog_rev)CPT(p25r11_selected_speed,p25_param_ts2_jog_speed*-1);
					N: [XIC(p25r11_request_jog_fwd) XIO(p25r09_pb_jog_fwd) ,XIC(p25r11_request_jog_rev) XIO(p25r09_pb_jog_rev) ]MOV(0,p25r11_selected_speed);
					N: XIO(p25r11_request_line_run)XIO(p25r11_request_thread_fwd)XIO(p25r11_request_thread_rev)XIO(p01r09_request_line_jog)SYS_ACC_DEC_RAMP(p25r11_acc_decel_ramp,p25r11_selected_speed,p25_ts2_acc_rate,p25_ts2_decel_rate,p01r02_plc_scan_time_in_sec,p25_ao_selected_speed);
					N: XIC(p25r11_request_line_run)[XIO(p01r09_stretch_mode) [GRT(p25r10_speed_offset,p25_ao_selected_speed) MOV(p25_ao_selected_speed,p25r10_speed_offset) ,CPT(p25_ao_selected_speed,p01r12_master_ramped_speed+p25r10_speed_offset) ] ,XIC(p01r09_stretch_mode) MOV(p01r12_master_ramped_speed,p25_ao_selected_speed) ];
					N: [XIO(p25r11_request_line_run) XIO(p25r11_request_jog_fwd) XIO(p25r11_request_jog_rev) XIO(p01r09_request_line_jog) XIO(p25r11_request_thread_fwd) XIO(p25r11_request_thread_rev) ,XIO(p01r13_permissive_drives) ]MOV(0,p25_ao_selected_speed);
					RC: "Faults";
					N: OTE(p25r11.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r11.fault,p25r11.fault_ack);
					N: XIC(p25_status_word.3)[TON(p25r11_timer_fault[0],?,?) ,XIC(p25r11_timer_fault[0].DN) OTL(p25r11.fault.0) ];
					N: XIC(p25r11.fault_ack.0)XIO(p25_status_word.3)XIC(p01r09_pb_global_reset)[OTU(p25r11.fault.0) ,OTU(p25r11.fault_ack.0) ];
					N: XIC(FAULT)[TON(p25r11_timer_fault[1],?,?) ,XIC(p25r11_timer_fault[1].DN) OTL(p25r11.fault.1) ];
					N: XIC(p25r11.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r11.fault.1) ,OTU(p25r11.fault_ack.1) ];
					N: XIO(p25_status_word.0)[TON(p25r11_timer_fault[2],?,?) ,XIC(p25r11_timer_fault[2].DN) OTL(p25r11.fault.2) ];
					N: XIC(p25r11.fault_ack.2)XIC(p25_status_word.0)XIC(p01r09_pb_global_reset)[OTU(p25r11.fault.2) ,OTU(p25r11.fault_ack.2) ];
					N: XIC(p25_status_word.1)XIO(p25_status_word.9)[TON(p25r11_timer_fault[3],?,?) ,XIC(p25r11_timer_fault[3].DN) OTL(p25r11.fault.3) ];
					N: XIC(p25r11.fault_ack.3)[XIC(p25_status_word.9) ,XIO(p25_status_word.1) ]XIC(p01r09_pb_global_reset)[OTU(p25r11.fault.3) ,OTU(p25r11.fault_ack.3) ];
					N: XIO(p25_di_therm)[TON(p25r11_timer_fault[4],?,?) ,XIC(p25r11_timer_fault[4].DN) OTL(p25r11.fault.4) ];
					N: XIC(p25r11.fault_ack.4)XIC(p25_di_therm)XIC(p01r09_pb_global_reset)[OTU(p25r11.fault.4) ,OTU(p25r11.fault_ack.4) ];
					N: XIO(p25_di_brake)[TON(p25r11_timer_fault[5],?,?) ,XIC(p25r11_timer_fault[5].DN) OTL(p25r11.fault.5) ];
					N: XIC(p25r11.fault_ack.5)XIC(p25_di_brake)XIC(p01r09_pb_global_reset)[OTU(p25r11.fault.5) ,OTU(p25r11.fault_ack.5) ];
					N: NEQ(p25r11.fault,p25r11.fault_ack)OTE(p25r11.unack_fault);
					RC: "Warnings$N"
					    "These warnings will stop the line";
					N: OTE(p25r11.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r11.warning,p25r11.warning_ack);
					N: XIC(p25_status_word.7)[TON(p25r11_timer_warning[0],?,?) ,XIC(p25r11_timer_warning[0].DN) OTL(p25r11.warning.0) ];
					N: XIC(p25r11.warning_ack.0)XIO(p25_status_word.7)[OTU(p25r11.warning.0) ,OTU(p25r11.warning_ack.0) ];
					N: XIC(p25_ts2_vfd.OUT_ENABLED)LES(p25_ai_ts2_lc,p25r02_tension_dev_min)[TON(p25r11_timer_warning[1],?,?) ,XIC(p25r11_timer_warning[1].DN) OTL(p25r11.warning.1) ];
					N: [GEQ(p25_ai_ts2_lc,p25r02_tension_dev_min) ,XIO(p25_ts2_vfd.OUT_ENABLED) ]OTU(p25r11.warning.1);
					N: XIC(p25_ts2_vfd.OUT_ENABLED)GRT(p25_ai_ts2_lc,p25r02_tension_dev_max)[TON(p25r11_timer_warning[2],?,?) ,XIC(p25r11_timer_warning[2].DN) OTL(p25r11.warning.2) ];
					N: XIO(p25_ts2_vfd.OUT_ENABLED)LEQ(p25_ai_ts2_lc,p25r02_tension_dev_max)OTU(p25r11.warning.2);
					N: XIC(FAULT)[TON(p25r11_timer_warning[3],?,?) ,XIC(p25r11_timer_warning[3].DN) OTL(p25r11.warning.3) ];
					N: XIO(FAULT)[OTU(p25r11.warning.3) ,OTU(p25r11.warning_ack.3) ];
					N: NEQ(p25r11.warning,p25r11.warning_ack)OTE(p25r11.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P26_Upper_Poly_Letoff (MAIN := "R01_Main",
	                               MODE := 0,
	                               DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					RC: "p26R01 System Main$N"
					    "$N"
					    "This routine is called, continuously, from p26 System while the plc is in Run mode.  All other p26 System routines are called from this routine.";
					N: OTE(p26r01.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p26r01.comment (dint)$N"
					    "p26r01.oneshot (dint)$N"
					    "p26r01_timer_xxxx (timer)$N"
					    "p26r01_xxxx (any)$N"
					    "p26r01.fault (dint)$N"
					    "p26r01a_warnings (dint)$N"
					    "";
					N: OTE(p26r01.comment.1);
					RC: "Notes";
					N: OTE(p26r01.comment.2);
					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Tension_A,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

			ROUTINE R02_Misc_Control 
					RC: "p26R02$N"
					    "This routine is called, continuously, from p26R01 Main while the plc is in Run mode.";
					N: SBR()OTE(p26r02.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p26r02.comment (dint)$N"
					    "p26r02.oneshot (dint)$N"
					    "p26r02_timer_xxxx (timer)$N"
					    "p26r02_xxxx (any)$N"
					    "p26r02.fault (dint)$N"
					    "p26r02a_warnings (dint)$N"
					    "";
					N: OTE(p26r02.comment.1);
					RC: "Notes";
					N: OTE(p26r02.comment.2);
					N: NEQ(p26_dint_to_hmi[2],0)OTE(p26r02_fault_exists);
					N: NEQ(p26_dint_to_hmi[4],0)OTE(p26r02_warning_exists);
					RC: "Requests";
					N: OTE(p26r02.comment.3);
					N: [XIC(p26r02.unack_fault) ,XIC(p26r03.unack_fault) ,XIC(p26r04.unack_fault) ,XIC(p26r05.unack_fault) ,XIC(p26r06.unack_fault) ,XIC(p26r07.unack_fault) ,XIC(p26r08.unack_fault) ,XIC(p26r09.unack_fault) ,XIC(p26r10.unack_fault) ]OTE(p26r02_unack_fault);
					N: [XIC(p26r02.unack_warning) ,XIC(p26r03.unack_warning) ,XIC(p26r04.unack_warning) ,XIC(p26r05.unack_warning) ,XIC(p26r06.unack_warning) ,XIC(p26r07.unack_warning) ,XIC(p26r08.unack_warning) ,XIC(p26r09.unack_warning) ,XIC(p26r10.unack_warning) ]OTE(p26r02_unack_warning);
					RC: "Sequence";
					N: OTE(p26r02.comment.4);
					RC: "Output Control";
					N: OTE(p26r02.comment.5);
					RC: "Faults";
					N: OTE(p26r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p26r02.fault,p26r02.fault_ack);
					N: XIC(FAULT)[TON(p26r02_timer_fault[0],?,?) ,XIC(p26r02_timer_fault[0].DN) OTL(p26r02.fault.0) ];
					N: XIC(p26r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p26r02.fault.0) ,OTU(p26r02.fault_ack.0) ];
					N: NEQ(p26r02.fault,p26r02.fault_ack)OTE(p26r02.unack_fault);
					RC: "Warnings";
					N: OTE(p26r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p26r02.warning,p26r02.warning_ack);
					N: XIC(FAULT)[TON(p26r02_timer_warning[0],?,?) ,XIC(p26r02_timer_warning[0].DN) OTL(p26r02.warning.0) ];
					N: XIO(FAULT)[OTU(p26r02.warning.0) ,OTU(p26r02.warning_ack.0) ];
					N: NEQ(p26r02.warning,p26r02.warning_ack)OTE(p26r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					RC: "p26r03$N"
					    "This routine is called, continuously, from p26r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p26r03.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p26r03.comment (dint)$N"
					    "p26r03.oneshot (dint)$N"
					    "p26r03_timer_xxxx (timer)$N"
					    "p26r03_xxxx (any)$N"
					    "p26r03.fault (dint)$N"
					    "p26r03.warning (dint)$N"
					    "";
					N: OTE(p26r03.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p26r03.comment.2);
					RC: "Digital";
					N: OTE(p26r03.comment.3);
					N: [XIC(p00_io_winder:5:I.1) OTE(p26r03_upper_A_tension_on) ,XIC(p00_io_winder:5:I.0) OTE(p26r03_upper_B_tension_on) ];
					RC: "Analog";
					N: OTE(p26r03.comment.4);
					N: SYS_SCP(p26r03_ltf_a_sensor_scp,p00_io_winder:2:I.Ch0Data,p26_ltf_a_sensor_input_min,p26_ltf_a_sensor_input_max,p26_ltf_a_sensor_output_min,p26_ltf_a_sensor_output_max,p26r03_ai_dia_a_sensor);
					N: SUB(p26r03_upper_poly_a_distance,p26r03_ai_dia_a_sensor,p26r03_a_radius)CPT(p26_ao_dia_a,p26r03_a_radius*2);
					N: SYS_SCP(p26r03_ltf_b_sensor_scp,p00_io_winder:2:I.Ch1Data,p26_ltf_b_sensor_input_min,p26_ltf_b_sensor_input_max,p26_ltf_b_sensor_output_min,p26_ltf_b_sensor_output_max,p26r03_ai_dia_b_sensor);
					N: SUB(p26r03_upper_poly_b_distance,p26r03_ai_dia_b_sensor,p26r03_b_radius)CPT(p26_ao_dia_b,p26r03_b_radius*2);
					RC: "VFD";
					N: OTE(p26r03.comment.5);
					RC: "Faults";
					N: OTE(p26r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p26r03.fault,p26r03.fault_ack);
					N: XIC(FAULT)[TON(p26r03_timer_fault[0],?,?) ,XIC(p26r03_timer_fault[0].DN) OTL(p26r03.fault.0) ];
					N: XIC(p26r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p26r03.fault.0) ,OTU(p26r03.fault_ack.0) ];
					N: NEQ(p26r03.fault,p26r03.fault_ack)OTE(p26r03.unack_fault);
					RC: "Warnings";
					N: OTE(p26r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p26r03.warning,p26r03.warning_ack);
					N: XIC(FAULT)[TON(p26r03_timer_warning[0],?,?) ,XIC(p26r03_timer_warning[0].DN) OTL(p26r03.warning.0) ];
					N: XIO(FAULT)[OTU(p26r03.warning.0) ,OTU(p26r03.warning_ack.0) ];
					N: NEQ(p26r03.warning,p26r03.warning_ack)OTE(p26r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					RC: "p26r04$N"
					    "This routine is called, continuously, from p26r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p26r04.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p26r04.comment (dint)$N"
					    "p26r04.oneshot (dint)$N"
					    "p26r04_timer_xxxx (timer)$N"
					    "p26r04_xxxx (any)$N"
					    "p26r04.fault (dint)$N"
					    "p26r04.warning (dint)$N"
					    "";
					N: OTE(p26r04.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p26r04.comment.2);
					RC: "Digital";
					N: OTE(p26r04.comment.3);
					RC: "Analog";
					N: OTE(p26r04.comment.4);
					N: SYS_SCP(p26r04_ula_prs_scp,p26_ao_dia_a,p26_ula_prs_input_min,p26_ula_prs_input_max,p26_ula_prs_output_min,p26_ula_prs_output_max,p00_io_winder:0:O.Ch2Data)CPT(p00_io_winder:0:O.Ch2Data,p26r10_ula_selected_tension/22.0*p00_io_winder:0:O.Ch2Data);
					N: SYS_SCP(p26r04_ulb_prs_scp,p26_ao_dia_b,p26_ulb_prs_input_min,p26_ulb_prs_input_max,p26_ulb_prs_output_min,p26_ulb_prs_output_max,p00_io_winder:0:O.Ch0Data)CPT(p00_io_winder:0:O.Ch0Data,p26r10_ulb_selected_tension/22.0*p00_io_winder:0:O.Ch0Data);
					RC: "VFD";
					N: OTE(p26r04.comment.5);
					RC: "Faults";
					N: OTE(p26r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p26r04.fault,p26r04.fault_ack);
