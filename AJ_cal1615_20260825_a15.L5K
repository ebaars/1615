					N: NEQ(p28r04.fault,p28r04.fault_ack)OTE(p28r04.unack_fault);
					RC: "Warnings";
					N: OTE(p28r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p28r04.warning,p28r04.warning_ack);
					N: XIC(FAULT)[TON(p28r04_timer_warning[0],?,?) ,XIC(p28r04_timer_warning[0].DN) OTL(p28r04.warning.0) ];
					N: XIO(FAULT)[OTU(p28r04.warning.0) ,OTU(p28r04.warning_ack.0) ];
					N: NEQ(p28r04.warning,p28r04.warning_ack)OTE(p28r04.unack_warning);
					N: RET();
			END_ROUTINE

