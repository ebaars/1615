					N: [XIC(p25_di_ts2.faulted) OTE(p25_dint_to_hmi[0].12) ,XIC(p25_di_ts2.warning) OTE(p25_dint_to_hmi[0].13) ,XIC(p25_di_ts2.running_fwd) OTE(p25_dint_to_hmi[0].14) ,XIC(p25_di_ts2.running_rev) OTE(p25_dint_to_hmi[0].15) ];
					N: [XIC(p25_di_ts2.ready) OTE(p25_dint_to_hmi[0].16) ,XIC(p25_di_ts2.ctrl_from_net) OTE(p25_dint_to_hmi[0].17) ,XIC(p25_di_ts2.ref_from_net) OTE(p25_dint_to_hmi[0].18) ,XIC(p25_di_ts2.at_reference) OTE(p25_dint_to_hmi[0].19) ];
					N: MOV(p25_status_word,p25_dint_to_hmi[1]);
					N: [XIC(HMI) OTE(p25_dint_to_hmi[6].0) ,XIC(HMI) OTE(p25_dint_to_hmi[6].1) ,XIC(HMI) OTE(p25_dint_to_hmi[6].2) ,XIC(HMI) OTE(p25_dint_to_hmi[6].3) ];
