	ADD_ON_INSTRUCTION_DEFINITION sys_Ramp (Description := "System Block$NRamp",
	                                        Revision := "1.0",
	                                        Vendor := "Rockwell Automation",
	                                        ExecutePrescan := No,
	                                        ExecutePostscan := No,
	                                        ExecuteEnableInFalse := No,
	                                        CreatedDate := "2025-12-23T14:55:59.511Z",
	                                        CreatedBy := "LITZLER\TSG",
	                                        EditedDate := "2025-12-23T14:57:25.104Z",
	                                        EditedBy := "LITZLER\TSG",
	                                        SoftwareRevision := "v16.03")
		
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			IN_accel_rate : REAL (Description := "Input Parameter$NAccel Ramp$Nx/second",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			IN_decel_rate : REAL (Description := "Input Parameter$NDecel Ramp$Nx/second",
			                         Usage := Input,
			                         RADIX := Float,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0.00000000e+000);
			IN_last_scan_s : REAL (Description := "Input Parameter$NLast Scan $Nseconds",
			                          Usage := Input,
			                          RADIX := Float,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0.00000000e+000);
			IN_OUT_ramped_setpoint : REAL (Description := "Input Output Parameter$NRamped Setpoint",
			                                  Usage := InOut,
			                                  RADIX := Float,
			                                  Required := Yes,
			                                  Visible := Yes);
			IN_target_setpoint : REAL (Description := "Input Parameter$NTargetet Setpoint",
			                              Usage := Input,
			                              RADIX := Float,
			                              Required := Yes,
			                              Visible := Yes,
			                              DefaultData := 0.00000000e+000);
		END_PARAMETERS

		LOCAL_TAGS
			local_last_scan_ms : DINT (RADIX := Decimal,
			                             ExternalAccess := Read/Write,
			                             DefaultData := 0);
			p01r03_last_scan_ms : DINT (RADIX := Decimal,
			                              ExternalAccess := Read/Write,
			                              DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: LEQ(IN_OUT_ramped_setpoint,IN_target_setpoint)[CPT(IN_OUT_ramped_setpoint,IN_OUT_ramped_setpoint+(IN_accel_rate*(IN_last_scan_s))) ,GRT(IN_OUT_ramped_setpoint,IN_target_setpoint) MOV(IN_target_setpoint,IN_OUT_ramped_setpoint) ];
				N: GRT(IN_OUT_ramped_setpoint,IN_target_setpoint)[CPT(IN_OUT_ramped_setpoint,IN_OUT_ramped_setpoint-(IN_decel_rate*(IN_last_scan_s))) ,LES(IN_OUT_ramped_setpoint,IN_target_setpoint) MOV(IN_target_setpoint,IN_OUT_ramped_setpoint) ];
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

