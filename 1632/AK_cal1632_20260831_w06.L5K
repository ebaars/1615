					N: XIC(p01r09_pb_global_reset)MOV(p30r10.fault,p30r10.fault_ack);
					N: XIC(p30_di_rotation_fault)[TON(p30r10_timer_fault[0],?,?) ,XIC(p30r10_timer_fault[0].DN) OTL(p30r10.fault.0) ];
					N: XIC(p30r10.fault_ack.0)XIO(p30_di_rotation_fault)XIC(p01r09_pb_global_reset)[OTU(p30r10.fault.0) ,OTU(p30r10.fault_ack.0) ];
					N: XIC(AFI)[TON(p30r10_timer_fault[1],?,?) ,XIC(p30r10_timer_fault[1].DN) OTL(p30r10.fault.1) ];
					N: XIC(p30r10.fault_ack.1)XIO(AFI)XIC(p01r09_pb_global_reset)[OTU(p30r10.fault.1) ,OTU(p30r10.fault_ack.1) ];
					N: NEQ(p30r10.fault,p30r10.fault_ack)OTE(p30r10.unack_fault);
					N: OTE(p30r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p30r10.warning,p30r10.warning_ack);
					N: XIO(p30r10_safety_pins_stowed)[TON(p30r10_timer_warning[0],?,?) ,XIC(p30r10_timer_warning[0].DN) OTL(p30r10.warning.0) ];
					N: XIC(p30r10.warning_ack.0)XIC(p30r10_safety_pins_stowed)[OTU(p30r10.warning.0) ,OTU(p30r10.warning_ack.0) ];
					N: NEQ(p30r10.warning,p30r10.warning_ack)OTE(p30r10.unack_warning);
					N: RET();
