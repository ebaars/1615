			ROUTINE R10_Annunciators 
					RC: "p01r04$N"
					    "This routine is called continuously from p01r01 Main while the plc is in Run mode.";
					N: SBR()OTE(p01r10.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p01r04.comment (dint)$N"
					    "p01r04.oneshot (dint)$N"
					    "p01r04_timer_xxxx (timer)$N"
					    "p01r04_xxxx (any)$N"
					    "p01r04.fault (dint)$N"
					    "p01r04.warning (dint)$N"
					    "";
					N: OTE(p01r10.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p01r10.comment.2);
					RC: "Requests";
					N: OTE(p01r10.comment.3);
					N: XIC(p01r02_unack_fault)OTE(p01r10_unack_fault.0);
					N: [XIC(p11r02_unack_fault) ,XIC(p12r02_unack_fault) ,XIC(p13r02_unack_fault) ]OTE(p01r10_unack_fault.1);
					N: [XIC(p20r02_unack_fault) ,XIC(p21r02_unack_fault) ,XIC(p22r02_unack_fault) ,XIC(p23r02_unack_fault) ,XIC(p24r02_unack_fault) ,XIC(p25r02_unack_fault) ]OTE(p01r10_unack_fault.2);
					N: [XIC(p26r02_unack_fault) ,XIC(p27r02_unack_fault) ,XIC(p28r02_unack_fault) ,XIC(p29r02_unack_fault) ,XIC(p00_wac.OUT_Unack_Alarm) ]OTE(p01r10_unack_fault.3);
					N: NEQ(p01r10_unack_fault,0)OTE(p01r10_unack_fault_ex);
					RC: "Unacknowledge Warnings";
					N: OTE(p01r10.comment.5);
					N: XIC(p01r02_unack_warning)OTE(p01r10_unack_warning.0);
					N: [XIC(p11r02_unack_warning) ,XIC(p12r02_unack_warning) ,XIC(p13r02_unack_warning) ,XIC(p19r02_unack_warning) ]OTE(p01r10_unack_warning.1);
					N: [XIC(p20r02_unack_warning) ,XIC(p21r02_unack_warning) ,XIC(p22r02_unack_warning) ,XIC(p23r02_unack_warning) ,XIC(p24r02_unack_warning) ]OTE(p01r10_unack_warning.2);
					N: [XIC(p25r02_unack_warning) ,XIC(p26r02_unack_warning) ,XIC(p27r02_unack_warning) ,XIC(p28r02_unack_warning) ,XIC(p29r02_unack_warning) ,XIC(p00_wac.OUT_Unack_Warning) ]OTE(p01r10_unack_warning.3);
					N: NEQ(p01r10_unack_warning,0)OTE(p01r10_unack_warn_ex);
					RC: "Output Control";
					N: OTE(p01r10.comment.6);
					N: [XIC(p01r02_fault_exists) ,XIC(p11r02_fault_exists) ,XIC(p12r02_fault_exists) ,XIC(p13r02_fault_exists) ,XIC(p19r02_fault_exists) ,XIC(p20r02_fault_exists) ,XIC(p21r02_fault_exists) ,XIC(p22r02_fault_exists) ,XIC(p23r02_fault_exists) ]OTE(p01r10_fault_exists);
					N: [XIC(p01r10_fault_exists) ,XIC(p24r02_fault_exists) ,XIC(p25r02_fault_exists) ,XIC(p26r02_fault_exists) ,XIC(p27r02_fault_exists) ,XIC(p28r02_fault_exists) ,XIC(p29r02_fault_exists) ,XIC(p00_wac.OUT_Alarm) ,XIC(p30r02_fault_exists) ]OTE(p01r10_fault_exists);
					N: [XIC(p01r02_warnings_exists) ,XIC(p11r02_warning_exists) ,XIC(p12r02_warning_exists) ,XIC(p13r02_warning_exists) ,XIC(p19r02_warning_exists) ,XIC(p20r02_warning_exists) ,XIC(p21r02_warning_exists) ,XIC(p22r02_warning_exists) ]OTE(p01r10_warning_exists);
					N: [XIC(p01r10_warning_exists) ,XIC(p23r02_warning_exists) ,XIC(p24r02_warning_exists) ,XIC(p25r02_warning_exists) ,XIC(p26r02_warning_exists) ,XIC(p27r02_warning_exists) ,XIC(p28r02_warning_exists) ,XIC(p29r02_warning_exists) ,XIC(p00_wac.OUT_Warning) ,XIC(p30r02_warning_exists) ]OTE(p01r10_warning_exists);
					RC: "Sequence";
					N: OTE(p01r10.comment.4);
					RC: "Output Control";
					N: OTE(p01r10.comment.7);
					N: [XIC(p01r13_permissive_drives) XIC(p01r13_permissive_line_run) XIC(p01r02_timer_second[0].TT) ,GEQ(p01r13_status,2) LEQ(p01r13_status,8) ]OTE(p01r02_do_green_stack_light_LINE);
					N: XIC(p01r10_unack_warn_ex)XIC(p01r02_timer_second[0].TT)OTE(p01r02_do_yellow_stack_light_LINE);
					N: XIC(p01r10_unack_fault_ex)OTE(p01r02_do_red_stack_light_LINE);
					N: [XIC(p01r10_unack_fault_ex) ,XIC(p01r10_unack_warn_ex) XIC(p01r02_timer_second[0].TT) ]OTE(p01r02_do_buzzer_LINE);
					N: XIO(p11r30.warning.4)XIO(p12r30.warning.4)XIO(p23r02.warning.0)XIO(p01r02_do_red_stack_light)OTE(p01r02_do_green_stack_light_lel);
					N: XIO(p01r02_do_red_stack_light)[XIC(p11r30.warning.4) ,XIC(p12r30.warning.4) ,XIC(p23r02.warning.0) ]XIC(p01r02_timer_second[0].TT)OTE(p01r02_do_yellow_stack_light);
					N: [XIC(p11r30.fault.4) ,XIC(p12r30.fault.4) ,XIC(p23r02.fault.0) ]OTE(p01r02_do_red_stack_light);
					N: [[XIC(p01r02_do_yellow_stack_light) ONS(p01r10.oneshot.1) XIC(p01r02_timer_second[0].TT) ,XIC(p01r02_do_red_stack_light) ONS(p01r10.oneshot.2) ] ,XIC(p01r02_do_buzzer) XIO(p01r09_pb_global_reset) ]OTE(p01r02_do_buzzer);
					N: [[XIC(p01r13_state.3) ONS(p01r10.oneshot.0) ,XIC(p01r02_do_buzzer) ] ,XIC(p01r02_do_horn) XIO(p01r02_do_buzzer) XIO(p01r09_pb_global_reset) XIO(p01r13_state.4) ]OTE(p01r02_do_horn);
					RC: "Faults";
					N: OTE(p01r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p01r10.fault,p01r10.fault_ack);
					N: XIC(FAULT)[TON(p01r10_timer_fault[0],?,?) ,XIC(p01r10_timer_fault[0].DN) OTL(p01r10.fault.0) ];
					N: XIC(p01r10.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p01r10.fault.0) ,OTU(p01r10.fault_ack.0) ];
					N: NEQ(p01r10.fault,p01r10.fault_ack)OTE(p01r10.unack_fault);
					RC: "Warnings";
					N: OTE(p01r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p01r10.warning,p01r10.warning_ack);
					N: XIC(FAULT)[TON(p01r10_timer_warning[0],?,?) ,XIC(p01r10_timer_warning[0].DN) OTL(p01r10.warning.0) ];
					N: XIO(FAULT)[OTU(p01r10.warning.0) ,OTU(p01r10.warning_ack.0) ];
					N: NEQ(p01r10.warning,p01r10.warning_ack)OTE(p01r10.unack_warning);
					RC: "Flash Timers";
					N: NOP();
					N: [XIO(tmrFlash[0].DN) ,XIC(tmrFlash[1].TT) ]TON(tmrFlash[0],?,?);
					N: XIO(tmrFlash[1].DN)XIC(tmrFlash[0].DN)TON(tmrFlash[1],?,?);
					N: XIC(tmrFlash[1].TT)OTE(p00_FlashBit_1Sec);
					N: [XIO(tmrFlash[2].DN) ,XIC(tmrFlash[3].TT) ]TON(tmrFlash[2],?,?);
					N: XIC(tmrFlash[2].DN)XIO(tmrFlash[3].DN)TON(tmrFlash[3],?,?);
					N: XIC(tmrFlash[3].TT)OTE(FlashBit_500MSec);
					N: RET();
			END_ROUTINE

