			P02_MOP_HMI_Iface;
			P11_Zone_1;
			P12_Zone_2;
			P13_Zone_3;
			P19_Advanced_Cooling;
			P20_Letoff;
			P21_Splice_Press;
			P22_Tension_Stand_1;
			P23_Impreg;
			P24_Edge_Control;
			P25_Tension_Stand_2;
			P26_Upper_Poly_Letoff;
			P27_Lower_Poly_Letoff;
			P28_Slitter;
			P29_Winder;
			P30_Retraction_System;
			P31_WAC;
	END_TASK

