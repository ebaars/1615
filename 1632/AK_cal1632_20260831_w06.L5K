			ROUTINE R00_Main (Description := "Winder Accumulator$NMain")
					RC: "Windup  Accumulator$N"
					    "$N"
					    "This program is called, periodically while the plc is in Run mode.  All other routines are called from this routine.$N"
					    "";
					N: NOP();
					RC: "Notes";
					N: NOP();
					N: JSR(R01_Input,0);
					N: JSR(R03_Data_In,0);
					N: JSR(R11_Modes,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R22_Fill_Pressure,0);
					N: JSR(R21_Fill_Request,0);
					N: JSR(R31_Nip_Roll,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R04_Data_Out,0);
					N: JSR(R02_Output,0);
			END_ROUTINE

			ROUTINE R01_Input (Description := "Windup Accumulator$NInput")
					N: SBR()NOP();
					RC: "Notes:$N"
					    "";
					N: NOP();
					RC: "Analog";
					N: NOP();
					N: SYS_SCP(add_sys_scp,IN_ai_lpt01,463,18438,0,7620,ai_lpt01_raw)SYS_SCP(add_sys_scp,IN_ai_lpt01,463,18438,0,100,ai_lpt01_pct);
					N: MOV(param_filter,param_filter)sys_Filter(add_sys_filter_lpt,param_filter,ai_lpt01_pct,ai_pos01_pct_flt);
					RC: "LPT Validity - safe fallback$N"
					    "$N"
					    "Thirteen rungs in this program now key off ai_pos01_pct_flt:  the winder$N"
					    "speed trim, the outfeed nip, the fill request, the payout latch, the full$N"
					    "stop and the empty alarms.  It is a single point of failure and SYS_SCP$N"
					    "clamps its input, so a failed transmitter does not read as failed - it$N"
					    "reads as a perfectly plausible 0% or 100%.$N"
					    "$N"
					    "A broken wire is the dangerous direction:  clamped to 0% the trim goes to$N"
					    "-0.20 and the winder SLOWS, the accumulator fills faster, and wac_full_stop$N"
					    "never trips because position reads empty.  Only di_high_limit would catch$N"
					    "it, at the mechanical stop.$N"
					    "$N"
					    "So on A08 the position is forced to the park setpoint.  The trim then$N"
					    "computes zero and the winder tracks line speed, the nip stays open, and no$N"
					    "spurious full or empty is raised.  di_high_limit remains the hard backstop.$N"
					    "$N"
					    "ai_lpt01_pct keeps the unfiltered reading for diagnosis on the HMI.$N"
					    "$N"
					    "Rev 20260825 a09";
					N: XIC(A08)MOV(p29_param_acc_park_sp,ai_pos01_pct_flt);
					RC: "VFD";
					N: NOP();
					N: SYS_SCP(add_sys_scp,Local:3:I.Ch3Data,0,10000,0,300,ai_tension);
					N: MOV(param_sys_filter_lc01,param_sys_filter_lc01)sys_Filter(sys_filter,param_sys_filter_lc01,ai_tension,ai_ten01);
					N: RET();
			END_ROUTINE

			ROUTINE R02_Output (Description := "Windup Accumulator$NOutput")
					N: SBR()NOP();
					RC: "Notes:$N"
					    "";
					N: NOP();
					RC: "Analog";
					N: NOP();
					N: SYS_SCP(add_sys_scp,ao_prs01,0,145,4000,20000,OUT_ao_prs01)SYS_SCP(add_sys_scp,ao_prs02,0,145,4000,20000,OUT_ao_prs02);
					RC: "VFD";
					N: NOP();
					N: RET();
			END_ROUTINE

			ROUTINE R03_Data_In (Description := "Windup Accumulator$NData In")
					RC: "Data In$N"
					    "Data Input from Other Programs";
					N: SBR()NOP();
					RC: "Pushbuttons";
					N: NOP();
					RC: "Parameters";
					N: NOP();
					N: XIC(di_ss_acc_on)OTE(pb_acc_on);
					N: XIO(di_pb_line_stop)OTE(pb_stop_line);
					N: XIC(hmi_pb_enable_tension)OTE(pb_enable_tension);
					N: [XIC(pb0.31) ,XIC(p01r09_pb_global_reset) ]OTE(pb_reset);
					RC: "Winder Running - is a winder actually taking web?$N"
					    "$N"
					    "Mode aware.  In tension mode a winder is only taking web once its start$N"
					    "sequence has reached state .6, which is what p29r10 / p29r11 request_run$N"
					    "already require.  In torque mode the sequencer never leaves state .1, so$N"
					    "those bits are never set and the raw VFD run request has to be used$N"
					    "instead - otherwise winder_running would be permanently false in torque$N"
					    "mode and the accumulator would fill continuously.$N"
					    "$N"
					    "Consumed by the payout latch in R22 and the fill request in R21.$N"
					    "$N"
					    "Rev 20260820 a02";
					N: [XIO(p29r09_torque_mode) [XIC(p29r10_request_run) ,XIC(p29r11_request_run) ] ,XIC(p29r09_torque_mode) [XIC(p29r15_request_run) ,XIC(p29r16_request_run) ] ]OTE(winder_running);
					RC: "Output Control";
					N: NOP();
					RC: "Configuration Parameters";
					N: NOP();
					N: RET();
			END_ROUTINE

			ROUTINE R04_Data_Out (Description := "Windup Accumulator$NData Out")
					RC: "Data Out$N"
					    "Data Output to Other Programs";
					N: SBR()NOP();
					RC: "Output Control";
					N: NOP();
					N: XIO(A00)OTE(Me.OUT_Not_EStop);
					N: XIC(Me.OUT_Not_EStop)XIO(A05)XIO(A07)OTE(Me.OUT_Not_Fast_Stop);
					N: XIO(W06)XIO(wac_full_stop)XIO(wac_empty_stop)[XIO(pb_acc_on) ,XIO(nip_open_selected) ]OTE(Me.OUT_Not_Normal_Stop);
					N: [XIC(A06) ,XIC(A04) ]OTE(Me.OUT_Empty);
					N: [XIC(A07) ,XIC(A05) ]OTE(Me.OUT_Full);
					N: XIC(accumulator_state.2)OTE(Me.OUT_control_limit);
					N: XIC(accumulator_state.6)OTE(Me.OUT_Acc_Payout);
					N: [XIC(accumulator_state.3) ,XIC(accumulator_state.4) ]OTE(Me.OUT_Acc_Fill_Request);
					RC: "Clear the Pushbuttons from HMI";
					N: MOV(0,pb0)MOV(0,pb1);
					RC: "Output Control";
					N: NOP();
					N: XIC(unack_alarm)OTE(Me.OUT_Unack_Alarm);
					N: XIC(alarm_exists)OTE(Me.OUT_Alarm);
					N: XIC(unack_warning)OTE(Me.OUT_Unack_Warning);
					N: XIC(warning_exists)OTE(Me.OUT_Warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI (Description := "Windup  Accumulator$NDint to HMI")
					RC: "Notes:$N"
					    "";
					N: SBR()NOP();
					RC: "Inputs";
					N: NOP();
					RC: "Outputs";
					N: NOP();
					N: [XIC(do_carriage_lift_sol) OTE(hmi_dint[7].0) ,XIC(do_close_nip_sol) OTE(hmi_dint[7].1) ];
					RC: "Data";
					N: NOP();
					N: MOV(0,acc_status)[EQU(acc_fill_status,0) MOV(1,acc_status) ,CMP(ai_pos01_pct_flt>(acc_position_last+0.01)) MOV(2,acc_status) ,CMP(ai_pos01_pct_flt<(acc_position_last-0.01)) MOV(3,acc_status) ,MOV(ai_pos01_pct_flt,acc_position_last) ,XIC(alarm_exists) MOV(4,acc_status) ,XIO(alarm_exists) XIC(warning_exists) MOV(5,acc_status) ,XIC(Me.OUT_Full) MOV(6,acc_status) ,XIC(Me.OUT_Empty) MOV(7,acc_status) ];
					N: MOV(0,line_run_status)[XIO(Me.OUT_Not_EStop) MOV(1,line_run_status) ,XIC(Me.OUT_Not_EStop) XIO(Me.OUT_Not_Fast_Stop) MOV(2,line_run_status) ,XIC(Me.OUT_Not_EStop) XIC(Me.OUT_Not_Fast_Stop) XIO(Me.OUT_Not_Normal_Stop) MOV(3,line_run_status) ];
					N: MOV(0,hmi_dint[16])MOV(0,hmi_dint[17]);
					N: MOV(0,hmi_dint[18])MOV(0,hmi_dint[19]);
			END_ROUTINE

			ROUTINE R07_Alarms (Description := "Windup Accumulator$NAlarms")
					RC: "Alarms";
					N: SBR()NOP();
					N: XIC(di_pb_e_stop)[MOV(p00_lin_timer_pre_0ms,timer_alarm[0].PRE) ,TON(timer_alarm[0],?,?) ,XIC(timer_alarm[0].DN) OTL(A00) ];
					N: XIC(alm_ack[0].0)XIO(di_pb_e_stop)XIC(pb_reset)[OTU(A00) ,OTU(alm_ack[0].0) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[1].PRE) ,TON(timer_alarm[1],?,?) ,XIC(timer_alarm[1].DN) OTL(A01) ];
					N: XIC(alm_ack[0].1)XIO(AFI)XIC(pb_reset)[OTU(A01) ,OTU(alm_ack[0].1) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[2].PRE) ,TON(timer_alarm[2],?,?) ,XIC(timer_alarm[2].DN) OTL(A02) ];
					N: XIC(alm_ack[0].2)XIO(AFI)XIC(pb_reset)[OTU(A02) ,OTU(alm_ack[0].2) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[3].PRE) ,TON(timer_alarm[3],?,?) ,XIC(timer_alarm[3].DN) OTL(A03) ];
					N: XIC(alm_ack[0].3)XIO(AFI)XIC(pb_reset)[OTU(A03) ,OTU(alm_ack[0].3) ];
					RC: "A04 - Accumulator Empty with No Winder Running$N"
					    "$N"
					    "The old condition was XIO(p29r09_winder_a_active) XIO(p29r09_winder_b_active).$N"
					    "Those two are complementary - a_active is XIC(p29_di_wdr_a) and b_active is$N"
					    "XIO of the same input - so one of them is ALWAYS true and both false is$N"
					    "impossible.  A04 could never latch.$N"
					    "$N"
					    "The real test is the run requests.  Empty is normal while a winder is$N"
					    "taking web; empty with NOTHING taking web means the line is feeding into an$N"
					    "accumulator that is already on the bottom, so the line must stop.$N"
					    "$N"
					    "Gated on the line actually moving, with the standard 3 s dwell, so the$N"
					    "moment at line start - accumulator empty, winder not yet up - does not$N"
					    "trip it.$N"
					    "$N"
					    "wac_empty_stop is the non-latching line stop, mirroring wac_full_stop.  A04$N"
					    "is the annunciation and still needs an acknowledge.$N"
					    "$N"
					    "Rev 20260825 a16";
					N: [XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIO(p29r15_request_run)XIO(p29r16_request_run)LEQ(ai_pos01_pct_flt,param_empty_pct)[MOV(p00_lin_timer_pre_0ms,timer_alarm[4].PRE) ,TON(timer_alarm[4],?,?) ,XIC(timer_alarm[4].DN) OTL(A04) OTE(wac_empty_stop) ];
					N: XIC(alm_ack[0].4)[GRT(ai_pos01_pct_flt,param_empty_pct) ,XIC(p29r15_request_run) ,XIC(p29r16_request_run) ][OTU(A04) ,OTU(alm_ack[0].4) ];
					N: XIC(di_high_limit)[MOV(p00_lin_timer_pre_disc,timer_alarm[5].PRE) ,TON(timer_alarm[5],?,?) ,XIC(timer_alarm[5].DN) OTL(A05) ];
					N: XIO(di_high_limit)[OTU(A05) ,OTU(alm_ack[0].5) ];
					N: LEQ(ai_pos01_pct_flt,param_acc_min_limit)OTE(acc_empty_limit);
					N: XIO(p29r09_winder_a_active)XIO(p29r09_winder_b_active)XIC(acc_empty_limit)[MOV(p00_lin_timer_pre_1s,timer_alarm[6].PRE) ,TON(timer_alarm[6],?,?) ,XIC(timer_alarm[6].DN) OTL(A06) ];
					N: [XIO(acc_empty_limit) ,XIC(p29r09_winder_a_active) ,XIC(p29r09_winder_b_active) ][OTU(A06) ,OTU(alm_ack[0].6) ];
					N: GEQ(ai_pos01_pct_flt,param_acc_max_limit)OTE(acc_full_limit);
					N: XIC(acc_full_limit)[MOV(p00_lin_timer_pre_disc,timer_alarm[7].PRE) ,TON(timer_alarm[7],?,?) ,XIC(timer_alarm[7].DN) OTL(A07) ];
					RC: "Normal Stop Threshold - sized to the line decel$N"
					    "$N"
					    "The line decelerates at p01_param_master_decel (2.5 fpm/s), and it keeps$N"
					    "feeding the accumulator all the way down.  Web delivered during the stop is$N"
					    "$N"
					    "     V^2 / (120 x decel_rate)   ft$N"
					    "$N"
					    "which as a fraction of param_acc_capacity_ft is the stroke that MUST be$N"
					    "left free above the normal stop point, or the accumulator reaches its$N"
					    "mechanical limit before the line is stopped:$N"
					    "$N"
					    "      5 fpm    0.08 ft     0.8 % of stroke$N"
					    "     10 fpm    0.33 ft     3.3 %$N"
					    "     15 fpm    0.75 ft     7.5 %$N"
					    "     23 fpm    1.76 ft    17.6 %$N"
					    "     30 fpm    3.00 ft    30.0 %$N"
					    "$N"
					    "The old fixed 90% left only 7% of stroke, which is only enough below about$N"
					    "14 fpm.  Above that the line could not stop before the hard limit and the$N"
					    "fast stop always fired instead - which is exactly the steep stop this is$N"
					    "meant to avoid.$N"
					    "$N"
					    "A fixed lower threshold would fix 30 fpm but throw away a third of the$N"
					    "accumulator at 5 fpm, where the decel needs almost nothing.  So the reserve$N"
					    "is computed from the present line speed instead, and the threshold floats$N"
					    "with it - the full accumulator is available at creep, the protection is$N"
					    "there at full speed.$N"
					    "$N"
					    "Clamped between param_acc_handover_pct and param_acc_max_limit so a bad$N"
					    "speed or decel value can never push it outside the stroke.$N"
					    "$N"
					    "Rev 20260825 a10";
					N: LEQ(p01_param_master_decel,0)MOV(2.5,p01_param_master_decel);
					N: LEQ(param_acc_capacity_ft,0)MOV(10.0,param_acc_capacity_ft);
					N: CPT(acc_decel_reserve_pct,(p01r12_master_ramped_speed*p01r12_master_ramped_speed)/(120*p01_param_master_decel)/param_acc_capacity_ft*100);
					N: CPT(acc_norm_stop_pct,param_acc_max_limit-acc_decel_reserve_pct-param_acc_stop_margin_pct);
					N: sys_Limit_Clamp(clamp_norm_stop,param_acc_max_limit,param_acc_handover_pct,acc_norm_stop_pct);
					RC: "Normal stop latches at the computed threshold and self-clears one$N"
					    "hysteresis band below it.  Routed to Me.OUT_Not_Normal_Stop, so it$N"
					    "requests a controlled line stop and leaves the drives permitted.";
					N: GEQ(ai_pos01_pct_flt,acc_norm_stop_pct)OTL(wac_full_stop);
					N: LES(ai_pos01_pct_flt,acc_norm_stop_pct-param_acc_stop_hyst_pct)OTU(wac_full_stop);
					N: XIO(acc_full_limit)[OTU(A07) ,OTU(alm_ack[0].7) ];
					RC: "A08 - Accumulator Position Signal Fault$N"
					    "$N"
					    "Three independent tests, any one of which raises A08:$N"
					    "$N"
					    "  1  Raw counts outside param_lpt_raw_min / _max.  The SCP scales$N"
					    "     463-18438, so a broken wire reads under that and a short reads over.$N"
					    "     Caught BEFORE the SCP clamps it into a plausible value.$N"
					    "$N"
					    "  2  Frozen.  Only armed while the position MUST be changing - filling, or$N"
					    "     paying out.  If it has not moved 0.5% in param_lpt_frozen_ms the$N"
					    "     transducer is stuck.  This catches the failure the range check$N"
					    "     cannot:  a signal that is in band but no longer tracking.$N"
					    "$N"
					    "  3  Disagreement with di_high_limit - the discrete says full while the$N"
					    "     analog says it is below the full-stop threshold.  One of them lies.$N"
					    "$N"
					    "Not self-clearing.  A sensor fault should be acknowledged deliberately,$N"
					    "unlike the process alarms A05 and A07.$N"
					    "$N"
					    "Rev 20260825 a09";
					N: LIM(param_lpt_raw_min,IN_ai_lpt01,param_lpt_raw_max)OTE(lpt_raw_ok);
					N: [XIC(request_fill) ,XIC(payout_active) ]OTE(pstn_should_move);
					N: [XIO(pstn_should_move) ,CMP(ABS(ai_pos01_pct_flt-lpt_ref_pct)>0.5) ][MOV(ai_pos01_pct_flt,lpt_ref_pct) ,RES(timer_lpt_frozen) ];
					N: XIC(pstn_should_move)[MOV(param_lpt_frozen_ms,timer_lpt_frozen.PRE) ,TON(timer_lpt_frozen,?,?) ];
					N: [XIO(lpt_raw_ok) ,XIC(timer_lpt_frozen.DN) ,XIC(di_high_limit) LES(ai_pos01_pct_flt,param_acc_max_limit) ][MOV(p00_lin_timer_pre_1s,timer_alarm[8].PRE) ,TON(timer_alarm[8],?,?) ,XIC(timer_alarm[8].DN) OTL(A08) ];
					N: XIC(alm_ack[0].8)XIC(lpt_raw_ok)XIO(timer_lpt_frozen.DN)XIC(pb_reset)[OTU(A08) ,OTU(alm_ack[0].8) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_mcp,timer_alarm[9].PRE) ,TON(timer_alarm[9],?,?) ,XIC(timer_alarm[9].DN) OTL(A09) ];
					N: XIC(alm_ack[0].9)XIO(AFI)XIC(pb_reset)[OTU(A09) ,OTU(alm_ack[0].9) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_ol,timer_alarm[10].PRE) ,TON(timer_alarm[10],?,?) ,XIC(timer_alarm[10].DN) OTL(A10) ];
					N: XIC(alm_ack[0].10)XIC(AFI)XIC(pb_reset)[OTU(A10) ,OTU(alm_ack[0].10) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_ms,timer_alarm[11].PRE) ,TON(timer_alarm[11],?,?) ,XIC(timer_alarm[11].DN) OTL(A11) ];
					N: XIC(alm_ack[0].11)XIO(AFI)XIC(pb_reset)[OTU(A11) ,OTU(alm_ack[0].11) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[12].PRE) ,TON(timer_alarm[12],?,?) ,XIC(timer_alarm[12].DN) OTL(A12) ];
					N: XIC(alm_ack[0].12)XIO(AFI)XIC(pb_reset)[OTU(A12) ,OTU(alm_ack[0].12) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[13].PRE) ,TON(timer_alarm[13],?,?) ,XIC(timer_alarm[13].DN) OTL(A13) ];
					N: XIC(alm_ack[0].13)XIO(AFI)XIC(pb_reset)[OTU(A13) ,OTU(alm_ack[0].13) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[14].PRE) ,TON(timer_alarm[14],?,?) ,XIC(timer_alarm[14].DN) OTL(A14) ];
					N: XIC(alm_ack[0].14)XIO(AFI)XIC(pb_reset)[OTU(A14) ,OTU(alm_ack[0].14) ];
					N: XIC(AFI)NEQ(p01r09.fault,0)XIO(enable_control)[MOV(p00_lin_timer_pre_0ms,timer_alarm[15].PRE) ,TON(timer_alarm[15],?,?) ,XIC(timer_alarm[15].DN) OTL(A15) ];
					N: XIC(alm_ack[0].15)[[XIC(enable_control) ,EQU(p01r09.fault,0) ] ,XIO(AFI) ]XIC(pb_reset)[OTU(A15) ,OTU(alm_ack[0].15) ];
					RC: "Output Control";
					N: NOP();
					RC: "Output Control";
					N: NOP();
					N: XIC(pb_reset)MOV(hmi_dint[0],alm_ack[0])MOV(hmi_dint[1],alm_ack[1]);
					N: [NEQ(hmi_dint[0],0) ,NEQ(hmi_dint[1],0) ]OTE(alarm_exists);
					N: [NEQ(hmi_dint[0],alm_ack[0]) ,NEQ(hmi_dint[1],alm_ack[1]) ]OTE(unack_alarm);
					N: RET();
			END_ROUTINE

			ROUTINE R08_Warnings (Description := "Windup Accumulator$NWarnings")
					N: SBR()NOP();
					RC: "Warnings";
					N: NOP();
					N: [XIC(nip_mode_auto) XIC(nip_close_request) ,XIC(nip_mode_close) ]XIO(do_close_nip_sol)[MOV(p00_lin_timer_pre_0ms,timer_warning[0].PRE) ,TON(timer_warning[0],?,?) ,XIC(timer_warning[0].DN) OTL(W00) ];
					N: [XIO(nip_mode_auto) XIO(nip_mode_close) ,XIO(nip_close_request) ,XIC(nip_mode_auto) XIC(nip_close_request) XIC(di_ss_close_nip) ][OTU(W00) ,OTU(wrn_ack[0].0) ];
					N: XIC(wac_full_stop)[MOV(p00_lin_timer_pre_0ms,timer_warning[1].PRE) ,TON(timer_warning[1],?,?) ,XIC(timer_warning[1].DN) OTL(W01) ];
					N: XIO(wac_full_stop)[OTU(W01) ,OTU(wrn_ack[0].1) ];
					RC: "W02 - Nip Selector Open with the Accumulator On$N"
					    "$N"
					    "The outfeed nip selector is a three position switch:  di_ss_nip_auto,$N"
					    "di_ss_close_nip, and OPEN when neither input is made.  Held open, the$N"
					    "accumulator can drag web back off the winder side during a fill, so the$N"
					    "accumulator cannot do its job.$N"
					    "$N"
					    "With the accumulator switched on this blocks Me.OUT_Not_Normal_Stop, which$N"
					    "both prevents a line start and stops a running line.  With the accumulator$N"
					    "off the selector may sit in open freely - the interlock only applies when$N"
					    "the accumulator is meant to be working.$N"
					    "$N"
					    "This warning exists because the line simply refusing to start is not enough$N"
					    "for the operator to know why.  It clears itself as soon as either condition$N"
					    "goes away.$N"
					    "$N"
					    "Rev 20260825 a12";
					N: XIC(pb_acc_on)XIC(nip_open_selected)[MOV(p00_lin_timer_pre_1s,timer_warning[2].PRE) ,TON(timer_warning[2],?,?) ,XIC(timer_warning[2].DN) OTL(W02) ];
					N: [XIO(pb_acc_on) ,XIO(nip_open_selected) ][OTU(W02) ,OTU(wrn_ack[0].2) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_warning[3].PRE) ,TON(timer_warning[3],?,?) ,XIC(timer_warning[3].DN) OTL(W03) ];
					N: XIO(AFI)[OTU(W03) ,OTU(wrn_ack[0].3) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_warning[4].PRE) ,TON(timer_warning[4],?,?) ,XIC(timer_warning[4].DN) OTL(W04) ];
					N: XIO(AFI)[OTU(W04) ,OTU(wrn_ack[0].4) ];
					N: XIO(pb_acc_on)[MOV(p00_lin_timer_pre_0ms,timer_warning[5].PRE) ,TON(timer_warning[5],?,?) ,XIC(timer_warning[5].DN) OTL(W05) ];
					N: XIC(pb_acc_on)[OTU(W05) ,OTU(wrn_ack[0].5) ];
					N: XIC(pb_stop_line)[MOV(p00_lin_timer_pre_0ms,timer_warning[6].PRE) ,TON(timer_warning[6],?,?) ,XIC(timer_warning[6].DN) OTL(W06) ];
					N: XIC(wrn_ack[0].6)XIO(pb_stop_line)XIC(pb_reset)[OTU(W06) ,OTU(wrn_ack[0].6) ];
					N: XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_warning[6].PRE) ,TON(timer_warning[7],?,?) ,XIC(timer_warning[7].DN) OTL(W07) ];
					N: XIO(AFI)[OTU(W07) ,OTU(wrn_ack[0].7) ];
					RC: "Output Control";
					N: NOP();
					N: XIC(pb_reset)MOV(hmi_dint[2],wrn_ack[0])MOV(hmi_dint[3],wrn_ack[1]);
					RC: "Warnings clear automatically, no $N"
					    "PB_Global_Reset required";
					N: sys_Acknowledge(add_sys_Acknowledge,wrn_ack[0],hmi_dint[2])sys_Acknowledge(add_sys_Acknowledge,wrn_ack[1],hmi_dint[3]);
					N: [NEQ(hmi_dint[2],0) ,NEQ(hmi_dint[3],0) ]OTE(warning_exists);
					N: [NEQ(hmi_dint[2],wrn_ack[0]) ,NEQ(hmi_dint[3],wrn_ack[1]) ]OTE(unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R11_Modes 
					RC: "Notes:$N"
					    "";
					N: SBR()NOP();
					RC: "Requests";
					N: NOP();
					RC: "Modes";
					N: NOP();
					RC: "Modes";
					N: NOP();
					N: XIC(di_ss_nip_auto)OTE(nip_mode_auto);
					N: XIC(di_ss_close_nip)OTE(nip_mode_close);
					N: XIO(nip_mode_auto)XIO(nip_mode_close)OTE(nip_open_selected);
					N: RET();
			END_ROUTINE

			ROUTINE R21_Fill_Request (Description := "WAC$NFill Request and Tension Enable")
					RC: "Fill Request$N"
					    "$N"
					    "a02 20260820 - the accumulator position PID has been removed from this$N"
					    "routine.  It regulated carriage position by trimming the carriage$N"
					    "pressure, which is a tension disturbance by definition and conflicted$N"
					    "with the requirement that the accumulator not affect web tension.$N"
					    "Carriage position is now regulated by the proportional position-to-speed$N"
					    "block in p29r10 / p29r11; pressure sets tension only.$N"
					    "$N"
					    "Removed:  pid_ctrl_pv / _sp / _cv, the sys_PIDE call, the autotune and$N"
					    "          gain plumbing, PIDE_ten manual mode and manual setpoint, and$N"
					    "          the PID_offset calculation.  The fill pressure bias that$N"
					    "          PID_offset used to supply now falls out of the separate$N"
					    "          vendor fill curve in p31 R22 - see param_press_slope_fill.$N"
					    "$N"
					    "Kept declared for HMI back-compat, no longer consumed by any rung:$N"
					    "          PIDE_ten, PIDE_Control, pid_ctrl_pv, pid_ctrl_sp, pid_ctrl_cv,$N"
					    "          PID_offset, pid_mode_manual, use_auto_tune_gains, param_gain,$N"
					    "          param_pid_kp / ki / kd, param_pid_process_type, param_fill_SO,$N"
					    "          param_cv01_manual_sp, param_acc_low_pstn_sp,$N"
					    "          param_low_ctrl_pct, param_high_ctrl_pct.$N"
					    "$N"
					    "What remains here is the fill request latch and the tension enable seal.$N"
					    "Routine renamed from R21_Position_PID; call order in R00_Main unchanged.";
					N: SBR()NOP();
					RC: "Tension Enable$N"
					    "Seals in from the HMI enable PB, drops on a system fault or fast stop.";
					N: [[XIC(pb_enable_tension) ,XIC(enable_control) ] EQU(p01r09.fault,0) XIC(Me.OUT_Not_Fast_Stop) ,XIO(AFI) ]OTE(enable_control);
					RC: "Fill Request$N"
					    "$N"
					    "One rung, plain OTE - NOT a latch.";
					N: XIO(p01r12_zero_line_speed)XIO(p29r15_request_run)XIO(p29r16_request_run)XIO(p00_wac.OUT_Full)OTE(request_fill);
					RC: "control_to_empty was driven by the removed position PID.  Held cleared so the HMI status bit does not sit stale at its last value.";
					N: OTU(control_to_empty);
					N: RET();
			END_ROUTINE

			ROUTINE R22_Fill_Pressure (Description := "Windup Accumulator$NFill Pressure")
					N: SBR()NOP();
					RC: "Notes:$N"
					    "";
					N: NOP();
					N: GSV(Task,THIS,Rate,task_scan_time_dint)DIV(task_scan_time_dint,1000000,task_scan_time);
					RC: "Counter pressure$N"
					    "";
					N: NOP();
					N: XIC(pb_acc_on)MOV(param_counter_prs,ao_prs01);
					RC: "Accumulator Pressure Setpoints$N"
					    "$N"
					    "";
					N: NOP();
					RC: "Accumulator Tension$N"
					    "$N"
					    "1 LBF -> 0.2415 PSI   (vendor, emptying)$N"
					    "1 LBF -> 0.2667 PSI   (vendor, filling)$N"
					    "$N"
					    "The old 0.0603 here was 1/cylinder area and ignored the 4x from the$N"
					    "2-pass reeving.  See the curve rung below.$N"
					    "$N"
					    "Rev 20260829 a32";
					N: NOP();
					RC: "Pressure from Web Tension - vendor curve$N"
					    "$N"
					    "C.A. Litzler, measured, excluding friction between parts:$N"
					    "$N"
					    "  FILLING    web tension lb = 3.75 x psi - 83$N"
					    "  EMPTYING   web tension lb = 4.14 x psi - 83$N"
					    "$N"
					    "inverted for the setpoint:   psi = (tension + 83) / slope$N"
					    "$N"
					    "THIS REPLACES THE 0.0603 FACTOR, WHICH WAS WRONG BY A FACTOR OF 4.$N"
					    "$N"
					    "0.0603 = 1/16.59, the reciprocal of the combined bore area of the two$N"
					    "3.25 in cylinders.  That converts cylinder FORCE to pressure - but web$N"
					    "tension is not cylinder force.  The carriage is reeved 2 passes, and$N"
					    "each pass puts two spans of web on the carriage, so the cylinders carry$N"
					    "4 x T:$N"
					    "$N"
					    "  psi = 4T/16.59 = 0.2411 T      vs vendor 1/4.14 = 0.2415 T$N"
					    "$N"
					    "The old factor commanded a quarter of the pressure needed.  At 1 PLI the$N"
					    "tare masked it (34.6 vs 35.3 psi); at 2.5 PLI it was 40.3 psi against a$N"
					    "required 58.1 - the accumulator would have held about a third of the$N"
					    "tension asked for, and worse the higher the setpoint.$N"
					    "$N"
					    "The 83 lbf offset is the carriage: 83 x 16.59/4 = 344 lb, consistent with$N"
					    "the mechanical note that the carriage must fall under its own weight.$N"
					    "$N"
					    "Rev 20260829 a32";
					N: CPT(wac_calc_tension_pressure,p01_recipe_active.winder_tension_sp+param_press_offset);
					RC: "Filling and Emptying Pressures$N"
					    "$N"
					    "Two curves, not one pressure plus a bias.  Filling needs more pressure$N"
					    "than emptying for the same web tension, and the gap is not constant -$N"
					    "3.7 psi at 1 PLI, 6.0 psi at 2.5 PLI.  A fixed param_fill_bias_psi could$N"
					    "not represent that, so it is gone.$N"
					    "$N"
					    "  wac_tension_pressure  = (tension + 83) / 4.14 + trim    emptying, hold$N"
					    "  filling_pressure      = (tension + 83) / 3.75 + trim    fill request$N"
					    "$N"
					    "param_tare_pressure is now a TRIM, starting at 0.  The vendor curve$N"
					    "already carries the carriage weight in the 83 lbf offset, and is stated$N"
					    "to exclude friction between parts.  Any standing offset found at install$N"
					    "- seal drag, guide friction - goes here.  It is no longer the whole$N"
					    "intercept, so do NOT set it to 30.8.$N"
					    "$N"
					    "Check against the vendor table at install:$N"
					    "$N"
					    "  PLI   tension lb   fill psi   empty psi$N"
					    "  1.0        63        38.9       35.3$N"
					    "  1.5        94.5      47.3       42.9$N"
					    "  2.0       126        55.7       50.5$N"
					    "  2.5       157.5      64.1       58.1$N"
					    "$N"
					    "Rev 20260829 a32";
					N: NOP();
					N: CPT(wac_tension_pressure,wac_calc_tension_pressure/param_press_slope_empty+param_tare_pressure);
					RC: "Accumulator Pressure Select$N"
					    "$N"
					    "DESIGN INTENT:  the accumulator is transparent to web tension.  The web$N"
					    "sees the same tension with the accumulator in the loop as it would with$N"
					    "the accumulator bypassed, in every state where the web is flowing through$N"
					    "to the winder.$N"
					    "$N"
					    "The cylinders are a constant-force device.  Pressure sets web tension; it$N"
					    "does NOT set carriage position.  Carriage position is set by the mass$N"
					    "balance between what the line feeds in and what the winder draws out.$N"
					    "$N"
					    "Rungs are in order of increasing priority - the last rung to write$N"
					    "selected_pressure wins:$N"
					    "$N"
					    "  1  Normal run                 wac_tension_pressure$N"
					    "  2  Payout                     wac_tension_pressure$N"
					    "  3  Fill request               filling_pressure  (steeper fill curve)$N"
					    "  4  Fault, or line not moving  wac_tension_pressure$N"
					    "$N"
					    "1, 2 and 4 are all the same pressure, and that is the point - nothing$N"
					    "about accumulator state changes web tension.  During payout the carriage$N"
					    "descends because the winder is overspeeding and drawing web out faster$N"
					    "than the line feeds it in, not because pressure was reduced.$N"
					    "$N"
					    "The position PID offset is NO LONGER added to the running pressure.  Any$N"
					    "position trim on the pressure is a tension disturbance by definition, so$N"
					    "the carriage is left to float.  PID_offset now reaches the web only$N"
					    "through the fill bias in rung 3, where the exit nip is closed and the$N"
					    "winder is isolated from the accumulator.$N"
					    "$N"
					    "Superseded, no longer used:  payout_pressure (fixed 29 psi),$N"
					    "param_holding_pressure (fixed 14 psi), tension_pressure (fixed 35 psi).$N"
					    "$N"
					    "Rev 20260820";
					N: NOP();
					N: XIO(request_fill)XIO(payout_active)MOV(wac_tension_pressure,selected_pressure);
					N: CPT(filling_pressure,wac_calc_tension_pressure/param_press_slope_fill+param_tare_pressure);
					RC: "Payout Status and Carriage Position Publish$N"
					    "$N"
					    "The winder speed trim is now a strict proportional function of carriage$N"
					    "position, done with a scaling block in p29r10 / p29r11:$N"
					    "$N"
					    "        0%  ->  -0.20      winder at 0.80 x line, accumulator refills$N"
					    "       10%  ->   0.00      park, in balance$N"
					    "       20%  ->  +0.20      winder at 1.20 x line, drawing down$N"
					    "   above 20% ->  +0.20      saturated - this IS the payout overspeed$N"
					    "$N"
					    "Because that curve is continuous there is no payout-to-running handover$N"
					    "to sequence and no cross-fade.  The accumulator seeks 10% on its own,$N"
					    "which also removes the position drift that a purely tension-transparent$N"
					    "accumulator would otherwise show over a long run.$N"
					    "$N"
					    "p00_wac_position_pct is the filtered carriage position published to p29.$N"
					    "P31 scans after P29 so p29 reads it one scan old - 10 ms on a carriage$N"
					    "that moves slowly, which is not significant.$N"
					    "$N"
					    "payout_active / accumulator_state.6 / Me.OUT_Acc_Payout are retained as$N"
					    "STATUS ONLY - HMI indication and the pressure select rungs below.  They$N"
					    "no longer gate any speed logic.  Latch is at park + 2% so that a short$N"
					    "doff which only part-fills still shows payout; unlatch at park, with$N"
					    "wac_nearly_empty kept as a backstop.$N"
					    "$N"
					    "Rev 20260820";
					N: MOV(ai_pos01_pct_flt,p00_wac_position_pct);
					RC: "Payout Activation$N"
					    "$N"
					    "Payout only runs into a winder that can actually take the web:$N"
					    "$N"
					    "  winder A active AND turret at winder A run position, OR$N"
					    "  winder B active AND turret at winder B run position$N"
					    "$N"
					    "via p29_winder_at_run_position.  Without it the accumulator would pay$N"
					    "out while the turret is mid-index or parked at doff, with the selected$N"
					    "winder nowhere near the web path.$N"
					    "$N"
					    "Losing the interlock also drops payout, not just blocks it starting -$N"
					    "the turret can be jogged away underneath an active payout.$N"
					    "$N"
					    "Rev 20260829 a33";
					N: XIO(request_fill)CMP(ai_pos01_pct_flt>(param_acc_handover_pct+2))XIC(winder_running)XIC(p29_winder_at_run_position)[OTL(payout_active) ,OTL(accumulator_state.6) ];
					N: [LEQ(ai_pos01_pct_flt,param_acc_handover_pct) ,XIO(p29_winder_at_run_position) ][OTU(payout_active) ,OTU(accumulator_state.6) ];
					N: XIC(payout_active)MOV(wac_tension_pressure,selected_pressure);
					N: [XIO(request_fill) CMP(ai_pos01_pct_flt<= param_acc_handover_pct+param_acc_handover_band_pct) ,XIO(p29r15_request_run) XIC(p29r15_wdra_active) ,XIO(p29r16_request_run) XIC(p29r16_wdrb_active) ][MOV(wac_tension_pressure,selected_pressure) ,OTE(accum_tension_pressure_on) ];
					N: XIC(request_fill)[MOV(filling_pressure,selected_pressure) ,OTE(accum_filling_on) ];
					RC: "Hold the accumulator in position$N"
					    "$N"
					    "Applied on a fault, or when the line is not moving and neither winder is$N"
					    "running.  Holding pressure is now the calculated tare + tension pressure so$N"
					    "the carriage stays where it is instead of drifting down - it was a fixed$N"
					    "param_holding_pressure of 14 psi, well below the carriage tare.$N"
					    "$N"
					    "A fill request is not overridden here unless there is a fault, and$N"
					    "p01r13_line_slow_ramp is now included in the line-not-moving test.$N"
					    "$N"
					    "param_holding_pressure is no longer used.$N"
					    "$N"
					    "Rev 20260820";
					N: [NEQ(p01r09.fault,0) ,XIO(request_fill) XIO(p01r13_line_running) XIO(p01r13_line_slow_ramp) XIO(p29r15_request_run) XIO(p29r16_request_run) ][MOV(wac_tension_pressure,selected_pressure) ,OTE(accum_holding_pressure_on) ];
					RC: "Accumulator Pressure Accel Decel Ramp$N"
					    "$N"
					    "";
					N: NOP();
					N: XIC(pb_acc_on)sys_Ramp(add_sys_ramp,param_accel_rate,param_decel_rate,task_scan_time,ao_prs02,selected_pressure)MOV(selected_pressure,ao_prs02);
					N: XIC(pb_acc_on)OTE(do_carriage_lift_sol);
					N: XIO(pb_acc_on)MOV(0,selected_pressure)MOV(0,ao_prs01)MOV(0,ao_prs02);
					N: RET();
			END_ROUTINE

			ROUTINE R31_Nip_Roll (Description := "WAC$NNip Roll")
					RC: "Notes:$N"
					    "";
					N: SBR()NOP();
					RC: "Nip Control";
					N: NOP();
					RC: "Nip Open Dwell$N"
					    "$N"
					    "The fill request clears the moment a winder is started again.  The nip$N"
					    "must not open on that instant - the winder needs 2 s at payout overspeed$N"
					    "to pick the web up and establish tension first, or the nip lets go into$N"
					    "slack web.$N"
					    "$N"
					    "E-stop bypasses the dwell and opens the nip immediately.$N"
					    "$N"
					    "Rev 20260825 a30";
					N: XIO(request_fill)TON(nip_open_dwell,?,?);
					RC: "Nip closes only while the accumulator is filling$N"
					    "$N"
					    "The outfeed nip is a one way roll - material pulls out toward the winder$N"
					    "with it closed but cannot roll back.  Its only job is to stop the$N"
					    "accumulator dragging web back off the winder side while it fills, so that$N"
					    "is the only condition that closes it.$N"
					    "$N"
					    "Open on E-stop.  Me.OUT_Not_EStop is A00 only, so this forces the nip open$N"
					    "regardless of the fill request and regardless of the manual close selector.$N"
					    "The solenoid rung also drops on any p01r09 fault, so E-stop is covered$N"
					    "twice - deliberately.$N"
					    "$N"
					    "Previously opened on accumulator level above param_acc_min_limit.  That$N"
					    "left it open during the fill, which is the one time it needs to be shut.$N"
					    "$N"
					    "No open delay - the level-based version needed one, this does not.$N"
					    "timer_nip_open_delay is left declared and unused.$N"
					    "$N"
					    "Rev 20260825 a12";
					N: [XIC(nip_open_dwell.DN) ,XIO(Me.OUT_Not_EStop) ]OTE(nip_auto_open_request);
					N: [XIC(nip_mode_auto) XIO(nip_auto_open_request) ,XIC(nip_mode_close) ]OTE(nip_close_request);
					N: XIC(nip_mode_auto)XIO(nip_close_request)OTE(nip_open_request);
					N: [XIC(nip_close_request) ONS(oneshot.0) ,XIC(do_close_nip_sol) ]EQU(p01r09.fault,0)XIC(nip_close_request)XIO(nip_open_request)OTE(do_close_nip_sol);
					N: [XIC(W00) XIC(p00_FlashBit_1Sec) ,XIC(nip_mode_auto) XIO(W00) ,XIC(p00_pb_lamp_test) ]OTE(do_nip_illuminated_ss);
			END_ROUTINE

	END_PROGRAM

	TASK MainTask (Type := CONTINUOUS,
	               Rate := 10,
	               Priority := 10,
	               Watchdog := 500,
	               DisableUpdateOutputs := No,
	               InhibitTask := No)
