			IN_OUT_master_ramped_speed : REAL (Usage := InOut,
			                                      RADIX := Float,
			                                      Required := Yes,
			                                      Visible := Yes);
		END_PARAMETERS

		LOCAL_TAGS
			p01r03_last_scan_ms : DINT (RADIX := Decimal,
			                              DefaultData := 0);
			local_last_scan_ms : DINT (RADIX := Decimal,
			                             DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: LEQ(IN_OUT_master_ramped_speed,IN_selected_line_speed)[CPT(IN_OUT_master_ramped_speed,IN_OUT_master_ramped_speed+(IN_param_master_accel_rate*(IN_last_scan_s))) ,GRT(IN_OUT_master_ramped_speed,IN_selected_line_speed) MOV(IN_selected_line_speed,IN_OUT_master_ramped_speed) ];
				N: GRT(IN_OUT_master_ramped_speed,IN_selected_line_speed)[CPT(IN_OUT_master_ramped_speed,IN_OUT_master_ramped_speed-(IN_param_master_decel_rate*(IN_last_scan_s))) ,LES(IN_OUT_master_ramped_speed,IN_selected_line_speed) MOV(IN_selected_line_speed,IN_OUT_master_ramped_speed) ];
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

