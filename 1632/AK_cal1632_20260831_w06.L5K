					N: MOV(0,p29_real_to_hmi[78])MOV(0,p29_real_to_hmi[79]);
					N: OTE(p29r06.comment.7);
					N: MOV(0,p29_real_to_hmi[80])MOV(0,p29_real_to_hmi[81])MOV(0,p29_real_to_hmi[82]);
					N: MOV(0,p29_real_to_hmi[83])MOV(0,p29_real_to_hmi[84])MOV(0,p29_real_to_hmi[85]);
					N: MOV(0,p29_real_to_hmi[86])MOV(0,p29_real_to_hmi[87])MOV(0,p29_real_to_hmi[88]);
					N: MOV(0,p29_real_to_hmi[89])MOV(0,p29_real_to_hmi[90])MOV(0,p29_real_to_hmi[91]);
					N: MOV(0,p29_real_to_hmi[92])MOV(0,p29_real_to_hmi[93])MOV(0,p29_real_to_hmi[94]);
					N: MOV(0,p29_real_to_hmi[95])MOV(0,p29_real_to_hmi[96])MOV(0,p29_real_to_hmi[97]);
					N: MOV(0,p29_real_to_hmi[98])MOV(0,p29_real_to_hmi[99])MOV(0,p29_real_to_hmi[100]);
					N: MOV(0,p29_real_to_hmi[101])MOV(0,p29_real_to_hmi[102])MOV(0,p29_real_to_hmi[103]);
					N: MOV(0,p29_real_to_hmi[104])MOV(0,p29_real_to_hmi[105])MOV(0,p29_real_to_hmi[106]);
					N: MOV(0,p29_real_to_hmi[107])MOV(0,p29_real_to_hmi[108])MOV(0,p29_real_to_hmi[109]);
					N: MOV(0,p29_real_to_hmi[110])MOV(0,p29_real_to_hmi[111]);
					N: OTE(p29r06.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r06.fault,p29r06.fault_ack);
					N: XIC(FAULT)[TON(p29r06_timer_fault[0],?,?) ,XIC(p29r06_timer_fault[0].DN) OTL(p29r06.fault.0) ];
					N: XIC(p29r06.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r06.fault.0) ,OTU(p29r06.fault_ack.0) ];
					N: NEQ(p29r06.fault,p29r06.fault_ack)OTE(p29r06.unack_fault);
					N: OTE(p29r06.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r06.warning,p29r06.warning_ack);
					N: XIC(FAULT)[TON(p29r06_timer_warning[0],?,?) ,XIC(p29r06_timer_warning[0].DN) OTL(p29r06.warning.0) ];
					N: XIO(FAULT)[OTU(p29r06.warning.0) ,OTU(p29r06.warning_ack.0) ];
					N: NEQ(p29r06.warning,p29r06.warning_ack)OTE(p29r06.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R07_Alarms 
					N: SBR()OTE(p29r07.comment.0);
					N: OTE(p29r07.comment.1);
					N: OTE(p29r07.comment.2);
					N: OTE(p29r07.comment.3);
					N: [XIC(p29r15.fault.0) OTE(p29_dint_to_hmi[2].0) ,XIC(p29r15.fault.1) OTE(p29_dint_to_hmi[2].1) ,XIC(p29r15.fault.2) OTE(p29_dint_to_hmi[2].2) ,XIC(p29r15.fault.3) OTE(p29_dint_to_hmi[2].3) ];
					N: [XIC(p29r15.fault.4) OTE(p29_dint_to_hmi[2].4) ,XIC(p29r15.fault.5) OTE(p29_dint_to_hmi[2].5) ,XIC(HMI) OTE(p29_dint_to_hmi[2].6) ,XIC(HMI) OTE(p29_dint_to_hmi[2].7) ];
					N: [XIC(p29r16.fault.0) OTE(p29_dint_to_hmi[2].8) ,XIC(HMI) OTE(p29_dint_to_hmi[2].9) ,XIC(p29r16.fault.2) OTE(p29_dint_to_hmi[2].10) ,XIC(p29r16.fault.3) OTE(p29_dint_to_hmi[2].11) ];
					N: [XIC(p29r16.fault.4) OTE(p29_dint_to_hmi[2].12) ,XIC(p29r16.fault.5) OTE(p29_dint_to_hmi[2].13) ,XIC(HMI) OTE(p29_dint_to_hmi[2].14) ,XIC(HMI) OTE(p29_dint_to_hmi[2].15) ];
					N: [XIC(p29r20.fault.0) OTE(p29_dint_to_hmi[2].16) ,XIC(HMI) OTE(p29_dint_to_hmi[2].17) ,XIC(p29r20.fault.2) OTE(p29_dint_to_hmi[2].18) ,XIC(p29r20.fault.3) OTE(p29_dint_to_hmi[2].19) ];
					N: [XIC(p29r20.fault.4) OTE(p29_dint_to_hmi[2].20) ,XIC(HMI) OTE(p29_dint_to_hmi[2].21) ,XIC(HMI) OTE(p29_dint_to_hmi[2].22) ,XIC(HMI) OTE(p29_dint_to_hmi[2].23) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[2].24) ,XIC(HMI) OTE(p29_dint_to_hmi[2].25) ,XIC(HMI) OTE(p29_dint_to_hmi[2].26) ,XIC(HMI) OTE(p29_dint_to_hmi[2].27) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[2].28) ,XIC(HMI) OTE(p29_dint_to_hmi[2].29) ,XIC(HMI) OTE(p29_dint_to_hmi[2].30) ,XIC(HMI) OTE(p29_dint_to_hmi[2].31) ];
					N: OTE(p29r07.comment.4);
					N: OTE(p29r07.comment.5);
					N: OTE(p29r07.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r07.fault,p29r07.fault_ack);
					N: XIC(FAULT)[TON(p29r07_timer_fault[0],?,?) ,XIC(p29r07_timer_fault[0].DN) OTL(p29r07.fault.0) ];
					N: XIC(p29r07.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r07.fault.0) ,OTU(p29r07.fault_ack.0) ];
					N: NEQ(p29r07.fault,p29r07.fault_ack)OTE(p29r07.unack_fault);
					N: OTE(p29r07.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r07.warning,p29r07.warning_ack);
					N: XIC(FAULT)[TON(p29r07_timer_warning[0],?,?) ,XIC(p29r07_timer_warning[0].DN) OTL(p29r07.warning.0) ];
					N: XIO(FAULT)[OTU(p29r07.warning.0) ,OTU(p29r07.warning_ack.0) ];
					N: NEQ(p29r07.warning,p29r07.warning_ack)OTE(p29r07.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R08_Warnings 
					N: SBR()OTE(p29r08.comment.0);
					N: OTE(p29r08.comment.1);
					N: OTE(p29r08.comment.2);
					N: OTE(p29r08.comment.3);
					N: OTE(p29r08.comment.4);
					N: [XIC(p29r15.warning.0) OTE(p29_dint_to_hmi[4].0) ,XIC(p29r15.warning.1) OTE(p29_dint_to_hmi[4].1) ,XIC(p29r15.warning.2) OTE(p29_dint_to_hmi[4].2) ,XIC(HMI) OTE(p29_dint_to_hmi[4].3) ];
					N: [XIC(p29r16.warning.0) OTE(p29_dint_to_hmi[4].4) ,XIC(p29r16.warning.1) OTE(p29_dint_to_hmi[4].5) ,XIC(p29r16.warning.2) OTE(p29_dint_to_hmi[4].6) ,XIC(HMI) OTE(p29_dint_to_hmi[4].7) ];
					N: [XIC(p29r20.warning.0) OTE(p29_dint_to_hmi[4].8) ,XIC(p29r20.warning.1) OTE(p29_dint_to_hmi[4].9) ,XIC(HMI) OTE(p29_dint_to_hmi[4].10) ,XIC(HMI) OTE(p29_dint_to_hmi[4].11) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[4].12) ,XIC(HMI) OTE(p29_dint_to_hmi[4].13) ,XIC(HMI) OTE(p29_dint_to_hmi[4].14) ,XIC(HMI) OTE(p29_dint_to_hmi[4].15) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[4].16) ,XIC(HMI) OTE(p29_dint_to_hmi[4].17) ,XIC(HMI) OTE(p29_dint_to_hmi[4].18) ,XIC(HMI) OTE(p29_dint_to_hmi[4].19) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[4].20) ,XIC(HMI) OTE(p29_dint_to_hmi[4].21) ,XIC(HMI) OTE(p29_dint_to_hmi[4].22) ,XIC(HMI) OTE(p29_dint_to_hmi[4].23) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[4].24) ,XIC(HMI) OTE(p29_dint_to_hmi[4].25) ,XIC(HMI) OTE(p29_dint_to_hmi[4].26) ,XIC(HMI) OTE(p29_dint_to_hmi[4].27) ];
					N: [XIC(HMI) OTE(p29_dint_to_hmi[4].28) ,XIC(HMI) OTE(p29_dint_to_hmi[4].29) ,XIC(HMI) OTE(p29_dint_to_hmi[4].30) ,XIC(HMI) OTE(p29_dint_to_hmi[4].31) ];
					N: OTE(p29r08.comment.5);
					N: OTE(p29r08.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r08.fault,p29r08.fault_ack);
					N: XIC(FAULT)[TON(p29r08_timer_fault[0],?,?) ,XIC(p29r08_timer_fault[0].DN) OTL(p29r08.fault.0) ];
					N: XIC(p29r08.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r08.fault.0) ,OTU(p29r08.fault_ack.0) ];
					N: NEQ(p29r08.fault,p29r08.fault_ack)OTE(p29r08.unack_fault);
					N: OTE(p29r08.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r08.warning,p29r08.warning_ack);
					N: XIC(FAULT)[TON(p29r08_timer_warning[0],?,?) ,XIC(p29r08_timer_warning[0].DN) OTL(p29r08.warning.0) ];
					N: XIO(FAULT)[OTU(p29r08.warning_ack.0) ,OTU(p29r08.warning.0) ];
					N: NEQ(p29r08.warning,p29r08.warning_ack)OTE(p29r08.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R09_Modes 
					RC: "p29r09$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r09.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r09.comment (dint)$N"
					    "p29r09.oneshot (dint)$N"
					    "p29r09_timer_xxxx (timer)$N"
					    "p29r09_xxxx (any)$N"
					    "p29r09.fault (dint)$N"
					    "p29r09.warning (dint)$N"
					    "";
					N: OTE(p29r09.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r09.comment.2);
					RC: "Winder A&B Modes";
					N: OTE(p29r09.comment.3);
					N: XIC(p29_di_wdr_a)OTE(p29r09_winder_a_active);
					N: XIO(p29_di_wdr_a)OTE(p29r09_winder_b_active);
					N: [XIC(turret_wa_pos_doff_request) ,XIC(turret_wb_pos_doff_request) ]OTE(di_mode_doff);
					N: [XIC(turret_wa_pos_run_request) ,XIC(turret_wb_pos_run_request) ]OTE(di_mode_run);
					RC: "Doff Position Mode$N"
					    "$N"
					    "AUTO    - Winder A / Winder B doff PB indexes the turret to the preset$N"
					    "          doff position, shortest way round.$N"
					    "MANUAL  - the doff PBs do nothing.  The operator jogs the turret to$N"
					    "          whatever doff position suits, using turret fwd / rev.$N"
					    "$N"
					    "Only the doff move is affected.  The Winder A / Winder B RUN position PBs$N"
					    "always index automatically, in both modes, and jog always works.$N"
					    "$N"
					    "Selector is hmi_dint[0].22, freed when shortest path replaced the$N"
					    "mode_under direction override.$N"
					    "$N"
					    "Rev 20260825 a29";
					N: XIC(p29r09_ss_doff_auto)OTE(p29r09_mode_doff_auto);
					N: XIO(p29r09_ss_doff_auto)OTE(p29r09_mode_doff_manual);
					N: [XIO(p01r13_line_running) ,XIO(p01r13_line_slow_ramp) ]XIC(p00_io_winder:6:I.11)OTL(any_jog_wa_permissive);
					N: [XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIO(p29r15_request_jog_fwd)OTU(any_jog_wa_permissive);
					N: [XIO(p01r13_line_running) ,XIO(p01r13_line_slow_ramp) ]XIC(p00_io_winder:6:I.11)OTL(any_jog_wb_permissive);
					N: [XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIO(p29r16_request_jog_fwd)OTU(any_jog_wb_permissive);
					N: EQU(p01_recipe_active.winder_mode_sp,0)OTE(p29r09_tension_mode);
					N: EQU(p01_recipe_active.winder_mode_sp,1)OTE(p29r09_torque_mode);
					RC: "Liner Winder Modes";
					N: OTE(p29r09.comment.4);
					RC: "Output Control";
					N: OTE(p29r09.comment.5);
					RC: "Faults";
					N: OTE(p29r09.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r09.fault,p29r09.fault_ack);
					N: XIC(FAULT)[TON(p29r09_timer_fault[0],?,?) ,XIC(p29r09_timer_fault[0].DN) OTL(p29r09.fault.0) ];
					N: XIC(p29r09.fault_ack.0)XIC(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r09.fault.0) ,OTU(p29r09.fault_ack.0) ];
					N: NEQ(p29r09.fault,p29r09.fault_ack)OTE(p29r09.unack_fault);
					RC: "Warnings";
					N: OTE(p29r09.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r09.warning,p29r09.warning_ack);
					N: XIC(FAULT)[TON(p29r09_timer_warning[0],?,?) ,XIC(p29r09_timer_warning[0].DN) OTL(p29r09.warning.0) ];
					N: XIO(FAULT)[OTU(p29r09.warning.0) ,OTU(p29r09.warning_ack.0) ];
					N: NEQ(p29r09.warning,p29r09.warning_ack)OTE(p29r09.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R10_Winder_A_Speed_Control 
					RC: "p29r10$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r11.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r10.comment (dint)$N"
					    "p29r10.oneshot (dint)$N"
					    "p29r10_timer_xxxx (timer)$N"
					    "p29r10_xxxx (any)$N"
					    "p29r10.fault (dint)$N"
					    "p29r10.warning (dint)$N"
					    "";
					N: OTE(p29r10.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r10.comment.2);
					N: EQU(p29r10.fault,0)OTE(p29r10_run_permissive);
					RC: "Requests";
					N: OTE(p29r10.comment.3);
					N: XIC(p29r10_run_permissive)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p29r15_wdra_active)XIC(p29r15_state.6)OTE(p29r10_request_run);
					N: [XIC(p29_di_wdr_index_fwd) ,XIC(p29r15_wdra_active) XIC(p29r10_index_active) ]OTE(p29r10_index_active);
					N: CPT(p29r10_calc_speed_offset,p29_ai_wa_speed-p25_ao_selected_speed);
					N: CPT(p29r10_pid_out,p29r10_calc_speed_offset/p29r10_psn_gain+50);
					RC: "Auto Start Sequence";
					N: OTE(p29r10.comment.4);
					RC: "Configure PID$N"
					    "The tension loadcell feedback is compared to its setpoint in a PID control.$N"
					    "With the PID output at 50%, error is made to be 0$N"
					    "Error is multiplied to the ramped line speed and added to the ramp line speed to calculate the required speed of the drive.$N"
					    "A gain factor is used to dampen the error effect on the drive speed.(P29R10-10)$N"
					    "The larger the number, the smaller the PID error effect.  Initial setting 60";
					N: OTE(p29r10.comment.5);
					N: TON(p29r10_timer[0],?,?);
					N: MOV(p29_ai_wdr_lc,p29r10_pid_psn_pv);
					N: MOV(p01_recipe_active.winder_tension_sp,p29r10_pid_psn.SP);
					RC: "Tension Error and Load Cell PID$N"
					    "$N"
					    "p29r10_tension_error is the explicit tension error in lbf.  It replaces$N"
					    "p29r10_pid_psn.ERR everywhere it was consumed (p01r13_winder_tension_ok$N"
					    "and the p29r17 diameter calculation), so no logic outside this routine$N"
					    "depends on PID block internals any more.$N"
					    "$N"
					    "The PID itself is OUT OF THE CONTROL PATH.  Winder speed trim now comes$N"
					    "from the proportional accumulator position block below.  The PID is held$N"
					    "in manual permanently with SO tracked at 50 so that it cannot wind up and$N"
					    "the HMI faceplate shows a sane output.  Block and tags are kept declared$N"
					    "for HMI back-compat - delete the PID instruction if the faceplate goes.$N"
					    "$N"
					    "Rev 20260820";
					N: CPT(p29r10_tension_error,p01_recipe_active.winder_tension_sp-p29_ai_wdr_lc);
					N: MOV(50,p29r10_pid_psn.SO);
					N: OTE(p29r10_pid_psn.SWM);
					N: XIC(p29_di_wdr_index_fwd)MOV(p29r10_accel_bias,p29r10_pid_psn.BIAS);
					N: XIO(p29_di_wdr_index_fwd)MOV(0.0,p29r10_pid_psn.BIAS);
					N: XIC(p29_di_wdr_index_fwd)MOV(p21r10_index_kp,p29r10_pid_psn.KP)MOV(p21r10_index_ki,p29r10_pid_psn.KI)MOV(p21r10_index_kd,p29r10_pid_psn.KD);
					N: OTU(p29r10_pid_psn.NOBC);
					RC: "If param_psn_gain is too big, fabric will not take up.$N"
					    "If it is too small, you get oscillation.$N"
					    "Big number means small PID error addition to winder speed.$N"
					    "Normal running, need 100.$N"
					    "Turret rotation need 80.$N"
					    "At start of 3$Q roll, need 40 for about 5 seconds$N"
					    "Use the 3$Q/6$Q SS for operator control of faster/slower.$N"
					    "The 3$Q-6$Q core switch is used to provide manual pickup speed.";
					N: NOP();
					RC: "Arm the PID Parameters$N"
					    "Minimum Control Valve Position = x % (per manufacturer)";
					N: MOV(p02_real_from_hmi.wdr[40],p29r10_pid_psn.KP)MOV(p02_real_from_hmi.wdr[41],p29r10_pid_psn.KI)MOV(p02_real_from_hmi.wdr[42],p29r10_pid_psn.KD)MOV(p29r10_pid_psn.BIAS,p29r10_pid_psn.BIAS);
					N: PID(p29r10_pid_psn,p29r10_pid_psn_pv,0,p29r10_pid_psn_cv,0,0,0);
					N: XIO(p29_di_wdr_index_fwd)MOV(p29r10_param_psn_gain,p29r10_psn_gain);
					N: XIC(p29_di_wdr_index_fwd)MOV(p29r10_misc_index_factor,p29r10_psn_gain);
					RC: "Accumulator Position to Winder Speed Trim$N"
					    "$N"
					    "Strict proportional, no integral.  Explicit setpoint and explicit gain:$N"
					    "$N"
					    "   error = carriage position - p29_param_acc_park_sp$N"
					    "   trim  = error x p29_param_acc_trim_gain$N"
					    "   trim  clamped to [p29_param_speed_trim_min, p29_param_speed_trim_max]$N"
					    "$N"
					    "Defaults - park 10%, gain 0.02 per % of stroke, clamp +/-0.20:$N"
					    "$N"
					    "        0%  ->  -0.20   winder 0.80 x line, accumulator refills$N"
					    "       10%  ->   0.00   park, winder at line speed, in balance$N"
					    "       20%  ->  +0.20   winder 1.20 x line, drawing down$N"
					    "   above 20%  ->  +0.20  clamped - this IS the payout overspeed$N"
					    "$N"
					    "Nothing commands the carriage to the park position.  Park is simply where$N"
					    "the trim crosses zero, and the loop settles there by negative feedback:$N"
					    "above park the winder outruns the line and the carriage falls, and the$N"
					    "trim shrinks as it approaches.  Steady state offset from park is$N"
					    "(persistent surface speed error) / gain - a 1% speed mismatch parks it$N"
					    "0.5% of stroke off, and it clamps only at a 20% mismatch.$N"
					    "$N"
					    "This replaces a SYS_SCP block that mapped 0-20% onto -0.20/+0.20.  That$N"
					    "worked, but the park position was implicit - it was the midpoint only$N"
					    "because the two trim limits were symmetric, so changing the negative$N"
					    "authority silently moved where the accumulator lived (trim_min -0.10 with$N"
					    "trim_max +0.20 would have parked it at 6.7%).  Setpoint, gain and$N"
					    "authority are now three independent parameters.$N"
					    "$N"
					    "Why proportional only:  carriage position is the INTEGRAL of the speed$N"
					    "difference.  P on an integrating plant is a first order closed loop - it$N"
					    "cannot oscillate on its own and needs no integral term to remove offset.$N"
					    "It also holds no state, so there is no windup and no manual/auto handover.$N"
					    "$N"
					    "If it ever hunts at high line speed, widen the band by REDUCING$N"
					    "p29_param_acc_trim_gain - do not reduce the trim clamp, that is the payout$N"
					    "authority and is now a separate number.$N"
					    "$N"
					    "The load cell PID does not drive speed.  See the rungs above.$N"
					    "$N"
					    "Rev 20260820 a02";
					N: MOV(p29_param_acc_park_sp,p29_param_acc_park_sp)CPT(p29r10_acc_pstn_error,p00_wac_position_pct-p29_param_acc_park_sp);
					N: MOV(p29_param_acc_trim_gain,p29_param_acc_trim_gain)CPT(p29r10_speed_offset,p29r10_acc_pstn_error*p29_param_acc_trim_gain);
					RC: "Speed Trim Limits$N"
					    "$N"
					    "Two different jobs, so two different kinds of limit.$N"
					    "$N"
					    "NORMAL RUNNING - fractional.  The trim is drawing the carriage back to$N"
					    "park, and how fast that should happen scales with line speed, so a$N"
					    "fraction is the right shape.  Recovery time then comes out the same at$N"
					    "5 fpm as at 30 fpm.  Limits are param_speed_trim_max / _min.$N"
					    "$N"
					    "TURRET INDEX - absolute.  The web path length changes at a rate set by$N"
					    "turret speed and swing radius, in fpm.  It does NOT scale with line$N"
					    "speed.  A fraction is the wrong shape: 0.20 gives 6 fpm of authority at$N"
					    "30 fpm line but only 1 fpm at 5 fpm line, where the disturbance is the$N"
					    "same size.  So during an index the limits become +/- the same absolute$N"
					    "fpm at any line speed:$N"
					    "$N"
					    "  trim_hi =  index_trim_fpm / line     ->  winder = line + index_trim_fpm$N"
					    "  trim_lo = -index_trim_fpm / line - 1 ->  winder = -index_trim_fpm$N"
					    "$N"
					    "trim_lo goes past -1 on purpose.  Below 1.0 the factor is negative and$N"
					    "the winder reverses, which it must be able to do: at the bottom of the$N"
					    "5-30 fpm range the path lengthens faster than the line feeds.$N"
					    "$N"
					    "line_guard floors the divisor at 1.0 fpm.  Line speed reaches 0 whenever$N"
					    "the line is stopped and this rung runs every scan.$N"
					    "$N"
					    "Rev 20260825 a26";
					N: MOV(p25_ao_selected_speed,p29r10_line_guard);
					N: LES(p29r10_line_guard,1.0)MOV(1.0,p29r10_line_guard);
					N: XIO(p29r10_index_active)[MOV(p29_param_speed_trim_max,p29r10_trim_hi) ,MOV(p29_param_speed_trim_min,p29r10_trim_lo) ];
					N: XIC(p29r10_index_active)[CPT(p29r10_trim_hi,p29_param_index_trim_fpm/p29r10_line_guard) ,CPT(p29r10_trim_lo,0-(p29_param_index_trim_fpm/p29r10_line_guard)-1) ];
					N: sys_Limit_Clamp(p29r10_trim_clamp,p29r10_trim_hi,p29r10_trim_lo,p29r10_speed_offset);
					RC: "Output Control";
					N: OTE(p29r10.comment.10);
					N: MOV(p01_recipe_active.winder_tension_sp,p29r10_pid_tq.SP);
					N: XIO(p29r10_index_active)OTE(p29r10_pid_tq.SWM);
					N: XIC(p29r10_pid_tq.SWM)MOV(p29_ai_wa_torque,p29r10_pid_tq.SO);
					N: MOV(p29r10_pid_tq.KP,p29r10_pid_tq.KP)MOV(p29r10_pid_tq.KI,p29r10_pid_tq.KI)MOV(p29r10_pid_tq.KD,p29r10_pid_tq.KD)MOV(p29r10_pid_tq.BIAS,p29r10_pid_tq.BIAS)MOV(p29r10_pid_tq.UPD,p29r10_pid_tq.UPD);
					N: PID(p29r10_pid_tq,p29r10_pid_psn_pv,0,p29r10_pid_tq_cv,0,0,0);
					N: MOV(p29r10_pid_tq.OUT,p29r10_pid_torque);
					RC: "Faults";
					N: OTE(p29r10.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r10.fault,p29r10.fault_ack);
					N: XIC(FAULT)[TON(p29r10_timer_fault[0],?,?) ,XIC(p29r10_timer_fault[0].DN) OTL(p29r10.fault.0) ];
					N: XIC(p29r10.fault_ack.0)XIC(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r10.fault.0) ,OTU(p29r10.fault_ack.0) ];
					N: NEQ(p29r10.fault,p29r10.fault_ack)OTE(p29r10.unack_fault);
					RC: "Warnings";
					N: OTE(p29r10.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r10.warning,p29r10.warning_ack);
					N: XIC(FAULT)[TON(p29r10_timer_warning[0],?,?) ,XIC(p29r10_timer_warning[0].DN) OTL(p29r10.warning.0) ];
					N: XIO(FAULT)[OTU(p29r10.warning.0) ,OTU(p29r10.warning_ack.0) ];
					N: NEQ(p29r10.warning,p29r10.warning_ack)OTE(p29r10.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R11_Winder_B_Speed_Control 
					RC: "p29r10$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r11.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r10.comment (dint)$N"
					    "p29r10.oneshot (dint)$N"
					    "p29r10_timer_xxxx (timer)$N"
					    "p29r10_xxxx (any)$N"
					    "p29r10.fault (dint)$N"
					    "p29r10.warning (dint)$N"
					    "";
					N: OTE(p29r11.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r11.comment.2);
					N: EQU(p29r11.fault,0)OTE(p29r11_run_permissive);
					RC: "Requests";
					N: OTE(p29r11.comment.3);
					N: XIC(p29r11_run_permissive)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]XIC(p29r16_wdrb_active)XIC(p29r16_state.6)OTE(p29r11_request_run);
					N: [XIC(p29_di_wdr_index_fwd) ,XIC(p29r16_wdrb_active) XIC(p29r11_index_active) ]OTE(p29r11_index_active);
					N: CPT(p29r11_calc_speed_offset,p29_ai_wb_speed-p25_ao_selected_speed);
					N: CPT(p29r11_pid_out,p29r11_calc_speed_offset/p29r11_psn_gain+50);
					RC: "Auto Start Sequence";
					N: OTE(p29r11.comment.4);
					RC: "Configure PID$N"
					    "The tension loadcell feedback is compared to its setpoint in a PID control.$N"
					    "With the PID output at 50%, error is made to be 0$N"
					    "Error is multiplied to the ramped line speed and added to the ramp line speed to calculate the required speed of the drive.$N"
					    "A gain factor is used to dampen the error effect on the drive speed.(P29R10-10)$N"
					    "The larger the number, the smaller the PID error effect.  Initial setting 60";
					N: OTE(p29r11.comment.5);
					N: TON(p29r11_timer[0],?,?);
					N: MOV(p29_ai_wdr_lc,p29r11_pid_psn_pv);
					N: MOV(p01_recipe_active.winder_tension_sp,p29r11_pid_psn.SP);
					RC: "Tension Error and Load Cell PID - see p29r10.$N"
					    "$N"
					    "Rev 20260820";
					N: CPT(p29r11_tension_error,p01_recipe_active.winder_tension_sp-p29_ai_wdr_lc);
					N: MOV(50,p29r11_pid_psn.SO);
					N: OTE(p29r11_pid_psn.SWM);
					N: XIC(p29_di_wdr_index_fwd)MOV(p29r11_accel_bias,p29r11_pid_psn.BIAS);
					N: XIO(p29_di_wdr_index_fwd)MOV(0.0,p29r11_pid_psn.BIAS);
					N: XIC(p29_di_wdr_index_fwd)MOV(p21r11_index_kp,p29r11_pid_psn.KP)MOV(p21r11_index_ki,p29r11_pid_psn.KI)MOV(p21r11_index_kd,p29r11_pid_psn.KD);
					N: OTU(p29r11_pid_psn.NOBC);
					RC: "If param_psn_gain is too big, fabric will not take up.$N"
					    "If it is too small, you get oscillation.$N"
					    "Big number means small PID error addition to winder speed.$N"
					    "Normal running, need 100.$N"
					    "Turret rotation need 80.$N"
					    "At start of 3$Q roll, need 40 for about 5 seconds$N"
					    "Use the 3$Q/6$Q SS for operator control of faster/slower.$N"
					    "The 3$Q-6$Q core switch is used to provide manual pickup speed.";
					N: NOP();
					N: MOV(p21r11_run_kp,p29r11_pid_psn.KP)MOV(p21r11_run_ki,p29r11_pid_psn.KI)MOV(p21r11_run_kd,p29r11_pid_psn.KD)MOV(p29r11_pid_psn.BIAS,p29r11_pid_psn.BIAS);
					N: MOV(p02_real_from_hmi.wdr[40],p29r11_pid_psn.KP)MOV(p02_real_from_hmi.wdr[41],p29r11_pid_psn.KI)MOV(p02_real_from_hmi.wdr[42],p29r11_pid_psn.KD)MOV(p29r11_pid_psn.BIAS,p29r11_pid_psn.BIAS);
					RC: "If param_psn_gain is too big, fabric will not take up.$N"
					    "If it is too small, you get oscillation.$N"
					    "Big number means small PID error addition to winder speed.$N"
					    "Normal running, need 100.$N"
					    "Turret rotation need 80.$N"
					    "At start of 3$Q roll, need 40 for about 5 seconds$N"
					    "Use the 3$Q/6$Q SS for operator control of faster/slower.$N"
					    "The 3$Q-6$Q core switch is used to provide manual pickup speed.";
					N: PID(p29r11_pid_psn,p29r11_pid_psn_pv,0,p29r11_pid_psn_cv,0,0,0);
					RC: "org 100";
					N: XIO(p29_di_wdr_index_fwd)MOV(p29r11_param_psn_gain,p29r11_psn_gain);
					RC: "org 80";
					N: XIC(p29_di_wdr_index_fwd)MOV(p29r11_misc_index_factor,p29r11_psn_gain);
					RC: "Accumulator Position to Winder Speed Trim$N"
					    "$N"
					    "See p29r10 for the full description.  Explicit setpoint and gain:$N"
					    "$N"
					    "   error = carriage position - p29_param_acc_park_sp$N"
					    "   trim  = error x p29_param_acc_trim_gain, clamped$N"
					    "$N"
					    "Rev 20260820 a02";
					N: MOV(p29_param_acc_park_sp,p29_param_acc_park_sp)CPT(p29r11_acc_pstn_error,p00_wac_position_pct-p29_param_acc_park_sp);
					N: MOV(p29_param_acc_trim_gain,p29_param_acc_trim_gain)CPT(p29r11_speed_offset,p29r11_acc_pstn_error*p29_param_acc_trim_gain);
					RC: "Speed Trim Limits$N"
					    "$N"
					    "Two different jobs, so two different kinds of limit.$N"
					    "$N"
					    "NORMAL RUNNING - fractional.  The trim is drawing the carriage back to$N"
					    "park, and how fast that should happen scales with line speed, so a$N"
					    "fraction is the right shape.  Recovery time then comes out the same at$N"
					    "5 fpm as at 30 fpm.  Limits are param_speed_trim_max / _min.$N"
					    "$N"
					    "TURRET INDEX - absolute.  The web path length changes at a rate set by$N"
					    "turret speed and swing radius, in fpm.  It does NOT scale with line$N"
					    "speed.  A fraction is the wrong shape: 0.20 gives 6 fpm of authority at$N"
					    "30 fpm line but only 1 fpm at 5 fpm line, where the disturbance is the$N"
					    "same size.  So during an index the limits become +/- the same absolute$N"
					    "fpm at any line speed:$N"
					    "$N"
					    "  trim_hi =  index_trim_fpm / line     ->  winder = line + index_trim_fpm$N"
					    "  trim_lo = -index_trim_fpm / line - 1 ->  winder = -index_trim_fpm$N"
					    "$N"
					    "trim_lo goes past -1 on purpose.  Below 1.0 the factor is negative and$N"
					    "the winder reverses, which it must be able to do: at the bottom of the$N"
					    "5-30 fpm range the path lengthens faster than the line feeds.$N"
					    "$N"
					    "line_guard floors the divisor at 1.0 fpm.  Line speed reaches 0 whenever$N"
					    "the line is stopped and this rung runs every scan.$N"
					    "$N"
					    "Rev 20260825 a26";
					N: MOV(p25_ao_selected_speed,p29r11_line_guard);
					N: LES(p29r11_line_guard,1.0)MOV(1.0,p29r11_line_guard);
					N: XIO(p29r11_index_active)[MOV(p29_param_speed_trim_max,p29r11_trim_hi) ,MOV(p29_param_speed_trim_min,p29r11_trim_lo) ];
					N: XIC(p29r11_index_active)[CPT(p29r11_trim_hi,p29_param_index_trim_fpm/p29r11_line_guard) ,CPT(p29r11_trim_lo,0-(p29_param_index_trim_fpm/p29r11_line_guard)-1) ];
					N: sys_Limit_Clamp(p29r11_trim_clamp,p29r11_trim_hi,p29r11_trim_lo,p29r11_speed_offset);
					RC: "Output Control";
					N: OTE(p29r11.comment.10);
					N: MOV(p01_recipe_active.winder_tension_sp,p29r11_pid_tq.SP);
					N: XIO(p29r11_index_active)OTE(p29r11_pid_tq.SWM);
					N: XIC(p29r11_pid_tq.SWM)MOV(p29_ai_wb_torque,p29r11_pid_tq.SO);
					N: MOV(p29r11_pid_tq.KP,p29r11_pid_tq.KP)MOV(p29r11_pid_tq.KI,p29r11_pid_tq.KI)MOV(p29r11_pid_tq.KD,p29r11_pid_tq.KD)MOV(p29r11_pid_tq.BIAS,p29r11_pid_tq.BIAS)MOV(p29r11_pid_tq.UPD,p29r11_pid_tq.UPD);
					N: PID(p29r11_pid_tq,p29r11_pid_psn_pv,0,p29r11_pid_tq_cv,0,0,0);
					N: MOV(p29r11_pid_tq.OUT,p29r11_pid_torque);
					RC: "Faults";
					N: OTE(p29r11.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r11.fault,p29r11.fault_ack);
					N: XIC(FAULT)[TON(p29r11_timer_fault[0],?,?) ,XIC(p29r11_timer_fault[0].DN) OTL(p29r11.fault.0) ];
					N: XIC(p29r11.fault_ack.0)XIC(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r11.fault.0) ,OTU(p29r11.fault_ack.0) ];
					N: NEQ(p29r11.fault,p29r11.fault_ack)OTE(p29r11.unack_fault);
					RC: "Warnings";
					N: OTE(p29r11.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r11.warning,p29r11.warning_ack);
					N: XIC(FAULT)[TON(p29r11_timer_warning[0],?,?) ,XIC(p29r11_timer_warning[0].DN) OTL(p29r11.warning.0) ];
					N: XIO(FAULT)[OTU(p29r11.warning.0) ,OTU(p29r11.warning_ack.0) ];
					N: NEQ(p29r11.warning,p29r11.warning_ack)OTE(p29r11.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R15_Winder_A_VFD 
					RC: "p29r15$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r15.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r15.comment (dint)$N"
					    "p29r15.oneshot (dint)$N"
					    "p29r15_timer_xxxx (timer)$N"
					    "p29r15_xxxx (any)$N"
					    "p29r15.fault (dint)$N"
					    "p29r15.warning (dint)$N"
					    "";
					N: OTE(p29r15.comment.1);
					N: MOV(p02_real_from_hmi.wdr[60],p29r15_jog_torque_ref)MOV(p02_real_from_hmi.wdr[61],p29r15_thread_torque_ref);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r15.comment.2);
					N: CPT(wa_run_position_high_limit,(wa_run_position + param_pos_db))CPT(wa_run_position_low_limit,(wa_run_position - param_pos_db));
					RC: "a04 20260820 - LIM operands were reversed on winder A:$N"
					    "LIM(high, test, low).  LIM evaluates the INVERTED range when Low > High,$N"
					    "so turret_in_wda_run_position was true whenever the turret was OUTSIDE$N"
					    "A$'s run window - backwards.  Winder B was already correct.$N"
					    "$N"
					    "The run permissive below was also missing XIC(turret_in_wda_run_position)$N"
					    "entirely, which winder B has, so winder A would run at any turret$N"
					    "position.  Both were introduced together when the inline LIM in the$N"
					    "permissive was refactored into a named bit and only B was completed.";
					N: LIM(wa_run_position_low_limit,ai_enc_position,wa_run_position_high_limit)OTE(turret_in_wda_run_position);
					RC: "Winder A run permissive$N"
					    "$N"
					    "Only three things stop this winder:  its own fault, E-stop, and the$N"
					    "accumulator.  p29r15_drive_ok is XIO(p01r09.fault.0) and EQU(p29r15.fault,0)$N"
					    "- E-stop and own fault, nothing else.$N"
					    "$N"
					    "p01r13_permissive_drives has been removed from here.  It carried every VFD$N"
					    "fault on the machine, so a fault anywhere else took the winder's permissive$N"
					    "away - and with it jog and thread, which is exactly when you need the winder$N"
					    "to free stuck fabric.$N"
					    "$N"
					    "The turret window stays:  the winder must not run with the turret away from$N"
					    "its run position.  The accumulator has its say through the run request and$N"
					    "through wac_empty_stop / wac_full_stop on the line.$N"
					    "$N"
					    "Rev 20260825 a16";
					N: XIO(p01r09.fault.0)EQU(p29r15.fault,0)OTE(p29r15_drive_ok);
					RC: "Run Permissive - Winder A$N"
					    "$N"
					    "No turret position compare here.  The interlock that matters - the turret$N"
					    "must not be commanded away from a run position with a winder running - is$N"
					    "enforced once, in p29r20 turret_index_permissive, on the thing that moves.$N"
					    "$N"
					    "Duplicating it here as XIC(turret_in_wda_run_position) blocked legitimate$N"
					    "work, because a +/-3 deg window (param_pos_db) is false everywhere except$N"
					    "the run position itself:$N"
					    "$N"
					    "  - no jog or thread of the new winder at the load station, which is where$N"
					    "    the leader is attached and has to be wound on$N"
					    "  - no winding the tail off the doffed roll at doff position$N"
					    "  - no accumulator wind-out unless the turret happens to be at run$N"
					    "  - the winder dropped out 0.7 s into a doff index, web still tensioned$N"
					    "$N"
					    "Rev 20260825 a23";
					N: XIC(p01r13_permissive_drives)EQU(p29r15.fault,0)OTE(p29r15_run_permissive);
					RC: "Requests";
					N: OTE(p29r15.comment.4);
					N: [XIC(p29_di_wdr_a_start) ,XIC(p29r15_wdra_active) ]XIO(p29_di_wdr_a_stop)[OTE(p29r15_wdra_active) ,OTU(p29r16_wdrb_active) ];
					RC: "Run Request - Winder A$N"
					    "$N"
					    "No turret position term.  The turret indexes whenever the operator asks$N"
					    "for it, and this winder keeps winding wherever the turret happens to be,$N"
					    "until the operator presses the winder stop PB.$N"
					    "$N"
					    "Rev 20260825 a28";
					N: XIC(p29r15_run_permissive)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ,GRT(p00_wac_position_pct,p29_param_wind_out_stop_pct) ]XIC(p29r15_wdra_active)OTE(p29r15_request_run);
					N: XIO(p01r13_line_running)XIC(p29r09_winder_a_active)[XIC(p01r09_request_line_jog) ,XIC(p29r15_run_permissive) [XIC(p29_di_wdr_jog) XIC(p29r15_zero_speed) ,XIC(p29r15_request_jog_fwd) XIO(p29r15_zero_speed) ] ]OTE(p29r15_request_jog_fwd);
					N: XIC(p29r15_run_permissive)XIC(p29r09_winder_a_active)XIC(p25r09_mode_thread)[XIC(p25r09_pb_jog_fwd) XIC(p29r15_zero_speed) ,XIC(p29r15_request_thread_fwd) XIO(p29r15_zero_speed) ]OTE(p29r15_request_thread_fwd);
					N: XIC(p29r15_run_permissive)XIC(p29r09_winder_a_active)XIC(p25r09_mode_thread)[XIC(p25r09_pb_jog_rev) XIC(p29r15_zero_speed) ,XIC(p29r15_request_thread_rev) XIO(p29r15_zero_speed) ]OTE(p29r15_request_thread_rev);
					N: MOV(p29_param_soak,p29_param_soak);
					N: CMP(p29_ai_wdr_lc<=(p01_recipe_active.winder_tension_sp+p29_param_soak))CMP(p29_ai_wdr_lc>=(p01_recipe_active.winder_tension_sp-p29_param_soak))OTE(p29r15_soak_active);
					N: LEQ(p29_ao_wdra_selected_speed,0.1)OTE(p29r15_zero_speed);
					RC: "Outputs";
					N: OTE(p29r15.comment.5);
					RC: "Stop Dwell - Winder A$N"
					    "$N"
					    "The operator presses winder stop.  wdra_active drops, request_run drops$N"
					    "with it, and that is what raises the fill request and closes the nip in$N"
					    "p31.  The winder must NOT stop in that same instant - it has to keep$N"
					    "tension on the web until the nip has actually gripped it.$N"
					    "$N"
					    "TOF: DN stays true while request_run is true AND for the preset after it$N"
					    "drops.  So the fill and nip fire immediately, and the drive stays enabled$N"
					    "and at line speed for the dwell, then ramps down normally.$N"
					    "$N"
					    "Rev 20260825 a30";
					N: XIC(p29r15_request_run)TOF(p29r15_stop_dwell,?,?);
					RC: "Winder drive enable - symmetric across A and B$N"
					    "$N"
					    "E-stop clear AND this winder$'s own drive healthy.  Nothing else.$N"
					    "$N"
					    "Winder A previously passed p29r15_run_permissive into its VFD AOI, which$N"
					    "carries the whole-line drive permissive AND the turret position window - so$N"
					    "winder A$'s drive was disabled for the entire doff, and disabled whenever any$N"
					    "other section on the line faulted.  Winder B passed drive_estop_ok, which is$N"
					    "E-stop only and does not check winder B$'s own faults.$N"
					    "$N"
					    "Neither is right.  Turret position belongs on the run REQUEST, where it$N"
					    "already is, not on the drive enable; and the whole-line permissive would$N"
					    "stop you jogging a winder to free the fabric while another section is down.$N"
					    "Own-drive faults do belong here.$N"
					    "$N"
					    "Rev 20260825 a12";
					N: [XIC(p29r15_stop_dwell.DN) ,XIC(p29r15_request_jog_fwd) ,XIC(p29r15_request_thread_fwd) ,XIC(p29r15_request_thread_rev) ]OTE(p29r15_vfd_start_request);
					N: ABB_PROTOCOL_VFD(p29_wda_vfd,p29_wda_status_word,p29_wda_control_word,p29r15_vfd_start_request,p01r09_pb_global_reset,p29r15_drive_ok);
					RC: "Speed Control";
					N: NOP();
					N: [XIC(S:FS) ,XIC(p29r15_state.7) XIC(p29r15_state.0) ,XIC(p29_di_wdr_a_start) ,XIC(p29r09_torque_mode) ,XIC(p29r10_index_active) ,XIC(p29_di_wdr_index_fwd) ONS(p29r15.oneshot.0) ][MOV(0,p29r15_state) ,OTL(p29r15_state.1) ];
					N: XIC(p29r15_state.1)XIC(p29r15_state.0)XIO(p29r10_index_active)XIO(p29r09_torque_mode)[XIC(p29r15_request_run) ,XIC(p29_di_wdr_index_fwd) ][MOV(0,p29r15_state) ,OTL(p29r15_state.2) ];
					N: XIC(p29r15_state.2)XIC(p29r15_state.0)XIO(p29_di_wdr_index_fwd)XIC(p29r15_torque_start_timer.DN)GRT(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp)[MOV(0,p29r15_state) ,OTL(p29r15_state.3) ];
					N: XIC(p29r15_state.2)XIC(p29r15_state.0)XIO(p29_di_wdr_index_fwd)XIC(p29r15_torque_start_timer.DN)LES(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp)[MOV(0,p29r15_state) ,OTL(p29r15_state.4) ];
					N: XIC(p29r15_state.2)XIC(p29r15_state.0)XIO(p29_di_wdr_index_fwd)XIC(p29r15_torque_start_timer.DN)XIC(p29r15_tension_ok)[MOV(0,p29r15_state) ,OTL(p29r15_state.5) ];
					N: [XIC(AFI) XIC(p29r15_state.2) ,XIC(p29r15_state.3) ,XIC(p29r15_state.4) ,XIC(p29r15_state.5) ]XIC(p29r15_state.0)[XIO(p29r15_state.2) XIC(p29r15_tension_ok) ,XIC(p29r15_state.2) GRT(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp) ][MOV(0,p29r15_state) ,OTL(p29r15_state.6) ];
					N: [XIC(p29r15_state.6) ,XIC(p29r15_state.2) ,XIC(p29r15_state.3) ,XIC(p29r15_state.4) ,XIC(p29r15_state.5) ]XIC(p29r15_state.0)XIO(p29r15_request_run)[MOV(0,p29r15_state) ,OTL(p29r15_state.7) ];
					N: OTE(p29r15_state.0);
					RC: "Speed Control";
					N: NOP();
					RC: "Tension established band$N"
					    "$N"
					    "Was hard coded +/-3 on winder A and +/-5 on winder B, so B declared tension$N"
					    "established on the looser criterion and reached state .6 - and therefore$N"
					    "started accumulator payout - sooner and at a wider tension error.$N"
					    "$N"
					    "Both now use p29_param_tension_ok_band, one shared parameter, so they$N"
					    "cannot drift apart again.$N"
					    "$N"
					    "Rev 20260825 a11";
					N: CMP(p29_ai_wdr_lc<=(p01_recipe_active.winder_tension_sp+p29_param_tension_ok_band))CMP(p29_ai_wdr_lc>=(p01_recipe_active.winder_tension_sp-p29_param_tension_ok_band))OTE(p29r15_tension_ok);
					N: XIC(p29r15_state.2)GRT(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp)TON(p29r15_torque_start_timer,?,?);
					RC: "Speed Control";
					N: NOP();
					N: XIC(p29_wda_vfd.OUT_ENABLED)[XIC(p29r09_torque_mode) ,XIO(p29r09_torque_mode) LES(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp) ]TON(p29r15_torque_boost_timer,?,?);
					N: XIO(p29r09_torque_mode)XIO(p29r10_index_active)MOV(p29_ai_wa_torque,p29r15_index_start_torque);
					RC: "Stage 2 - selected torque, LOWEST priority first, last rung to write wins$N"
					    "$N"
					    "   0                       default$N"
					    "   calc_torque_ref         torque mode - recipe setpoint x diameter$N"
					    "   const_torque_ref        state .2 - starting torque, 36% or 50% by core$N"
					    "   torque_low_ref          state .3 - tension above setpoint$N"
					    "   torque_high_ref         state .4 - tension below setpoint$N"
					    "   torque_high_ref         state .6 - running$N"
					    "   index_start_torque      indexing - held from the last tension value$N"
					    "   jog_torque_ref          jog$N"
					    "   thread_torque_ref       thread$N"
					    "   torque_boost_ref        boost timer or start pushbutton$N"
					    "   payout_torque           accumulator paying out, line running$N"
					    "   wind_out_torque         accumulator paying out, line stopped$N";
					N: MOV(0.0,p29r15_selected_torque);
					N: XIC(p29r09_torque_mode)MOV(p29r02_wa_calc_torque_ref,p29r15_selected_torque);
					N: XIC(p29r15_state.2)MOV(p29r15_const_torque_ref,p29r15_ao_torque);
					N: XIC(p29r15_state.3)MOV(p29r15_torque_low_ref,p29r15_selected_torque);
					N: XIC(p29r15_state.4)MOV(p29r15_torque_high_ref,p29r15_selected_torque);
					N: XIC(p29r15_state.6)MOV(p29r15_torque_high_ref,p29r15_selected_torque);
					N: XIC(p29r15_request_run)XIC(p29r15_state.6)XIC(p00_wac.OUT_Acc_Payout)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]MOV(p29_param_payout_torque,p29r15_selected_torque);
					N: XIC(p29r15_request_run)XIO(p01r13_line_running)XIO(p01r13_line_slow_ramp)MOV(p29_param_wind_out_torque,p29r15_selected_torque);
					N: XIC(p29r15_request_jog_fwd)MOV(p29r15_jog_torque_ref,p29r15_ao_torque);
					N: [XIC(p29r15_request_thread_fwd) ,XIC(p29r15_request_thread_rev) ]MOV(p29r15_thread_torque_ref,p29r15_ao_torque);
					N: [XIC(p29r15_torque_boost_timer.TT) ,XIC(p29_di_wdr_a_start) ][XIO(p29r09_torque_mode) MOV(p29r15_torque_boost_ref,p29r15_selected_torque) ,XIC(p29r09_torque_mode) CPT(p29r15_selected_torque,p29r02_wa_calc_torque_ref*2) ];
					RC: "Stage 3 - ramp rates";
					N: XIO(p29r09_torque_mode)XIO(p29r15_soak_active)MOV(p29r15_torque_fast_acc_rate,p29r15_torque_acc_rate)MOV(p29r15_torque_fast_dec_rate,p29r15_torque_dec_rate);
					N: XIO(p29r09_torque_mode)XIC(p29r15_soak_active)MOV(p29r15_torque_soak_acc_rate,p29r15_torque_acc_rate)MOV(p29r15_torque_soak_dec_rate,p29r15_torque_dec_rate);
					N: XIC(p29r09_torque_mode)MOV(p29r15_torque_mode_acc_rate,p29r15_torque_acc_rate)MOV(p29r15_torque_mode_dec_rate,p29r15_torque_dec_rate);
					N: XIC(p29_di_wdr_a_start)MOV(p29r15_torque_boost_acc_rate,p29r15_torque_acc_rate)MOV(p29r15_torque_boost_dec_rate,p29r15_torque_dec_rate);
					RC: "Stage 4 - the only place winder A's torque output is written";
					N: SYS_ACC_DEC_RAMP(p29r15_torque_ramp,p29r15_selected_torque,p29r15_torque_acc_rate,p29r15_torque_dec_rate,p01r02_plc_scan_time_in_sec,p29r15_ao_torque)MOV(p29r15_ao_torque,p29r15_ao_torque);
					RC: "Frozen Index Torque - Winder A$N"
					    "$N"
					    "Written AFTER the ramp, direct to ao_torque, so it is the last word.$N"
					    "That is how the original ran and it is what the operation depends on.$N"
					    "$N"
					    "index_start_torque tracks actual torque continuously while NOT indexing,$N"
					    "so the instant INDEX FWD is pressed the winder is commanded exactly the$N"
					    "torque it was already pulling, and holds it.  Constant torque on a roll$N"
					    "of known radius is constant tension, so the arc cannot disturb the web -$N"
					    "nothing has to compute the geometry.$N"
					    "$N"
					    "index_active is a SEAL, cleared only by stopping the winder, so the$N"
					    "freeze holds for the rest of the roll.  As the roll builds, tension falls$N"
					    "as torque/radius - a natural taper of roughly 2 to 10 percent over the$N"
					    "back of the roll depending on web thickness.  That is the existing$N"
					    "winding behaviour and it is deliberately preserved.$N"
					    "$N"
					    "It was briefly moved into the selected_torque cascade during the a19$N"
					    "refactor, which let the jog, thread and 90 percent start boost rungs$N"
					    "override it mid-index.  Restored.$N"
					    "$N"
					    "Rev 20260831";
					N: XIO(p29r09_torque_mode)XIC(p29r10_index_active)XIC(p29r15_request_run)[GRT(p29_ai_wa_torque,0) MOV(p29r15_index_start_torque,p29r15_ao_torque) ,LEQ(p29_ai_wa_torque,0) MOV(p29r15_jog_torque_ref,p29r15_ao_torque) ];
					RC: "Speed Control - Winder A$N"
					    "$N"
					    "Five stages, and each winder now owns every one of them.  Winder A and B$N"
					    "are identical rung for rung apart from their own tag names, so both can$N"
					    "jog, thread or wind out at the same time without fighting over a shared$N"
					    "setpoint and a shared ramp.$N"
					    "$N"
					    "  1  speed setpoint   fpm - where the speed comes from$N"
					    "  2  own accel/decel ramp$N"
					    "  3  speed factor     dimensionless - which mode is active$N"
					    "  4  one multiply     the ONLY place this winder's speed is calculated$N"
					    "  5  output ramp and clamp$N"
					    "$N"
					    "This replaces a cascade of nine writes to p29r15_selected_speed and four to$N"
					    "a shared winder_speed_setpoint, where the last rung to execute won and the$N"
					    "precedence was nowhere stated.  Two faults came straight out of that:$N"
					    "$N"
					    "  - the shared MOV(0,winder_speed_setpoint) fired whenever the line was not$N"
					    "    running and no jog was requested, which cancelled the wind out setpoint$N"
					    "    two rungs after it was written.  Wind out never ran.$N"
					    "  - the shared ramp lived inside p29r15, so it executed before p29r16 had$N"
					    "    written the setpoint at all.$N"
					    "$N"
					    "Stage 3 is still a priority cascade - that is idiomatic in ladder - but it$N"
					    "is over a dimensionless factor, listed lowest priority first, and it is$N"
					    "trendable online so the active mode can be seen rather than inferred.$N"
					    "$N"
					    "Rev 20260825 a18";
					N: OTE(p29r15.comment.7);
					RC: "Stage 1 - speed setpoint [fpm]";
					N: MOV(0,p29r15_speed_setpoint);
					N: [XIC(p29r15_request_run) ,XIC(p29r15_request_thread_fwd) ,XIC(p29r15_request_thread_rev) ]MOV(p25_ao_selected_speed,p29r15_speed_setpoint);
					N: XIC(p29r15_request_run)XIO(p01r13_line_running)XIO(p01r13_line_slow_ramp)MOV(p29_param_wind_out_speed,p29r15_speed_setpoint);
					N: XIC(p29r15_request_jog_fwd)MOV(p29_param_winder_jog_speed,p29r15_speed_setpoint);
					RC: "Stage 2 - winder A's own ramp.  Rates are shared but the ramp is not, so the two winders no longer share one ramp state.";
					N: LEQ(winder_accel_rate,0)MOV(p29_param_winder_accel_rate,winder_accel_rate);
					N: LEQ(winder_decel_rate,0)MOV(p29_param_winder_decel_rate,winder_decel_rate);
					N: SYS_ACC_DEC_RAMP(p29r15_acel_decel_ramp,p29r15_speed_setpoint,winder_accel_rate,winder_decel_rate,p01r02_plc_scan_time_in_sec,p29r15_ramped_setpoint)MOV(p29r15_ramped_setpoint,p29r15_ramped_setpoint);
					RC: "Stage 3 - speed factor, LOWEST priority first, last rung to write wins$N"
					    "$N"
					    "   0.0                        stopped$N"
					    "   1.0                        jog$N"
					    "   1.5                        thread fwd, or torque mode$N"
					    "   start_speed_factor         running, before state .6 - start slow$N"
					    "   3.0                        boost pushbutton, before state .6$N"
					    "  -1.5                        thread reverse$N"
					    "   1 + p29r10_speed_offset    state .6 - accumulator position trim$N"
					    "   1.0                        line stopped - wind out, trim bypassed$N"
					    "   0.0                        turret going to doff$N";
					N: MOV(0.0,p29r15_speed_factor);
					N: XIC(p29r15_request_jog_fwd)MOV(1.0,p29r15_speed_factor);
					N: [XIC(p29r15_request_thread_fwd) ,XIC(p29r15_request_run) XIC(p29r09_torque_mode) ]MOV(1.5,p29r15_speed_factor);
					N: XIC(p29r15_request_run)XIO(p29r09_torque_mode)XIO(p29r15_state.6)MOV(p29_param_start_speed_factor,p29r15_speed_factor);
					N: XIC(p29r15_request_run)XIC(p29_di_wdr_a_start)[XIO(p29r15_state.6) ,XIC(p29r09_torque_mode) ]MOV(3.0,p29r15_speed_factor);
					N: XIC(p29r15_request_thread_rev)MOV(-1.5,p29r15_speed_factor);
					N: XIC(p29r15_stop_dwell.DN)XIC(p29r15_state.6)CPT(p29r15_speed_factor,1+p29r10_speed_offset);
					N: XIC(p29r15_request_run)XIO(p01r13_line_running)XIO(p01r13_line_slow_ramp)MOV(1.0,p29r15_speed_factor);
					RC: "Stage 4 - the only place winder A's speed is calculated";
					N: CPT(p29r15_selected_speed,p29r15_ramped_setpoint*p29r15_speed_factor);
					RC: "Stage 5 - output ramp and clamp";
					N: MOV(p29r15_fast_accel_rate,p29r15_accel_rate)MOV(p29r15_fast_decel_rate,p29r15_decel_rate)SYS_ACC_DEC_RAMP(p29r15_wdra_accel_decel,p29r15_selected_speed,p29r15_accel_rate,p29r15_decel_rate,p01r02_plc_scan_time_in_sec,p29r15_wdra_ramped_speed)MOV(p29r15_wdra_ramped_speed,p29_ao_wdra_selected_speed);
					RC: "Output Clamp$N"
					    "$N"
					    "Loss of run permissive always zeroes the output.$N"
					    "$N"
					    "The floor at zero is separate, and no longer unconditional.  It used to$N"
					    "be OR-ed with the permissive test, so ANY negative speed was clamped to$N"
					    "0 - which silently killed thread reverse, since request_thread_rev sets$N"
					    "a speed factor of -1.5 and every bit of it was thrown away at this rung.$N"
					    "$N"
					    "It also blocked the reverse the turret index needs at low line speed.$N"
					    "$N"
					    "So the floor now applies except where reverse is deliberate: thread$N"
					    "reverse, or an index in progress.  SYS_SPEED_TO_VFD passes a negative$N"
					    "speed straight through - it only guards gear ratio and diameter - so the$N"
					    "drive must be configured for a bipolar speed reference for this to do$N"
					    "anything at the motor.$N"
					    "$N"
					    "Rev 20260825 a26";
					N: XIO(p29r15_run_permissive)MOV(0,p29_ao_wdra_selected_speed);
					N: XIO(p29r15_request_thread_rev)XIO(p29r10_index_active)LES(p29_ao_wdra_selected_speed,0)MOV(0,p29_ao_wdra_selected_speed);
					RC: "Faults";
					N: OTE(p29r15.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r15.fault,p29r15.fault_ack);
					N: XIC(p29_wda_status_word.3)[TON(p29r15_timer_fault[0],?,?) ,XIC(p29r15_timer_fault[0].DN) OTL(p29r15.fault.0) ];
					N: XIC(p29r15.fault_ack.0)XIO(p29_wda_status_word.3)XIC(p01r09_pb_global_reset)[OTU(p29r15.fault.0) ,OTU(p29r15.fault_ack.0) ];
					N: XIO(p29_wda_status_word.0)[TON(p29r15_timer_fault[2],?,?) ,XIC(p29r15_timer_fault[2].DN) OTL(p29r15.fault.2) ];
					N: XIC(p29r15.fault_ack.2)XIC(p29_wda_status_word.0)XIC(p01r09_pb_global_reset)[OTU(p29r15.fault.2) ,OTU(p29r15.fault_ack.2) ];
					N: XIC(p29_wda_status_word.1)XIO(p29_wda_status_word.9)[TON(p29r15_timer_fault[3],?,?) ,XIC(p29r15_timer_fault[3].DN) OTL(p29r15.fault.3) ];
					N: XIC(p29r15.fault_ack.3)[XIC(p29_wda_status_word.9) ,XIO(p29_wda_status_word.1) ]XIC(p01r09_pb_global_reset)[OTU(p29r15.fault.3) ,OTU(p29r15.fault_ack.3) ];
					N: XIO(p29_di_wa_motor)[TON(p29r15_timer_fault[4],?,?) ,XIC(p29r15_timer_fault[4].DN) OTL(p29r15.fault.4) ];
					N: XIC(p29r15.fault_ack.4)XIC(p29_di_wa_motor)XIC(p01r09_pb_global_reset)[OTU(p29r15.fault.4) ,OTU(p29r15.fault_ack.4) ];
					N: XIO(p29_di_wa_brake)[TON(p29r15_timer_fault[5],?,?) ,XIC(p29r15_timer_fault[5].DN) OTL(p29r15.fault.5) ];
					N: XIC(p29r15.fault_ack.5)XIC(p29_di_wa_brake)XIC(p01r09_pb_global_reset)[OTU(p29r15.fault.5) ,OTU(p29r15.fault_ack.5) ];
					RC: "Winder Tension High$N"
					    "$N"
					    "a04 20260820 - the reset rung used OTL, so it re-latched the fault it was$N"
					    "meant to clear.  p29r15.fault.6 could never be cleared, and because$N"
					    "p29r15_run_permissive and p01r13_permissive_drives both gate on$N"
					    "EQU(p29r15.fault,0), the first tension high event locked out every drive$N"
					    "on the line until a download or an online force.$N"
					    "$N"
					    "Now OTU, and following the same pattern as every other fault in this$N"
					    "routine:  acknowledged, condition gone, reset pressed - then clear both$N"
					    "the fault bit and its ack bit so unack_fault clears with it.$N"
					    "$N"
					    "Note p29_ai_wdr_lc is a single load cell shared by both winders, so a$N"
					    "tension excursion latches fault.6 on A and B together.  That is correct$N"
					    "for one web, but both need the reset.";
					N: GRT(p29_ai_wdr_lc,p29_param_tension_hi_limit)[TON(p29r15_timer_fault[6],?,?) ,XIC(p29r15_timer_fault[6].DN) OTL(p29r15.fault.6) ];
					N: XIC(p29r15.fault_ack.6)CMP(p29_ai_wdr_lc<(p29_param_tension_hi_limit - 20))XIC(p01r09_pb_global_reset)[OTU(p29r15.fault.6) ,OTU(p29r15.fault_ack.6) ];
					N: NEQ(p29r15.fault,p29r15.fault_ack)OTE(p29r15.unack_fault);
					RC: "Warnings";
					N: OTE(p29r15.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r15.warning,p29r15.warning_ack);
					N: XIC(p29_wda_status_word.7)[TON(p29r15_timer_warning[0],?,?) ,XIC(p29r15_timer_warning[0].DN) OTL(p29r15.warning.0) ];
					N: XIC(p29r15.warning_ack.0)XIO(p29_wda_status_word.7)[OTU(p29r15.warning.0) ,OTU(p29r15.warning_ack.0) ];
					N: XIO(p29r09_torque_mode)XIC(p29r15_request_run)XIC(p29_wda_vfd.OUT_ENABLED)LES(p29_ai_wdr_lc,p29r02_tension_dev_min)[TON(p29r15_timer_warning[1],?,?) ,XIC(p29r15_timer_warning[1].DN) OTL(p29r15.warning.1) ];
					N: [XIC(p29r09_torque_mode) ,XIO(p29r15_request_run) ,XIO(p29_wda_vfd.OUT_ENABLED) ,GEQ(p29_ai_wdr_lc,p29r02_tension_dev_min) ]OTU(p29r15.warning.1);
					N: XIO(p29r09_torque_mode)XIC(p29r15_request_run)XIC(p29_wda_vfd.OUT_ENABLED)GRT(p29_ai_wdr_lc,p29r02_tension_dev_max)[TON(p29r15_timer_warning[2],?,?) ,XIC(p29r15_timer_warning[2].DN) OTL(p29r15.warning.2) ];
					N: [XIC(p29r09_torque_mode) ,XIO(p29r15_request_run) ,XIO(p29_wda_vfd.OUT_ENABLED) ,LEQ(p29_ai_wdr_lc,p29r02_tension_dev_min) ]OTU(p29r15.warning.2);
					N: XIC(p29r15_wdra_active)XIO(turret_auto_index_request)XIO(p29_di_wdr_index_fwd)XIO(pb_jog_turret_rev)XIO(turret_in_wda_run_position)OTE(p29r15.warning.3);
					N: NEQ(p29r15.warning,p29r15.warning_ack)OTE(p29r15.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R16_Winder_B_VFD 
					RC: "p29r16$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r16.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r16.comment (dint)$N"
					    "p29r16.oneshot (dint)$N"
					    "p29r16_timer_xxxx (timer)$N"
					    "p29r16_xxxx (any)$N"
					    "p29r16.fault (dint)$N"
					    "p29r16.warning (dint)$N"
					    "";
					N: OTE(p29r16.comment.1);
					N: MOV(p02_real_from_hmi.wdr[60],p29r16_jog_torque_ref)MOV(p02_real_from_hmi.wdr[61],p29r16_thread_torque_ref);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r16.comment.2);
					RC: "Run Permissive - Winder B$N"
					    "$N"
					    "No turret position compare here.  The interlock that matters - the turret$N"
					    "must not be commanded away from a run position with a winder running - is$N"
					    "enforced once, in p29r20 turret_index_permissive, on the thing that moves.$N"
					    "$N"
					    "Duplicating it here as XIC(turret_in_wdb_run_position) blocked legitimate$N"
					    "work, because a +/-3 deg window (param_pos_db) is false everywhere except$N"
					    "the run position itself:$N"
					    "$N"
					    "  - no jog or thread of the new winder at the load station, which is where$N"
					    "    the leader is attached and has to be wound on$N"
					    "  - no winding the tail off the doffed roll at doff position$N"
					    "  - no accumulator wind-out unless the turret happens to be at run$N"
					    "  - the winder dropped out 0.7 s into a doff index, web still tensioned$N"
					    "$N"
					    "Rev 20260825 a23";
					N: XIC(p01r13_permissive_drives)EQU(p29r16.fault,0)OTE(p29r16_run_permissive);
					N: CPT(wb_run_position_high_limit,(wb_run_position + param_pos_db))CPT(wb_run_position_low_limit,(wb_run_position - param_pos_db));
					RC: "a04 20260820 - LIM operands were reversed on winder B:$N"
					    "LIM(high, test, low).  LIM evaluates the INVERTED range when Low > High,$N"
					    "so turret_in_wdb_run_position was true whenever the turret was OUTSIDE$N"
					    "B$'s run window - backwards.  Winder B was already correct.$N"
					    "$N"
					    "The run permissive below was also missing XIC(turret_in_wdb_run_position)$N"
					    "entirely, which winder B has, so winder B would run at any turret$N"
					    "position.  Both were introduced together when the inline LIM in the$N"
					    "permissive was refactored into a named bit and only B was completed.";
					N: LIM(wb_run_position_low_limit,ai_enc_position,wb_run_position_high_limit)OTE(turret_in_wdb_run_position);
					RC: "Winder B run permissive$N"
					    "$N"
					    "Only three things stop this winder:  its own fault, E-stop, and the$N"
					    "accumulator.  p29r16_drive_ok is XIO(p01r09.fault.0) and EQU(p29r16.fault,0)$N"
					    "- E-stop and own fault, nothing else.$N"
					    "$N"
					    "p01r13_permissive_drives has been removed from here.  It carried every VFD$N"
					    "fault on the machine, so a fault anywhere else took the winder's permissive$N"
					    "away - and with it jog and thread, which is exactly when you need the winder$N"
					    "to free stuck fabric.$N"
					    "$N"
					    "The turret window stays:  the winder must not run with the turret away from$N"
					    "its run position.  The accumulator has its say through the run request and$N"
					    "through wac_empty_stop / wac_full_stop on the line.$N"
					    "$N"
					    "Rev 20260825 a16";
					N: XIO(p01r09.fault.0)EQU(p29r16.fault,0)OTE(p29r16_drive_ok);
					RC: "Requests";
					N: OTE(p29r16.comment.4);
					N: [XIC(p29_di_wdr_b_start) ,XIC(p29r16_wdrb_active) ]XIO(p29_di_wdr_b_stop)[OTE(p29r16_wdrb_active) ,OTU(p29r15_wdra_active) ];
					RC: "Run Request - Winder B$N"
					    "$N"
					    "No turret position term.  The turret indexes whenever the operator asks$N"
					    "for it, and this winder keeps winding wherever the turret happens to be,$N"
					    "until the operator presses the winder stop PB.$N"
					    "$N"
					    "Rev 20260825 a28";
					N: XIC(p29r16_run_permissive)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ,GRT(p00_wac_position_pct,p29_param_wind_out_stop_pct) ]XIC(p29r16_wdrb_active)OTE(p29r16_request_run);
					N: XIO(p01r13_line_running)XIC(p29r09_winder_b_active)[XIC(p01r09_request_line_jog) ,XIC(p29r16_run_permissive) [XIC(p29_di_wdr_jog) XIC(p29r16_zero_speed) ,XIC(p29r16_request_jog_fwd) XIO(p29r16_zero_speed) ] ]OTE(p29r16_request_jog_fwd);
					N: XIC(p29r16_run_permissive)XIC(p29r09_winder_b_active)XIC(p25r09_mode_thread)[XIC(p25r09_pb_jog_fwd) XIC(p29r16_zero_speed) ,XIC(p29r16_request_thread_fwd) XIO(p29r16_zero_speed) ]OTE(p29r16_request_thread_fwd);
					N: XIC(p29r16_run_permissive)XIC(p29r09_winder_b_active)XIC(p25r09_mode_thread)[XIC(p25r09_pb_jog_rev) XIC(p29r16_zero_speed) ,XIC(p29r16_request_thread_rev) XIO(p29r16_zero_speed) ]OTE(p29r16_request_thread_rev);
					N: MOV(p29_param_soak,p29_param_soak);
					N: CMP(p29_ai_wdr_lc<=(p01_recipe_active.winder_tension_sp+p29_param_soak))CMP(p29_ai_wdr_lc>=(p01_recipe_active.winder_tension_sp-p29_param_soak))OTE(p29r16_soak_active);
					N: LEQ(p29_ao_wdrb_selected_speed,0.1)OTE(p29r16_zero_speed);
					RC: "Outputs";
					N: OTE(p29r16.comment.5);
					N: ABB_PROTOCOL_VFD(p29_wdb_vfd,p29_wdb_status_word,p29_wdb_control_word,p29r16_vfd_start_request,p01r09_pb_global_reset,p29r16_drive_ok);
					RC: "Stop Dwell - Winder B$N"
					    "$N"
					    "The operator presses winder stop.  wdrb_active drops, request_run drops$N"
					    "with it, and that is what raises the fill request and closes the nip in$N"
					    "p31.  The winder must NOT stop in that same instant - it has to keep$N"
					    "tension on the web until the nip has actually gripped it.$N"
					    "$N"
					    "TOF: DN stays true while request_run is true AND for the preset after it$N"
					    "drops.  So the fill and nip fire immediately, and the drive stays enabled$N"
					    "and at line speed for the dwell, then ramps down normally.$N"
					    "$N"
					    "Rev 20260825 a30";
					N: XIC(p29r16_request_run)TOF(p29r16_stop_dwell,?,?);
					RC: "Winder drive enable - symmetric across A and B$N"
					    "$N"
					    "E-stop clear AND this winder$'s own drive healthy.  Nothing else.$N"
					    "$N"
					    "Winder B previously passed p29r16_run_permissive into its VFD AOI, which$N"
					    "carries the whole-line drive permissive AND the turret position window - so$N"
					    "winder B$'s drive was disabled for the entire doff, and disabled whenever any$N"
					    "other section on the line faulted.  Winder B passed drive_estop_ok, which is$N"
					    "E-stop only and does not check winder B$'s own faults.$N"
					    "$N"
					    "Neither is right.  Turret position belongs on the run REQUEST, where it$N"
					    "already is, not on the drive enable; and the whole-line permissive would$N"
					    "stop you jogging a winder to free the fabric while another section is down.$N"
					    "Own-drive faults do belong here.$N"
					    "$N"
					    "Rev 20260825 a12";
					N: [XIC(p29r16_stop_dwell.DN) ,XIC(p29r16_request_jog_fwd) ,XIC(p29r16_request_thread_fwd) ,XIC(p29r16_request_thread_rev) ]OTE(p29r16_vfd_start_request);
					RC: "Speed Control";
					N: NOP();
					N: [XIC(S:FS) ,XIC(p29r16_state.7) XIC(p29r16_state.0) ,XIC(p29_di_wdr_b_start) ,XIC(p29r09_torque_mode) ,XIC(p29r11_index_active) ,XIC(p29_di_wdr_index_fwd) ONS(p29r16.oneshot.0) ][MOV(0,p29r16_state) ,OTL(p29r16_state.1) ];
					N: XIC(p29r16_state.1)XIC(p29r16_state.0)XIO(p29r11_index_active)XIO(p29r09_torque_mode)[XIC(p29r16_request_run) ,XIC(p29_di_wdr_index_fwd) ][MOV(0,p29r16_state) ,OTL(p29r16_state.2) ];
					N: XIC(p29r16_state.2)XIC(p29r16_state.0)XIO(p29_di_wdr_index_fwd)XIC(p29r16_torque_start_timer.DN)GRT(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp)[MOV(0,p29r16_state) ,OTL(p29r16_state.3) ];
					N: XIC(p29r16_state.2)XIC(p29r16_state.0)XIO(p29_di_wdr_index_fwd)XIC(p29r16_torque_start_timer.DN)LES(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp)[MOV(0,p29r16_state) ,OTL(p29r16_state.4) ];
					N: XIC(p29r16_state.2)XIC(p29r16_state.0)XIO(p29_di_wdr_index_fwd)XIC(p29r16_torque_start_timer.DN)XIC(p29r16_tension_ok)[MOV(0,p29r16_state) ,OTL(p29r16_state.5) ];
					N: [XIC(AFI) XIC(p29r16_state.2) ,XIC(p29r16_state.3) ,XIC(p29r16_state.4) ,XIC(p29r16_state.5) ]XIC(p29r16_state.0)[XIO(p29r16_state.2) XIC(p29r16_tension_ok) ,XIC(p29r16_state.2) GRT(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp) ][MOV(0,p29r16_state) ,OTL(p29r16_state.6) ];
					N: [XIC(p29r16_state.6) ,XIC(p29r16_state.2) ,XIC(p29r16_state.3) ,XIC(p29r16_state.4) ,XIC(p29r16_state.5) ]XIC(p29r16_state.0)XIO(p29r16_request_run)[MOV(0,p29r16_state) ,OTL(p29r16_state.7) ];
					N: OTE(p29r16_state.0);
					RC: "Speed Control";
					N: NOP();
					RC: "Tension established band$N"
					    "$N"
					    "Was hard coded +/-3 on winder B and +/-5 on winder B, so B declared tension$N"
					    "established on the looser criterion and reached state .6 - and therefore$N"
					    "started accumulator payout - sooner and at a wider tension error.$N"
					    "$N"
					    "Both now use p29_param_tension_ok_band, one shared parameter, so they$N"
					    "cannot drift apart again.$N"
					    "$N"
					    "Rev 20260825 a11";
					N: CMP(p29_ai_wdr_lc<=(p01_recipe_active.winder_tension_sp+p29_param_tension_ok_band))CMP(p29_ai_wdr_lc>=(p01_recipe_active.winder_tension_sp-p29_param_tension_ok_band))OTE(p29r16_tension_ok);
					N: XIC(p29r16_state.2)GRT(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp)TON(p29r16_torque_start_timer,?,?);
					RC: "Speed Control";
					N: NOP();
					N: XIC(p29_wdb_vfd.OUT_ENABLED)[XIC(p29r09_torque_mode) ,XIO(p29r09_torque_mode) LES(p29_ai_wdr_lc,p01_recipe_active.winder_tension_sp) ]TON(p29r16_torque_boost_timer,?,?);
					N: XIO(p29r09_torque_mode)XIO(p29r11_index_active)MOV(p29_ai_wb_torque,p29r16_index_start_torque);
					RC: "Stage 2 - selected torque, LOWEST priority first, last rung to write wins$N"
					    "$N"
					    "   0                       default$N"
					    "   calc_torque_ref         torque mode - recipe setpoint x diameter$N"
					    "   const_torque_ref        state .2 - starting torque, 36% or 50% by core$N"
					    "   torque_low_ref          state .3 - tension above setpoint$N"
					    "   torque_high_ref         state .4 - tension below setpoint$N"
					    "   torque_high_ref         state .6 - running$N"
					    "   index_start_torque      indexing - held from the last tension value$N"
					    "   jog_torque_ref          jog$N"
					    "   thread_torque_ref       thread$N"
					    "   torque_boost_ref        boost timer or start pushbutton$N"
					    "   payout_torque           accumulator paying out, line running$N"
					    "   wind_out_torque         accumulator paying out, line stopped$N";
					N: MOV(0.0,p29r16_selected_torque);
					N: XIC(p29r09_torque_mode)MOV(p29r02_wb_calc_torque_ref,p29r16_selected_torque);
					N: XIC(p29r16_state.2)MOV(p29r16_const_torque_ref,p29r16_ao_torque);
					N: XIC(p29r16_state.3)MOV(p29r16_torque_low_ref,p29r16_selected_torque);
					N: XIC(p29r16_state.4)MOV(p29r16_torque_high_ref,p29r16_selected_torque);
					N: XIC(p29r16_state.6)MOV(p29r16_torque_high_ref,p29r16_selected_torque);
					N: XIC(p29r16_request_run)XIC(p29r16_state.6)XIC(p00_wac.OUT_Acc_Payout)[XIC(p01r13_line_running) ,XIC(p01r13_line_slow_ramp) ]MOV(p29_param_payout_torque,p29r16_selected_torque);
					N: XIC(p29r16_request_run)XIO(p01r13_line_running)XIO(p01r13_line_slow_ramp)MOV(p29_param_wind_out_torque,p29r16_selected_torque);
					N: XIC(p29r16_request_jog_fwd)MOV(p29r16_jog_torque_ref,p29r16_ao_torque);
					N: [XIC(p29r16_request_thread_fwd) ,XIC(p29r16_request_thread_rev) ]MOV(p29r16_thread_torque_ref,p29r16_ao_torque);
					N: [XIC(p29r16_torque_boost_timer.TT) ,XIC(p29_di_wdr_b_start) ][XIO(p29r09_torque_mode) MOV(p29r16_torque_boost_ref,p29r16_selected_torque) ,XIC(p29r09_torque_mode) CPT(p29r16_selected_torque,p29r02_wb_calc_torque_ref*2) ];
					RC: "Stage 3 - ramp rates";
					N: XIO(p29r09_torque_mode)XIO(p29r16_soak_active)MOV(p29r16_torque_fast_acc_rate,p29r16_torque_acc_rate)MOV(p29r16_torque_fast_dec_rate,p29r16_torque_dec_rate);
					N: XIO(p29r09_torque_mode)XIC(p29r16_soak_active)MOV(p29r16_torque_soak_acc_rate,p29r16_torque_acc_rate)MOV(p29r16_torque_soak_dec_rate,p29r16_torque_dec_rate);
					N: XIC(p29r09_torque_mode)MOV(p29r16_torque_mode_acc_rate,p29r16_torque_acc_rate)MOV(p29r16_torque_mode_dec_rate,p29r16_torque_dec_rate);
					N: XIC(p29_di_wdr_b_start)MOV(p29r16_torque_boost_acc_rate,p29r16_torque_acc_rate)MOV(p29r16_torque_boost_dec_rate,p29r16_torque_dec_rate);
					RC: "Stage 4 - the only place winder B's torque output is written";
					N: SYS_ACC_DEC_RAMP(p29r16_torque_ramp,p29r16_selected_torque,p29r16_torque_acc_rate,p29r16_torque_dec_rate,p01r02_plc_scan_time_in_sec,p29r16_ao_torque)MOV(p29r16_ao_torque,p29r16_ao_torque);
					RC: "Frozen Index Torque - Winder B$N"
					    "$N"
					    "Written AFTER the ramp, direct to ao_torque, so it is the last word.$N"
					    "That is how the original ran and it is what the operation depends on.$N"
					    "$N"
					    "index_start_torque tracks actual torque continuously while NOT indexing,$N"
					    "so the instant INDEX FWD is pressed the winder is commanded exactly the$N"
					    "torque it was already pulling, and holds it.  Constant torque on a roll$N"
					    "of known radius is constant tension, so the arc cannot disturb the web -$N"
					    "nothing has to compute the geometry.$N"
					    "$N"
					    "index_active is a SEAL, cleared only by stopping the winder, so the$N"
					    "freeze holds for the rest of the roll.  As the roll builds, tension falls$N"
					    "as torque/radius - a natural taper of roughly 2 to 10 percent over the$N"
					    "back of the roll depending on web thickness.  That is the existing$N"
					    "winding behaviour and it is deliberately preserved.$N"
					    "$N"
					    "It was briefly moved into the selected_torque cascade during the a19$N"
					    "refactor, which let the jog, thread and 90 percent start boost rungs$N"
					    "override it mid-index.  Restored.$N"
					    "$N"
					    "Rev 20260831";
					N: XIO(p29r09_torque_mode)XIC(p29r11_index_active)XIC(p29r16_request_run)[GRT(p29_ai_wb_torque,0) MOV(p29r16_index_start_torque,p29r16_ao_torque) ,LEQ(p29_ai_wb_torque,0) MOV(p29r16_jog_torque_ref,p29r16_ao_torque) ];
					RC: "Speed Control - Winder B$N"
					    "$N"
					    "Five stages, and each winder now owns every one of them.  Winder B and B$N"
					    "are identical rung for rung apart from their own tag names, so both can$N"
					    "jog, thread or wind out at the same time without fighting over a shared$N"
					    "setpoint and a shared ramp.$N"
					    "$N"
					    "  1  speed setpoint   fpm - where the speed comes from$N"
					    "  2  own accel/decel ramp$N"
					    "  3  speed factor     dimensionless - which mode is active$N"
					    "  4  one multiply     the ONLY place this winder's speed is calculated$N"
					    "  5  output ramp and clamp$N"
					    "$N"
					    "This replaces a cascade of nine writes to p29r16_selected_speed and four to$N"
					    "a shared winder_speed_setpoint, where the last rung to execute won and the$N"
					    "precedence was nowhere stated.  Two faults came straight out of that:$N"
					    "$N"
					    "  - the shared MOV(0,winder_speed_setpoint) fired whenever the line was not$N"
					    "    running and no jog was requested, which cancelled the wind out setpoint$N"
					    "    two rungs after it was written.  Wind out never ran.$N"
					    "  - the shared ramp lived inside p29r16, so it executed before p29r16 had$N"
					    "    written the setpoint at all.$N"
					    "$N"
					    "Stage 3 is still a priority cascade - that is idiomatic in ladder - but it$N"
					    "is over a dimensionless factor, listed lowest priority first, and it is$N"
					    "trendable online so the active mode can be seen rather than inferred.$N"
					    "$N"
					    "Rev 20260825 a18";
					N: OTE(p29r16.comment.7);
					RC: "Stage 1 - speed setpoint [fpm]";
					N: MOV(0,p29r16_speed_setpoint);
					N: [XIC(p29r16_request_run) ,XIC(p29r16_request_thread_fwd) ,XIC(p29r16_request_thread_rev) ]MOV(p25_ao_selected_speed,p29r16_speed_setpoint);
					N: XIC(p29r16_request_run)XIO(p01r13_line_running)XIO(p01r13_line_slow_ramp)MOV(p29_param_wind_out_speed,p29r16_speed_setpoint);
					N: XIC(p29r16_request_jog_fwd)MOV(p29_param_winder_jog_speed,p29r16_speed_setpoint);
					RC: "Stage 2 - winder B's own ramp.  Rates are shared but the ramp is not, so the two winders no longer share one ramp state.";
					N: LEQ(winder_accel_rate,0)MOV(p29_param_winder_accel_rate,winder_accel_rate);
					N: LEQ(winder_decel_rate,0)MOV(p29_param_winder_decel_rate,winder_decel_rate);
					N: SYS_ACC_DEC_RAMP(p29r16_acel_decel_ramp,p29r16_speed_setpoint,winder_accel_rate,winder_decel_rate,p01r02_plc_scan_time_in_sec,p29r16_ramped_setpoint)MOV(p29r16_ramped_setpoint,p29r16_ramped_setpoint);
					RC: "Stage 3 - speed factor, LOWEST priority first, last rung to write wins$N"
					    "$N"
					    "   0.0                        stopped$N"
					    "   1.0                        jog$N"
					    "   1.5                        thread fwd, or torque mode$N"
					    "   start_speed_factor         running, before state .6 - start slow$N"
					    "   3.0                        boost pushbutton, before state .6$N"
					    "  -1.5                        thread reverse$N"
					    "   1 + p29r11_speed_offset    state .6 - accumulator position trim$N"
					    "   1.0                        line stopped - wind out, trim bypassed$N"
					    "   0.0                        turret going to doff$N";
					N: MOV(0.0,p29r16_speed_factor);
					N: XIC(p29r16_request_jog_fwd)MOV(1.0,p29r16_speed_factor);
					N: [XIC(p29r16_request_thread_fwd) ,XIC(p29r16_request_run) XIC(p29r09_torque_mode) ]MOV(1.5,p29r16_speed_factor);
					N: XIC(p29r16_request_run)XIO(p29r09_torque_mode)XIO(p29r16_state.6)MOV(p29_param_start_speed_factor,p29r16_speed_factor);
					N: XIC(p29r16_request_run)XIC(p29_di_wdr_b_start)[XIO(p29r16_state.6) ,XIC(p29r09_torque_mode) ]MOV(3.0,p29r16_speed_factor);
					N: XIC(p29r16_request_thread_rev)MOV(-1.5,p29r16_speed_factor);
					N: XIC(p29r16_stop_dwell.DN)XIC(p29r16_state.6)CPT(p29r16_speed_factor,1+p29r11_speed_offset);
					N: XIC(p29r16_request_run)XIO(p01r13_line_running)XIO(p01r13_line_slow_ramp)MOV(1.0,p29r16_speed_factor);
					RC: "Stage 4 - the only place winder B's speed is calculated";
					N: CPT(p29r16_selected_speed,p29r16_ramped_setpoint*p29r16_speed_factor);
					RC: "Stage 5 - output ramp and clamp";
					N: MOV(p29r16_fast_accel_rate,p29r16_accel_rate)MOV(p29r16_fast_decel_rate,p29r16_decel_rate)SYS_ACC_DEC_RAMP(p29r16_wdrb_accel_decel,p29r16_selected_speed,p29r16_accel_rate,p29r16_decel_rate,p01r02_plc_scan_time_in_sec,p29r16_wdrb_ramped_speed)MOV(p29r16_wdrb_ramped_speed,p29_ao_wdrb_selected_speed);
					RC: "Output Clamp$N"
					    "$N"
					    "Loss of run permissive always zeroes the output.$N"
					    "$N"
					    "The floor at zero is separate, and no longer unconditional.  It used to$N"
					    "be OR-ed with the permissive test, so ANY negative speed was clamped to$N"
					    "0 - which silently killed thread reverse, since request_thread_rev sets$N"
					    "a speed factor of -1.5 and every bit of it was thrown away at this rung.$N"
					    "$N"
					    "It also blocked the reverse the turret index needs at low line speed.$N"
					    "$N"
					    "So the floor now applies except where reverse is deliberate: thread$N"
					    "reverse, or an index in progress.  SYS_SPEED_TO_VFD passes a negative$N"
					    "speed straight through - it only guards gear ratio and diameter - so the$N"
					    "drive must be configured for a bipolar speed reference for this to do$N"
					    "anything at the motor.$N"
					    "$N"
					    "Rev 20260825 a26";
					N: XIO(p29r16_run_permissive)MOV(0,p29_ao_wdrb_selected_speed);
					N: XIO(p29r16_request_thread_rev)XIO(p29r11_index_active)LES(p29_ao_wdrb_selected_speed,0)MOV(0,p29_ao_wdrb_selected_speed);
					RC: "Faults";
					N: OTE(p29r16.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r16.fault,p29r16.fault_ack);
					N: XIC(p29_wdb_status_word.3)[TON(p29r16_timer_fault[0],?,?) ,XIC(p29r16_timer_fault[0].DN) OTL(p29r16.fault.0) ];
					N: XIC(p29r16.fault_ack.0)XIO(p29_wdb_status_word.3)XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.0) ,OTU(p29r16.fault_ack.0) ];
					N: XIO(p29_wdb_status_word.0)[TON(p29r16_timer_fault[2],?,?) ,XIC(p29r16_timer_fault[2].DN) OTL(p29r16.fault.2) ];
					N: XIC(p29r16.fault_ack.2)XIC(p29_wdb_status_word.0)XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.2) ,OTU(p29r16.fault_ack.2) ];
					N: XIC(p29_wdb_status_word.1)XIO(p29_wdb_status_word.9)[TON(p29r16_timer_fault[3],?,?) ,XIC(p29r16_timer_fault[3].DN) OTL(p29r16.fault.3) ];
					N: XIC(p29r16.fault_ack.3)[XIC(p29_wdb_status_word.9) ,XIO(p29_wdb_status_word.1) ]XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.3) ,OTU(p29r16.fault_ack.3) ];
					N: XIO(p29_di_wb_motor)[TON(p29r16_timer_fault[4],?,?) ,XIC(p29r16_timer_fault[4].DN) OTL(p29r16.fault.4) ];
					N: XIC(p29r16.fault_ack.4)XIC(p29_di_wb_motor)XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.4) ,OTU(p29r16.fault_ack.4) ];
					N: XIO(p29_di_wb_brake)[TON(p29r16_timer_fault[5],?,?) ,XIC(p29r16_timer_fault[5].DN) OTL(p29r16.fault.5) ];
					N: XIC(p29r16.fault_ack.5)XIC(p29_di_wb_brake)XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.5) ,OTU(p29r16.fault_ack.5) ];
					RC: "Winder Tension High$N"
					    "$N"
					    "a04 20260820 - the reset rung used OTL, so it re-latched the fault it was$N"
					    "meant to clear.  p29r16.fault.6 could never be cleared, and because$N"
					    "p29r16_run_permissive and p01r13_permissive_drives both gate on$N"
					    "EQU(p29r16.fault,0), the first tension high event locked out every drive$N"
					    "on the line until a download or an online force.$N"
					    "$N"
					    "Now OTU, and following the same pattern as every other fault in this$N"
					    "routine:  acknowledged, condition gone, reset pressed - then clear both$N"
					    "the fault bit and its ack bit so unack_fault clears with it.$N"
					    "$N"
					    "Note p29_ai_wdr_lc is a single load cell shared by both winders, so a$N"
					    "tension excursion latches fault.6 on A and B together.  That is correct$N"
					    "for one web, but both need the reset.";
					N: GRT(p29_ai_wdr_lc,p29_param_tension_hi_limit)[TON(p29r16_timer_fault[6],?,?) ,XIC(p29r16_timer_fault[6].DN) OTL(p29r16.fault.6) ];
					N: XIC(p29r16.fault_ack.6)CMP(p29_ai_wdr_lc<(p29_param_tension_hi_limit - 20))XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.6) ,OTU(p29r16.fault_ack.6) ];
					N: NEQ(p29r16.fault,p29r16.fault_ack)OTE(p29r16.unack_fault);
					RC: "Warnings";
					N: OTE(p29r16.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r16.warning,p29r16.warning_ack);
					N: XIC(p29_wdb_status_word.7)[TON(p29r16_timer_warning[0],?,?) ,XIC(p29r16_timer_warning[0].DN) OTL(p29r16.warning.0) ];
					N: XIC(p29r16.warning_ack.0)XIO(p29_wdb_status_word.7)[OTU(p29r16.warning.0) ,OTU(p29r16.warning_ack.0) ];
					N: XIO(p29r09_torque_mode)XIC(p29r16_request_run)XIC(p29_wdb_vfd.OUT_ENABLED)LES(p29_ai_wdr_lc,p29r02_tension_dev_min)[TON(p29r16_timer_warning[1],?,?) ,XIC(p29r16_timer_warning[1].DN) OTL(p29r16.warning.1) ];
					N: [XIC(p29r09_torque_mode) ,XIO(p29r16_request_run) ,XIO(p29_wdb_vfd.OUT_ENABLED) ,GEQ(p29_ai_wdr_lc,p29r02_tension_dev_min) ]OTU(p29r16.warning.1);
					N: XIO(p29r09_torque_mode)XIC(p29r16_request_run)XIC(p29_wdb_vfd.OUT_ENABLED)GRT(p29_ai_wdr_lc,p29r02_tension_dev_max)[TON(p29r16_timer_warning[2],?,?) ,XIC(p29r16_timer_warning[2].DN) OTL(p29r16.warning.2) ];
					N: [XIC(p29r09_torque_mode) ,XIO(p29r16_request_run) ,XIO(p29_wdb_vfd.OUT_ENABLED) ,LEQ(p29_ai_wdr_lc,p29r02_tension_dev_min) ]OTU(p29r16.warning.2);
					N: XIC(p29r16_wdrb_active)XIO(turret_auto_index_request)XIO(p29_di_wdr_index_fwd)XIO(pb_jog_turret_rev)XIO(turret_in_wdb_run_position)OTE(p29r16.warning.3);
					N: NEQ(p29r16.warning,p29r16.warning_ack)OTE(p29r16.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R17_Winder_A_diameter_calc 
					N: SBR()OTE(p29r17.comment.0);
					N: OTE(p29r17.comment.1);
					N: OTE(p29r17.comment.2);
					N: XIO(p29_di_wdr_a_core_size)MOV(3.25,p29r17_selected_core_diameter);
					N: XIC(p29_di_wdr_a_core_size)MOV(6,p29r17_selected_core_diameter);
					N: XIC(p29r09_torque_mode)MOV(p29r09_trq_pos,p29r17_stack_ctrl.POS)MOV(p29r09_trq_len,p29r17_stack_ctrl.LEN)MOV(p29r09_trq_ave_len,p29r17_ave_control.LEN);
					N: XIO(p29r09_torque_mode)MOV(p29r09_ten_pos,p29r17_stack_ctrl.POS)MOV(p29r09_ten_len,p29r17_stack_ctrl.LEN)MOV(p29r09_ten_ave_len,p29r17_ave_control.LEN);
					N: OTE(p29r17.comment.3);
					N: MOV(p29r18_min_tension,p29r18_min_tension);
					N: XIO(p29_di_wdr_index_fwd)XIO(p01r13_state.8)XIC(p29r15_request_run)[XIC(p29r15_state.6) ,XIC(p29r09_torque_mode) ]CMP(p29r10_pid_psn.PV>p29r18_min_tension)GRT(p29_ai_wa_rpm,1)[TON(p29r17_timer[0],?,?) ,XIC(p29r17_timer[0].DN) OTE(p29r17_diameter_clac_active) ];
					N: XIO(p29r15_request_run)XIC(p29_di_wdr_a_reset_core)[MOV(p29r17_selected_core_diameter,p29r17_winder_a_selected_diam_inch) ,MOV(p29r17_winder_a_selected_diam_inch,p29r17_winder_a_avg_diam_inch) ,MOV(p29r17_winder_a_selected_diam_inch,p29r17_winder_a_actual_diam_inch) ,MOV(p29r17_winder_a_selected_diam_inch,p29r17_winder_a_calc_diam_inch) ,FLL(p29r17_winder_a_selected_diam_inch,p29r17_winder_a_diam_avg_stack[0],1000) ];
					N: XIC(p29r17_diameter_clac_active)XIO(p29r17_timer[1].DN)TON(p29r17_timer[1],?,?);
					N: XIC(p29r17_diameter_clac_active)CPT(p29r17_winder_a_calc_diam_inch,p25_ao_selected_speed*(12/1)*(1/3.14)*(p29_param_wa_gear_ratio/p29_ai_wa_rpm));
					N: [CMP(ABS(p29r10_pid_psn.ERR)<=p01_param_tension_deviation) ,XIC(p29r09_torque_mode) ]XIO(p29_di_wdr_index_fwd)XIC(p29r17_diameter_clac_active)MOV(p29r17_winder_a_calc_diam_inch,p29r17_winder_a_actual_diam_inch);
					N: XIC(p29r20_index_complete)XIC(p29r17_diameter_clac_active)GRT(p29_ai_wdr_dia_in,p29r17_winder_a_calc_diam_inch)MOV(p29r17_winder_a_calc_diam_inch,p29r17_winder_a_actual_diam_inch);
					N: XIC(p29r17_diameter_clac_active)LES(p29r17_winder_a_actual_diam_inch,p29r17_selected_core_diameter)MOV(p29r17_selected_core_diameter,p29r17_winder_a_actual_diam_inch);
					N: XIC(p29r17_diameter_clac_active)LIM(1,p29r17_winder_a_actual_diam_inch,30)[XIC(p29r17_stack_ctrl.DN) FFU(p29r17_winder_a_diam_avg_stack[0],p29r17_winder_a_unload,p29r17_stack_ctrl,?,?) ,XIC(p29r17_timer[1].DN) FFL(p29r17_winder_a_actual_diam_inch,p29r17_winder_a_diam_avg_stack[0],p29r17_stack_ctrl,?,?) ,XIC(p29r17_stack_ctrl.DN) AVE(p29r17_winder_a_diam_avg_stack[0],0,p29r17_winder_a_avg_diam_inch,p29r17_ave_control,?,?) ];
					N: XIC(p29r17_ave_control.ER)OTU(p29r17_ave_control.ER);
					N: XIC(p29r17_stack_ctrl.ER)OTU(p29r17_stack_ctrl.ER);
					N: OTE(p29r17.comment.5);
					N: OTE(p29r17.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r17.fault,p29r17.fault_ack);
					N: XIC(FAULT)[TON(p29r17_timer_fault[0],?,?) ,XIC(p29r17_timer_fault[0].DN) OTL(p29r17.fault.0) ];
					N: XIC(p29r17.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r17.fault.0) ,OTU(p29r17.fault_ack.0) ];
					N: NEQ(p29r17.fault,p29r17.fault_ack)OTE(p29r17.unack_fault);
					N: OTE(p29r17.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r17.warning,p29r17.warning_ack);
					N: XIC(FAULT)[TON(p29r17_timer_warning[0],?,?) ,XIC(p29r17_timer_warning[0].DN) OTL(p29r17.warning.0) ];
					N: XIO(FAULT)[OTU(p29r17.warning.0) ,OTU(p29r17.warning_ack.0) ];
					N: NEQ(p29r17.warning,p29r17.warning_ack)OTE(p29r17.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R18_Winder_B_diameter_calc 
					N: SBR()OTE(p29r18.comment.0);
					N: OTE(p29r18.comment.1);
					N: OTE(p29r18.comment.2);
					N: XIO(p29_di_wdr_b_core_size)MOV(3.25,p29r18_selected_core_diameter);
					N: XIC(p29_di_wdr_b_core_size)MOV(6,p29r18_selected_core_diameter);
					N: XIC(p29r09_torque_mode)MOV(p29r09_trq_pos,p29r18_stack_ctrl.POS)MOV(p29r09_trq_len,p29r18_stack_ctrl.LEN)MOV(p29r09_trq_ave_len,p29r18_ave_control.LEN);
					N: XIO(p29r09_torque_mode)MOV(p29r09_ten_pos,p29r18_stack_ctrl.POS)MOV(p29r09_ten_len,p29r18_stack_ctrl.LEN)MOV(p29r09_ten_ave_len,p29r18_ave_control.LEN);
					N: OTE(p29r18.comment.3);
					N: MOV(p29r18_min_tension,p29r18_min_tension);
					N: XIO(p29_di_wdr_index_fwd)XIO(p01r13_state.8)XIC(p29r16_request_run)[XIC(p29r16_state.6) ,XIC(p29r09_torque_mode) ]CMP(p29r11_pid_psn.PV>p29r18_min_tension)GRT(p29_ai_wb_rpm,1)[TON(p29r18_timer[0],?,?) ,XIC(p29r18_timer[0].DN) OTE(p29r18_diameter_calc_active) ];
					N: XIO(p29r16_request_run)XIC(p29_di_wdr_b_reset_core)[MOV(p29r18_selected_core_diameter,p29r18_winder_b_selected_diam_inch) ,MOV(p29r18_winder_b_selected_diam_inch,p29r18_winder_b_avg_diam_inch) ,MOV(p29r18_winder_b_selected_diam_inch,p29r18_winder_b_actual_diam_inch) ,MOV(p29r18_winder_b_selected_diam_inch,p29r18_winder_b_calc_diam_inch) ,FLL(p29r18_winder_b_selected_diam_inch,p29r18_winder_b_diam_avg_stack[0],1000) ];
					N: XIC(p29r18_diameter_calc_active)XIO(p29r18_timer[1].DN)TON(p29r18_timer[1],?,?);
					N: XIC(p29r18_diameter_calc_active)CPT(p29r18_winder_b_calc_diam_inch,p25_ao_selected_speed*(12/1)*(1/3.14)*(p29_param_wb_gear_ratio/p29_ai_wb_rpm));
					N: [CMP(ABS(p29r11_pid_psn.ERR)<=p01_param_tension_deviation) ,XIC(p29r09_torque_mode) ]XIO(p29_di_wdr_index_fwd)XIC(p29r18_diameter_calc_active)MOV(p29r18_winder_b_calc_diam_inch,p29r18_winder_b_actual_diam_inch);
					N: XIC(p29r20_index_complete)XIC(p29r18_diameter_calc_active)GRT(p29_ai_wdr_dia_in,p29r18_winder_b_calc_diam_inch)MOV(p29r18_winder_b_calc_diam_inch,p29r18_winder_b_actual_diam_inch);
					N: XIC(p29r18_diameter_calc_active)LES(p29r18_winder_b_actual_diam_inch,p29r18_selected_core_diameter)MOV(p29r18_selected_core_diameter,p29r18_winder_b_actual_diam_inch);
					N: XIC(p29r18_diameter_calc_active)LIM(1,p29r18_winder_b_actual_diam_inch,30)[XIC(p29r18_stack_ctrl.DN) FFU(p29r18_winder_b_diam_avg_stack[0],p29r18_winder_b_unload,p29r18_stack_ctrl,?,?) ,XIC(p29r18_timer[1].DN) FFL(p29r18_winder_b_actual_diam_inch,p29r18_winder_b_diam_avg_stack[0],p29r18_stack_ctrl,?,?) ,XIC(p29r18_stack_ctrl.DN) AVE(p29r18_winder_b_diam_avg_stack[0],0,p29r18_winder_b_avg_diam_inch,p29r18_ave_control,?,?) ];
					N: XIC(p29r18_ave_control.ER)OTU(p29r18_ave_control.ER);
					N: XIC(p29r18_stack_ctrl.ER)OTU(p29r18_stack_ctrl.ER);
					N: OTE(p29r18.comment.5);
					N: OTE(p29r18.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r18.fault,p29r18.fault_ack);
					N: XIC(FAULT)[TON(p29r18_timer_fault[0],?,?) ,XIC(p29r18_timer_fault[0].DN) OTL(p29r18.fault.0) ];
					N: XIC(p29r18.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r18.fault.0) ,OTU(p29r18.fault_ack.0) ];
					N: NEQ(p29r18.fault,p29r18.fault_ack)OTE(p29r18.unack_fault);
					N: OTE(p29r18.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r18.warning,p29r18.warning_ack);
					N: XIC(FAULT)[TON(p29r18_timer_warning[0],?,?) ,XIC(p29r18_timer_warning[0].DN) OTL(p29r18.warning.0) ];
					N: XIO(FAULT)[OTU(p29r18.warning.0) ,OTU(p29r18.warning_ack.0) ];
					N: NEQ(p29r18.warning,p29r18.warning_ack)OTE(p29r18.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R20_Winder_Turret_VFD 
					RC: "p29r20$N"
					    "This routine is called, continuously, from p29r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.$N"
					    "";
					N: SBR()OTE(p29r20.comment.0);
					RC: "Tag Usage$N"
					    "$N"
					    "p29r20.comment (dint)$N"
					    "p29r20.oneshot (dint)$N"
					    "p29r20_timer_xxxx (timer)$N"
					    "p29r20_xxxx (any)$N"
					    "p29r20.fault (dint)$N"
					    "p29r20.warning (dint)$N"
					    "";
					N: OTE(p29r20.comment.1);
					RC: "Notes:$N"
					    "";
					N: OTE(p29r20.comment.2);
					RC: "Requests";
					N: NOP();
					N: MOV(param_doff_position,wa_doff_pos)MOV(wa_run_position,wa_run_position)MOV(param_pos_db,param_pos_db);
					N: CPT(wb_doff_pos_tmp,wa_doff_pos+180)MOD(wb_doff_pos_tmp,360,wb_doff_position);
					N: CPT(wb_run_position_tmp,wa_run_position+180)MOD(wb_run_position_tmp,360,wb_run_position);
					N: [CPT(pos_lo_limit_temp,selected_pos+360-param_pos_db) MOD(pos_lo_limit_temp,360,pos_lo_limit) ,CPT(pos_hi_limit_temp,selected_pos+360+param_pos_db) MOD(pos_hi_limit_temp,360,pos_hi_limit) ];
					RC: "Sequence$N"
					    "Ramping and Speed Control for entire Letoff Section";
					N: NOP();
					N: [XIC(p29_do_wdr_turret.forward) ,XIC(p29_do_wdr_turret.reverse) ]OTE(turret_index_active_last_scan);
					RC: "Original Prox Index Sequence$N"
					    "$N"
					    "Restored verbatim from the pre-accumulator program and held as the default.$N"
					    "Hold INDEX FWD, the turret leaves the detent, reaches the next one, dwells,$N"
					    "and index_complete lights the in-position lamp.  Nothing here reads the$N"
					    "encoder.$N"
					    "$N"
					    "p29_param_turret_encoder_enable = 0 runs this.  = 1 hands the turret to the$N"
					    "encoder positioning below.  Only request_fwd and request_rev are gated -$N"
					    "the state machine cannot advance past state.1 without them, so it parks$N"
					    "harmlessly when the encoder has the turret.$N"
					    "$N"
					    "Rev 20260831";
					N: LEQ(p29_ao_wdr_turret_selected_speed,0.1)OTE(p29r20_zero_speed);
					N: XIO(p29_param_turret_encoder_enable)[XIC(p29_di_wdr_index_fwd) XIC(p29r20_zero_speed) ,XIC(p29r20_request_fwd) XIO(p29r20_zero_speed) ]XIO(p29r20.state.6)XIC(p29r20_permissive)OTE(p29r20_request_fwd);
					N: XIO(p29_param_turret_encoder_enable)XIC(p29r20_request_rev)XIO(p29r20_zero_speed)XIC(p29r20_permissive)OTE(p29r20_request_rev);
					N: [XIC(S:FS) ,XIC(p29r20.state.8) XIC(p29r20.state.0) ,XIO(p29_di_wdr_index_fwd) ][MOV(0,p29r20.state) ,OTL(p29r20.state.1) ];
					N: XIC(p29r20.state.1)XIC(p29r20.state.0)XIC(p29r20_request_fwd)XIC(p29_di_wdr_index_fwd)[MOV(0,p29r20.state) ,OTL(p29r20.state.2) ];
					N: XIC(p29r20.state.2)XIC(p29r20.state.0)XIO(p29_di_turret_pos)[MOV(0,p29r20.state) ,OTL(p29r20.state.3) ];
					N: XIC(p29r20.state.3)XIC(p29r20.state.0)XIC(p29_di_turret_pos)[MOV(0,p29r20.state) ,OTL(p29r20.state.4) ];
					N: XIC(p29r20.state.4)XIC(p29r20.state.0)XIC(p29r20_index_move_timer.DN)[MOV(0,p29r20.state) ,OTL(p29r20.state.5) ];
					N: XIC(p29r20.state.5)XIC(p29r20.state.0)XIC(p29r20_zero_speed)XIO(p29_di_wdr_index_fwd)[MOV(0,p29r20.state) ,OTL(p29r20.state.6) ];
					N: [XIC(S:FS) XIC(p29_di_turret_pos) ,XIC(p29r20.state.5) ,XIC(p29r20_index_complete) ]XIO(p29r20.state.2)OTE(p29r20_index_complete);
					N: OTE(p29r20.state.0);
					N: XIC(p29r20.state.4)TON(p29r20_index_move_timer,?,?);
					N: EQU(p29r20.fault,0)OTE(p29r20_permissive);
					RC: "Turret Index Permissive$N"
					    "$N"
					    "The turret indexes when the operator asks, running or not.  Two things$N"
					    "stop it:$N"
					    "$N"
					    "  p29r20_permissive   the turret drive itself is healthy$N"
					    "  p29r15/16.fault.6   winder high tension$N"
					    "$N"
					    "The swing loads the web: the path from the last fixed roll to the winding$N"
					    "roll lengthens through part of the arc, and if the winder cannot give web$N"
					    "back fast enough the tension climbs.  Stopping the turret removes the$N"
					    "cause; carrying on pulls against it.$N"
					    "$N"
					    "Both winders are tested, not just the selected one.  fault.6 latches until$N"
					    "a global reset, so a stale fault on the idle winder will hold the turret$N"
					    "until it is acknowledged - deliberate.$N"
					    "$N"
					    "fault.6 = GRT(p29_ai_wdr_lc, p29_param_tension_hi_limit), 20 lbf$N"
					    "hysteresis on the reset.$N"
					    "$N"
					    "Rev 20260825 a31";
					N: XIC(p29r20_permissive)XIO(p29r15.fault.6)XIO(p29r16.fault.6)OTE(turret_index_permissive);
					RC: "Winder At Run Position - payout interlock export$N"
					    "$N"
					    "A active AND A at A run position, OR B active AND B at B run position.$N"
					    "Paired deliberately - it is not enough that some winder is selected and$N"
					    "the turret is at some run position, it must be THAT winder at ITS own.$N"
					    "$N"
					    "Exported to controller scope because turret_in_wda/b_run_position are$N"
					    "program scoped to p29 and the payout latch lives in p31.$N"
					    "$N"
					    "Evaluated in p29r20, which p29r01 calls after r15 and r16, so the$N"
					    "position bits are current this scan.$N"
					    "$N"
					    "Rev 20260829 a33";
					N: [XIC(p29r15_wdra_active) XIC(turret_in_wda_run_position) ,XIC(p29r16_wdrb_active) XIC(turret_in_wdb_run_position) ]OTE(p29_winder_at_run_position);
					N: XIC(p01r13_permissive_drives)XIC(turret_index_permissive)[XIC(pb_wa_doff_position) XIC(p29r09_mode_doff_auto) ,XIC(turret_wa_pos_doff_request) XIC(turret_auto_index_request) ][ONS(oneshot.7) MOV(selected_pos,last_selected_position) ,MOV(wa_doff_pos,selected_pos) OTE(turret_wa_pos_doff_request) ];
					N: XIC(p01r13_permissive_drives)XIC(turret_index_permissive)[XIC(pb_wa_run_position) ,XIC(turret_wa_pos_run_request) XIC(turret_auto_index_request) ][ONS(oneshot.6) MOV(selected_pos,last_selected_position) ,MOV(wa_run_position,selected_pos) OTE(turret_wa_pos_run_request) ];
					N: XIC(p01r13_permissive_drives)XIC(turret_index_permissive)[XIC(pb_wb_doff_position) XIC(p29r09_mode_doff_auto) ,XIC(turret_wb_pos_doff_request) XIC(turret_auto_index_request) ][ONS(oneshot.5) MOV(selected_pos,last_selected_position) ,MOV(wb_doff_position,selected_pos) OTE(turret_wb_pos_doff_request) ];
					N: XIC(p01r13_permissive_drives)XIC(turret_index_permissive)[XIC(pb_wb_run_position) ,XIC(turret_wb_pos_run_request) XIC(turret_auto_index_request) ][ONS(oneshot.4) MOV(selected_pos,last_selected_position) ,MOV(wb_run_position,selected_pos) OTE(turret_wb_pos_run_request) ];
					RC: "Shortest Path to Selected Position$N"
					    "$N"
					    "Signed error from where the turret IS to where it is going, wrapped into$N"
					    "-180..+180.  Negative means counter clockwise is the short way round.$N"
					    "$N"
					    "  err = selected_pos - ai_enc_position          -360 .. +360$N"
					    "  +540, MOD 360                                     0 .. +360$N"
					    "  -180                                           -180 .. +180$N"
					    "$N"
					    "The +540 offset matters: Logix MOD keeps the sign of the dividend, so a$N"
					    "negative error would stay negative and wrap the wrong way.  Adding 540$N"
					    "puts the argument in 180..900, always positive, before the MOD.$N"
					    "$N"
					    "Evaluated continuously, not one shot on the request.  The old rung took$N"
					    "SUB(last_selected_position, selected_pos) - the distance between the two$N"
					    "most recent TARGETS, not the distance from where the turret actually is.$N"
					    "After a jog, or an aborted index, that is simply the wrong number.  Live$N"
					    "evaluation also corrects an overshoot instead of driving on round.$N"
					    "$N"
					    "Replaces the old 45 deg threshold test and the mode_under HMI override,$N"
					    "which picked direction by rules rather than by which way was shorter.$N"
					    "$N"
					    "A run and B run are 180 deg apart, so a run-to-run move is exactly$N"
					    "antipodal and resolves to reverse.  Deterministic, but if that is the$N"
					    "wrong way round the machine, bias one run position by a degree.$N"
					    "$N"
					    "Rev 20260825 a25";
					N: CPT(turret_err_raw,selected_pos-ai_enc_position+540)MOD(turret_err_raw,360,turret_err_mod)SUB(turret_err_mod,180,distance_to_move)ABS(distance_to_move,abs_distance_to_move);
					N: LES(distance_to_move,0)OTE(turret_request_reverse);
					RC: "Output Control";
					N: NOP();
					N: XIC(p29_param_turret_encoder_enable)[XIC(turret_wa_pos_run_request) ,XIC(turret_wb_pos_run_request) ,XIC(turret_wa_pos_doff_request) ,XIC(turret_wb_pos_doff_request) ]XIO(turret_auto_index_request)NEQ(ai_enc_position,selected_pos)OTL(turret_auto_index_request);
					N: [GEQ(ai_enc_position,pos_lo_limit) LEQ(ai_enc_position,pos_hi_limit) ,XIO(p01r13_permissive_drives) ,XIO(p29r20_permissive) ,XIC(p29_di_wdr_index_fwd) ,XIC(pb_jog_turret_rev) ]OTU(turret_auto_index_request);
					RC: "Turret In Position$N"
					    "$N"
					    "The turret is in position when winder A or winder B is at its own run$N"
					    "position.  Nothing else counts as in position.$N"
					    "$N"
					    "This used to share a rung with the OTU above, which meant losing the drive$N"
					    "permissive, losing the turret drive, or simply jogging all reported the$N"
					    "turret as IN POSITION.  Those conditions belong to the unlatch, not to a$N"
					    "position status, so the two are now separate rungs.$N"
					    "$N"
					    "Rev 20260831";
					N: [XIO(p29_param_turret_encoder_enable) XIC(p29r20_index_complete) ,XIC(p29_param_turret_encoder_enable) [XIC(turret_in_wda_run_position) ,XIC(turret_in_wdb_run_position) ] ]OTE(turret_in_position);
					N: [XIO(p29_param_turret_encoder_enable) XIC(p29r20_request_fwd) ,XIC(p29_param_turret_encoder_enable) XIC(turret_index_permissive) [XIC(p29_di_wdr_index_fwd) XIO(pb_jog_turret_rev) ,XIC(turret_auto_index_request) XIO(turret_request_reverse) ] [TON(tmr_fwd_delay,?,?) ,XIC(tmr_fwd_delay.DN) ] ]OTE(p29_do_wdr_turret.forward);
					N: [XIO(p29_param_turret_encoder_enable) XIC(p29r20_request_rev) ,XIC(p29_param_turret_encoder_enable) XIC(turret_index_permissive) [XIC(pb_jog_turret_rev) XIO(p29_di_wdr_index_fwd) ,XIC(turret_auto_index_request) XIC(turret_request_reverse) ] [TON(tmr_ref_delay,?,?) ,XIC(tmr_ref_delay.DN) ] ]OTE(p29_do_wdr_turret.reverse);
					N: [XIO(p29_param_turret_encoder_enable) [XIC(p29r20.state.2) ,XIC(p29r20.state.3) ,XIC(p29r20.state.4) ] ,XIC(p29_param_turret_encoder_enable) [XIC(p29_do_wdr_turret.forward) ,XIC(p29_do_wdr_turret.reverse) ,XIC(turret_auto_index_request) ] ]LEQ(p01_recipe_active.line_speed_sp,10)MOV(p29_param_slow_turret_speed,p29r20_selected_speed);
					N: [XIO(p29_param_turret_encoder_enable) [XIC(p29r20.state.2) ,XIC(p29r20.state.3) ,XIC(p29r20.state.4) ] ,XIC(p29_param_turret_encoder_enable) [XIC(p29_do_wdr_turret.forward) ,XIC(p29_do_wdr_turret.reverse) ,XIC(turret_auto_index_request) ] ]GRT(p01_recipe_active.line_speed_sp,10)MOV(p29_param_fast_turret_speed,p29r20_selected_speed);
					N: [XIO(p29_param_turret_encoder_enable) XIO(p29r20.state.2) XIO(p29r20.state.3) XIO(p29r20.state.4) ,XIC(p29_param_turret_encoder_enable) XIO(p29_do_wdr_turret.forward) XIO(p29_do_wdr_turret.reverse) XIO(turret_auto_index_request) ]MOV(0,p29r20_selected_speed);
					N: MOV(p29r20_fast_accel,p29r20_accel_rate)MOV(p29r20_fast_decel,p29r20_decel_rate);
					N: SYS_ACC_DEC_RAMP(p29r20_acc_dec_ramp,p29r20_selected_speed,p29r20_accel_rate,p29r20_decel_rate,p01r02_plc_scan_time_in_sec,p29_ao_wdr_turret_selected_speed)MOV(p29_ao_wdr_turret_selected_speed,p29_ao_wdr_turret_selected_speed);
					RC: "Outputs";
					N: OTE(p29r20.comment.10);
					N: XIC(p01r09_pb_global_reset)OTE(p29_do_wdr_turret.fault_reset);
					RC: "Faults";
					N: OTE(p29r20.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p29r20.fault,p29r20.fault_ack);
					N: XIC(p29_di_wdr_turret.faulted)[TON(p29r20_timer_fault[0],?,?) ,XIC(p29r20_timer_fault[0].DN) OTL(p29r20.fault.0) ];
					N: XIC(p29r20.fault_ack.0)XIO(p29_di_wdr_turret.faulted)XIC(p01r09_pb_global_reset)[OTU(p29r20.fault.0) ,OTU(p29r20.fault_ack.0) ];
					N: XIO(p29_di_wdr_turret.ready)[TON(p29r20_timer_fault[2],?,?) ,XIC(p29r20_timer_fault[2].DN) OTL(p29r20.fault.2) ];
					N: XIC(p29r20.fault_ack.2)XIC(p29_di_wdr_turret.ready)XIC(p01r09_pb_global_reset)[OTU(p29r20.fault.2) ,OTU(p29r20.fault_ack.2) ];
					N: XIC(p29_di_wdr_turret.ready)XIO(p29_di_wdr_turret.ctrl_from_net)[TON(p29r20_timer_fault[3],?,?) ,XIC(p29r20_timer_fault[3].DN) OTL(p29r20.fault.3) ];
					N: XIC(p29r20.fault_ack.3)[XIC(p29_di_wdr_turret.ctrl_from_net) ,XIO(p29_di_wdr_turret.ready) ]XIC(p01r09_pb_global_reset)[OTU(p29r20.fault.3) ,OTU(p29r20.fault_ack.3) ];
					N: XIO(p29_di_wt_motor)[TON(p29r20_timer_fault[4],?,?) ,XIC(p29r20_timer_fault[4].DN) OTL(p29r20.fault.4) ];
					N: XIC(p29r20.fault_ack.4)XIC(p29_di_wt_motor)XIC(p01r09_pb_global_reset)[OTU(p29r20.fault.4) ,OTU(p29r20.fault_ack.4) ];
					N: XIC(FAULT)[TON(p29r20_timer_fault[5],?,?) ,XIC(p29r20_timer_fault[5].DN) OTL(p29r20.fault.5) ];
					N: XIC(p29r20.fault_ack.5)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r20.fault.5) ,OTU(p29r20.fault_ack.5) ];
					N: NEQ(p29r20.fault,p29r20.fault_ack)OTE(p29r20.unack_fault);
					RC: "Warnings";
					N: OTE(p29r20.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p29r20.warning,p29r20.warning_ack);
					N: XIC(p29_di_wdr_turret.warning)[TON(p29r20_timer_warning[0],?,?) ,XIC(p29r20_timer_warning[0].DN) OTL(p29r20.warning.0) ];
					N: XIC(p29r20.warning_ack.0)XIO(p29_di_wdr_turret.warning)[OTU(p29r20.warning.0) ,OTU(p29r20.warning_ack.0) ];
					N: XIO(p29r15_wdra_active)XIO(p29r16_wdrb_active)[TON(p29r20_timer_warning[1],?,?) ,XIC(p29r20_timer_warning[1].DN) OTL(p29r20.warning.1) ];
					N: XIC(p29r20.warning_ack.1)[XIC(p29r15_wdra_active) ,XIC(p29r16_wdrb_active) ][OTU(p29r20.warning.1) ,OTU(p29r20.warning_ack.1) ];
					N: NEQ(p29r20.warning,p29r20.warning_ack)OTE(p29r20.unack_warning);
					N: RET();
			END_ROUTINE

	END_PROGRAM

	PROGRAM P30_Retraction_System (MAIN := "R01_Main",
	                               MODE := 0,
	                               DisableFlag := 0)
			TAG
			END_TAG

			ROUTINE R01_Main 
					N: OTE(p30r01.comment.0);
					N: OTE(p30r01.comment.1);
					N: OTE(p30r01.comment.2);
					N: JSR(R03_Input,0);
					N: JSR(R02_Misc_Control,0);
					N: JSR(R05_Dint_to_HMI,0);
					N: JSR(R06_Real_to_HMI,0);
					N: JSR(R07_Alarms,0);
					N: JSR(R08_Warnings,0);
					N: JSR(R09_Modes,0);
					N: JSR(R10_Retraction,0);
					N: JSR(R04_Output,0);
			END_ROUTINE

