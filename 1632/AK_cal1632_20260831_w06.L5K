					N: NEQ(p28r08.fault,p28r08.fault_ack)OTE(p28r08.unack_fault);
					N: OTE(p28r08.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p28r08.warning,p28r08.warning_ack);
					N: XIC(FAULT)[TON(p28r08_timer_warning[0],?,?) ,XIC(p28r08_timer_warning[0].DN) OTL(p28r08.warning.0) ];
					N: XIO(FAULT)[OTU(p28r08.warning_ack.0) ,OTU(p28r08.warning.0) ];
					N: NEQ(p28r08.warning,p28r08.warning_ack)OTE(p28r08.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R09_Modes 
					N: SBR()OTE(p28r09.comment.0);
					N: OTE(p28r09.comment.1);
					N: OTE(p28r09.comment.2);
					N: OTE(p28r09.comment.3);
					N: OTE(p28r09.comment.4);
					N: OTE(p28r09.comment.5);
