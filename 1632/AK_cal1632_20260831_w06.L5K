					N: NEQ(p30_dint_to_hmi[4],0)OTE(p30r02_warning_exists);
					N: OTE(p30r02.comment.3);
					N: [XIC(p30r02.unack_fault) ,XIC(p30r03.unack_fault) ,XIC(p30r04.unack_fault) ,XIC(p30r05.unack_fault) ,XIC(p30r06.unack_fault) ,XIC(p30r07.unack_fault) ,XIC(p30r08.unack_fault) ,XIC(p30r09.unack_fault) ,XIC(p30r10.unack_fault) ]OTE(p30r02_unack_fault);
					N: [XIC(p30r02.unack_warning) ,XIC(p30r03.unack_warning) ,XIC(p30r04.unack_warning) ,XIC(p30r05.unack_warning) ,XIC(p30r06.unack_warning) ,XIC(p30r07.unack_warning) ,XIC(p30r08.unack_warning) ,XIC(p30r09.unack_warning) ,XIC(p30r10.unack_warning) ]OTE(p30r02_unack_warning);
					N: OTE(p30r02.comment.4);
					N: OTE(p30r02.comment.5);
					N: OTE(p30r02.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p30r02.fault,p30r02.fault_ack);
					N: XIC(FAULT)[TON(p30r02_timer_fault[0],?,?) ,XIC(p30r02_timer_fault[0].DN) OTL(p30r02.fault.0) ];
					N: XIC(p30r02.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p30r02.fault.0) ,OTU(p30r02.fault_ack.0) ];
					N: NEQ(p30r02.fault,p30r02.fault_ack)OTE(p30r02.unack_fault);
					N: OTE(p30r02.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p30r02.warning,p30r02.warning_ack);
					N: XIC(FAULT)[TON(p30r02_timer_warning[0],?,?) ,XIC(p30r02_timer_warning[0].DN) OTL(p30r02.warning.0) ];
					N: XIO(FAULT)[OTU(p30r02.warning.0) ,OTU(p30r02.warning_ack.0) ];
					N: NEQ(p30r02.warning,p30r02.warning_ack)OTE(p30r02.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R03_Input 
					N: SBR()OTE(p30r03.comment.0);
					N: OTE(p30r03.comment.1);
					N: OTE(p30r03.comment.2);
					N: OTE(p30r03.comment.3);
					N: [XIC(p00_io_oven:4:I.3) OTE(p30_di_ss_open) ,XIC(p00_io_oven:4:I.4) [XIC(RETRACTION_DELAY_TIMER_2.DN) OTE(p30_di_ss_close) ,TON(RETACTION_DELAY_TIMER,?,?) ,TON(RETRACTION_DELAY_TIMER_2,?,?) ] ,XIC(p00_io_oven:4:I.5) OTE(p30_di_retraction_up_ls) ,XIC(p00_io_oven:4:I.6) OTE(p30_di_retraction_down_ls) ,XIC(Local:6:I.Data.7) OTE(p30_di_rotation_fault) ];
					N: [XIC(p00_io_oven:5:I.0) OTE(p30_di_pin_1) ,XIC(p00_io_oven:5:I.1) OTE(p30_di_pin_2) ,XIC(p00_io_oven:5:I.2) OTE(p30_di_pin_3) ,XIC(p00_io_oven:5:I.3) OTE(p30_di_pin_4) ];
					N: [XIC(p00_io_oven:5:I.4) OTE(p30_di_pin_5) ,XIC(p00_io_oven:5:I.5) OTE(p30_di_pin_6) ,XIC(p00_io_oven:5:I.6) OTE(p30_di_pin_7) ,XIC(p00_io_oven:5:I.7) OTE(p30_di_pin_8) ];
					N: OTE(p30r03.comment.4);
					N: OTE(p30r03.comment.5);
					N: OTE(p30r03.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p30r03.fault,p30r03.fault_ack);
					N: XIC(FAULT)[TON(p30r03_timer_fault[0],?,?) ,XIC(p30r03_timer_fault[0].DN) OTL(p30r03.fault.0) ];
					N: XIC(p30r03.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p30r03.fault.0) ,OTU(p30r03.fault_ack.0) ];
					N: XIC(FAULT)[TON(p30r03_timer_fault[1],?,?) ,XIC(p30r03_timer_fault[1].DN) OTL(p30r03.fault.1) ];
					N: XIC(p30r03.fault_ack.1)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p30r03.fault.1) ,OTU(p30r03.fault_ack.1) ];
					N: NEQ(p30r03.fault,p30r03.fault_ack)OTE(p30r03.unack_fault);
					N: OTE(p30r03.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p30r03.warning,p30r03.warning_ack);
					N: XIC(FAULT)[TON(p30r03_timer_warning[0],?,?) ,XIC(p30r03_timer_warning[0].DN) OTL(p30r03.warning.0) ];
					N: XIO(FAULT)[OTU(p30r03.warning.0) ,OTU(p30r03.warning_ack.0) ];
					N: NEQ(p30r03.warning,p30r03.warning_ack)OTE(p30r03.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R04_Output 
					N: SBR()OTE(p30r04.comment.0);
					N: OTE(p30r04.comment.1);
					N: OTE(p30r04.comment.2);
					N: OTE(p30r04.comment.3);
					N: [XIC(p30_do_rotation_rev) OTE(p00_io_prc:0:O.3) ,XIC(p30_do_rotation_fwd) OTE(p00_io_prc:0:O.4) ,XIC(p30_do_retract_motion) OTE(Local:7:O.Data.5) ];
					N: OTE(p30r04.comment.4);
					N: OTE(p30r04.comment.5);
					N: OTE(p30r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p30r04.fault,p30r04.fault_ack);
					N: XIC(FAULT)[TON(p30r04_timer_fault[0],?,?) ,XIC(p30r04_timer_fault[0].DN) OTL(p30r04.fault.0) ];
					N: XIC(p30r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p30r04.fault.0) ,OTU(p30r04.fault_ack.0) ];
					N: NEQ(p30r04.fault,p30r04.fault_ack)OTE(p30r04.unack_fault);
