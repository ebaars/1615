					N: CPT(p00_vfd_ts2:O.Data[2],p25_ao_torque*100);
					N: OTE(p25r04.comment.30);
					N: XIC(p01r09_pb_global_reset)MOV(p25r04.fault,p25r04.fault_ack);
					N: XIC(FAULT)[TON(p25r04_timer_fault[0],?,?) ,XIC(p25r04_timer_fault[0].DN) OTL(p25r04.fault.0) ];
					N: XIC(p25r04.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p25r04.fault.0) ,OTU(p25r04.fault_ack.0) ];
					N: NEQ(p25r04.fault,p25r04.fault_ack)OTE(p25r04.unack_fault);
					N: OTE(p25r04.comment.31);
					N: XIC(p01r09_pb_global_reset)MOV(p25r04.warning,p25r04.warning_ack);
					N: XIC(FAULT)[TON(p25r04_timer_warning[0],?,?) ,XIC(p25r04_timer_warning[0].DN) OTL(p25r04.warning.0) ];
					N: XIO(FAULT)[OTU(p25r04.warning.0) ,OTU(p25r04.warning_ack.0) ];
					N: NEQ(p25r04.warning,p25r04.warning_ack)OTE(p25r04.unack_warning);
					N: RET();
			END_ROUTINE

			ROUTINE R05_Dint_to_HMI 
					N: SBR()OTE(p25r05.comment.0);
					N: OTE(p25r05.comment.1);
					N: OTE(p25r05.comment.2);
					N: OTE(p25r05.comment.3);
					N: [XIC(HMI) OTE(p25_dint_to_hmi[0].0) ,XIC(HMI) OTE(p25_dint_to_hmi[0].1) ,XIC(HMI) OTE(p25_dint_to_hmi[0].2) ,XIC(HMI) OTE(p25_dint_to_hmi[0].3) ];
