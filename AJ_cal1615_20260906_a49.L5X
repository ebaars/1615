<Text>
<![CDATA[XIC(p01r09_pb_global_reset)MOV(p29r18.fault,p29r18.fault_ack);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(FAULT)[TON(p29r18_timer_fault[0],?,?) ,XIC(p29r18_timer_fault[0].DN) OTL(p29r18.fault.0) ];]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(p29r18.fault_ack.0)XIO(FAULT)XIC(p01r09_pb_global_reset)[OTU(p29r18.fault.0) ,OTU(p29r18.fault_ack.0) ];]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[NEQ(p29r18.fault,p29r18.fault_ack)OTE(p29r18.unack_fault);]]>
</Text>
</Rung>
