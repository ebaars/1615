<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ABB ACS800 ABB PROTOCOL DRIVE CONTROL]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Permissive]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(IN_DRIVE_PERMISSIVE)OTE(run_permissive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Requests]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(run_permissive)XIO(DRIVE_NOT_READY_FAULT)OTE(enable_drives);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(run_permissive)XIC(IN_START)OTE(request_run);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Sequence]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(request_run)OTE(drive_on_request);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[XIC(S:FS) ,XIC(seq.state.7) XIC(seq.state.0) ][MOV(0,seq.state) ,OTL(seq.state.1) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(enable_drives)XIC(seq.state.1)XIC(seq.state.0)[XIO(STATUS_WORD.0) ,XIC(STATUS_WORD.0) ][MOV(0,seq.state) ,OTL(seq.state.2) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(enable_drives)XIC(seq.state.0)XIC(seq.state.2)XIC(STATUS_WORD.0)[MOV(0,seq.state) ,OTL(seq.state.3) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(enable_drives)XIC(seq.state.3)XIC(seq.state.0)XIC(step_3_timer.DN)[MOV(0,seq.state) ,OTL(seq.state.4) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(enable_drives)XIC(seq.state.4)XIC(seq.state.0)XIC(STATUS_WORD.1)[MOV(0,seq.state) ,OTL(seq.state.5) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(enable_drives)XIC(drive_on_request)XIC(seq.state.5)XIC(seq.state.0)[MOV(0,seq.state) ,OTL(seq.state.6) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIO(enable_drives)[MOV(0,seq.state) ,OTL(seq.state.7) ];]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[OTE(seq.state.0);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(seq.state.3)TON(step_3_timer,?,?);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Comment>
<![CDATA[Outputs]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[XIC(seq.state.3) ,XIC(seq.state.4) ,XIC(seq.state.5) ,XIC(seq.state.6) ]OTE(CONTROL_WORD.0);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[[OTE(CONTROL_WORD.1) ,OTE(CONTROL_WORD.2) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[XIC(seq.state.6)XIC(drive_on_request)XIO(STATUS_WORD.3)XIC(STATUS_WORD.4)XIC(STATUS_WORD.5)OTE(CONTROL_WORD.3);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(seq.state.6)XIC(drive_on_request)OTE(CONTROL_WORD.4);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(seq.state.6)XIC(drive_on_request)OTE(CONTROL_WORD.5);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIC(seq.state.6)XIC(drive_on_request)OTE(CONTROL_WORD.6);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(IN_GLOBAL_RESET)[XIC(STATUS_WORD.3) ,XIC(STATUS_WORD.7) ]OTE(CONTROL_WORD.7);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[OTE(CONTROL_WORD.10);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[OTU(CONTROL_WORD.11);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[TEMP OUTPUT FOR DISPLAY ONLY]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(STATUS_WORD.2)OTE(OUT_ENABLED);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIC(STATUS_WORD.7)OTE(OUT_ALARM);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIO(STATUS_WORD.0)[TON(fault_timer,?,?) ,OTL(DRIVE_NOT_READY_FAULT) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(IN_GLOBAL_RESET)OTU(DRIVE_NOT_READY_FAULT);]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[Warnings]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[XIC(STATUS_WORD.3)OTE(OUT_FAULT);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
