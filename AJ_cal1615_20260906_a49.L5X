<Text>
<![CDATA[XIC(vfd_wdb.In_DriveStatus_ALARM)[TON(p29r16_timer_warning[0],?,?) ,XIC(p29r16_timer_warning[0].DN) OTL(p29r16.warning.0) ];]]>
</Text>
</Rung>
<Rung Number="94" Type="N">
<Text>
<![CDATA[XIC(p29r16.warning_ack.0)XIO(vfd_wdb.In_DriveStatus_ALARM)[OTU(p29r16.warning.0) ,OTU(p29r16.warning_ack.0) ];]]>
</Text>
</Rung>
<Rung Number="95" Type="N">
<Text>
<![CDATA[XIO(p29r09_torque_mode)XIC(p29r16_request_run)XIC(p29_wdb_vfd.OUT_ENABLED)LES(p29_ai_wdr_lc,p29r02_tension_dev_min)[TON(p29r16_timer_warning[1],?,?) ,XIC(p29r16_timer_warning[1].DN) OTL(p29r16.warning.1) ];]]>
</Text>
</Rung>
<Rung Number="96" Type="N">
<Text>
<![CDATA[[XIC(p29r09_torque_mode) ,XIO(p29r16_request_run) ,XIO(p29_wdb_vfd.OUT_ENABLED) ,GEQ(p29_ai_wdr_lc,p29r02_tension_dev_min) ]OTU(p29r16.warning.1);]]>
</Text>
</Rung>
<Rung Number="97" Type="N">
<Text>
<![CDATA[XIO(p29r09_torque_mode)XIC(p29r16_request_run)XIC(p29_wdb_vfd.OUT_ENABLED)GRT(p29_ai_wdr_lc,p29r02_tension_dev_max)[TON(p29r16_timer_warning[2],?,?) ,XIC(p29r16_timer_warning[2].DN) OTL(p29r16.warning.2) ];]]>
</Text>
</Rung>
<Rung Number="98" Type="N">
<Text>
<![CDATA[[XIC(p29r09_torque_mode) ,XIO(p29r16_request_run) ,XIO(p29_wdb_vfd.OUT_ENABLED) ,LEQ(p29_ai_wdr_lc,p29r02_tension_dev_min) ]OTU(p29r16.warning.2);]]>
</Text>
</Rung>
<Rung Number="99" Type="N">
<Text>
<![CDATA[XIC(p29r16_wdrb_active)XIO(turret_auto_index_request)XIO(p29_di_wdr_index_fwd)XIO(pb_jog_turret_rev)XIO(turret_in_wdb_run_position)OTE(p29r16.warning.3);]]>
</Text>
</Rung>
<Rung Number="100" Type="N">
<Text>
<![CDATA[NEQ(p29r16.warning,p29r16.warning_ack)OTE(p29r16.unack_warning);]]>
