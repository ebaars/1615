<Routine Name="R07_Alarms" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[p13r07
This routine is called, continuously, from p13R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.
]]>
</Comment>
<Text>
<![CDATA[SBR()OTE(p13r07.comment.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tag Usage

p13r07.comment (dint)
p13r07.oneshot (dint)
p13r07_timer_xxxx (timer)
p13r07_xxxx (any)
p13r07.fault (dint)
p13r07.warning (dint)
]]>
</Comment>
<Text>
<![CDATA[OTE(p13r07.comment.1);]]>
</Text>
