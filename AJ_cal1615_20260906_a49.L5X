<![CDATA[XIO(vfd_wdb.In_DriveStatus_RDY_ON)[TON(p29r16_timer_fault[2],?,?) ,XIC(p29r16_timer_fault[2].DN) OTL(p29r16.fault.2) ];]]>
</Text>
</Rung>
<Rung Number="81" Type="N">
<Text>
<![CDATA[XIC(p29r16.fault_ack.2)XIC(vfd_wdb.In_DriveStatus_RDY_ON)XIC(p01r09_pb_global_reset)[OTU(p29r16.fault.2) ,OTU(p29r16.fault_ack.2) ];]]>
</Text>
