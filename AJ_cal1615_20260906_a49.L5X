</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(p01r09_open_oven)MOV(p01_param_open_oven_temp,p12r30_pid_temp_sp);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Multiply by 10,
Scaled back down in the PID
Use Dint for PID]]>
</Comment>
<Text>
<![CDATA[[MUL(p12_ai_tc01,10,p12r30_pid_temp_pv) ,XIC(p12r30.warning.1) MUL(p12_ai_tc02,10,p12r30_pid_temp_pv) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Requests]]>
</Comment>
