<![CDATA[MOV(p29r17_winder_a_avg_diam_inch,p29_real_to_hmi[3])MOV(p29r18_winder_b_avg_diam_inch,p29_real_to_hmi[4])MOV(0,p29_real_to_hmi[5]);]]>
