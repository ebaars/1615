   const_torque_ref        state .2 - starting torque, 36% or 50% by core
   torque_low_ref          state .3 - tension above setpoint
   torque_high_ref         state .4 - tension below setpoint
   torque_high_ref         state .6 - running
   index_start_torque      indexing - held from the last tension value
   jog_torque_ref          jog
   thread_torque_ref       thread
   torque_boost_ref        boost timer or start pushbutton
   payout_torque           accumulator paying out, line running
   wind_out_torque         accumulator paying out, line stopped
]]>
