<Text>
<![CDATA[[XIC(p12r30_pb_manual) ,XIC(p12r30_request_manual) ]XIO(p12r30_pb_auto)XIC(p12r30_permissive_run)OTE(p12r30_request_manual);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[LES(p12r30_pid_temp_sp_error,p12r30_temp_deviation_setpoint)ONS(p12r30.oneshot.2)OTL(p12r30_request_deviation_warning);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[[XIO(p12r30_request_heat) ,NEQ(p12r30_pid_temp_sp,p12r30_pid_temp_sp_last) ]OTU(p12r30_request_deviation_warning);]]>
