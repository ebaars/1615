</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[Configure PID]]>
</Comment>
<Text>
<![CDATA[OTE(p12r30.comment.5);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[XIC(p12r30_request_heat)MOV(p12r30_pid_temp_sp,p12r30_pid_temp.SP);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[XIO(p12r30_request_heat)MOV(0,p12r30_pid_temp.SP);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[Need?  If PID is at 100% and grossly overshoots(appears to freeze at 100%), this "kick" will "reset" the PID and get it working again.]]>
</Comment>
<Text>
<![CDATA[[XIC(p12r20_state.9) ,XIC(p12r20_state.10) ]EQU(p12r30_pid_temp.OUT,100)LES(p12r30_pid_temp.ERR,3.0)OTE(p12r30_request_PID_shot);]]>
</Text>
</Rung>
