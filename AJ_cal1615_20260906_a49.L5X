<![CDATA[[XIC(p11r20_state.9) ,XIC(p11r20_state.10) ]EQU(p11r30_pid_temp.OUT,100)LES(p11r30_pid_temp.ERR,3.0)OTE(p11r30_request_PID_shot);]]>
