<Routine Name="R02_Misc_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[p23R02
This routine is called, continuously, from p23R01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.
]]>
</Comment>
<Text>
<![CDATA[SBR()OTE(p23r02.comment.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tag Usage

p23r02.comment (dint)
p23r02.oneshot (dint)
p23r02_timer_xxxx (timer)
p23r02_xxxx (any)
p23r02.fault (dint)
p23r02.warning (dint)
]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Notes:
Dip Level controls]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[NEQ(p23_dint_to_hmi[2],0)OTE(p23r02_fault_exists);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[NEQ(p23_dint_to_hmi[4],0)OTE(p23r02_warning_exists);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[XIC(p02_dint_from_hmi.impreg[0].18) ,XIC(p02_dint_from_hmi.global[6].10) ]OTE(p23r02_pb_start_exh);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(p02_dint_from_hmi.impreg[0].19) ,XIO(p23r02.warning.0) XIO(p11r30.warning.4) XIO(p12r30.warning.4) XIC(p11r02_shutdown_temp) XIC(p12r02_shutdown_temp) [ONS(p23r02.oneshot.1) ,XIC(p02_dint_from_hmi.global[6].7) ] ]OTE(p23r02_pb_stop_exh);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[[ADD(p01_recipe_active.impreg_gap_sp,-0.005,p23r02_open_pos_real) ,MUL(p23r02_open_pos_real,10000,p23r02_open_pos_dint) ,DIV(p23r02_open_pos_dint,10000,p23_param_servo_open_position) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Requests]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.3);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[XIC(p23r02.unack_fault) ,XIC(p23r03.unack_fault) ,XIC(p23r04.unack_fault) ,XIC(p23r05.unack_fault) ,XIC(p23r06.unack_fault) ,XIC(p23r07.unack_fault) ,XIC(p23r08.unack_fault) ,XIC(p23r09.unack_fault) ,XIC(p23r12.unack_fault) ,XIC(p23r15.unack_fault) ]OTE(p23r02_unack_fault);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(p23r02.unack_warning) ,XIC(p23r03.unack_warning) ,XIC(p23r04.unack_warning) ,XIC(p23r05.unack_warning) ,XIC(p23r06.unack_warning) ,XIC(p23r07.unack_warning) ,XIC(p23r08.unack_warning) ,XIC(p23r09.unack_warning) ,XIC(p23r12.unack_warning) ,XIC(p23r11.unack_warning) ,XIC(p23r15.unack_warning) ]OTE(p23r02_unack_warning);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Sequence]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.4);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[XIC(p23_di_metering_bar_close) ,XIC(p23r02_request_nip_close) ]XIO(p23_di_metering_bar_open)[OTE(p23r02_request_nip_close) ,TON(metering_roll_close,?,?) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Output Control]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.5);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[XIC(p23r02_pb_start_exh) ,XIC(p23_do_enable_impreg_exhaust_fan) ]XIO(p23r02_pb_stop_exh)XIO(p23r02.fault.1)OTE(p23_do_enable_impreg_exhaust_fan);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(p23r02_request_nip_close)XIO(p23_di_splice_jump)XIO(metering_roll_close.TT)OTE(p23_do_impreg_nip_close);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.30);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(p01r09_pb_global_reset)MOV(p23r02.fault,p23r02.fault_ack);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[GEQ(p23_ai_lfl,p23_param_lfl_hhl)[TON(p23r02_timer_fault[0],?,?) ,XIC(p23r02_timer_fault[0].DN) OTL(p23r02.fault.0) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[XIC(p23r02.fault_ack.0)CMP(p23_ai_lfl<(p23_param_lfl_hhl-5))XIC(p01r09_pb_global_reset)[OTU(p23r02.fault.0) ,OTU(p23r02.fault_ack.0) ];]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(p23_do_enable_impreg_exhaust_fan) XIO(p23_di_impreg_exhaust_running) ,XIO(p23_do_enable_impreg_exhaust_fan) XIC(p23_di_impreg_exhaust_running) ][TON(p23r02_timer_fault[1],?,?) ,XIC(p23r02_timer_fault[1].DN) OTL(p23r02.fault.1) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[XIC(p23r02.fault_ack.1)XIO(p23_do_enable_impreg_exhaust_fan)XIO(p23_di_impreg_exhaust_running)XIC(p01r09_pb_global_reset)[OTU(p23r02.fault.1) ,OTU(p23r02.fault_ack.1) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[NEQ(p23r02.fault,p23r02.fault_ack)OTE(p23r02.unack_fault);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[Warnings]]>
</Comment>
<Text>
<![CDATA[OTE(p23r02.comment.31);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIC(p01r09_pb_global_reset)MOV(p23r02.warning,p23r02.warning_ack);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[GEQ(p23_ai_lfl,p23_param_lfl_hl)[TON(p23r02_timer_warning[0],?,?) ,XIC(p23r02_timer_warning[0].DN) OTL(p23r02.warning.0) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[CMP(p23_ai_lfl<(p23_param_lfl_hl-5))[OTU(p23r02.warning.0) ,OTU(p23r02.warning_ack.0) ];]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Comment>
<![CDATA[Probably need to add a FIFO for the pressure.]]>
</Comment>
<Text>
<![CDATA[LES(p23_ai_prs,p23_param_zone_pressure)[TON(p23r02_timer_warning[1],?,?) ,XIC(p23r02_timer_warning[1].DN) OTL(p23r02.warning.1) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(p23r02.warning_ack.1)CMP(p23_ai_prs>(p23_param_zone_pressure+0.002))[OTU(p23r02.warning.1) ,OTU(p23r02.warning_ack.1) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIC(FAULT)[TON(p23r02_timer_warning[2],?,?) ,XIC(p23r02_timer_warning[2].DN) OTL(p23r02.warning.2) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Text>
<![CDATA[XIO(FAULT)[OTU(p23r02.warning.2) ,OTU(p23r02.warning_ack.2) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[XIC(p23_do_enable_impreg_exhaust_fan)XIO(p23_di_exhaust_speed_ok)[TON(p23r02_timer_warning[3],?,?) ,XIC(p23r02_timer_warning[3].DN) OTL(p23r02.warning.3) ];]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Text>
<![CDATA[XIC(p23r02.warning_ack.3)[XIC(p23_di_exhaust_speed_ok) ,XIO(p23_do_enable_impreg_exhaust_fan) ][OTU(p23r02.warning.3) ,OTU(p23r02.warning_ack.3) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Text>
<![CDATA[NEQ(p23r02.warning,p23r02.warning_ack)OTE(p23r02.unack_warning);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Text>
<![CDATA[RET();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
