<![CDATA[XIC(AFI)NEQ(p01r09.fault,0)XIO(enable_control)[MOV(p00_lin_timer_pre_0ms,timer_alarm[15].PRE) ,TON(timer_alarm[15],?,?) ,XIC(timer_alarm[15].DN) OTL(A15) ];]]>
