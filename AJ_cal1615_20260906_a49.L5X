<AddOnInstructionDefinition Name="sys_ACS880_inputs" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2023-03-06T19:03:31.866Z" CreatedBy="DESKTOP-UJLNSL3\cal1615" EditedDate="2023-03-07T15:48:43.148Z" EditedBy="DESKTOP-UJLNSL3\cal1615" SoftwareRevision="v16.03">
<Description>
<![CDATA[System AOI
ACS880 Inputs]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="IN_vfd_inputs" TagType="Base" DataType="AB:ETHERNET_MODULE_INT_24Bytes:I:0" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="IN_vfd_data" TagType="Base" DataType="vfd_data_ACS880" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="IN_vfd_status" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_RPM" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Amps" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Hz" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_TorquePct" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Speed" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="true" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="IN_Roll_Diameter" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="IN_Gear_Reduction" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="afi" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write">
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="comm_ok" DataType="BOOL" Radix="Decimal" ExternalAccess="Read/Write">
<DefaultData>00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="NPRPM" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="NPHz" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[OTU(afi);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Status Word - Data[0]]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[0],IN_vfd_data.In_DriveStatus);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LIM(16384,IN_vfd_status,20479)[OTE(comm_ok) ,OTE(IN_vfd_data.OUT_Comm_Status) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Clear the Data from the VFD on a communication error]]>
</Comment>
<Text>
<![CDATA[XIO(comm_ok)MOV(0,IN_vfd_inputs.Data[0]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Status Word - Data[0]]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[0],IN_vfd_data.In_DriveStatus);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Map the Drive Status Word to the individual bits]]>
</Comment>
<Text>
<![CDATA[[XIC(IN_vfd_data.In_DriveStatus.0) OTE(IN_vfd_data.In_DriveStatus_RDY_ON) ,XIC(IN_vfd_data.In_DriveStatus.1) OTE(IN_vfd_data.In_DriveStatus_RDY_RUN) ,XIC(IN_vfd_data.In_DriveStatus.2) OTE(IN_vfd_data.In_DriveStatus_RDY_REF) ,XIC(IN_vfd_data.In_DriveStatus.3) OTE(IN_vfd_data.In_DriveStatus_TRIPPED) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Map the Drive Status Word to the individual bits]]>
</Comment>
<Text>
<![CDATA[[XIC(IN_vfd_data.In_DriveStatus.4) OTE(IN_vfd_data.In_DriveStatus_OFF_2_STA) ,XIC(IN_vfd_data.In_DriveStatus.5) OTE(IN_vfd_data.In_DriveStatus_OFF_3_STA) ,XIC(IN_vfd_data.In_DriveStatus.6) OTE(IN_vfd_data.In_DriveStatus_SWC_ON_INHIB) ,XIC(IN_vfd_data.In_DriveStatus.7) OTE(IN_vfd_data.In_DriveStatus_ALARM) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Map the Drive Status Word to the individual bits]]>
</Comment>
<Text>
<![CDATA[[XIC(IN_vfd_data.In_DriveStatus.8) OTE(IN_vfd_data.In_DriveStatus_AT_SETPOINT) ,XIC(IN_vfd_data.In_DriveStatus.9) OTE(IN_vfd_data.In_DriveStatus_REMOTE) ,XIC(IN_vfd_data.In_DriveStatus.10) OTE(IN_vfd_data.In_DriveStatus_ABOVE_LIMIT) ,XIC(IN_vfd_data.In_DriveStatus.11) OTE(IN_vfd_data.In_DriveStatus_EXT_CTRL_LOC) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Map the Drive Status Word to the individual bits]]>
</Comment>
<Text>
<![CDATA[[XIC(IN_vfd_data.In_DriveStatus.12) OTE(IN_vfd_data.In_DriveStatus_EXT_RUN_ENABLE) ,XIC(IN_vfd_data.In_DriveStatus.13) NOP() ,XIC(IN_vfd_data.In_DriveStatus.14) NOP() ,XIC(IN_vfd_data.In_DriveStatus.15) OTE(IN_vfd_data.In_DriveStatus_FBA_ERROR) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Status Word - Data[1] - Actual Speed]]>
</Comment>
<Text>
<![CDATA[CPT(IN_vfd_data.In_OutputRPM,(IN_vfd_inputs.Data[1] * IN_vfd_inputs.Data[3]) / 20000);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Status Word - Data[2] - Actual Motor Current]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[2],IN_vfd_data.In_OutputCurrent);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[Status Word - Data[3] - Speed Scaling]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[3],IN_vfd_data.In_SpeedScaling);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Status Word - Data[4] - Nameplate Hz]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[4],IN_vfd_data.In_MotorNPHz);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[Status Word - Data[5] - Nameplate RPM]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[5],IN_vfd_data.In_MotorNPRPM);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Status Word - Data[6] - Actual Motor Torque %]]>
</Comment>
<Text>
<![CDATA[MOV(IN_vfd_inputs.Data[6],IN_vfd_data.IN_OutputTorque);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Comment>
<![CDATA[Status Word - Data[7] - Actual Motor Hz]]>
</Comment>
<Text>
<![CDATA[CPT(IN_vfd_data.IN_OutputHz,(IN_vfd_inputs.Data[7] * IN_vfd_inputs.Data[8]) / 20000);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Comment>
<![CDATA[Analog Input Scaling: Convert to Real and scale as necessary]]>
</Comment>
<Text>
<![CDATA[MOV(0,Out_RPM)CPT(Out_RPM,IN_vfd_data.In_OutputRPM);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[[MOV(0,NPRPM) CPT(NPRPM,IN_vfd_data.In_MotorNPRPM) ,LES(NPRPM,1000) MOV(1800,NPRPM) MOV(1800,IN_vfd_data.In_MotorNPRPM) ];]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[[MOV(0,NPHz) CPT(NPHz,IN_vfd_data.In_MotorNPHz) ,LES(NPHz,50) MOV(60,NPHz) MOV(60,IN_vfd_data.In_MotorNPHz) ];]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[MOV(0,Out_Amps)CPT(Out_Amps,IN_vfd_data.In_OutputCurrent * 1);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[MOV(0,Out_Hz)CPT(Out_Hz,IN_vfd_data.IN_OutputHz * 0.1);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[MOV(0,Out_TorquePct)CPT(Out_TorquePct,IN_vfd_data.IN_OutputTorque * 0.01);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[CPT(Out_Speed,Out_RPM /IN_Gear_Reduction*3.14159265359*IN_Roll_Diameter);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="sys_ACS880_Outputs" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2023-03-06T20:28:57.583Z" CreatedBy="AzureAD\ErikBaars" EditedDate="2023-03-06T20:35:38.521Z" EditedBy="AzureAD\ErikBaars" SoftwareRevision="v16.05">
<Description>
<![CDATA[System AOI
ACS880 Outputs]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="IO_vfd_outputs" TagType="Base" DataType="AB:ETHERNET_MODULE_INT_24Bytes:O:0" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="IO_vfd_data" TagType="Base" DataType="vfd_data_ACS880" Usage="InOut" Required="true" Visible="true" Constant="false">
<Description>
<![CDATA[VFD Data Object]]>
</Description>
</Parameter>
<Parameter Name="IN_Gear_Reduction" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="IN_Roll_Diameter" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="IN_Speed_Setpoint" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="Out_Speed_Command" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
<Parameter Name="OUT_Speed_RPM" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only">
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</Parameter>
</Parameters>
<LocalTags>
<LocalTag Name="speed_hz" DataType="REAL" Radix="Float" ExternalAccess="Read/Write">
<Description>
<![CDATA[Speed Setpoint in Hz]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
<LocalTag Name="speed_pct" DataType="REAL" Radix="Float" ExternalAccess="Read/Write">
<Description>
<![CDATA[Motor Speed Percent]]>
</Description>
<DefaultData>00 00 00 00</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="REAL" Radix="Float" Value="0.0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[[XIC(IO_vfd_data.Out_DriveLogicRslt_OFF1_CONTROL) OTE(IO_vfd_data.Out_DriveLogicRslt.0) ,XIC(IO_vfd_data.Out_DriveLogicRslt_OFF2_CONTROL) OTE(IO_vfd_data.Out_DriveLogicRslt.1) ,XIC(IO_vfd_data.Out_DriveLogicRslt_OFF3_CONTROL) OTE(IO_vfd_data.Out_DriveLogicRslt.2) ,XIC(IO_vfd_data.Out_DriveLogicRslt_INHIBIT_OPERATION) OTE(IO_vfd_data.Out_DriveLogicRslt.3) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[XIC(IO_vfd_data.Out_DriveLogicRslt_RAMP_OUT_ZERO) OTE(IO_vfd_data.Out_DriveLogicRslt.4) ,XIC(IO_vfd_data.Out_DriveLogicRslt_RAMP_HOLD) OTE(IO_vfd_data.Out_DriveLogicRslt.5) ,XIC(IO_vfd_data.Out_DriveLogicRslt_RAMP_IN_ZERO) OTE(IO_vfd_data.Out_DriveLogicRslt.6) ,XIC(IO_vfd_data.Out_DriveLogicRslt_RESET) OTE(IO_vfd_data.Out_DriveLogicRslt.7) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[XIC(IO_vfd_data.Out_DriveLogicRslt_REMOTE_CMD) OTE(IO_vfd_data.Out_DriveLogicRslt.10) ,XIC(IO_vfd_data.Out_DriveLogicRslt_EXT_CTRL_LOC) OTE(IO_vfd_data.Out_DriveLogicRslt.11) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Command Word - Data[0] - Control Word]]>
</Comment>
<Text>
<![CDATA[MOV(IO_vfd_data.Out_DriveLogicRslt,IO_vfd_outputs.Data[0]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[RPM Command=(setpoint in units/minute)/(shaft circumference in units)*gear reduction between motor and roll
]]>
</Comment>
<Text>
<![CDATA[CPT(OUT_Speed_RPM,IN_Speed_Setpoint/( 3.14159265359*IN_Roll_Diameter)*IN_Gear_Reduction);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Scale the Speed Setpoint to the speed scaling parameter of the drive]]>
</Comment>
<Text>
<![CDATA[[CPT(IO_vfd_data.Out_Commanded_SPEED,OUT_Speed_RPM * 20000/IO_vfd_data.In_SpeedScaling) ,LES(IO_vfd_data.Out_Commanded_SPEED,-20000) MOV(-20000,IO_vfd_data.Out_Commanded_SPEED) ,GRT(IO_vfd_data.Out_Commanded_SPEED,20000) MOV(20000,IO_vfd_data.Out_Commanded_SPEED) ,MOV(IO_vfd_data.Out_Commanded_SPEED,Out_Speed_Command) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Command Word - Data[1] - Commanded Speed]]>
</Comment>
<Text>
<![CDATA[[XIC(IO_vfd_data.In_DriveStatus_RDY_ON) MOV(IO_vfd_data.Out_Commanded_SPEED,IO_vfd_outputs.Data[1]) ,XIO(IO_vfd_data.In_DriveStatus_RDY_ON) MOV(0,IO_vfd_outputs.Data[1]) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Command Word - Data [2] - Max Torque]]>
</Comment>
<Text>
<![CDATA[[XIC(IO_vfd_data.In_DriveStatus_RDY_ON) CPT(IO_vfd_outputs.Data[2],IO_vfd_data.Out_Commanded_Torque*10) ,XIO(IO_vfd_data.In_DriveStatus_RDY_ON) MOV(0,IO_vfd_outputs.Data[2]) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
