<![CDATA[OTE(p12r30.comment.3);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(p23_di_impreg_exhaust_running)XIO(p23r02.fault.1)EQU(p12r31.fault,0)EQU(p12r32.fault,0)EQU(p23r13.fault,0)OTE(p12r30_vfds_ok);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[EQU(p12r30.fault,0)[XIC(p23_di_impreg_tank_up) XIC(p01r13_permissive_oxidizer) ,XIO(p23_di_impreg_tank_up) ]XIC(p12r30_vfds_ok)XIO(p23r02.fault.0)XIO(p11r30.fault.4)XIO(p12r30.fault.4)OTE(p12r30_permissive_run);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[XIC(p12r30_pb_zone_on) ,XIC(p12r30_request_heat) ]XIO(p12r30_pb_zone_off)XIC(p12r30_permissive_run)XIC(p12_di_burner_auto)OTE(p12r30_request_heat);]]>
