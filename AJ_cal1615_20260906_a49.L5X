<Routine Name="R10_Letoff_Speed_Control" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[p20r10
This routine is called, continuously, from p20r01 Main while the plc is in Run mode.  All modes and fault reset requests are controlled, here.
]]>
</Comment>
<Text>
<![CDATA[SBR()OTE(p20r10.comment.0);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Tag Usage

p20r10.comment (dint)
p20r10.oneshot (dint)
p20r10_timer_xxxx (timer)
p20r10_xxxx (any)
p20r10.fault (dint)
p20r10.warning (dint)
]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.1);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Notes:
]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.2);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(p20r10.fault,0)OTE(p20r10_run_permissive);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Requests]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.3);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(p20r10_run_permissive)[XIC(p20r15_request_tension) ,XIC(p20r16_request_tension) ]OTE(p20r10_tension_request);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Comment>
<![CDATA[Auto Start Sequence]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.4);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Configure PID
The tension loadcell feedback is compared to its setpoint in a PID control.
With the PID output at 50%, error is made to be 0
Error is added or subtracted to the Tension of the previous drive to calculate the required Tension of the drive.
A gain factor is used to dampen the error effect on the drive Tension.]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.5);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[TON(p20r10_timer[0],?,?);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(p20r13_state.8)XIO(p20r13_state.4)MOV(p20r10_param_normal_gain,p20r10_param_psn_gain);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(p20r13_state.4) ,XIC(p20r13_state.8) ]MOV(p20r10_param_fill_gain,p20r10_param_psn_gain);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Comment>
<![CDATA[TENSION CONTROL PID
Arm the PID Parameters
Minimum Control Valve Position = x % (per manufacturer)]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.8);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(p20r10_tension_request)OTE(p20r10_pid_tens.SWM);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(p20r10_pid_tens.SWM)MOV(65,p20r10_pid_tens.SO);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[MOV(p01_recipe_active.letoff_tension_sp,p20r10_pid_tens.SP)MOV(p20_ai_lc01,p20r10_pid_tens_pv);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[MOV(p02_real_from_hmi.letoff[40],p20r10_pid_tens.KP)MOV(p02_real_from_hmi.letoff[41],p20r10_pid_tens.KI)MOV(p02_real_from_hmi.letoff[42],p20r10_pid_tens.KD)MOV(p02_real_from_hmi.letoff[43],p20r10_pid_tens.UPD)MOV(p20r10_pid_tens.BIAS,p20r10_pid_tens.BIAS);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(p20r13_state.8)MOV(p20_param_high_kp,p20r10_pid_tens.KP)MOV(p20_param_high_ki,p20r10_pid_tens.KI)MOV(p20_param_high_upd,p20r10_pid_tens.UPD);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[OTE(p20r10_pid_tens.NOBC);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[PID(p20r10_pid_tens,p20r10_pid_tens_pv,0,p20r10_pid_tens_cv,0,0,0);]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Text>
<![CDATA[CPT(p20r10_speed_offset_tens,(p20r10_pid_tens_cv-50)*p20r10_param_psn_gain*-1);]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[[XIC(p20_di_loa_fwd_dir) XIC(p20r15_request_thread_rev) ,XIO(p20_di_loa_fwd_dir) XIC(p20r15_request_thread_fwd) ,XIC(p20_di_lob_fwd_dir) XIC(p20r16_request_thread_rev) ,XIO(p20_di_lob_fwd_dir) XIC(p20r16_request_thread_fwd) ]CPT(p20r10_speed_offset_tens,(p20r10_pid_tens_cv-50)*p20r10_param_psn_gain*1);]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Comment>
<![CDATA[POSITION CONTROL PID
Arm the PID Parameters
Minimum Control Valve Position = x % (per manufacturer)]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.9);]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[MOV(100,p20r10_param_acc_full_psn);]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Text>
<![CDATA[MOV(p20r10_param_acc_full_psn,p20r10_pid_psn.SP);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Text>
<![CDATA[XIO(p20r13_state.5)MOV(100,p20r10_pid_psn.SO)OTE(p20r10_pid_psn.SWM);]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[MOV(p20r13_ai_acc_pct,p20r10_pid_psn_pv);]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Text>
<![CDATA[MOV(p20r10_pid_psn.KP,p20r10_pid_psn.KP)MOV(p20r10_pid_psn.KI,p20r10_pid_psn.KI)MOV(p20r10_pid_psn.KD,p20r10_pid_psn.KD)MOV(p20r10_pid_psn.UPD,p20r10_pid_psn.UPD);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[OTE(p20r10_pid_psn.NOBC);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[MOV(p20r10_pid_psn.BIAS,p20r10_pid_psn.BIAS)PID(p20r10_pid_psn,p20r10_pid_psn_pv,0,p20r10_pid_psn_cv,0,0,0);]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[CPT(p20r10_speed_offset_psn,(p20r10_pid_psn_cv-50)*p20r10_param_psn_gain);]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[Output Control]]>
</Comment>
<Text>
<![CDATA[OTE(p20r10.comment.10);]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Text>
<![CDATA[[MOV(p20r10_speed_offset_tens,p20r10_speed_offset) ,XIO(p20r10_tension_request) MOV(p20r10_speed_offset_psn,p20r10_speed_offset) ];]]>
</Text>
</Rung>
