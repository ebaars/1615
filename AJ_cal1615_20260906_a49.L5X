<![CDATA[MOV(0,acc_status)[EQU(acc_fill_status,0) MOV(1,acc_status) ,CMP(ai_lpt01_pct>(acc_position_last+0.01)) MOV(2,acc_status) ,CMP(ai_lpt01_pct<(acc_position_last-0.01)) MOV(3,acc_status) ,MOV(ai_lpt01_pct,acc_position_last) ,XIC(alarm_exists) MOV(4,acc_status) ,XIO(alarm_exists) XIC(warning_exists) MOV(5,acc_status) ,XIC(Me.OUT_Full) MOV(6,acc_status) ,XIC(Me.OUT_Empty) MOV(7,acc_status) ];]]>
