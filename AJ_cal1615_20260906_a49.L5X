<![CDATA[LEQ(IN_OUT_master_ramped_speed,IN_selected_line_speed)[CPT(IN_OUT_master_ramped_speed,IN_OUT_master_ramped_speed+(IN_param_master_accel_rate*(IN_last_scan_s))) ,GRT(IN_OUT_master_ramped_speed,IN_selected_line_speed) MOV(IN_selected_line_speed,IN_OUT_master_ramped_speed) ];]]>
