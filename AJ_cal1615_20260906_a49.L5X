<Tag Name="p29r16_state" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[Winder
Winder B VFD
Tension Mode Start Sequence
State Word]]>
</Description>
<Comments>
<Comment Operand=".0">
<![CDATA[Winder B Sequence
Step Gate
One Step per Scan]]>
</Comment>
<Comment Operand=".1">
<![CDATA[Winder B Sequence
State 1
Idle / Reset]]>
</Comment>
<Comment Operand=".2">
<![CDATA[Winder B Sequence
State 2
Start - Constant Torque
const_torque_ref, Speed Limit 1.5x]]>
</Comment>
<Comment Operand=".3">
<![CDATA[Winder B Sequence
State 3
Tension High
torque_low_ref]]>
</Comment>
<Comment Operand=".4">
<![CDATA[Winder B Sequence
State 4
Tension Low
torque_high_ref]]>
</Comment>
<Comment Operand=".5">
<![CDATA[Winder B Sequence
State 5
Tension OK]]>
</Comment>
<Comment Operand=".6">
<![CDATA[Winder B Sequence
State 6
Run
Enables p29r11_request_run]]>
</Comment>
<Comment Operand=".7">
<![CDATA[Winder B Sequence
State 7
Stopping
Returns to State 1]]>
</Comment>
</Comments>
<Data>03 00 00 00</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="3"/>
</Data>
</Tag>
