</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[XIC(AFI)[MOV(p00_lin_timer_pre_0ms,timer_alarm[13].PRE) ,TON(timer_alarm[13],?,?) ,XIC(timer_alarm[13].DN) OTL(A13) ];]]>
