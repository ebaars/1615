<![CDATA[Warnings]]>
</Comment>
<Text>
<![CDATA[OTE(p29r18.comment.31);]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[XIC(p01r09_pb_global_reset)MOV(p29r18.warning,p29r18.warning_ack);]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[XIC(FAULT)[TON(p29r18_timer_warning[0],?,?) ,XIC(p29r18_timer_warning[0].DN) OTL(p29r18.warning.0) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[XIO(FAULT)[OTU(p29r18.warning.0) ,OTU(p29r18.warning_ack.0) ];]]>
