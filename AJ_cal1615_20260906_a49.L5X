<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(in_pb)ONS(ons.1)OTL(toggle_select_deselct);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(toggle_select_deselct)XIO(out_state)[OTL(out_state) ,OTU(toggle_select_deselct) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(toggle_select_deselct)XIC(out_state)[OTU(out_state) ,OTU(toggle_select_deselct) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(out_state)OTE(toggle_state);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
