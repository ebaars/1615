<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[ABB ACS800 ABB PROTOCOL DRIVE CONTROL]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Permissive]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[OTE(vfd_abb_data.Out_DriveLogicRslt_INHIBIT_OPERATION)OTE(vfd_abb_data.Out_DriveLogicRslt_OFF2_CONTROL);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(IN_DRIVE_PERMISSIVE)OTE(vfd_abb_data.Out_DriveLogicRslt_OFF3_CONTROL);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Requests]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[OTE(vfd_abb_data.Out_DriveLogicRslt_RAMP_OUT_ZERO) ,OTE(vfd_abb_data.Out_DriveLogicRslt_RAMP_HOLD) ,OTE(vfd_abb_data.Out_DriveLogicRslt_RAMP_IN_ZERO) ,OTE(vfd_abb_data.Out_DriveLogicRslt_REMOTE_CMD) ,OTU(vfd_abb_data.Out_DriveLogicRslt_EXT_CTRL_LOC) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIO(vfd_abb_data.In_DriveStatus_SWC_ON_INHIB)XIC(vfd_abb_data.In_DriveStatus_RDY_ON)XIC(vfd_abb_data.Out_DriveLogicRslt_INHIBIT_OPERATION)XIC(IN_START)[OTE(vfd_abb_data.Out_DriveLogicRslt_OFF1_CONTROL) ,OTE(OUT_ENABLED) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(IN_GLOBAL_RESET)XIC(vfd_abb_data.In_DriveStatus_TRIPPED)OTE(vfd_abb_data.Out_DriveLogicRslt_RESET);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Comment>
<![CDATA[Faults]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIC(vfd_abb_data.In_DriveStatus_TRIPPED)OTE(OUT_FAULT);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Warnings]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(vfd_abb_data.In_DriveStatus_ALARM)OTE(OUT_ALARM);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
